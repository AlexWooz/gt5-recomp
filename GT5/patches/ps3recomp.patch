+/* ---- PS3RECOMP_VK_ASYNC_SHADERS=<threads> -----------------------------------
+ * A pipeline the engine has not seen before is translated (HLSL -> SPIR-V,
+ * glslang) and built (vkCreateGraphicsPipelines) on worker threads instead of
+ * the FIFO walker, and scene draws that use it are skipped until it is ready
+ * (a draw that doesn't test depth gets it built at once: vk_eng_pipe_build_now). A new
+ * car or track asks for 50-100 new pipelines at once; one after another on the
+ * walker that was a frozen frame of 300 ms or more (the [slow-frame] lines say
+ * how much of a long frame was this). Skipped draws mean an object can be
+ * missing for the first frames it is on screen. Off (0) by default; 1 picks a
+ * thread count from the CPU count (vk_shader_threads_auto), 2..8 that many. (Its state, s_async_sh,
+ * is with the [slow-frame] counters near the top.) */
+
+/* ---- VK_SHADER_BOOST (on unless =0): the backlog a new scene leaves, built in seconds -------------
+ * A race start queues 200-500 new pipelines. A laptop's Intel driver takes ~25 ms of CPU for each
+ * (the [slow-frame] lines of an i5-1135G7 + Iris Xe), and the two workers ran at normal priority beside
+ * a dozen busy game threads on 8 logical CPUs: they got a fraction of a core each, the queue took one
+ * to two minutes to empty, and every scene draw waiting for it was left out meanwhile (black sky,
+ * missing track), 25,000-57,000 draws per 5 s. Now, unless VK_SHADER_BOOST=0:
+ *  - workers: half the logical CPUs the game may use (its affinity), 2..8, where it was a quarter of
+ *    all the PC's CPUs (an 8-thread laptop got 2, now 4);
+ *  - they build above normal priority (Windows; they only run while something is queued), so a busy
+ *    game no longer starves them;
+ *  - each takes the queued pipeline the most skipped draws are waiting for, not the oldest;
+ *  - a pipeline the start-up builder (VK_PIPELINE_PREBUILD) hasn't reached yet when a draw asks for it
+ *    is built once, by the workers, not a second time by that builder;
+ *  - a scene pipeline still queued VK_SHADER_ASSIST_MS (default 1500) after its first skipped draw is
+ *    built by the walker itself, one a frame, so no scene stays half-drawn however busy the PC is.
+ * VK_SHADER_LOG=1 prints a [vkq] line a second: draws, skipped, queued, built, waiting, worker time. */
+static int vk_shader_boost(void)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("VK_SHADER_BOOST"); on = !(e && *e && atoi(e) == 0); }
+    return on;
+}
+static int vk_shader_log_on(void)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("VK_SHADER_LOG"); on = e && *e && atoi(e) != 0; }
+    return on;
