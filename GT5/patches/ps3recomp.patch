+/* A dumped scene frame: the upscaled picture (..._up.ppm, the output's own texels) and what the info
+ * file says of the evaluation. */
+static void ld_up_dump(const char* base, FILE* info)
+{
+    int wrote = 0;
+    if (s_up.evaluated && s_up.out) {
+        char path[MAX_PATH * 2 + 32];
+        snprintf(path, sizeof path, "%s_up.ppm", base);
+        surface_t tmp;
+        memset(&tmp, 0, sizeof tmp);
+        tmp.tex = s_up.out; tmp.w = s_up.ow; tmp.h = s_up.oh; tmp.fmt = DXGI_FORMAT_R8G8B8A8_UNORM; tmp.rs = 1.0f;
+        ld_mv_barrier(s_up.out, D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE, D3D12_RESOURCE_STATE_RENDER_TARGET);
+        wrote = ld_dump_surface_ppm(path, &tmp) != UINT64_MAX;
+        ld_mv_barrier(s_up.out, D3D12_RESOURCE_STATE_RENDER_TARGET, D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE);
+    }
+    if (!info) return;
+    fprintf(info, "up_mode=%s\nup_evaluated=%d\nup_shown=%d\n", ld_up_mode_name(s_up.want), s_up.evaluated, s_up.frame_ok);
+    fprintf(info, "up_render_size=%ux%u\nup_output_size=%ux%u\nup_model=%d\n", s_up.rw, s_up.rh, s_up.ow, s_up.oh, s_up.made_preset);
+    fprintf(info, "up_reset=%d\nup_jitter_given=%.6f,%.6f\nup_jitter_sign=%.0f,%.0f\nup_jitter_phases=%u\nup_view=%d\n",
+            s_up.last_reset, (double)s_up.last_jx, (double)s_up.last_jy, (double)s_up.sign_x, (double)s_up.sign_y,
+            s_up.phases_now, s_up.view);
+    fprintf(info, "up_out=%s\nup_quality_value=%d\nup_scale_percent=%.1f\nup_lod_bias=%.2f\nup_gpu_ms=%.3f\nup_display_rect=%ux%u x%.4f\n",
+            s_up.out_scene ? "scene" : "display", (int)s_up.made_quality, (double)s_up.scale_pct, -(double)s_up.lod_code * 0.25,
+            (double)s_up.gpu_ms, s_up.vp_w, s_up.vp_h, (double)s_up.disp_rs);
+    fprintf(info, "up_file=%s\n", wrote ? "the upscaler's output: 8-bit, sRGB-encoded like the scene, what the boundary draw reads" : "none");
+    if (!s_up.evaluated) fprintf(info, "up_reason=%s\n", s_up.reason[0] ? s_up.reason : "not a 3D scene frame");
+}
