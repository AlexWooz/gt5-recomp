+        const double k1 = 1000.0 / f.QuadPart / n;
+        extern unsigned g_ld_ovl_why_pub[8];
+        fprintf(stderr, "[frame-time] 5 s: %u presents; each: before the flush %.1f ms, flush %.1f ms, Present %.1f ms; "
+                        "waiting for the graphics card: %.1f ms a present at presents, %.1f ms in %u other flushes\n",
+                n, pre * k1, flush * k1, swap * k1, (double)g_dc_wait[0][1] / 1000.0 / n,
+                (double)(g_dc_wait[1][1] + g_dc_wait[2][1]) / 1000.0, (unsigned)(g_dc_wait[1][0] + g_dc_wait[2][0]));
+        memset(g_ld_ovl_why_pub, 0, sizeof g_ld_ovl_why_pub);
