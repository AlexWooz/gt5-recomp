+                    if (g_sys_event_timeout_veto && q->active && g_sys_event_timeout_veto(q->key))
+                        continue;   /* an event is on its way: wait on */
                     LeaveCriticalSection(&q->lock);
                     return (int64_t)(int32_t)CELL_ETIMEDOUT;
                 }
@@ -570,6 +579,14 @@
         while (q->count == 0 && q->active && !q->cancelled) {
             int rc = pthread_cond_timedwait(&q->not_empty, &q->lock, &ts);
             if (rc == ETIMEDOUT) {
+                if (g_sys_event_timeout_veto && q->active && g_sys_event_timeout_veto(q->key)) {
+                    /* an event is on its way: wait on, another timeout from now */
+                    clock_gettime(CLOCK_REALTIME, &ts);
+                    ts.tv_sec  += (time_t)(timeout_us / 1000000);
+                    ts.tv_nsec += (long)((timeout_us % 1000000) * 1000);
+                    if (ts.tv_nsec >= 1000000000L) { ts.tv_sec++; ts.tv_nsec -= 1000000000L; }
+                    continue;
+                }
                 pthread_mutex_unlock(&q->lock);
                 return (int64_t)(int32_t)CELL_ETIMEDOUT;
             }
