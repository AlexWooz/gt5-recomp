+void rsx_draw_engine_hitch_take(unsigned long long ns[3], unsigned n[3])
+{
+    for (int i = 0; i < ENG_HX_COUNT; i++) {
+        ns[i] = s_eng_hx_ns[i]; n[i] = s_eng_hx_n[i];
+        s_eng_hx_ns[i] = 0; s_eng_hx_n[i] = 0;
+    }
+}
