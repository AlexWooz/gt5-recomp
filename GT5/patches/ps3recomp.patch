+    if (!fw || !fh) { fw = g.width; fh = g.height; }
+    if (s_fill.mode <= 0 || !fw || !fh) { s_fill.on = 0; __atomic_store_n(&s_fill_pub, 0ull, __ATOMIC_RELEASE); return; }
+    const float W = (float)fw, H = (float)fh;
+    if (s_fill.fw != fw || s_fill.fh != fh) {
+        s_fill.fw = fw; s_fill.fh = fh;
+        s_fill.cur[0] = 0.0f; s_fill.cur[1] = 0.0f; s_fill.cur[2] = W; s_fill.cur[3] = H;
+        s_fill.win_have = 0; s_fill.win_n = 0; s_fill.on = 0;
+        __atomic_store_n(&s_fill_pub, 0ull, __ATOMIC_RELEASE);
+        return;                          /* this frame's rect was taken against the old size */
+    }
+    if (!have) return;
+    const float* r = s_fill.r;
+    float* c = s_fill.cur;
+    const char* why = NULL;
+    float b[4];
+    if (r[0] < c[0] - 0.5f || r[1] < c[1] - 0.5f || r[2] > c[2] + 0.5f || r[3] > c[3] + 0.5f) {
+        b[0] = r[0] < c[0] ? r[0] : c[0]; b[1] = r[1] < c[1] ? r[1] : c[1];
+        b[2] = r[2] > c[2] ? r[2] : c[2]; b[3] = r[3] > c[3] ? r[3] : c[3];
+        eng_fill_fit(b);
+        why = "widened";
+        s_fill.win_have = 0; s_fill.win_n = 0;
+    } else {
