+"#elif PASS == 9\n"
+"cbuffer K : register(b0) { float T; float K1; float K2; float K3; };\n"
+"Texture2D<float4> PrevF : register(t0);\n"
+"Texture2D<float4> CurF : register(t1);\n"
+"RWTexture2D<uint> Mv : register(u1);\n"
+"SamplerState S : register(s0);\n"
+"float4 vs(uint id : SV_VertexID) : SV_Position {\n"
+"    float2 uv = float2((id << 1) & 2, id & 2);\n"
+"    return float4(uv * float2(2, -2) + float2(-1, 1), 0, 1);\n"
+"}\n"
+"uint mvat(int2 i) { return Mv[uint2(clamp(i, int2(0, 0), int2(GQW - 1, GQH - 1)))]; }\n"
+"float4 ps(float4 pos : SV_Position) : SV_Target {\n"
+"    float2 px = pos.xy;\n"
+"    float2 g = px / 16.0 - 0.5;\n"
+"    int2 i0 = int2(floor(g));\n"
+"    float2 f = g - float2(i0);\n"
+"    uint v00 = mvat(i0), v10 = mvat(i0 + int2(1, 0)), v01 = mvat(i0 + int2(0, 1)), v11 = mvat(i0 + int2(1, 1));\n"
+"    float2 mv = lerp(lerp(float2(unpackmv(v00)), float2(unpackmv(v10)), f.x),\n"
+"                     lerp(float2(unpackmv(v01)), float2(unpackmv(v11)), f.x), f.y);\n"
+"    float2 inv = float2(1.0 / W, 1.0 / H);\n"
+"    float4 a = PrevF.SampleLevel(S, (px + T * mv) * inv, 0);\n"
+"    float4 b = CurF.SampleLevel(S, (px - (1.0 - T) * mv) * inv, 0);\n"
+"    float d = abs(LUMA(a) - LUMA(b));\n"
+"    float w = lerp(T, 1.0, saturate((d - 0.08) * 6.0));\n"
+"    float3 moved = lerp(a.rgb, b.rgb, w);\n"
+"    float3 p0 = PrevF.SampleLevel(S, px * inv, 0).rgb;\n"
+"    float3 c0 = CurF.SampleLevel(S, px * inv, 0).rgb;\n"
+"    float s0 = abs(LUMA(p0) - LUMA(c0));\n"
+"    [unroll] for (int i = 0; i < 4; i++) {\n"
+"        float2 o = float2(i == 0 ? 2 : i == 1 ? -2 : 0, i == 2 ? 2 : i == 3 ? -2 : 0);\n"
