+/* ---- rectangle clears (rsx_draw_backend.clear_color_rect / _depth_stencil_rect)
+ * RSX clears only what the scissor lets through. Without these the engine
+ * clears the whole target, and GT5 lost its text with it: it draws each
+ * glyph into a corner of the zeta's stencil, clears a rectangle elsewhere and
+ * then reads the glyph back -- a whole clear wiped the glyphs first, and the
+ * letters came out as solid boxes. vkCmdClearAttachments takes rectangles but
+ * only inside a render pass, so each clear begins a one-attachment pass on
+ * the target (passes cached per format); the framebuffer goes to the grave,
+ * destroyed after the next wait. */
+static struct { VkFormat fmt; int depth; VkRenderPass rp; } s_crp[8];
+static u32 s_crp_n;
+
+static VkRenderPass vk_clear_pass(VkFormat fmt, int depth)
+{
+    for (u32 i = 0; i < s_crp_n; i++)
+        if (s_crp[i].fmt == fmt && s_crp[i].depth == depth) return s_crp[i].rp;
+    if (s_crp_n >= 8) return VK_NULL_HANDLE;
+    VkAttachmentDescription att = {
+        .format = fmt, .samples = VK_SAMPLE_COUNT_1_BIT,
+        .loadOp = VK_ATTACHMENT_LOAD_OP_LOAD, .storeOp = VK_ATTACHMENT_STORE_OP_STORE,
+        .stencilLoadOp = VK_ATTACHMENT_LOAD_OP_LOAD, .stencilStoreOp = VK_ATTACHMENT_STORE_OP_STORE,
+        .initialLayout = VK_IMAGE_LAYOUT_GENERAL, .finalLayout = VK_IMAGE_LAYOUT_GENERAL };
+    VkAttachmentReference ref = { 0, VK_IMAGE_LAYOUT_GENERAL };
+    VkSubpassDescription sub = { .pipelineBindPoint = VK_PIPELINE_BIND_POINT_GRAPHICS,
+                                 .colorAttachmentCount = depth ? 0u : 1u,
+                                 .pColorAttachments = depth ? NULL : &ref,
+                                 .pDepthStencilAttachment = depth ? &ref : NULL };
+    VkRenderPassCreateInfo rci = { .sType = VK_STRUCTURE_TYPE_RENDER_PASS_CREATE_INFO,
+                                   .attachmentCount = 1, .pAttachments = &att,
+                                   .subpassCount = 1, .pSubpasses = &sub };
+    VkRenderPass rp = VK_NULL_HANDLE;
+    if (pvkCreateRenderPass(s_vk.device, &rci, NULL, &rp) != VK_SUCCESS) return VK_NULL_HANDLE;
+    s_crp[s_crp_n].fmt = fmt; s_crp[s_crp_n].depth = depth; s_crp[s_crp_n].rp = rp;
+    s_crp_n++;
+    return rp;
