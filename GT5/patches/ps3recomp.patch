+    (void)flags;
+    *granularity = 4096;
+    struct page_region rg[64];
+    unsigned long long n = 0;
+    const unsigned long long end = (unsigned long long)(uintptr_t)base + size;
+    unsigned long long at = (unsigned long long)(uintptr_t)base;
+    while (at < end) {
