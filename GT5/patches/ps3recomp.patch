+static void vk_test_driver_cost(void)
+{
+    static int ms = -1;
+    if (ms < 0) { const char* e = getenv("VK_TEST_DRIVER_MS"); ms = e ? atoi(e) : 0; if (ms < 0) ms = 0; }
+    if (!ms) return;
+    const u64 end = vk_thread_cpu_ns() + (u64)ms * 1000000ull;
