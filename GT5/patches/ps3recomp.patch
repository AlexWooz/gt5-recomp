+typedef struct { vk_pb_rec r; vk_eng_pipe P; u32 topos; int state; } vk_pb_ent;   /* 0 waiting, 1 built, 2 gone */
+typedef struct { u64 key; u32 used, val; } vk_pb_slot;   /* seen: val 1 = written this session; idx: tab index */
+static struct {
+    int decided, on, mru;
+    char list[1100];
+    FILE* out;
+    SDL_mutex* mu;
+    vk_pb_slot* seen; u32 nseen;
+    vk_pb_slot* idx;
+    vk_pb_ent* tab; u32 ntab;
+    SDL_Thread* th;
+    u32 built, taken, failed, left;   /* left: asked for before it was reached, so left to the workers */
+    u32 touched;                      /* records from the list written again: used this session */
