+/* On the walker. 0 = queued; -1 = no workers (translate here). */
+static int vk_async_enqueue(u32 slot)
+{
+    if (!s_async_sh.mu) {
+        s_async_sh.mu = SDL_CreateMutex();
+        s_async_sh.cv = SDL_CreateCond();
+        s_async_sh.queue = (u32*)calloc(VK_ENG_MAX_PIPE, sizeof(u32));
+        if (!s_async_sh.mu || !s_async_sh.cv || !s_async_sh.queue) { s_async_sh.threads = 0; return -1; }
+        int started = 0;
+        for (int i = 0; i < s_async_sh.threads; i++) {
+            s_async_sh.th[i] = SDL_CreateThread(vk_async_worker, "vk-shaders", NULL);
+            started += s_async_sh.th[i] != NULL;
+        }
+        if (!started) { s_async_sh.threads = 0; return -1; }
+        VK_LOG("engine: new shaders translate and build on %d threads (PS3RECOMP_VK_ASYNC_SHADERS%s);"
+               " draws wait for nothing\n", started,
+               vk_shader_boost() ? "; VK_SHADER_BOOST: above normal priority, most-waited-for first" : "");
+    }
+    s_async_sh.queued++;
+    SDL_LockMutex(s_async_sh.mu);
+    s_async_sh.queue[s_async_sh.tail] = slot;
+    s_async_sh.tail = (s_async_sh.tail + 1u) % VK_ENG_MAX_PIPE;
+    SDL_CondSignal(s_async_sh.cv);
+    SDL_UnlockMutex(s_async_sh.mu);
+    return 0;
+}
+
+static void vk_async_stop(void)
+{
+    if (!s_async_sh.mu) return;
+    SDL_LockMutex(s_async_sh.mu);
+    s_async_sh.quit = 1;
+    SDL_CondBroadcast(s_async_sh.cv);
+    SDL_UnlockMutex(s_async_sh.mu);
+    for (int i = 0; i < 8; i++) if (s_async_sh.th[i]) SDL_WaitThread(s_async_sh.th[i], NULL);
+    SDL_DestroyCond(s_async_sh.cv);
+    SDL_DestroyMutex(s_async_sh.mu);
+    free(s_async_sh.queue);
+    const u64 skipped = s_async_sh.skipped;
+    memset(&s_async_sh, 0, sizeof s_async_sh);
+    s_async_sh.threads = -1;
+    if (skipped) VK_LOG("engine: %llu draws were skipped while their shaders built\n", (unsigned long long)skipped);
 }
 
