+            const float f = c[k] / (k & 1 ? H : W);
+            const u64 q = (u64)(f * 65535.0f + 0.5f);
+            pub |= (q > 65535u ? 65535u : q) << (16 * k);
+        }
+    __atomic_store_n(&s_fill_pub, pub, __ATOMIC_RELEASE);
+    fprintf(stderr, "[fill] frame %u: the game draws inside %.0f,%.0f %.0fx%.0f of %ux%u (%s): the window shows %s\n",
+            s_fill.n_present, (double)r[0], (double)r[1], (double)(r[2] - r[0]), (double)(r[3] - r[1]), fw, fh, why,
+            s_fill.on ? "that part, filled" : "the whole frame");
+    if (s_fill.on)
+        fprintf(stderr, "[fill]   shown: %.1f,%.1f %.1fx%.1f, x%.3f\n", (double)c[0], (double)c[1], (double)(c[2] - c[0]),
+                (double)(c[3] - c[1]), (double)(W / (c[2] - c[0])));
+}
+
+int rsx_draw_engine_fill(float out[4])
+{
+    const u64 p = __atomic_load_n(&s_fill_pub, __ATOMIC_ACQUIRE);
+    if (!p) { out[0] = 0.0f; out[1] = 0.0f; out[2] = 1.0f; out[3] = 1.0f; return 0; }
+    for (int k = 0; k < 4; k++) out[k] = (float)((p >> (16 * k)) & 0xFFFFu) / 65535.0f;
+    return 1;
+}
