+        a.start = at; a.end = end; a.vec = (unsigned long long)(uintptr_t)rg; a.vec_len = 64;
+        a.category_mask = PAGE_IS_WRITTEN; a.return_mask = PAGE_IS_WRITTEN;
+        const long r = ioctl(s_ww_pagemap, PAGEMAP_SCAN, &a);
+        if (r < 0) return 1;
+        for (long i = 0; i < r; i++)
+            for (unsigned long long pg = rg[i].start; pg < rg[i].end; pg += 4096) {
+                if (n >= *count) return 1;   /* more than the caller can take: treat as failed */
+                addrs[n++] = (void*)(uintptr_t)pg;
