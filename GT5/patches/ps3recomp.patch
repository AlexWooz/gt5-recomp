+
+char* gt5_settings_render(void)
+{
+    ensure_init();
+    lock();
+    char* t = render_locked(0, NULL, NULL);
+    unlock();
+    return t;
+}
+
+static int write_atomic(const char* path, const char* text)
+{
+    char tmp[1100];
+#ifdef _WIN32
+    snprintf(tmp, sizeof tmp, "%s.%lu.tmp", path, (unsigned long)GetCurrentProcessId());
+    FILE* f = open_utf8(tmp, L"wb");
+#else
+    snprintf(tmp, sizeof tmp, "%s.%ld.tmp", path, (long)getpid());
+    FILE* f = open_utf8(tmp, "wb");
+#endif
+    if (!f) { fprintf(stderr, "[settings] can't write %s\n", tmp); return 0; }
+    const size_t n = strlen(text);
+    int ok = fwrite(text, 1, n, f) == n;
+    ok = fflush(f) == 0 && ok;
+#ifdef _WIN32
+    if (ok) _commit(_fileno(f));
+#else
+    if (ok) fsync(fileno(f));
+#endif
+    fclose(f);
+#ifdef _WIN32
+    wchar_t wt[1100], wp[1100];
+    MultiByteToWideChar(CP_UTF8, 0, tmp, -1, wt, 1100);
+    MultiByteToWideChar(CP_UTF8, 0, path, -1, wp, 1100);
+    /* The launcher (or a virus scanner) may have the file open for a moment: try a few times. */
+    for (int attempt = 0; ok && attempt < 5; attempt++) {
+        if (MoveFileExW(wt, wp, MOVEFILE_REPLACE_EXISTING | MOVEFILE_WRITE_THROUGH)) return 1;
+        Sleep(40);
+    }
+    if (ok) fprintf(stderr, "[settings] can't replace %s (error %lu)\n", path, GetLastError());
+    DeleteFileW(wt);
+    return 0;
+#else
+    if (ok && rename(tmp, path) == 0) return 1;
+    fprintf(stderr, "[settings] can't replace %s\n", path);
+    remove(tmp);
+    return 0;
+#endif
+}
+
+int gt5_settings_save(void)
+{
+    if (!s_inited || !s_path[0]) return 0;
+    if (!gt5_settings_dirty()) return 1;
+    change_t* changes = NULL;
+    int n_changes = 0;
+    lock();
+    /* The registry takes the merged values only once the file is written: a failed save changes
+     * nothing, and the next one tries again with the same changes. */
+    char* text = render_locked(0, NULL, NULL);
+    unlock();
+    const int ok = write_atomic(s_path, text);
+    free(text);
+    if (!ok) return 0;
+    lock();
+    text = render_locked(1, &changes, &n_changes);   /* the file now holds every change: all are taken in */
+    free(text);
+    if (n_changes) g_gt5_settings_gen++;
+    unlock();
+    for (int i = 0; i < n_changes; i++) {
+        fire(changes[i].key, changes[i].old_v, changes[i].new_v);
+        free(changes[i].key); free(changes[i].old_v); free(changes[i].new_v);
+    }
+    free(changes);
+    fprintf(stderr, "[settings] saved to %s\n", s_path);
+    return 1;
+}
