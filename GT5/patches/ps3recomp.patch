+" *     (ground that was uncovered has no earlier picture). */\n"
+"cbuffer K : register(b0) { float T; float K1; float K2; float K3; float4 K4; };\n"
+"Texture2D<float4> PrevH : register(t0);\n"
+"Texture2D<float4> CurH : register(t1);\n"
+"Texture2D<float4> CurF : register(t2);\n"
+"Texture2D<float4> MvC : register(t3);\n"
+"Texture2D<float4> MvP : register(t4);\n"
+"SamplerState S : register(s0);\n"
+"float4 vs(uint id : SV_VertexID) : SV_Position {\n"
+"    float2 uv = float2((id << 1) & 2, id & 2);\n"
+"    return float4(uv * float2(2, -2) + float2(-1, 1), 0, 1);\n"
+"}\n"
+"int2 cl(float2 p) { return clamp(int2(floor(p)), int2(0, 0), int2(W - 1, H - 1)); }\n"
+"float4 ps(float4 pos : SV_Position) : SV_Target {\n"
+"    int2 ip = int2(pos.xy);\n"
+"    float3 cf = CurF.Load(int3(ip, 0)).rgb;\n"
+"    if (MvC.Load(int3(ip, 0)).w < 0.5) return float4(cf, 1.0);\n"
+"    float hud = 0.0;\n"
+"    [unroll] for (int j = -1; j <= 1; j++) [unroll] for (int i = -1; i <= 1; i++) {\n"
+"        int3 q = int3(clamp(ip + int2(i, j) * 2, int2(0, 0), int2(W - 1, H - 1)), 0);\n"
