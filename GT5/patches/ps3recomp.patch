+/* s_pb.mu held: r written to the list unless it was this session already. VK_PB_MRU writes one from an
+ * earlier session again (used again: newest), and stops taking new keys at 2 * VK_PB_MAX this session;
+ * the v0.1.80 list stops at VK_PB_MAX records in all. */
+static void vk_pb_put(const vk_pb_rec* r, u64 key, int flush)
+{
+    if (!s_pb.out) return;
+    vk_pb_slot* s = vk_pb_slot_at(s_pb.seen, VK_PB_SEEN, key);
+    if (!s->used) {
+        if (s_pb.nseen >= (s_pb.mru ? VK_PB_MAX * 2u : VK_PB_MAX)) return;
+        s->used = 1; s->key = key; s->val = 0; s_pb.nseen++;
+    } else if (s->val) return;
