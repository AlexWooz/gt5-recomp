diff --git a/libs/video/rsx_framegen.c b/libs/video/rsx_framegen.c
new file mode 100644
--- /dev/null
+++ b/libs/video/rsx_framegen.c
@@ -0,0 +1,3014 @@
+/*
+ * ps3recomp - frame generation for the D3D12 live renderer (Windows); see rsx_framegen.h.
+ *
+ * RSX thread, per drawn frame (rsx_fg_begin), on the renderer's list:
+ *   copy the presented frame into history slot n (of FG_SLOTS; slot p holds the drawn frame before),
+ *   pass 0  luma at 1/4 size (box of 4x4),           pass 1  luma at 1/16 size,
+ * and when frames went undrawn since the one before:
+ *   pass 2  motion of 4x4 blocks at 1/16 size, full search +-FG_RS (+-128 screen pixels),
+ *   pass 3  motion of 4x4 blocks at 1/4 size (16x16 screen pixels), searched +-FG_RQ around the
+ *           coarse vector, +-1 around zero (the HUD and whatever holds still) and +-1 around the four
+ *           neighbouring coarse vectors (a repeating pattern can fool one coarse block),
+ *   pass 4  3x3 median of the vectors into mvf[m] (two of them, alternating).
+ * Presenter thread, per frame handed over: on lists of its own, each made frame is a full-screen pass
+ * into the back buffer: a vector v says the current frame's pixel at x was at x + v in the frame
+ * before, so what shows at x at time t (0 = before, 1 = now) is the current frame's pixel at
+ * x - (1-t)v and the earlier frame's at x + t v, mixed by t, leaning on the newer frame where they
+ * disagree; what is the same in both frames holds still, and a block that matched badly shows the newer
+ * frame. Then the drawn frame is copied from its slot. Each is presented, waiting for the refresh there
+ * and not on the RSX thread.
+ *
+ * The RSX thread writes slot d % 3 and mvf[d % 2] for drawn frame d only once the presenter has taken
+ * frame d - 2 (shown or dropped), the last one that reads them. A frame handed over while the presenter
+ * is still busy replaces the one waiting, so a slow screen drops frames instead of falling behind.
+ * Every list call made on the RSX thread is one the renderer's recording thread carries (ld_rec_install).
+ * Luma and vectors are R32 textures in UNORDERED_ACCESS all along (typed UAV loads of R32 are always
+ * there); a vector is x and y as int12 in screen pixels plus the match quality in the top byte.
+ */
+#ifdef _WIN32
+#include "rsx_framegen.h"
