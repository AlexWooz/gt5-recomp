+static int SDLCALL vk_async_worker(void* arg)
+{
+    (void)arg;
+    s_vk_in_worker = 1;
+#ifdef _WIN32
+    if (vk_shader_boost()) SetThreadPriority(GetCurrentThread(), 1 /* THREAD_PRIORITY_ABOVE_NORMAL */);
