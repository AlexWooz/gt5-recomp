+               (double)(now - s_fg.rep_at) / (double)hz, (unsigned long long)(s_fg.drawn - s_fg.rep_drawn),
+               (unsigned long long)(shown - s_fg.rep_shown), (unsigned long long)(made - s_fg.rep_made),
+               (unsigned long long)(dropped - s_fg.rep_dropped), (double)s_fg.waited * 1000.0 / (double)hz);
+        s_fg.rep_drawn = s_fg.drawn; s_fg.rep_shown = shown; s_fg.rep_made = made; s_fg.rep_dropped = dropped;
+        s_fg.waited = 0; s_fg.rep_at = now;
+    }
