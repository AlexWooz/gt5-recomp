+static int eng_up_resolve_wanted(const rsx_dsp_surface* sf, u32 target, int depth_test, int blend, u32 n_targets, u32 color_mask)
+{
+    if (!s_up.ready || s_up.out_scene || !s_scn.sig_valid) return 0;
