+/* On the walker: a draw that can't be skipped while its pipeline is still in the queue. Only
+ * scene geometry (a draw that tests depth) is left out until its pipeline is ready; full-screen
+ * passes, downsamples and the HUD don't test depth, and leaving one of those out breaks more than
+ * the frame: GT5 measures each scene's brightness by halving the frame level by level and reading
+ * the smallest level back, and sets its exposure from that. A level left out at a scene's first
+ * frames, while its pipelines were new, gave a measurement of whatever those rows held before, and
+ * the race could stay far too dark (or too bright) until the scene was loaded again with the
+ * pipelines ready. Translated here if no worker has it yet, else waited for: one build at most. */
+/* vk_eng_pipe_build_now's part on the walker, P being claimed by it: the two programs translated here
+ * (the driver's part comes at the draw, vk_eng_variant). */
+static void vk_eng_pipe_translate_here(vk_eng_pipe* P)
+{
+    const u64 th = vk_hitch_t0();
+    int ok = P->src[0] && P->src[1];
+    if (ok && vk_eng_translate(P->src[0], RSX_SHADER_STAGE_VERTEX, &P->vs)) ok = 0;
+    if (ok && vk_eng_translate(P->src[1], RSX_SHADER_STAGE_FRAGMENT, &P->fs)) ok = 0;
+    if (!ok) {
+        if (P->vs) { pvkDestroyShaderModule(s_vk.device, P->vs, NULL); P->vs = VK_NULL_HANDLE; }
+        if (P->fs) { pvkDestroyShaderModule(s_vk.device, P->fs, NULL); P->fs = VK_NULL_HANDLE; }
+    }
+    vk_hitch_add(VH_TRANSLATE, th);
+    free(P->src[0]); free(P->src[1]);
+    P->src[0] = P->src[1] = NULL;
+    __atomic_store_n(&P->pending, 0, __ATOMIC_RELEASE);
+}
+
+static void vk_eng_pipe_build_now(vk_eng_pipe* P)
+{
+    if (!__atomic_exchange_n(&P->claimed, 1, __ATOMIC_ACQ_REL)) {
+        vk_eng_pipe_translate_here(P);
+        s_async_sh.on_walker++;
+        return;
+    }
+    while (__atomic_load_n(&P->pending, __ATOMIC_ACQUIRE)) SDL_Delay(1);   /* a worker has it */
+    s_async_sh.waited++;
+}
