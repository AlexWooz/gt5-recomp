+/* GCM_DRAIN_STAT=1: every 5 s, how far apart the window got new pictures ([vkpace]), as the thread
+ * that presents them sees it: the walker (each drawn frame) or the frame generation presenter (each
+ * made and drawn frame; a repeat is no new picture). Called with s_swap_mu held. */
+static void vk_pace_note(int presenter)
+{
+    static int on = -1;
+    static u64 last, t0;
+    static float gaps[2048];
+    static u32 n, by;
+    if (on < 0) on = getenv("GCM_DRAIN_STAT") ? 1 : 0;
+    if (!on) return;
+    const u64 now = SDL_GetPerformanceCounter(), hz = SDL_GetPerformanceFrequency();
+    if (last && n < 2048) gaps[n++] = (float)((double)(now - last) * 1000.0 / (double)hz);
+    last = now;
+    by |= 1u << presenter;
+    if (!t0) t0 = now;
+    if (now - t0 < 5 * hz) return;
+    if (n > 4) {
+        for (u32 i = 1; i < n; i++) {   /* insertion sort: a few hundred */
+            const float g = gaps[i];
+            u32 j = i;
+            while (j > 0 && gaps[j - 1] > g) { gaps[j] = gaps[j - 1]; j--; }
+            gaps[j] = g;
+        }
+        u32 b[5] = { 0, 0, 0, 0, 0 };
+        for (u32 i = 0; i < n; i++) {
+            const float g = gaps[i];
+            b[g < 12.f ? 0 : g < 21.f ? 1 : g < 29.f ? 2 : g < 38.f ? 3 : 4]++;
+        }
+        VK_LOG("[vkpace] %u new pictures in 5 s, ms apart p10=%.1f p50=%.1f p90=%.1f p99=%.1f max=%.1f |"
+               " <12:%u 12-21:%u 21-29:%u 29-38:%u more:%u (%s)\n", n, gaps[n / 10], gaps[n / 2],
+               gaps[n * 9 / 10], gaps[n * 99 / 100], gaps[n - 1], b[0], b[1], b[2], b[3], b[4],
+               by == 2u ? "presenter thread" : by == 1u ? "walker" : "both");
+    }
+    n = 0; by = 0; t0 = now;
+}
