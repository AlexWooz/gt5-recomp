+/* Any thread, after vk_eng_variant made a variant: noted in the list once a session (the start-up
+ * builder's own builds are in it already, and are not a use). */
+static void vk_pb_note(const vk_eng_pipe* P, u32 topo)
+{
+    if (!s_pb.on || !s_pb.out || !P->vs_h || !P->ps_h || s_vk_in_prebuild) return;
+    vk_pb_rec r;
+    memset(&r, 0, sizeof r);
+    r.magic = 0x31425056u;   /* "VPB1" */
+    r.pad = (u32)sizeof r;   /* the record's size: checked when read */
+    r.nslots = P->nslots; r.stride = P->stride; r.rt_count = P->rt_count | (P->mv ? RSX_BE_RT_MV : 0u);   /* [mv] */
+    r.cube_mask = P->cube_mask;
+    r.topo = topo; r.rt_fmt = (u32)P->rt_fmt; r.vs_h = P->vs_h; r.ps_h = P->ps_h; r.rs_h = P->rs_h; r.rs = P->rs;
+    const u64 key = vk_pb_reckey(&r, P->dkey);
+    SDL_LockMutex(s_pb.mu);
+    vk_pb_put(&r, key, 1);
+    SDL_UnlockMutex(s_pb.mu);
+}
+
+/* VK_SHADER_BOOST: the render state as vk_eng_variant uses it. The alpha test is in the pixel program
+ * (ps_h); blend factors and equations mean nothing with blending off, the depth function and writes
+ * nothing with the depth test off, the stencil state nothing with the stencil test off (the back face's
+ * nothing when it is one-sided), the cull face nothing with culling off, and a colour mask byte only
+ * whether it is 0. The engine keys its pipelines on the GCM registers, so a race start asked for a third
+ * of its Vulkan pipelines twice or more (1,463 asked for, 967 different): each was built again. */
+static u64 vk_eng_vk_state_hash(const rsx_be_render_state* rs)
+{
+    rsx_be_render_state n = *rs;
+    n.alpha_test_enable = n.alpha_func = n.alpha_ref_raw = n.alpha_ref_format = 0;
+    n.rt_fp16 = 0;
+    if (!n.blend_enable && !n.blend_mrt) n.sf_rgb = n.df_rgb = n.sf_a = n.df_a = n.eq_rgb = n.eq_a = 0;
+    if (!n.depth_test) n.depth_write = n.depth_func = 0;
+    if (!n.stencil_enable) {
+        n.stencil_two_sided = n.s_func = n.s_func_mask = n.s_write_mask = n.s_fail = n.s_zfail = n.s_zpass = 0;
+        n.bs_func = n.bs_fail = n.bs_zfail = n.bs_zpass = 0;
+    } else if (!n.stencil_two_sided) {
+        n.bs_func = n.bs_fail = n.bs_zfail = n.bs_zpass = 0;
+    }
+    if (!n.cull_enable) n.cull_face = 0;
+    u32 cm = 0;
+    for (u32 b = 0; b < 32; b += 8) if ((n.color_mask >> b) & 0xFFu) cm |= 0xFFu << b;
+    n.color_mask = cm;
+    return rsx_draw_engine_hash_render_state(&n, 0x84222325cbf29ce4ull);
+}
+/* Everything vk_eng_variant builds a pipeline from, but the topology. */
+static u64 vk_eng_vk_key(const vk_eng_pipe* P)
+{
+    const u64 k[6] = { P->vs_h, P->ps_h, P->nrs_h, ((u64)P->nslots << 32) | P->stride,
+                       ((u64)(P->rt_count | (P->mv ? RSX_BE_RT_MV : 0u)) << 32) | (u32)P->rt_fmt, P->cube_mask };   /* [mv] */
+    return vk_pb_fnv(k, sizeof k, 0xcbf29ce484222325ull);
 }
 
