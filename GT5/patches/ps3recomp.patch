+"#define LUMA(c) dot((c).rgb, float3(0.299, 0.587, 0.114))\n"
+"/* A vector: x and y as int12 in screen pixels, and in the top byte how well its block matched\n"
+" * (mean luma difference per pixel x 2000, 255 at most). */\n"
+"uint packmv(int2 v, uint q) { return (uint(v.x) & 0xFFFu) | ((uint(v.y) & 0xFFFu) << 12) | (min(q, 255u) << 24); }\n"
