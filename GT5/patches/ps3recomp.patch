+#                    the C compiler sees it as a literal only because of a fold or a guard of
+#                    this lifter (an il/ilhu/iohl constant is one the old lift had as well).
+#                    origins: the guards it came through (ids, for choosing which guards pay).
+#   "c"              the compiler may know it as a constant (computed from constants only), as it
+#                    could in the old lift: no tainted constant went into it
+#   "t"              the same, with a tainted constant among its inputs
+#   "m"              computed from a tainted constant and something else in a way that may leave
+#                    constant lanes (a shuffle that takes lanes of a literal, a mask, ...)
+# The compiler folds what it knows. Integer and shuffle folds are exact; float folds are not
+# (round-to-nearest and no denormals-are-zero at compile time, see spu_opq in spu_helpers.h). So
+# every value in a state the OLD lift could not have had as a compile-time constant -- a
+# tainted "k", "t", "m" -- is wrapped in spu_opq() where it enters a float helper and where it
+# leaves the function's registers for memory (the context, the local store, the store-forwarding
+# pair), from where the compiler could pick it up again. A run-time value combined with a
+# tainted constant stays a run-time value where the operation cannot make constant lanes out of
+# it (_KEEPS_RUNTIME, a shufb whose known control takes every byte from a run-time register, a
+# select between two run-time registers); everything else is "m".
+
+_FV = 128        # pseudo register: _fv, the quadword _store_forward keeps
+_LSC = 129       # pseudo register: set once the function has stored a constant to local store
+
+_K_SIMPLE_RE = re.compile(r"^\s*ctx->gpr\[(\d+)\] = spu_(il|ila|ilh|ilhu|fsmbi|link)\((-?(?:0x[0-9A-Fa-f]+|\d+))\);$")
+_K_IOHL_RE = re.compile(r"^\s*ctx->gpr\[(\d+)\] = spu_iohl\(ctx->gpr\[(\d+)\], (-?(?:0x[0-9A-Fa-f]+|\d+))\);$")
+_K_MOVE_RE = re.compile(r"^\s*ctx->gpr\[(\d+)\] = (?:spu_ori\(ctx->gpr\[(\d+)\], 0(?:x0)?\)|spu_shlqbyi\(ctx->gpr\[(\d+)\], 0\)|spu_or\(ctx->gpr\[(\d+)\], ctx->gpr\[(\d+)\]\));$")
+_K_K4_RE = re.compile(r"ctx->gpr\[(\d+)\] = spu_k4\(0x([0-9A-F]{8})u, 0x([0-9A-F]{8})u, 0x([0-9A-F]{8})u, 0x([0-9A-F]{8})u\);(?: /\*@(?:O(\d+)|SAME)@\*/)?$")
+_SQ_VAL_RE = re.compile(r"spu_ls_(?:sq|write128)\(.*, (?:spu_opq\()?ctx->gpr\[(\d+)\]\)?\);")
+_FWD_LQ_RE = re.compile(r"^\s*ctx->gpr\[(\d+)\] = spu_ls_lq_fwd\(")
+_DIRECT_RE = re.compile(r"SPU_DIRECT_SV\(ctx, 0x([0-9A-F]+),")
+_CALL_RE = re.compile(r"spu_func_([0-9A-F]{8})_sv\(ctx\); spu_drain_call\(ctx, 0x([0-9A-F]+)\)")
+_DRAIN_RE = re.compile(r"spu_drain_call\(ctx, 0x([0-9A-F]+)\)")
+_OP_RE = re.compile(r"^(\s*)ctx->gpr\[(\d+)\] = (spu_\w+)\((.*)\);$")
+_ARG_REG_RE = re.compile(r"^ctx->gpr\[(\d+)\]$")
+ABI_KEEP = 80    # the guess: a call gives r80..r127 back unchanged (the SPU ABI's saved registers)
+
+# helpers whose result depends on the float environment or on float value classes
+_FP_HELPERS = {"spu_" + n for n in (
+    "fa fs fm fma fms fnms fi frest frsqest fceq fcgt fcmeq fcmgt fesd frds "
+    "dfa dfs dfm dfma dfms dfnms dfnma dfceq dfcgt dfcmeq dfcmgt dftsv csflt cuflt cflts cfltu").split()}
+_LZ_HELPERS = {"spu_fa": 2, "spu_fs": 2, "spu_fm": 2, "spu_fma": 3, "spu_fms": 3, "spu_fnms": 3}
+# word-wise moves of a register: the twin of the result is the same move of the twins
+_TWIN_MOVES = {"spu_rotqbyi", "spu_shlqbyi", "spu_rotqmbyi", "spu_ori", "spu_or", "spu_shufb", "spu_selb", "spu_insw"}
+_WORD_CMP = {"spu_fcgt", "spu_fceq", "spu_fcmgt", "spu_fcmeq", "spu_cgt", "spu_ceq", "spu_clgt",
+             "spu_cgti", "spu_ceqi", "spu_clgti"}
+# helpers that take a register as a shuffle control, a select mask or a shift count: a literal
+# there lets the compiler replace the general form (shufb: two pshufb, a blend, a table lookup)
+_PROFIT_ARG = {"spu_shufb": 2, "spu_selb": 2, "spu_rotqby": 1, "spu_shlqby": 1, "spu_rotqmby": 1,
+               "spu_rotqbybi": 1, "spu_shlqbybi": 1, "spu_rotqmbybi": 1, "spu_rotqbi": 1,
+               "spu_shlqbi": 1, "spu_rotqmbi": 1, "spu_shl": 1, "spu_rot": 1, "spu_rotm": 1,
+               "spu_rotma": 1, "spu_shlh": 1, "spu_roth": 1, "spu_rothm": 1, "spu_rothma": 1}
+
+
+def _const_words(kind, tok):
+    v = int(tok, 0)
+    if kind == "il":
+        w = v & 0xFFFFFFFF
+        return (w, w, w, w)
+    if kind == "ila":
+        w = v & 0x3FFFF
+        return (w, w, w, w)
+    if kind == "ilh":
+        h = v & 0xFFFF
+        return ((h << 16) | h,) * 4
+    if kind == "ilhu":
+        w = (v & 0xFFFF) << 16
+        return (w, w, w, w)
+    if kind == "fsmbi":
+        v &= 0xFFFF
+        by = [0xFF if (v >> (15 - i)) & 1 else 0 for i in range(16)]
+        return tuple((by[4 * j] << 24) | (by[4 * j + 1] << 16) | (by[4 * j + 2] << 8) | by[4 * j + 3] for j in range(4))
+    if kind == "link":
+        return (v & 0xFFFFFFFF, 0, 0, 0)
+    raise ValueError(kind)
+
+
+def _k4(words):
+    return "spu_k4(" + ", ".join("0x%08Xu" % w for w in words) + ")"
+
+
+def _keq(reg, words):
+    return f"spu_keq(ctx->gpr[{reg}], " + ", ".join("0x%08Xu" % w for w in words) + ")"
+
+
+def _isk(v):
+    return v is not None and v.__class__ is tuple
+
+
+def _tainted(v):
+    """The value must not reach a float helper or memory as the compiler knows it."""
+    return v == "t" or v == "m" or (_isk(v) and v[2])
+
+
+def _constish(v):
+    """The compiler may know the whole value as a constant."""
+    return v == "c" or v == "t" or _isk(v)
+
+
+# With one operand a run-time value, the result is one too, whatever constant the others are:
+# float arithmetic (x * 0 and x + 0 are not folded), adds, subtracts and exclusive ors, rotates.
+_KEEPS_RUNTIME = {"spu_fa", "spu_fs", "spu_fm", "spu_fma", "spu_fms", "spu_fnms",
+                  "spu_a", "spu_sf", "spu_ah", "spu_sfh", "spu_xor", "spu_eqv",
+                  "spu_rotqby", "spu_rotqbybi", "spu_rotqbi", "spu_rot", "spu_roth"}
+_RUNTIME_SOURCES = ("spu_ls_lq(", "spu_ls_lq_fwd(", "spu_ls_read128(", "spu_rdch(", "spu_rchcnt(", "spu_fscrrd(")
+_IMM_ARG_RE = re.compile(r"^-?(?:0x[0-9A-Fa-f]+|\d+)$")
+
+
+class _Line:
+    """What the constant flow needs to know about one body line."""
+    __slots__ = ("label", "gotos", "falls", "call", "sets", "reads", "kind", "t", "a", "k", "origin",
+                 "exits", "calls", "ret", "profit", "fn", "argregs", "runtime")
+
+    def __init__(self, ln):
+        s = ln.strip()
+        self.label = s[:-1] if s.startswith("loc_") and s.endswith(":") else None
+        self.gotos = re.findall(r"goto (loc_[0-9A-F]{8});", ln)
+        # Falling into the next line is assumed unless the line is plainly a jump or a tail: a
+        # way in that does not exist only makes the result more cautious.
+        self.falls = not ((s.endswith(";") and re.search(r"(?:^|; )goto loc_[0-9A-F]{8};$", s) and not s.startswith("if ("))
+                          or s.startswith("{ @WB@ SPU_DIRECT_SV("))
+        self.call = "@RL@" in ln
+        targets = {m.start() for m in _GPR_SET_RE.finditer(ln)}
+        self.sets = [int(n) for n in _GPR_SET_RE.findall(ln)]
+        self.reads = {int(m.group(1)) for m in _GPR_RE.finditer(ln) if m.start() not in targets}
+        self.exits = [int(x, 16) for x in _DIRECT_RE.findall(ln)]
+        self.calls = [int(a, 16) for a, _ in _CALL_RE.findall(ln)]
+        m = _DRAIN_RE.search(ln)
+        self.ret = int(m.group(1), 16) if (m and self.call) else None
+        self.kind, self.t, self.a, self.k, self.origin = "op", None, None, None, None
+        self.profit = None             # the register a literal would pay in (a control, mask or count)
+        self.fn, self.argregs = None, None   # ctx->gpr[T] = fn(registers and immediates only);
+        self.runtime = next((x for x in _RUNTIME_SOURCES if x in ln), None)   # the result is read from outside
+        if self.label is not None or self.call:
+            return
+        m = _OP_RE.match(ln)
+        if m:
+            args = _split_args(m.group(4))
+            regs = [int(ma.group(1)) if ma else None for ma in map(_ARG_REG_RE.match, args)]
+            if m.group(3) in _PROFIT_ARG and len(args) > _PROFIT_ARG[m.group(3)] and regs[_PROFIT_ARG[m.group(3)]] is not None:
+                self.profit = regs[_PROFIT_ARG[m.group(3)]]
+            if all(r is not None or _IMM_ARG_RE.match(a) for r, a in zip(regs, args)):
+                self.fn, self.argregs = m.group(3), regs
+            elif m.group(3) in ("spu_insb", "spu_insh", "spu_insw", "spu_insd") and regs[0] is not None and regs[1] is not None:
+                self.fn, self.argregs = "spu_ins", regs[:2]
+        m = _K_SIMPLE_RE.match(ln)
+        if m:
+            self.kind, self.t, self.k = "k", int(m.group(1)), (_const_words(m.group(2), m.group(3)), False)
+            return
+        m = _K_K4_RE.search(ln)
+        if m and len(self.sets) == 1:
+            # a literal of this lifter (a folded local-store line, a guarded register): tainted
+            self.kind, self.t = "k", int(m.group(1))
+            self.k = (tuple(int(m.group(i), 16) for i in range(2, 6)), True)
+            self.origin = int(m.group(6)) if m.group(6) else None
+            return
+        m = _K_IOHL_RE.match(ln)
+        if m:
+            self.kind, self.t, self.a, self.k = "iohl", int(m.group(1)), int(m.group(2)), int(m.group(3), 0) & 0xFFFF
+            return
+        m = _K_MOVE_RE.match(ln)
+        if m and (m.group(4) is None or m.group(4) == m.group(5)):
+            self.kind, self.t = "move", int(m.group(1))
+            self.a = int(m.group(2) or m.group(3) or m.group(4))
+            return
+        if _FWD_LQ_RE.match(ln):
+            self.kind, self.t = "lqfwd", self.sets[0]
+            return
+        m = _SQ_VAL_RE.search(ln)
+        if m and not self.sets:
+            # a store; "sqfwd" when _store_forward also keeps the value in _fv
+            self.kind, self.a = ("sqfwd" if "_fv = " in ln else "sq"), int(m.group(1))
+
+
+def _shufb_runtime(words, sa, sb):
+    """shufb with the known control `words`: every result byte comes from a run-time register
+    (sa, sb: whether a / b is one)."""
+    for w in words:
+        for sh in (24, 16, 8, 0):
+            c = (w >> sh) & 0xFF
+            if c >= 0x80 or not (sb if c & 0x10 else sa):
+                return False
+    return True
+
+
+def _generic_state(li, st):
+    """The state of what a line without a special form writes."""
+    reads = [st.get(r) for r in li.reads]
+    tainted = any(_tainted(v) for v in reads)
+    if li.runtime:
+        return "c" if (_LSC in st and "spu_ls_" in li.runtime) else None
+    if all(v is not None for v in reads):          # no operand is certainly a run-time value
+        if not tainted:
+            return "c"
+        return "t" if all(_constish(v) for v in reads) else "m"
+    if not tainted:
+        # one operand is a run-time value and no literal of this lifter is involved: a run-time
+        # value for a plain helper; anything else is taken as "may be a constant" (the cautious
+        # reading: it only ever adds barriers)
+        return None if li.fn is not None else "c"
+    fn = li.fn
+    if fn in _KEEPS_RUNTIME:
+        return None
+    if fn == "spu_shufb":
+        a, b, c = (st.get(r) for r in li.argregs)
+        if _isk(c) and _shufb_runtime(c[1], a is None, b is None):
+            return None
+    elif fn in ("spu_selb", "spu_ins"):
+        if st.get(li.argregs[0]) is None and st.get(li.argregs[1]) is None:
+            return None
+    return "m"
+
+
+def _transfer(li, st, guess):
+    """The state after a line, from the state before it (st is not changed)."""
+    if li.label is not None:
+        return st
+    if li.call:
+        if not guess:
+            return {} if st else st
+        # the guess that seeds the guards: saved registers come back as they went in
+        return {r: v for r, v in st.items() if ABI_KEEP <= r < 128 and _isk(v) and r not in li.sets}
+    k = li.kind
+    if k == "k":
+        v = ("k", li.k[0], li.k[1], frozenset() if li.origin is None else frozenset((li.origin,)))
+    elif k == "iohl":
+        a = st.get(li.a)
+        v = ("k", tuple(w | li.k for w in a[1]), a[2], a[3]) if _isk(a) else a
+    elif k == "move":
+        v = st.get(li.a)
+    elif k == "lqfwd":
+        # what the store-forwarding pair holds, if anything constant (a tainted value went into
+        # it through spu_opq, see _barriers: the compiler does not know that one)
+        fv = st.get(_FV)
+        v = "c" if ((fv is not None and not _tainted(fv)) or _LSC in st) else None
+    elif k in ("sq", "sqfwd"):
+        # A constant the compiler knows (not a tainted one: those are stored through spu_opq)
+        # is in local store from here on, and the compiler may hand it to a later load of this
+        # function: loads give "may be a constant" until the next call.
+        v = st.get(li.a)
+        lsc = _LSC in st or (v is not None and not _tainted(v))
+        if (k == "sq" or st.get(_FV) == v) and lsc == (_LSC in st):
+            return st
+        out = dict(st)
+        if k == "sqfwd":
+            if v is None:
+                out.pop(_FV, None)
+            else:
+                out[_FV] = v
+        if lsc:
+            out[_LSC] = "c"
+        return out
+    else:
+        if not li.sets:
+            return st
+        v = _generic_state(li, st)
+        if all(st.get(t) == v for t in li.sets):
+            return st
+        out = dict(st)
+        for t in li.sets:
+            if v is None:
+                out.pop(t, None)
+            else:
+                out[t] = v
+        return out
+    if st.get(li.t) == v:
+        return st
+    out = dict(st)
+    if v is None:
+        out.pop(li.t, None)
+    else:
+        out[li.t] = v
+    return out
+
+
+def _join(a, b):
+    if a is b or a == b:
+        return a
+    out = {}
+    for r in a.keys() | b.keys():
+        x, y = a.get(r), b.get(r)
+        if x == y:
+            out[r] = x
+        elif r == _LSC:
+            out[r] = "c"               # a constant was stored on one of the ways here
+        elif _isk(x) and _isk(y) and x[1] == y[1]:
+            out[r] = ("k", x[1], x[2] or y[2], x[3] | y[3])
+        elif _tainted(x) or _tainted(y):
+            out[r] = "t" if (_constish(x) and _constish(y)) else "m"
+        elif x is not None and y is not None:
+            out[r] = "c"
+    return out
+
+
+def _flow(infos, entry, guess=False):
+    """Forward flow over one function body: the state before each line (None: not reached)."""
+    n = len(infos)
+    ins = [None] * n
+    if not n:
+        return ins
+    label_at = {li.label: i for i, li in enumerate(infos) if li.label is not None}
+    ins[0] = entry
+    work = [0]
+    while work:
+        i = work.pop()
+        li = infos[i]
+        out = _transfer(li, ins[i], guess)
+        succ = [label_at[g] for g in li.gotos if g in label_at]
+        if li.falls and i + 1 < n:
+            succ.append(i + 1)
+        for j in succ:
+            new = out if ins[j] is None else _join(ins[j], out)
+            if ins[j] is None or new != ins[j]:
+                ins[j] = new
+                work.append(j)
+    return ins
+
+
+def _wordwise_control(words):
+    """A shufb control that moves whole words (or makes constant ones): every result word is
+    bytes 4j..4j+3 of the a:b concatenation, or four special selectors."""
+    for w in words:
+        b = [(w >> 24) & 0xFF, (w >> 16) & 0xFF, (w >> 8) & 0xFF, w & 0xFF]
+        if all(x >= 0x80 for x in b):
+            continue
+        if any(x >= 0x80 for x in b):
+            return False
+        b = [x & 0x1F for x in b]
+        if b[0] % 4 or b[1] != b[0] + 1 or b[2] != b[0] + 2 or b[3] != b[0] + 3:
+            return False
+    return True
+
+
+def _split_args(argstr):
+    out, depth, cur = [], 0, ""
+    for ch in argstr:
+        if ch == "(":
+            depth += 1
+        elif ch == ")":
+            depth -= 1
+        if ch == "," and depth == 0:
+            out.append(cur.strip()); cur = ""
+        else:
+            cur += ch
+    if cur.strip():
+        out.append(cur.strip())
+    return out
+
+
+def _barriers(lines, infos, ins):
+    """spu_opq() around tainted values entering float helpers, local-store stores and the
+    store-forwarding pair (the context write-backs are _localize's). One line in, one line out."""
+    out = []
+    for ln, li, st in zip(lines, infos, ins):
+        if st is None or not st or li.label is not None:
+            out.append(ln)
+            continue
+        m = _OP_RE.match(ln)
+        if m and m.group(3) in _FP_HELPERS:
+            args = _split_args(m.group(4))
+            changed = False
+            for i, a in enumerate(args):
+                ma = _ARG_REG_RE.match(a)
+                if ma and _tainted(st.get(int(ma.group(1)))):
+                    args[i] = f"spu_opq({a})"
+                    changed = True
+            if changed:
+                ln = f"{m.group(1)}ctx->gpr[{m.group(2)}] = {m.group(3)}({', '.join(args)});"
+        elif "spu_ls_sq(" in ln or "spu_ls_write128(" in ln:
+            def wrap(mm, st=st):
+                return f"spu_opq({mm.group(0)})" if _tainted(st.get(int(mm.group(1)))) else mm.group(0)
+            # the stored value is the last register named in the store, and _fv's source
+            ln = re.sub(r"ctx->gpr\[(\d+)\](?=\);)", wrap, ln)
+            ln = re.sub(r"(?<=_fv = )ctx->gpr\[(\d+)\](?=;)", wrap, ln)
+        out.append(ln)
+    return out
+
+
+def _lazy_flush(lines, infos, ins):
+    """Twins for float chains (--lazy-flush; spu_fa_lz and friends in spu_helpers.h).
+
+    Every register that some float add/subtract/multiply/fused operation of this function both
+    writes and reads gets a twin local _uN: the register's value before the "a zero is +0" fix
+    where a float operation wrote it, a copy of the register everywhere else. Float operations
+    take their operands' twins, so a chain of them is op, op, op instead of op, fix, op, fix.
+    The twin is kept in step at every write of the register: here for the lines of the body
+    (a float line sets both; a whole-word move of twins -- a rotate or shift by whole words, a
+    register move, a shufb whose known control moves whole words, a select under a word mask, a
+    lane insert -- makes the twin by the same move; any other write copies the register), in
+    _localize wherever a register is loaded from the context. Returns (lines, twins); the line
+    count does not change."""
+    dst, src = set(), set()
+    parsed = []
+    for ln in lines:
+        m = _OP_RE.match(ln)
+        if m and m.group(3) in _TWIN_MOVES:
+            # a move a twin may pass through: its result can carry one, its operands feed one
+            dst.add(int(m.group(2)))
+            src.update(int(x) for x in _GPR_RE.findall(m.group(4)))
+        if m and m.group(3) in _LZ_HELPERS:
+            args = _split_args(m.group(4))
+            regs = []
+            for a in args:
+                ma = re.match(r"^(?:spu_opq\()?ctx->gpr\[(\d+)\]\)?$", a)
+                regs.append(int(ma.group(1)) if ma else None)
+            if None not in regs and len(regs) == _LZ_HELPERS[m.group(3)]:
+                parsed.append((m, args, regs))
+                dst.add(int(m.group(2)))
+                src.update(regs)
+                continue
+        parsed.append(None)
+    twins = dst & src
+    if not twins:
+        return lines, set()
+
+    def tw(arg, reg):                  # the twin of an operand (same wrapping)
+        return arg.replace(f"ctx->gpr[{reg}]", f"_u{reg}") if reg in twins else arg
+
+    out = []
+    wm = set()                         # registers holding whole-word masks (this block)
+    for i, ln in enumerate(lines):
+        li, p = infos[i], parsed[i]
+        if li.label is not None:
+            wm.clear()
+            out.append(ln)
+            continue
+        if p is not None:
+            m, args, regs = p
+            t = int(m.group(2))
+            sink = f"&_u{t}" if t in twins else "&_ud"
+            ua = [tw(a, r) for a, r in zip(args, regs)]
+            if t in twins or ua != args:
+                ln = f"{m.group(1)}ctx->gpr[{t}] = {m.group(3)}_lz({', '.join(args + ua)}, {sink});"
+            wm.discard(t)
+            out.append(ln)
+            continue
+        if li.call:
+            wm.clear()
+            out.append(ln)             # every local is reloaded after it, twins with them
+            continue
+        sets = [t for t in li.sets if t in twins]
