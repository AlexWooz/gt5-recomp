--- a/runtime/spu/spu_coh_bitmap.h
+++ b/runtime/spu/spu_coh_bitmap.h
@@ -41,6 +41,39 @@
     return (bits[line >> 3] >> (line & 7)) & 1;
 }
 
+/* The lifted PPU code's store gate: one byte per 4 KiB guest page, non-zero when a store to the
+ * page cannot be a plain store. A lifted store used to make three checks of its own -- two
+ * diagnostic watches and the bitmap above, four loads and four branches -- which made a guest
+ * store about twenty host instructions. It now reads this one byte; only on a flagged page does
+ * it go on to the exact test (ppu_recomp.h, vm_mm_st_ok_page).
+ *   PPU_ST_PAGE_COH    a line of the page has been marked in the bitmap. Set just before the
+ *                      line's bit and never cleared, so whoever sees the bit sees the byte.
+ *   PPU_ST_PAGE_SWEEP  the null-store sweep is on (g_null_sweep_hi): every page.
+ *   PPU_ST_PAGE_WATCH  the barrier watch is armed (g_barrier_sync_watch): every page.
+ * Shared like g_spu_coh_bits: untouched pages of it are never committed. */
+#define PPU_ST_PAGE_SHIFT  12
+#define PPU_ST_PAGE_COH    0x01u
+#define PPU_ST_PAGE_WATCH  0x40u
+#define PPU_ST_PAGE_SWEEP  0x80u
+SPU_COH_SHARED unsigned char g_ppu_st_page[1u << (32 - PPU_ST_PAGE_SHIFT)];
+
+static inline void ppu_st_page_mark(uint32_t addr)
+{
+    unsigned char* b = &g_ppu_st_page[addr >> PPU_ST_PAGE_SHIFT];
+    if (!(__atomic_load_n(b, __ATOMIC_RELAXED) & PPU_ST_PAGE_COH))
+        __atomic_or_fetch(b, PPU_ST_PAGE_COH, __ATOMIC_SEQ_CST);
+}
+
+/* Turn a diagnostic flag on or off for every page. Rare (a diagnostic arming), so the megabyte
+ * walk does not matter; atomic because ppu_st_page_mark may run beside it. */
+static inline void ppu_st_page_all(unsigned char flag, int on)
+{
+    for (uint32_t i = 0; i < (1u << (32 - PPU_ST_PAGE_SHIFT)); i++) {
+        if (on) __atomic_or_fetch(&g_ppu_st_page[i], flag, __ATOMIC_SEQ_CST);
+        else    __atomic_and_fetch(&g_ppu_st_page[i], (unsigned char)~flag, __ATOMIC_SEQ_CST);
+    }
+}
+
 #ifdef __cplusplus
 }
 #endif
