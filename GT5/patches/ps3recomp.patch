+/* The slot holding key, or the free one where it goes (the tables stay at most half full). */
+static vk_pb_slot* vk_pb_slot_at(vk_pb_slot* t, u32 n, u64 key)
+{
+    u32 i = (u32)(key ^ (key >> 31)) & (n - 1u);
+    while (t[i].used && t[i].key != key) i = (i + 1u) & (n - 1u);
+    return &t[i];
