+                                    (double)(((unsigned long long)u.dwHighDateTime << 32) | u.dwLowDateTime)) * 1e-7;
+                if (st0 && now > st0) st.cpu_cores = (float)((cpu - cpu0) * 1000.0 / (double)(now - st0));
+                cpu0 = cpu;
+            } }
+          { long long made = 0, shown = 0;
+            rsx_fg_counts(&made, &shown);
+            if (st0 && now > st0 && (made != made0 || shown != shown0)) {
+                const double dt = (double)(now - st0) / 1000.0;
+                st.made_fps = (float)((double)(made - made0) / dt);
+                st.shown_fps = (float)((double)((made - made0) + (shown - shown0)) / dt);
+            }
+            made0 = made; shown0 = shown; }
+          st0 = now;
+          gt5_menu_set_stats(&st); }
         s_state.title_frames = s_state.frame_count;
         s_state.title_time = now;
     }
diff --git a/runtime/settings/gt5_menu.h b/runtime/settings/gt5_menu.h
new file mode 100644
--- /dev/null
+++ b/runtime/settings/gt5_menu.h
@@ -0,0 +1,202 @@
+/*
+ * gt5_menu - the in-game settings menu of the GT5 PC port (Dear ImGui on Direct3D 12 and Vulkan).
+ *
+ * A C API: the renderer and the input code are C. The menu knows nothing of the renderer beyond what
+ * is handed to it here (a device, a command queue, the size and format of the frame that goes to the
+ * window), and nothing of the settings beyond the registry (gt5_settings.h).
+ *
+ * Two halves. The first is plain C on every platform: what the input code needs (is the menu holding
+ * the input, here is the controller). The second is Windows and Direct3D 12: the window's messages
+ * and the drawing. The Vulkan renderer's drawing is in gt5_menu_vk.h; it shares everything else here,
+ * gt5_menu_wndproc included. A build without the menu (another title, Linux, a test) links
+ * gt5_menu_stub.c, which answers "no menu" to all of it. A C file that must not see <windows.h> (the
+ * Vulkan renderer) defines GT5_MENU_NO_D3D12 first and gets the first half only.
+ *
+ * Threads. Everything is called on the window's thread (the one that owns the HWND and runs its
+ * messages; in the game that is also the thread that presents), except the calls marked "any thread":
+ *     gt5_menu_input_captured, gt5_menu_is_open            (input code)
+ *     gt5_menu_overlay_visible, gt5_menu_overlay_composite (frame generation's presenter)
+ *     gt5_menu_set_stats, gt5_menu_feed_pad, gt5_menu_feed_wheel, gt5_menu_notice
+ *
+ * A frame, with the overlay texture (recommended, and the only way when another thread presents too):
+ *     gt5_menu_frame();                        builds the menu and draws it into the overlay texture
+ *     ... wherever a frame is put into a back buffer, on whichever thread, with that thread's list:
+ *     if (gt5_menu_overlay_visible()) gt5_menu_overlay_composite(list, rtv);
+ *     or, with no list of your own at hand:
+ *     if (gt5_menu_overlay_visible()) gt5_menu_overlay_blit(back_buffer, rtv);   (window thread)
+ * A frame, drawn directly into the back buffer:
+ *     gt5_menu_frame_direct(list, rtv);        builds the menu and draws it with your list
+ */
+#ifndef GT5_MENU_H
+#define GT5_MENU_H
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* ==== input: every platform ============================================================================ */
+
+/* Any thread, a single load: 1 while the menu has the input (it is open, its controller buttons are
+ * being held to open it, or the press that closed it isn't up yet). The game must then see no key, no
+ * mouse and a controller at rest. */
+extern volatile long g_gt5_menu_captured;
+#define gt5_menu_input_captured() (g_gt5_menu_captured != 0)
+/* [win] Any thread, a single load: 1 while the menu or its "Quit the game?" is open, i.e. while the game
+ * should hold still. cellPad.c (GT5_MENU_PAUSE) pauses a race on it and resumes it when it goes back to 0. */
+extern volatile long g_gt5_menu_pause_want;
+int  gt5_menu_is_open(void);
+void gt5_menu_set_open(int open);
+
+/* The controller as the port reads it, once a poll, whether the menu is open or not (it opens on a
+ * button chord). Buttons are CELL_PAD_CTRL_* bits, sticks 0..255 with 128 at rest, as in cellPad.c's
+ * PadHostState, so the same feed serves XInput pads, DualSense/DualShock 4 and SDL. Any thread. */
+typedef struct gt5_menu_pad {
+    int            connected;
+    unsigned short buttons;        /* CELL_PAD_CTRL_*: select 1<<0, l3 1<<1, r3 1<<2, start 1<<3, up 1<<4, right 1<<5,
+                                      down 1<<6, left 1<<7, l2 1<<8, r2 1<<9, l1 1<<10, r1 1<<11, triangle 1<<12,
+                                      circle 1<<13, cross 1<<14, square 1<<15 */
+    unsigned char  lx, ly, rx, ry; /* 128 = centre, 0 = left / up */
+    unsigned char  l2, r2;         /* 0..255 */
+} gt5_menu_pad;
+void gt5_menu_feed_pad(const gt5_menu_pad* pad);
+
+/* A few plain words in a corner of the picture about something the player can put right (a wheel that
+ * isn't found or stopped answering). One notice per id: the same id again replaces it, en NULL takes it
+ * away. It shows for ms milliseconds from when it is first on the screen (0: until taken away), not
+ * while the menu is open; zh NULL = the English. GT5_NOTICES=0: none are shown. Any thread. */
+enum { GT5_NOTICE_WHEEL = 0, GT5_NOTICE_COUNT = 4 };
+void gt5_menu_notice(int id, const char* en, const char* zh, unsigned ms);
+
+/* The PC wheel as DirectInput reports it, for the wheel map's "press a button" rows. Any thread. */
+typedef struct gt5_menu_wheel {
+    int           connected;
+    char          name[64];
+    unsigned char button[64];      /* 1 = held, by the wheel's own button number (0-based) */
+    float         axis[8];         /* X Y Z RX RY RZ S0 S1, each 0..1 over its range */
+} gt5_menu_wheel;
+void gt5_menu_feed_wheel(const gt5_menu_wheel* wheel);
+
+/* ==== the live readout: every platform ================================================================= */
+
+/* What the Performance page (and the corner readout) shows. The renderer fills it about once a second;
+ * a field it can't fill stays negative and is left out. Any thread. */
+typedef struct gt5_menu_stats {
+    float game_fps;        /* game frames a second (rsx_live_draw_get_game_fps)                  */
+    float shown_fps;       /* frames put on the screen a second, drawn and made                  */
+    float drawn_fps;       /* frames the renderer drew a second (rsx_live_draw_get_present_fps)  */
+    float made_fps;        /* frames frame generation made a second                              */
+    float cpu_cores;       /* CPU cores busy, the whole process (process time / wall time)       */
+    float gpu_ms;          /* GPU time of a frame, when measured                                 */
+    int   draws;           /* draws in the last frame                                            */
+    int   frame_w, frame_h;/* the size frames are drawn at                                       */
+    int   display_hz;
+    char  gpu_name[96];
+    char  aa_state[128];   /* what the anti-aliasing / upscaler is doing right now, or why it can't
+                              (the renderer's ld_upscale_state); "" = nothing to say               */
+    char  fg_state[160];   /* the same for frame generation (rsx_fg_state)                         */
+} gt5_menu_stats;
+void gt5_menu_stats_clear(gt5_menu_stats* s);   /* every field "not known" */
+void gt5_menu_set_stats(const gt5_menu_stats* s);
+
+#ifdef __cplusplus
+}
+#endif
+
+/* ==== the window and the drawing: Windows, Direct3D 12 ================================================= */
+#if defined(_WIN32) && !defined(GT5_MENU_NO_D3D12)
+#include <windows.h>
+#include <d3d12.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef struct gt5_menu_init_info {
+    HWND                hwnd;           /* the game window */
+    ID3D12Device*       device;
+    ID3D12CommandQueue* queue;          /* the queue the swap chain presents on */
+    DXGI_FORMAT         rtv_format;     /* of the back buffers (DXGI_FORMAT_R8G8B8A8_UNORM in the game) */
+    unsigned            frame_w, frame_h; /* the back buffers' size: the menu is drawn at this size. It is laid
+                                           out in the window's own pixels (its client area, followed through
+                                           WM_SIZE, and the monitor's scaling through WM_DPICHANGED) and drawn
+                                           scaled, so that once the swap chain is stretched to the window its
+                                           text has the same size on the screen whatever the frame's size */
+    const char*         version;        /* shown on the About page; NULL = $GT5_VER */
+    const char*         title;          /* the game's name there; NULL = $PS3_TITLE */
+    int                 no_overlay;     /* 1: only gt5_menu_frame_direct is used, make no overlay texture */
+} gt5_menu_init_info;
+
+/* Sets up the registry if nobody has (gt5_settings_init(NULL)), Dear ImGui, the fonts and the D3D12
+ * objects. 1 on success; on failure the menu stays off and every other call does nothing. */
+int  gt5_menu_init(const gt5_menu_init_info* info);
+void gt5_menu_shutdown(void);
+/* The back buffers changed size (a new swap chain or a render scale): the menu follows. Call it when
+ * no command list that drew the overlay is still waiting to run (the presenter has finished). */
+void gt5_menu_set_frame_size(unsigned w, unsigned h);
+
+/* The window procedure calls this first with every message. 1: the menu took it, return *result and
+ * don't process it further. 0: carry on as before. Opens and closes the menu on its key (F1 unless
+ * GT5_MENU_KEY names another); while it is open, takes the keyboard and the mouse. It also watches
+ * WM_SIZE and WM_DPICHANGED (and lets them through) to size itself for the window. */
+int  gt5_menu_wndproc(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp, LRESULT* result);
+
+/* Builds this frame's menu (when open, or with the corner readout on) and draws it into the overlay
+ * texture with a command list of the menu's own, executed on the queue. Returns 1 when there is
+ * something to show. Cheap when there isn't: a few tests. Also where a changed setting gets written
+ * to settings.bat (half a second after the last change), so call it every frame. */
+int  gt5_menu_frame(void);
+/* Any thread: 1 when the overlay holds something to put over the frame. */
+int  gt5_menu_overlay_visible(void);
+/* Any thread: draws the overlay over the render target rtv (a back buffer in RENDER_TARGET state,
+ * frame_w x frame_h) with the caller's open command list. It sets its own descriptor heap, root
+ * signature, pipeline, viewport and scissor, and leaves them set. */
+void gt5_menu_overlay_composite(ID3D12GraphicsCommandList* list, D3D12_CPU_DESCRIPTOR_HANDLE rtv);
+/* Window thread: the same with a list of the menu's own, for a back buffer in PRESENT state: it is
+ * taken to RENDER_TARGET and back, and the list is executed on the queue before this returns. Call it
+ * after your own lists for the frame are executed and before Present. */
+void gt5_menu_overlay_blit(ID3D12Resource* back_buffer, D3D12_CPU_DESCRIPTOR_HANDLE rtv);
+
+/* The other way: builds this frame's menu and draws it straight into rtv (RENDER_TARGET state) with
+ * the caller's list. Returns 1 when something was drawn (the list's heaps, root signature, pipeline,
+ * viewport, scissor, vertex and index buffers are then the menu's). */
+int  gt5_menu_frame_direct(ID3D12GraphicsCommandList* list, D3D12_CPU_DESCRIPTOR_HANDLE rtv);
+
+/* [win] "Quit the game?" in the menu's own overlay (Yes / No; keyboard, mouse and pad; the menu's
+ * language), over the game or over the open menu. Window thread. Returns 1 when it now asks, 2 when it
+ * was asking already (a second close request: the caller may take that as Yes), 0 when it can't be
+ * shown (no menu, or no frame has been drawn for a second: the picture stopped). Yes posts
+ * GT5_MENU_QUIT_MSG to the game window (DirectX 12: rsx_null_backend.c; Vulkan: rsx_vulkan_win32.c,
+ * which asks it the same way); No (also Esc, Circle) closes it. Also opened by the About page's
+ * "Quit the game", on either renderer. */
+int  gt5_menu_ask_quit(void);
+#define GT5_MENU_QUIT_MSG (WM_APP + 0x35)
+
+/* ---- for tests and the demo ---------------------------------------------------------------------------- */
+void gt5_menu_test_goto(int page, int sub);     /* page 0..5; sub 1 = the keyboard map, 2 = the wheel map */
+int  gt5_menu_test_bind_row(int row);           /* starts "press a key" on a row of the open map */
+int  gt5_menu_test_focus(const char* key);      /* moves the menu's focus to a setting's row */
+int  gt5_menu_test_page(void);                  /* the page shown, 0..5 */
+/* What the menu laid out in its last frame, in the window's client pixels (rectangles x0 y0 x1 y1). */
+#define GT5_MENU_TEST_INFO 1
+typedef struct gt5_menu_test_info {
+    int   client_w, client_h, dpi;      /* the window as the menu sees it */
+    float text_px;                      /* the body text's size (Dear ImGui's font size, about a line) */
+    float cap_px;                       /* a capital H of the body text, top to bottom */
+    float small_px;                     /* the size of the smallest text */
+    float density;                      /* glyphs are rasterised at this many frame pixels per window pixel */
+    float panel[4];                     /* the menu */
+    float page[4];                      /* the visible part of the page */
+    float focus[4];                     /* the item with the focus, all 0 = none */
+    float nav[6][4];                    /* the page list's entries (GT5_PAGE_COUNT) */
+    int   stacked;                      /* 1: each value sits under its label (a narrow window) */
+    int   help_cut;                     /* 1: the help shown didn't fit its box */
+    int   help_inline;                  /* 1: no help box (a low window): the focused row shows its help */
+    char  focus_key[64];                /* the setting whose row has the focus, "" = none */
+} gt5_menu_test_info;
+int  gt5_menu_test_info_get(gt5_menu_test_info* out);   /* 0 before the first frame */
+
+#ifdef __cplusplus
+}
+#endif
+#endif /* _WIN32 && !GT5_MENU_NO_D3D12 */
+#endif /* GT5_MENU_H */
diff --git a/runtime/settings/gt5_menu_stub.c b/runtime/settings/gt5_menu_stub.c
new file mode 100644
--- /dev/null
+++ b/runtime/settings/gt5_menu_stub.c
@@ -0,0 +1,40 @@
+/*
+ * gt5_menu_stub.c - "there is no menu", for a build that doesn't have one.
+ *
+ * The runtime's input code and renderer call the menu (gt5_menu.h). This file goes into the runtime
+ * library (ps3recomp_runtime) and gives every one of those calls a do-nothing body, so another title, the
+ * Linux and Android builds and the runtime's own tests link as before.
+ *
+ * It is one translation unit on purpose, and it must define exactly what gt5_menu.cpp defines and the
+ * runtime calls: the game's exe has gt5_menu.cpp among its own objects, so every name here is already
+ * resolved when the linker reaches the library, and this member is never pulled in. (The runtime's
+ * job_complete_weak.c and spu_tsp_weak.c work the same way.) A name added to the runtime's calls goes
+ * into both files.
+ */
+#include "gt5_menu.h"
+
+volatile long g_gt5_menu_captured = 0;
+volatile long g_gt5_menu_pause_want = 0;   /* [win] no menu: never asks for a pause */
+
+int  gt5_menu_is_open(void) { return 0; }
+void gt5_menu_set_open(int open) { (void)open; }
+void gt5_menu_feed_pad(const gt5_menu_pad* pad) { (void)pad; }
+void gt5_menu_feed_wheel(const gt5_menu_wheel* wheel) { (void)wheel; }
+void gt5_menu_notice(int id, const char* en, const char* zh, unsigned ms) { (void)id; (void)en; (void)zh; (void)ms; }
+void gt5_menu_stats_clear(gt5_menu_stats* s) { (void)s; }
+void gt5_menu_set_stats(const gt5_menu_stats* s) { (void)s; }
+
+#ifdef _WIN32
+int  gt5_menu_init(const gt5_menu_init_info* info) { (void)info; return 0; }
+void gt5_menu_shutdown(void) {}
+void gt5_menu_set_frame_size(unsigned w, unsigned h) { (void)w; (void)h; }
+int  gt5_menu_wndproc(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp, LRESULT* result)
+{ (void)hwnd; (void)msg; (void)wp; (void)lp; (void)result; return 0; }
+int  gt5_menu_frame(void) { return 0; }
+int  gt5_menu_overlay_visible(void) { return 0; }
+void gt5_menu_overlay_composite(ID3D12GraphicsCommandList* list, D3D12_CPU_DESCRIPTOR_HANDLE rtv) { (void)list; (void)rtv; }
+void gt5_menu_overlay_blit(ID3D12Resource* back_buffer, D3D12_CPU_DESCRIPTOR_HANDLE rtv) { (void)back_buffer; (void)rtv; }
+int  gt5_menu_frame_direct(ID3D12GraphicsCommandList* list, D3D12_CPU_DESCRIPTOR_HANDLE rtv) { (void)list; (void)rtv; return 0; }
+int  gt5_menu_ask_quit(void) { return 0; }   /* [win] no overlay: the window quits its old way */
+void gt5_menu_test_goto(int page, int sub) { (void)page; (void)sub; }   /* the renderer's GT5_MENU_TEST calls it */
+#endif
diff --git a/libs/video/rsx_present_fit.h b/libs/video/rsx_present_fit.h
new file mode 100644
--- /dev/null
+++ b/libs/video/rsx_present_fit.h
@@ -0,0 +1,81 @@
+/*
+ * rsx_present_fit.h - [win] [fill] where the frame goes in the window, and [winf] with which filter, for the
+ * Vulkan renderer's step into the window (the DirectX 12 engine has the same rules in rsx_live_draw.c, ld_win_rect,
+ * ld_rs_present_draw and ld_rs_draw). Plain C, no dependencies: the renderer, its tests and the demos use it alike.
+ *
+ *   fw x fh   the frame (the game's picture)
+ *   fill      LD_FILL's part of it (x0, y0, x1, y1 as fractions of the frame), or NULL for all of it
+ *   tw x th   the window's drawing area (the swap chain image)
+ *   fit       PS3_PRESENT_FIT: the picture in its own shape, the largest rectangle of the frame's shape
+ *             centred in the window, when the two shapes differ by more than 1 %; else (or 0) all of it
+ * Out: src = x0, y0, x1, y1 in frame pixels; dst = x0, y0, x1, y1 in window pixels. Returns 1 when there are
+ * bars (the rest of the window is to be black).
+ */
+#ifndef RSX_PRESENT_FIT_H
+#define RSX_PRESENT_FIT_H
+
+#include <stdint.h>
+
+static inline int rsx_present_fit_rects(uint32_t fw, uint32_t fh, const float* fill, uint32_t tw, uint32_t th, int fit,
+                                        int32_t src[4], int32_t dst[4])
+{
+    src[0] = 0; src[1] = 0; src[2] = (int32_t)fw; src[3] = (int32_t)fh;
+    if (fill) {
+        int32_t s[4];
+        s[0] = (int32_t)(fill[0] * (float)fw + 0.5f); s[1] = (int32_t)(fill[1] * (float)fh + 0.5f);
+        s[2] = (int32_t)(fill[2] * (float)fw + 0.5f); s[3] = (int32_t)(fill[3] * (float)fh + 0.5f);
+        if (s[0] < 0) s[0] = 0;
+        if (s[1] < 0) s[1] = 0;
+        if (s[2] > (int32_t)fw) s[2] = (int32_t)fw;
+        if (s[3] > (int32_t)fh) s[3] = (int32_t)fh;
+        if (s[2] - s[0] >= 16 && s[3] - s[1] >= 16) { src[0] = s[0]; src[1] = s[1]; src[2] = s[2]; src[3] = s[3]; }
+    }
+    dst[0] = 0; dst[1] = 0; dst[2] = (int32_t)tw; dst[3] = (int32_t)th;
+    if (!fit || !fw || !fh || !tw || !th) return 0;
+    const double pic = (double)fw / (double)fh, tgt = (double)tw / (double)th;
+    const double off = tgt / pic - 1.0;
+    if (off <= 0.01 && off >= -0.01) return 0;          /* within 1 %: the whole window */
+    if (tgt > pic) {                                     /* wider: bars left and right */
+        const int32_t w = (int32_t)((double)th * pic + 0.5);
+        dst[0] = ((int32_t)tw - w) / 2; dst[2] = dst[0] + w;
+    } else {                                             /* taller: bars above and below */
+        const int32_t h = (int32_t)((double)tw / pic + 0.5);
+        dst[1] = ((int32_t)th - h) / 2; dst[3] = dst[1] + h;
+    }
+    return 1;
+}
+
+/* [winf] The filter of the step into the window, chosen as the DirectX 12 renderer's ld_rs_draw chooses it for
+ * that step (point = 2), from the rects above. Out: the shader's eight constants (vulkan/rsx_vk_winf.frag):
+ *   [0..3] r, the frame's part shown as uv (x0, y0, x1, y1); [4..5] fp, uv per window pixel;
+ *   [6] n: -1 a magnification (ratio < 0.999) while filling or fitting: Catmull-Rom over 4x4 texels;
+ *          1 about 1:1 (or a magnification with neither): one bilinear tap;
+ *          2..8 a reduction by up to n: n x n bilinear taps (a box);
+ *   [7] flags: 1 every tap kept inside r (fill: the rest of the frame is GT5's black margin);
+ *              2 a reduction by 2-4 takes a tent over +-1 window pixel (2n x 2n taps) instead of the box (tent).
+ * ratio is frame pixels per window pixel, the larger of the two directions. */
+static inline void rsx_present_filter(uint32_t fw, uint32_t fh, const int32_t src[4], const int32_t dst[4], int fill,
+                                      int fit, int tent, float out[8])
+{
+    const float dw = (float)(dst[2] - dst[0]), dh = (float)(dst[3] - dst[1]);
+    out[0] = (float)src[0] / (float)fw; out[1] = (float)src[1] / (float)fh;
+    out[2] = (float)src[2] / (float)fw; out[3] = (float)src[3] / (float)fh;
+    out[4] = dw > 0.0f ? (out[2] - out[0]) / dw : 0.0f;
+    out[5] = dh > 0.0f ? (out[3] - out[1]) / dh : 0.0f;
+    const float rx = dw > 0.0f ? (float)(src[2] - src[0]) / dw : 1.0f, ry = dh > 0.0f ? (float)(src[3] - src[1]) / dh : 1.0f;
+    const float ratio = rx > ry ? rx : ry;
+    int n = 1;
+    if (ratio > 1.001f) {                                  /* ceil(ratio - 0.001) */
+        const float c = ratio - 0.001f;
+        n = (int)c;
+        if ((float)n < c) n++;
+    }
+    if (n > 8) n = 8;
+    float flags = 0.0f;
+    if (fill) { flags += 1.0f; if (ratio < 0.999f) n = -1; }
+    else if (ratio < 0.999f && fit) n = -1;
+    if (tent && n >= 2 && n <= 4) flags += 2.0f;           /* above 4x: the box (a tent would be 2n x 2n taps) */
+    out[6] = (float)n; out[7] = flags;
+}
+
+#endif /* RSX_PRESENT_FIT_H */
diff --git a/libs/video/vulkan/rsx_vk_winf.vert b/libs/video/vulkan/rsx_vk_winf.vert
new file mode 100644
--- /dev/null
+++ b/libs/video/vulkan/rsx_vk_winf.vert
@@ -0,0 +1,11 @@
+#version 450
+// The step into the window ([winf]): one triangle over the viewport (the picture's rectangle in the
+// swap chain image); uv runs over r, the frame's part shown.
+layout(push_constant) uniform C { vec4 r; vec2 fp; float n; float cl; } c;
+layout(location = 0) out vec2 uv;
+void main()
+{
+    vec2 q = vec2((gl_VertexIndex << 1) & 2, gl_VertexIndex & 2);
+    gl_Position = vec4(q * 2.0 - 1.0, 0.0, 1.0);
+    uv = c.r.xy + (c.r.zw - c.r.xy) * q;
+}
diff --git a/libs/video/vulkan/rsx_vk_winf.frag b/libs/video/vulkan/rsx_vk_winf.frag
