+"    V[4] = input.a4; V[5] = input.a5; V[6] = input.a6; V[7] = input.a7;\n"
+"    V[8] = input.a8; V[9] = input.a9; V[10] = input.a10; V[11] = input.a11;\n"
+"    V[12] = input.a12; V[13] = input.a13; V[14] = input.a14; V[15] = input.a15;\n"
+"    [unroll] for (uint q = 0u; q < 16u; q++) if (!((present >> q) & 1u)) V[q] = float4(0, 0, 0, 1);\n"
+"    float4 R[32];\n"
+"    [unroll] for (uint i = 0u; i < 32u; i++) R[i] = (float4)0;\n"
+"    float4 O[16];\n"
+"    [unroll] for (uint j = 0u; j < 16u; j++) O[j] = float4(0, 0, 0, 1);\n"
+"    int4 A0 = (int4)0, A1 = (int4)0;\n"
+"    float4 CC[2]; CC[0] = (float4)0; CC[1] = (float4)0;\n"
+"    uint CS[8];\n"
+"    [unroll] for (uint z = 0u; z < 8u; z++) CS[z] = 0u;\n"
+"    uint csp = 0u;\n"
+"    int pc = 0;\n"
+"    [loop] for (uint guard = 0u; guard < 65536u && pc >= 0 && (uint)pc < n_ops; guard++) {\n"
+"        const uint4 W = k[vb + 1u + 2u * (uint)pc];\n"
+"        const uint4 X = k[vb + 2u + 2u * (uint)pc];\n"
+"        const uint d0 = W.x, d1 = W.y, d2 = W.z, d3 = W.w;\n"
+"        const int next = pc + 1;\n"
+"        pc = next;\n"
+"        const uint vec_op = (d1 >> 22) & 0x1Fu, sca_op = (d1 >> 27) & 0x1Fu;\n"
+"        const uint input_src = (d1 >> 8) & 0xFu, const_src = (d1 >> 12) & 0x3FFu;\n"
+"        const bool index_const = ((d3 >> 1) & 1u) != 0u;\n"
+"        const uint src0 = ((d2 >> 23) & 0x1FFu) | ((d1 & 0xFFu) << 9);\n"
+"        const uint src1 = (d2 >> 6) & 0x1FFFFu;\n"
+"        const uint src2 = ((d3 >> 21) & 0x7FFu) | ((d2 & 0x3Fu) << 11);\n"
+"        const uint addr_sel = (d0 >> 24) & 1u, addr_swz = d0 & 3u;\n"
+"        const bool sat = ((d0 >> 26) & 1u) != 0u;\n"
+"        const uint cond = (d0 >> 10) & 7u;\n"
+"        const bool test = ((d0 >> 13) & 1u) != 0u && cond != 7u;\n"
+"        const uint sel = (d0 >> 25) & 1u;\n"
+"        const uint4 cswz = uint4((d0 >> 8) & 3u, (d0 >> 6) & 3u, (d0 >> 4) & 3u, (d0 >> 2) & 3u);\n"
+"        const bool cc_update = ((d0 >> 14) & 1u) != 0u && ((d0 >> 29) & 1u) != 0u;\n"
+"        const uint dst_tmp = (d0 >> 15) & 0x3Fu, dst_out = (d3 >> 2) & 0x1Fu, sca_dst_tmp = (d3 >> 7) & 0x3Fu;\n"
+"        const bool vec_result = ((d0 >> 30) & 1u) != 0u;\n"
+"        const uint vm = (d3 >> 13) & 0xFu;    // w z y x in bits 0..3: x = 8\n"
+"        const uint sm = (d3 >> 17) & 0xFu;\n"
+"        // ---- vector unit ----\n"
+"        if (vm != 0u && vec_op != 0u) {\n"
+"            float4 a, b, c;\n"
+"            VS_SRC(a, src0, ((d0 >> 21) & 1u) != 0u);\n"
+"            VS_SRC(b, src1, ((d0 >> 22) & 1u) != 0u);\n"
+"            VS_SRC(c, src2, ((d0 >> 23) & 1u) != 0u);\n"
+"            float4 vv = (float4)0;\n"
+"            bool handled = true;\n"
+"            [forcecase] switch (vec_op) {\n"
+"            case 0x01u: vv = a; break;\n"
+"            case 0x02u: vv = vp_mul((a), (b)); break;\n"
+"            case 0x03u: vv = (a) + (c); break;\n"
+"            case 0x04u: vv = vp_mul((a), (b)) + (c); break;\n"
+"            case 0x05u: vv = (float4)vp_dot3((a), (b)); break;\n"
+"            case 0x06u: vv = (float4)(vp_dot3((a), (b)) + (b).w); break;\n"
+"            case 0x07u: vv = (float4)vp_dot4((a), (b)); break;\n"
+"            case 0x08u: vv = float4(1, (a).y * (b).y, (a).z, (b).w); break;\n"
+"            case 0x09u: vv = min((a), (b)); break;\n"
+"            case 0x0Au: vv = max((a), (b)); break;\n"
+"            case 0x0Bu: vv = (float4)((a) < (b)); break;\n"
+"            case 0x0Cu: vv = (float4)((a) >= (b)); break;\n"
+"            case 0x0Eu: vv = frac(a); break;\n"
+"            case 0x0Fu: vv = floor(a); break;\n"
+"            case 0x10u: vv = (float4)((a) == (b)); break;\n"
+"            case 0x11u: vv = (float4)0; break;\n"
+"            case 0x12u: vv = (float4)((a) > (b)); break;\n"
+"            case 0x13u: vv = (float4)((a) <= (b)); break;\n"
+"            case 0x14u: vv = (float4)((a) != (b)); break;\n"
+"            case 0x15u: vv = float4(1, 1, 1, 1); break;\n"
+"            case 0x16u: vv = sign(a); break;\n"
+"            case 0x19u: { const uint u = (d2 >> 8) & 3u; vv = ((vtex >> u) & 1u) ? vs_fetch(u, a) : float4(0, 0, 0, 0); break; }\n"
+"            case 0x0Du: {                                      // ARL: not under the condition test\n"
+"                const int4 ia = (int4)floor(a);\n"
+"                int4 t = addr_sel ? A1 : A0;\n"
+"                if (vm & 8u) t.x = ia.x; if (vm & 4u) t.y = ia.y; if (vm & 2u) t.z = ia.z; if (vm & 1u) t.w = ia.w;\n"
+"                if (addr_sel) A1 = t; else A0 = t;\n"
+"                handled = false; break; }\n"
+"            default: handled = false; break;\n"
+"            }\n"
+"            if (handled) {\n"
+"                if (sat) vv = saturate(vv);\n"
+"                if (vec_result && dst_out != 0x1Fu) { float4 d = O[dst_out & 15u]; VS_STORE(d, vm); O[dst_out & 15u] = d; }\n"
+"                if (dst_tmp != 0x3Fu) { float4 d = R[dst_tmp & 31u]; VS_STORE(d, vm); R[dst_tmp & 31u] = d; }\n"
+"                if (cc_update) {\n"
+"                    float4 d = CC[sel];\n"
+"                    if (!test) { if (vm & 8u) d.x = vv.x; if (vm & 4u) d.y = vv.y; if (vm & 2u) d.z = vv.z; if (vm & 1u) d.w = vv.w; }\n"
+"                    else if (cond != 0u) {                     // each component tests the register as written so far\n"
+"                        if ((vm & 8u) && vs_test(vs_c(d, cswz.x), cond)) d.x = vv.x;\n"
+"                        if ((vm & 4u) && vs_test(vs_c(d, cswz.y), cond)) d.y = vv.y;\n"
+"                        if ((vm & 2u) && vs_test(vs_c(d, cswz.z), cond)) d.z = vv.z;\n"
+"                        if ((vm & 1u) && vs_test(vs_c(d, cswz.w), cond)) d.w = vv.w;\n"
+"                    }\n"
+"                    CC[sel] = d;\n"
+"                }\n"
+"            }\n"
+"        }\n"
+"        // ---- scalar unit (reads its source after the vector unit's writes) ----\n"
+"        if (sm != 0u && sca_op != 0u) {\n"
+"            float4 c;\n"
+"            VS_SRC(c, src2, ((d0 >> 23) & 1u) != 0u);\n"
+"            float4 vv = (float4)0;\n"
+"            bool handled = true;\n"
+"            [forcecase] switch (sca_op) {\n"
+"            case 0x01u: vv = c; break;\n"
+"            case 0x02u: vv = (float4)(1.0 / (c).x); break;\n"
+"            case 0x03u: vv = (float4)clamp(1.0 / (c).x, 5.42101e-20, 1.884467e19); break;\n"
+"            case 0x04u: vv = (float4)rsqrt(max(abs((c).x), 1e-10)); break;\n"
+"            case 0x05u: vv = (float4)exp2((c).x); break;\n"
+"            case 0x06u: vv = (float4)log2(max(abs((c).x), 1e-10)); break;\n"
+"            case 0x0Du: vv = (float4)log2(max(abs((c).x), 1e-10)); break;\n"
+"            case 0x0Eu: vv = (float4)exp2((c).x); break;\n"
+"            case 0x0Fu: vv = (float4)sin((c).x); break;\n"
+"            case 0x10u: vv = (float4)cos((c).x); break;\n"
+"            case 0x07u: vv = float4(1.0, max((c).x, 0.0), ((c).x > 0.0) ?\n"
+"                                    exp2(clamp((c).w, -127.996, 127.996) * log2(max((c).y, 1e-10))) : 0.0, 1.0); break;\n"
+"            default: handled = false; break;\n"
+"            }\n"
+"            if (handled) {\n"
+"                if (sat) vv = saturate(vv);\n"
+"                if (!vec_result && dst_out != 0x1Fu) { float4 d = O[dst_out & 15u]; VS_STORE(d, sm); O[dst_out & 15u] = d; }\n"
+"                if (sca_dst_tmp != 0x3Fu) { float4 d = R[sca_dst_tmp & 31u]; VS_STORE(d, sm); R[sca_dst_tmp & 31u] = d; }\n"
+"            }\n"
+"        }\n"
+"        // ---- flow (X.x: the target, already made relative; X.y: a BRB / CLB taken) ----\n"
+"        if (X.z != 0u) {\n"
+"            bool cnd = true;\n"
+"            if (cond == 0u) cnd = false;\n"
+"            else if (cond != 7u) cnd = vs_test(vs_c(CC[sel], cswz.x), cond);\n"
+"            const int tgt = (int)X.x;\n"
+"            if (sca_op == 0x09u || sca_op == 0x08u) pc = cnd ? tgt : next;\n"
+"            else if (sca_op == 0x0Au || sca_op == 0x0Bu) {\n"
+"                if (cnd) { CS[csp] = (uint)next; csp = min(csp + 1u, 7u); pc = tgt; } else pc = next;\n"
+"            } else if (sca_op == 0x0Cu) {\n"
+"                if (cnd) { if (csp > 0u) { csp--; pc = (int)CS[csp]; } else pc = -1; } else pc = next;\n"
+"            } else {\n"
+"                if (X.y == 0u) pc = next;\n"
+"                else if (sca_op == 0x11u) pc = tgt;\n"
+"                else { CS[csp] = (uint)next; csp = min(csp + 1u, 7u); pc = tgt; }\n"
+"            }\n"
+"        }\n"
+"    }\n"
+"    VSOutput Out;\n"
+"    float4 _p = O[0];\n"
+"    Out.pos = float4(_p.xyz * vp_posscale.xyz + _p.w * vp_posoffset.xyz, _p.w);\n"
+"#if SI_MV\n"
+"    Out.mvp = float4(dot(_p, vp_mv[0]), dot(_p, vp_mv[1]), dot(_p, vp_mv[2]), 0.0); Out.mvj = vp_mvjit;\n"
+"#endif\n"
+"    Out.col0 = O[1]; Out.col1 = O[2]; Out.fog = O[5].xxxx;\n"
+"    Out.t0 = O[7];  Out.t1 = O[8];  Out.t2 = O[9];  Out.t3 = O[10];\n"
+"    Out.t4 = O[11]; Out.t5 = O[12]; Out.t6 = O[13]; Out.t7 = O[14];\n"
+"    Out.t8 = O[15]; Out.t9 = O[6];\n"
+"    return Out;\n"
+"}\n"
+"\n"
+;
diff --git a/libs/video/rsx_standin.c b/libs/video/rsx_standin.c
new file mode 100644
--- /dev/null
+++ b/libs/video/rsx_standin.c
@@ -0,0 +1,380 @@
+/*
+ * [standin] See rsx_standin.h. The encoder walks a fragment program exactly as rsx_fp_decompile_internal does
+ * (the same constant-slot rule, the same block opening and closing), so the pixel shader in
+ * rsx_standin_fp.hlsl does per instruction what the translated text does, in the same order.
+ */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "rsx_standin.h"
+#include "rsx_standin_fp_hlsl.h"
+#include "rsx_standin_vp_hlsl.h"
+#include "rsx_vp_decompiler.h"
+
+const char* rsx_si_reason_name(u32 reason)
+{
+    switch (reason) {
+    case RSX_SI_R_PROGRAM:    return "program not walkable";
+    case RSX_SI_R_FLOW:       return "flow control too deep";
+    case RSX_SI_R_TARGETS:    return "several targets or depth export";
+    case RSX_SI_R_SHADOW:     return "depth comparison layout";
+    case RSX_SI_R_RESOLVE:    return "one-tap resolve";
+    case RSX_SI_R_OPCODE:     return "fetch kind";
+    case RSX_SI_R_UNBUFFERED: return "constants in the text";
+    case RSX_SI_R_DERIV:      return "derivatives";
+    case RSX_SI_R_INPUTS:     return "inputs outside the vertex layout";
+    default:                  return "none";
+    }
+}
+
+static u32 si_word(const u8* p)
+{
+    const u32 be = ((u32)p[0] << 24) | ((u32)p[1] << 16) | ((u32)p[2] << 8) | (u32)p[3];
+    return (be << 16) | (be >> 16);
+}
+
+/* How many of the three sources the translation of an opcode reads (rsx_fp_decompile_internal's switch);
+ * 0 for what it leaves out (no destination written either). */
+static u32 si_sources(u32 op)
+{
+    switch (op) {
+    case 0x01: case 0x10: case 0x11: case 0x13: case 0x14: case 0x1A: case 0x1B: case 0x1C: case 0x1D:
+    case 0x22: case 0x23: case 0x24: case 0x25: case 0x27: case 0x28: case 0x29: case 0x2A: case 0x2C: case 0x2D:
+    case 0x39: case 0x3C: case 0x17: case 0x18:
+        return 1;
+    case 0x02: case 0x03: case 0x05: case 0x06: case 0x08: case 0x09: case 0x0A: case 0x0B: case 0x0C: case 0x0D:
+    case 0x0E: case 0x0F: case 0x26: case 0x3A: case 0x3B: case 0x38: case 0x2F: case 0x31:
+        return 2;
+    case 0x04: case 0x1F:
+        return 3;
+    default:
+        return 0;
+    }
+}
+
+enum { SI_K_INSTR = 0, SI_K_IF = 1, SI_K_ELSE = 2, SI_K_ENDIF = 3, SI_K_LOOP = 4, SI_K_ENDLOOP = 5, SI_K_BRK = 6 };
+
+static rsx_si_op* si_emit(rsx_si_prog* p, u32 kind, const u32 w[4])
+{
+    if (p->n_ops >= RSX_SI_MAX_OPS) { p->refused = RSX_SI_R_PROGRAM; return NULL; }
+    rsx_si_op* o = &p->ops[p->n_ops++];
+    memset(o, 0, sizeof *o);
+    if (w) memcpy(o->w, w, sizeof o->w);
+    o->x[0] = kind;
+    return o;
+}
+
+int rsx_si_encode(const u8* ucode, u32 max_bytes, rsx_si_prog* p)
+{
+    p->n_ops = p->n_slots = p->n_regs = p->uses_units = p->refused = 0;
+    if (!ucode) { p->refused = RSX_SI_R_PROGRAM; return -1; }
+    enum { MAXB = 32 };
+    u32 b_else[MAXB], b_end[MAXB], b_op[MAXB], b_else_op[MAXB];
+    int b_loop[MAXB];
+    int n_blk = 0, loops_open = 0, ended = 0;
+    u32 off = 0, slot = 0, max_reg = 0;
+    while (off + 16 <= max_bytes && !p->refused) {
+        /* Close blocks ending here, innermost first, then open an else (the decompiler's order). */
+        while (n_blk > 0 && b_end[n_blk - 1] == off) {
+            --n_blk;
+            rsx_si_op* e = si_emit(p, b_loop[n_blk] ? SI_K_ENDLOOP : SI_K_ENDIF, NULL);
+            if (!e) break;
+            const u32 at = p->n_ops;                       /* the op after the end */
+            if (b_loop[n_blk]) { e->x[1] = b_op[n_blk] + 1u; p->ops[b_op[n_blk]].x[1] = at; loops_open--; }
+            else {
+                if (b_else_op[n_blk] != ~0u) p->ops[b_else_op[n_blk]].x[1] = at;
+                else p->ops[b_op[n_blk]].x[1] = at;
+            }
+        }
+        if (p->refused) break;
+        if (n_blk > 0 && b_else[n_blk - 1] == off) {
+            rsx_si_op* e = si_emit(p, SI_K_ELSE, NULL);
+            if (!e) break;
+            b_else_op[n_blk - 1] = p->n_ops - 1u;
+            p->ops[b_op[n_blk - 1]].x[1] = p->n_ops;       /* false: into the else part */
+            b_else[n_blk - 1] = 0;
+        }
+        u32 w[4];
+        for (u32 i = 0; i < 4; i++) w[i] = si_word(ucode + off + 4u * i);
+        off += 16;
+        const int has_k = (w[1] & 3u) == 2u || (w[2] & 3u) == 2u || (w[3] & 3u) == 2u;
+        if (has_k && off + 16 <= max_bytes) off += 16;
+        const u32 my_slot = slot;
+        if (has_k) slot++;
+        const u32 opcode = (w[0] >> 24) & 63u;
+        if (w[2] >> 31) {                                   /* flow control */
+            const u32 end_at = (w[3] & 0x7FFFFFFFu) << 2;
+            if (opcode == 0x02u || opcode == 0x03u || opcode == 0x04u) {
+                if (!(n_blk == MAXB || end_at <= off)) {
+                    rsx_si_op* o = si_emit(p, opcode == 0x02u ? SI_K_IF : SI_K_LOOP, w);
+                    if (!o) break;
+                    if (opcode == 0x02u) {
+                        const u32 else_at = (w[2] & 0x7FFFFFFFu) << 2;
+                        b_else[n_blk] = else_at != end_at ? else_at : 0;
+                        b_loop[n_blk] = 0;
+                    } else {
+                        const u32 end_n = (w[2] >> 2) & 0xFFu, init = (w[2] >> 10) & 0xFFu, inc = (w[2] >> 19) & 0xFFu;
+                        o->x[2] = init | (end_n << 8) | ((inc ? inc : 1u) << 16);
+                        b_else[n_blk] = 0;
+                        b_loop[n_blk] = 1;
+                        loops_open++;
+                        if (loops_open > 4) p->refused = RSX_SI_R_FLOW;
+                    }
+                    b_end[n_blk] = end_at;
+                    b_op[n_blk] = p->n_ops - 1u;
+                    b_else_op[n_blk] = ~0u;
+                    n_blk++;
+                }
+            } else if (opcode == 0x00u && loops_open) {
+                if (!si_emit(p, SI_K_BRK, w)) break;
+            }
+            if (w[0] & 1u) { ended = 1; break; }
+            continue;
+        }
+        if (opcode == 0x15u || opcode == 0x16u) p->refused = RSX_SI_R_DERIV;
+        rsx_si_op* o = si_emit(p, SI_K_INSTR, w);
+        if (!o) break;
+        o->x[1] = my_slot;
+        o->x[2] = si_sources(opcode);                     /* the sources the shader reads */
+        o->x[3] = has_k ? 1u : 0u;
+        /* registers the text names: the TEMP sources the opcode reads, and the destination when written */
+        { const u32 n_src = si_sources(opcode);
+          for (u32 s = 1; s <= n_src; s++)
+              if ((w[s] & 3u) == 0u) { const u32 r = (w[s] >> 2) & 63u; if (r > max_reg) max_reg = r; }
+          if (n_src && !(w[0] & (1u << 30))) { const u32 r = (w[0] >> 1) & 63u; if (r > max_reg) max_reg = r; } }
+        if (opcode == 0x17u || opcode == 0x18u || opcode == 0x2Fu || opcode == 0x31u || opcode == 0x19u ||
+            opcode == 0x33u || opcode == 0x34u)
+            p->uses_units |= 1u << ((w[0] >> 17) & 15u);
+        if (w[0] & 1u) { ended = 1; break; }
+    }
+    if (!p->refused && !ended) p->refused = RSX_SI_R_PROGRAM;   /* no END: the buffered translation fails too */
+    if (!p->refused && max_reg >= 48u) p->refused = RSX_SI_R_PROGRAM;
+    while (!p->refused && n_blk > 0) {                         /* a block that never saw its end closes at END */
+        --n_blk;
+        rsx_si_op* e = si_emit(p, b_loop[n_blk] ? SI_K_ENDLOOP : SI_K_ENDIF, NULL);
+        if (!e) break;
+        const u32 at = p->n_ops;
+        if (b_loop[n_blk]) { e->x[1] = b_op[n_blk] + 1u; p->ops[b_op[n_blk]].x[1] = at; }
+        else if (b_else_op[n_blk] != ~0u) p->ops[b_else_op[n_blk]].x[1] = at;
+        else p->ops[b_op[n_blk]].x[1] = at;
+    }
+    p->n_slots = slot;
+    p->n_regs = max_reg + 1u;
+    if (!p->refused && RSX_SI_HEAD_ROWS + p->n_slots + 2u * p->n_ops > RSX_SI_BLOCK_ROWS) p->refused = RSX_SI_R_PROGRAM;
+    return p->refused ? -1 : (int)p->n_ops;
+}
+
+/* A float as the translated text spells it ("%.9g" of the double) and fxc reads it back. */
+static u32 si_literal(double v)
+{
+    char t[48];
+    snprintf(t, sizeof t, "%.9g", v);
+    const float f = strtof(t, NULL);
+    u32 u; memcpy(&u, &f, 4);
+    return u;
+}
+
+u32 rsx_si_desc_check(const rsx_si_prog* p, const rsx_si_desc* d, rsx_si_state* s)
+{
+    memset(s, 0, sizeof *s);
+    if (p->refused) return p->refused;
+    if (d->fp_ctrl == RSX_FP_CTRL_AUTO || (d->fp_ctrl & 0xEu) || (d->rt_count & 0xFFu) > 1u) return RSX_SI_R_TARGETS;
+    if (d->upres) return RSX_SI_R_RESOLVE;
+    /* What the decompiler refuses outright (the real pipeline then fails too: nothing to stand in for). */
+    for (u32 u = 0; u < 16; u++) {
+        if (!(p->uses_units & (1u << u))) continue;
+        const rsx_fp_shadow_desc* sd = d->shadow ? &d->shadow[u] : NULL;
+        if (sd && sd->enabled &&
+            (sd->enabled != 1 || sd->func > 7 || sd->linear > 1 || sd->unnormalized > 1 || sd->soft > 1 ||
+             (sd->scale != 0 && sd->scale != 1 && sd->scale != 2 && sd->scale != 4) ||
+             ((d->cube_mask | d->vol_mask) & (1u << u))))
+            return RSX_SI_R_SHADOW;
+    }
+    for (u32 i = 0; i < p->n_ops; i++) {
+        const rsx_si_op* o = &p->ops[i];
+        if (o->x[0] != 0u) continue;
+        const u32 op = (o->w[0] >> 24) & 63u, unit = (o->w[0] >> 17) & 15u;
+        const int fetch_other = op == 0x19u || op == 0x33u || op == 0x34u;
+        if (d->shadow && d->shadow[unit].enabled && (op == 0x31u || op == 0x2Fu || fetch_other)) return RSX_SI_R_SHADOW;
+        if (d->gamma && d->gamma[unit] && !(o->w[0] & (1u << 21)) && fetch_other) return RSX_SI_R_OPCODE;
+    }
+    u32 f = 0;
+    if (!(d->fp_ctrl & 0x40u)) f |= 1u;
+    if (d->srgb_output) f |= 2u;
+    if (d->wpos_mode == 1u && (d->wpos_x > 1u || d->wpos_y > 1u)) f |= 4u;
+    else if (d->wpos_mode == 2u) f |= 8u;
+    if (d->alpha_test && d->alpha_func >= 0x200u && d->alpha_func <= 0x206u)
+        f |= 16u | ((d->alpha_func - 0x200u) << 5);
+    s->flags = f;
+    s->wpos[0] = d->wpos_x ? d->wpos_x : 1u;
+    s->wpos[1] = d->wpos_y ? d->wpos_y : 1u;
+    for (u32 u = 0; u < 16; u++) {
+        u32 x = 0;
+        const int cube = (d->cube_mask >> u) & 1u, vol = !cube && ((d->vol_mask >> u) & 1u);
+        if (d->gamma) x |= d->gamma[u] & 15u;
+        if (d->expand) x |= (u32)(d->expand[u] & 31u) << 4;
+        if (d->shadow && d->shadow[u].enabled && (p->uses_units & (1u << u))) {
+            const rsx_fp_shadow_desc* sd = &d->shadow[u];
+            x |= 1u << 9 | (u32)(sd->func & 7u) << 10 | (u32)(sd->linear & 1u) << 13 |
+                 (u32)(sd->unnormalized & 1u) << 14 | (u32)(sd->soft & 1u) << 15 | (u32)(sd->scale & 7u) << 16;
+        }
+        if (cube) x |= 1u << 20;
+        if (vol) x |= 1u << 21;
+        /* rsx_fp_apply_unnorm_scale: TEX / TXP of a texel-addressed 2D or 3D unit, not a comparison */
+        const u32 w = d->unnorm_dim[u][0], h = d->unnorm_dim[u][1], dd = d->unnorm_dim[u][2];
+        if (((d->unnorm_mask >> u) & 1u) && !cube && w && h && (!vol || dd) && !(x & (1u << 9))) {
+            x |= 1u << 19;
+            s->unit[u][1] = si_literal(1.0 / (double)w);
+            s->unit[u][2] = si_literal(1.0 / (double)h);
+            if (vol) s->unit[u][3] = si_literal(1.0 / (double)dd);
+        }
+        s->unit[u][0] = x;
+    }
+    return 0;
+}
+
+u32 rsx_si_block_rows(u32 n_slots, u32 n_ops)
+{
+    return RSX_SI_HEAD_ROWS + n_slots + 2u * n_ops;
+}
+
+void rsx_si_block_write(void* dst, u32 n_slots, u32 n_regs, u32 n_ops, const rsx_si_op* ops, const rsx_si_state* s,
+                        const u32 (*constants)[4], u32 n_constants, const float fp_alpha[4])
+{
+    u32 (*k)[4] = (u32 (*)[4])dst;
+    k[0][0] = n_slots; k[0][1] = s->flags; k[0][2] = n_ops; k[0][3] = 2u * n_regs;
+    memcpy(k[1], fp_alpha, 16);
+    k[2][0] = s->wpos[0]; k[2][1] = s->wpos[1]; k[2][2] = 0; k[2][3] = 0;
+    memcpy(k[3], s->unit, sizeof s->unit);
+    u32 (*kc)[4] = k + RSX_SI_HEAD_ROWS;
+    for (u32 i = 0; i < n_slots; i++) {
+        if (constants && i < n_constants) memcpy(kc[i], constants[i], 16);
+        else memset(kc[i], 0, 16);
+    }
+    memcpy(kc + n_slots, ops, (size_t)n_ops * sizeof(rsx_si_op));
+}
+
+u64 rsx_si_variant_of(const rsx_si_desc* d)
+{
+    u64 v = 0;
+    for (u32 u = 0; u < 16; u++) {
+        if ((d->cube_mask >> u) & 1u) v |= 1ull << (2u * u);
+        else if ((d->vol_mask >> u) & 1u) v |= 2ull << (2u * u);
+    }
+    if (d->mv) v |= 1ull << 32;
+    if (d->shadow)   /* the depth comparison's code only in the variants that need it (it costs every pixel) */
+        for (u32 u = 0; u < 16; u++) if (d->shadow[u].enabled) { v |= 1ull << 33; break; }
+    return v;
+}
+
+u32 rsx_si_variant_source(u64 variant, char* out, u32 cap)
+{
+    u32 n = 0;
+    char line[64];
+    for (u32 u = 0; u < 16; u++) {
+        const u32 kind = (u32)(variant >> (2u * u)) & 3u;
+        if (!kind) continue;
+        const int m = snprintf(line, sizeof line, "#define SI_K%u %u\n", u, kind);
+        if (m < 0 || n + (u32)m + 1u > cap) return 0;
+        memcpy(out + n, line, (size_t)m); n += (u32)m;
+    }
+    if ((variant >> 33) & 1u) {
+        static const char sh[] = "#define SI_SHADOW 1\n";
+        if (n + sizeof sh > cap) return 0;
+        memcpy(out + n, sh, sizeof sh - 1); n += (u32)(sizeof sh - 1);
+    }
+    if ((variant >> 32) & 1u) {
+        static const char mv[] = "#define SI_MV 1\n";
+        if (n + sizeof mv > cap) return 0;
+        memcpy(out + n, mv, sizeof mv - 1); n += (u32)(sizeof mv - 1);
+    }
+    const u32 len = (u32)(sizeof k_rsx_si_fp_hlsl - 1);
+    if (n + len + 1u > cap) return 0;
+    memcpy(out + n, k_rsx_si_fp_hlsl, len);
+    n += len;
+    out[n] = '\0';
+    return n;
+}
+
+/* ---- [standin2] the vertex side ---------------------------------------------------------------------------- */
+static u32 si_le(const u8* p) { return (u32)p[0] | ((u32)p[1] << 8) | ((u32)p[2] << 16) | ((u32)p[3] << 24); }
+static int si_vp_flow(u32 sca_op)
+{
+    return sca_op == 0x08 || sca_op == 0x09 || sca_op == 0x0A || sca_op == 0x0B ||
+           sca_op == 0x0C || sca_op == 0x11 || sca_op == 0x12;
+}
+
+u32 rsx_si_vp_encode(const u8* words, u32 bytes, u32 vp_start, u32 branch_bits, u32 vtex_mask,
+                     int compact, u32 layout_mask, rsx_si_vprog* p)
+{
+    p->n_ops = 0; p->present = 0xFFFFu; p->vtex = vtex_mask & 15u; p->refused = 0;
+    if (!words) return p->refused = RSX_SI_R_PROGRAM;
+    /* the inputs exactly as rsx_vp_decompile_compact_ex chooses them */
+    if (compact) {
+        rsx_vp_input_analysis an;
+        if (rsx_vp_analyze_inputs(words, bytes, &an) < 0 || !an.exact || (an.input_mask & ~(layout_mask & 0xFFFFu)) != 0)
+            p->present = 0xFFFFu;
+        else
+            p->present = an.input_mask;
+        if (p->present & ~(layout_mask & 0xFFFFu)) return p->refused = RSX_SI_R_INPUTS;
+    }
+    for (u32 off = 0; off + 16 <= bytes && p->n_ops < RSX_SI_MAX_VP_OPS; off += 16) {
+        rsx_si_op* o = &p->ops[p->n_ops++];
+        memset(o, 0, sizeof *o);
+        for (u32 i = 0; i < 4; i++) o->w[i] = si_le(words + off + 4u * i);
+        const u32 d0 = o->w[0], d2 = o->w[2], d3 = o->w[3];
+        const u32 sca_op = (o->w[1] >> 27) & 0x1Fu;
+        if (si_vp_flow(sca_op)) {
+            /* the decompiler's vp_branch_target, made relative to the program's start slot */
+            const u32 t = (((d0 >> 23) & 1u) << 9) | ((d2 & 0x3Fu) << 3) | ((d3 >> 29) & 7u);
+            o->x[0] = t >= vp_start ? t - vp_start : t;
+            o->x[1] = ((branch_bits >> ((d3 >> 23) & 0x1Fu)) & 1u) == ((d3 >> 28) & 1u);   /* BRB / CLB taken */
+            o->x[2] = 1u;
+        }
+        if (d3 & 1u) break;
+    }
+    return 0;
+}
+
+u32 rsx_si_vp_block_rows(u32 n_ops) { return 1u + 2u * n_ops; }
+
+void rsx_si_vp_block_write(void* block, u32 at, u32 n_ops, u32 present, u32 vtex, const rsx_si_op* ops)
+{
+    u32 (*k)[4] = (u32 (*)[4])block;
+    k[2][2] = at;
+    k[at][0] = n_ops; k[at][1] = present; k[at][2] = vtex; k[at][3] = 0;
+    memcpy(k + at + 1, ops, (size_t)n_ops * sizeof(rsx_si_op));
+}
+
+u32 rsx_si_vp_source(int mv, char* out, u32 cap)
+{
+    static const char def[] = "#define SI_MV 1\n";
+    u32 n = 0;
+    if (mv) { if (sizeof def > cap) return 0; memcpy(out, def, sizeof def - 1); n = (u32)(sizeof def - 1); }
+    const u32 len = (u32)(sizeof k_rsx_si_vp_hlsl - 1);
+    if (n + len + 1u > cap) return 0;
+    memcpy(out + n, k_rsx_si_vp_hlsl, len);
+    n += len;
+    out[n] = '\0';
+    return n;
+}
+
+/* [standin4] The pixel shader variants of the stand-in met on this PC's recorded pipelines (14,994 records of
+ * menus, car select and races; 44 variants: texture unit kinds x motion vectors x depth comparison), commonest
+ * first (the first, all units 2D, is 63 % of them). gt5.exe --prepare-shaders compiles all of them (and both vertex
+ * variants) even on a PC with no records, and the game compiles any the cache lacks at start, in this order. */
+static const u64 k_si_builtin[] = {
+    0x0000000000ull, 0x0200000000ull, 0x0210400000ull, 0x0200400000ull, 0x0010400000ull, 0x0000400000ull,
+    0x0010000000ull, 0x0210000000ull, 0x0010000010ull, 0x0100000000ull, 0x0000000004ull, 0x0210000010ull,
+    0x0000000010ull, 0x0010000004ull, 0x0210000040ull, 0x0000000001ull, 0x0200400028ull, 0x00000008a2ull,
+    0x0200000040ull, 0x0210400028ull, 0x0000000040ull, 0x0300400000ull, 0x0300000000ull, 0x0200000010ull,
+    0x0000400028ull, 0x0210000028ull, 0x0310400000ull, 0x0000000050ull, 0x0200000100ull, 0x0210000004ull,
+    0x0100400000ull, 0x0010000001ull, 0x0210000100ull, 0x0200000004ull, 0x0200000028ull, 0x0210000001ull,
+    0x0110000000ull, 0x0110000004ull, 0x0110400000ull, 0x0000000100ull, 0x0210400004ull, 0x0100000050ull,
+    0x0300000010ull, 0x0010000040ull,
+};
+u32 rsx_si_builtin_variants(const u64** out)
+{
+    *out = k_si_builtin;
+    return (u32)(sizeof k_si_builtin / sizeof k_si_builtin[0]);
+}
diff --git a/libs/video/rsx_standin.h b/libs/video/rsx_standin.h
new file mode 100644
--- /dev/null
+++ b/libs/video/rsx_standin.h
@@ -0,0 +1,111 @@
+/*
+ * [standin] A stand-in for a draw whose own pipeline is still being made: the draw's own vertex shader with
+ * one general pixel shader that runs the RSX fragment program from its words (rsx_standin_fp.hlsl), as
+ * rsx_fp_decompiler.c translates it. Pure C, no graphics API: rsx_live_draw.c makes the pipelines.
+ *
+ *  - rsx_si_encode: the program as the decompiler walks it, turned into micro-ops (its instructions, and its
+ *    IFE / LOOP / REP / BRK blocks exactly where the decompiler opens and closes them).
+ *  - rsx_si_desc_check: everything else that shapes the translated text (units, gamma, sign expansion, depth
+ *    comparison, texel sizes, sRGB, alpha test, WPOS edits, motion vectors), honoured or refused with a reason.
+ *  - rsx_si_block_*: the per-draw block the pixel shader reads at b1 (header, fp_alpha, unit descriptors, the
+ *    inline constants, the micro-ops).
+ *  - rsx_si_variant_source: the shader text for a variant (the kind of each texture unit, motion vectors).
+ */
+#ifndef PS3RECOMP_RSX_STANDIN_H
+#define PS3RECOMP_RSX_STANDIN_H
+
+#include "ps3emu/ps3types.h"
+#include "rsx_fp_decompiler.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define RSX_SI_MAX_OPS     1536u     /* micro-ops a program may have: the block must fit b1's 4096 rows */
+#define RSX_SI_BLOCK_ROWS  4096u
+#define RSX_SI_HEAD_ROWS   19u       /* header, fp_alpha, WPOS divisor, 16 unit descriptors */
+
+/* Why a draw cannot be drawn by the stand-in (it is then left out or waited for, as without it). */
+enum {
+    RSX_SI_OK = 0,
+    RSX_SI_R_PROGRAM,        /* the program could not be walked (no end, too long, a register past 47) */
+    RSX_SI_R_FLOW,           /* flow control the interpreter does not nest (more than 4 open loops) */
+    RSX_SI_R_TARGETS,        /* several colour targets or a depth export */
+    RSX_SI_R_SHADOW,         /* a depth comparison the translation itself refuses */
+    RSX_SI_R_RESOLVE,        /* the upscaler's one-tap resolve edit */
+    RSX_SI_R_OPCODE,         /* a fetch the translation refuses (gamma on TXD / TEXBEM) */
+    RSX_SI_R_UNBUFFERED,     /* inline constants written into the text (LD constants not buffered) */
+    RSX_SI_R_DERIV,          /* DDX / DDY: the translation leaves them out, and divides by the zeros that leaves
+                              * where fxc folds the division and the GPU does not: no stand-in can match that */
+    RSX_SI_R_INPUTS,         /* [standin2] the vertex program reads inputs the vertex layout does not have */
+    RSX_SI_R_N
+};
+const char* rsx_si_reason_name(u32 reason);
+
+typedef struct { u32 w[4]; u32 x[4]; } rsx_si_op;   /* the instruction's words; kind, slot / jump, loop, flags */
+typedef struct {
+    u32 n_ops, n_slots, n_regs;      /* micro-ops; inline constant slots (the decompiler's count); registers */
+    u32 uses_units;                  /* units a TEX / TXP / TXB / TXL reads */
+    u32 refused;                     /* RSX_SI_R_*, 0 when it can run */
+    rsx_si_op ops[RSX_SI_MAX_OPS];
+} rsx_si_prog;
+int rsx_si_encode(const u8* ucode, u32 max_bytes, rsx_si_prog* out);
+
+/* The rest of the translation's inputs, as get_pso has them. */
+typedef struct {
+    u32 fp_ctrl;
+    u32 cube_mask, vol_mask;
+    const rsx_fp_shadow_desc* shadow;    /* NULL: none */
+    const u8* gamma;                     /* 16, or NULL */
+    const u8* expand;                    /* 16, or NULL (the decompiler is given NULL with no expand unit) */
+    u32 unnorm_mask;
+    u32 unnorm_dim[16][3];
+    u32 srgb_output;
+    u32 alpha_test, alpha_func;
+    u32 wpos_mode, wpos_x, wpos_y;       /* 0 none, 1 the AA grid, 2 the render-scale line */
+    u32 mv, upres, rt_count;
+} rsx_si_desc;
+/* The descriptor rows (k[0].y flags and the 16 unit rows) for a program; 0 or a reason. */
+typedef struct { u32 flags; u32 wpos[2]; u32 unit[16][4]; } rsx_si_state;
+u32 rsx_si_desc_check(const rsx_si_prog* p, const rsx_si_desc* d, rsx_si_state* out);
+
+/* Rows of b1 the stand-in reads for a program of n_slots constant slots and n_ops micro-ops. */
+u32 rsx_si_block_rows(u32 n_slots, u32 n_ops);
+/* Writes them (16 bytes a row). constants: the draw's inline constants as the decompiler numbers them
+ * (missing rows are zero); fp_alpha: the draw's fp_alpha row. */
+void rsx_si_block_write(void* dst, u32 n_slots, u32 n_regs, u32 n_ops, const rsx_si_op* ops, const rsx_si_state* s,
+                        const u32 (*constants)[4], u32 n_constants, const float fp_alpha[4]);
+
+/* Variant = the kind of each texture unit (2 bits: 0 2D, 1 cube, 2 3D) | motion vectors << 32 | a depth
+ * comparison unit << 33. The shader
+ * text for it: the defines, then the shader. Returns its length, 0 when it does not fit. */
+u64 rsx_si_variant_of(const rsx_si_desc* d);
+u32 rsx_si_variant_source(u64 variant, char* out, u32 cap);
+
+/* ---- [standin2] the vertex side: a vertex program run from its words (rsx_standin_vp.hlsl), for a pipeline whose
+ * own vertex shader is not compiled: its stand-in then needs no compile at all, and one pipeline serves every
+ * new pipeline of the same render state and vertex layout. */
+#define RSX_SI_MAX_VP_OPS 544u
+typedef struct {
+    u32 n_ops;
+    u32 present;                     /* the inputs the translated shader reads (others are 0,0,0,1) */
+    u32 vtex;                        /* vertex texture units bound */
+    u32 refused;
+    rsx_si_op ops[RSX_SI_MAX_VP_OPS];
+} rsx_si_vprog;
+/* words: the transform program as the decompiler reads it; compact/layout_mask: as get_pso decompiles it
+ * (rsx_vp_decompile_compact_ex with the layout's mask, or rsx_vp_decompile_ex). 0 or a reason. */
+u32 rsx_si_vp_encode(const u8* words, u32 bytes, u32 vp_start, u32 branch_bits, u32 vtex_mask,
+                     int compact, u32 layout_mask, rsx_si_vprog* out);
+u32 rsx_si_vp_block_rows(u32 n_ops);
+/* Appends the vertex part at row `at` of a block rsx_si_block_write wrote (and points its header at it). */
+void rsx_si_vp_block_write(void* block, u32 at, u32 n_ops, u32 present, u32 vtex, const rsx_si_op* ops);
+/* The vertex shader text: mv = the motion-vector variant. Returns its length, 0 when it does not fit. */
+u32 rsx_si_vp_source(int mv, char* out, u32 cap);
+/* [standin4] The built-in list of pixel variants (commonest first): their count, *out the list. */
+u32 rsx_si_builtin_variants(const u64** out);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/libs/video/rsx_shader_prep.inc b/libs/video/rsx_shader_prep.inc
new file mode 100644
--- /dev/null
+++ b/libs/video/rsx_shader_prep.inc
@@ -0,0 +1,2088 @@
+/*
+ * [prep] Shaders made before their first draw. #included by rsx_live_draw.c just before get_pso(), so it
+ * sees the renderer's own state. On a draw's path it only runs ld_prep_note (once per new pipeline) and
+ * ld_prep_lookup (a shader that is not in the pack); the rest is the walker's tick at present (cheap:
+ * hand-overs only), threads of its own, and gt5.exe --prepare-shaders.
+ *
+ * Why: the shader cache and the made-ahead list (pipelines_d3d12.lst) name shaders by the hash of OUR
+ * HLSL, so nothing in them outlives a change of the generator, and nothing on a PC can give GT5's own
+ * programs back: its data is one encrypted volume (GT.VOL), so they can't be read from the disc either.
+ * Here each new pipeline is noted by the two programs it came from (a hash of their own bytes) and every
+ * input of their translation (shader_keys.lst), and every program the game used is kept once
+ * (programs.bin: the player's own data, never shipped). Both live in scratch\shader_keys, which "Clear
+ * the shader cache" leaves alone. With them:
+ *  - gt5.exe --prepare-shaders (the install / update / launcher step) translates every noted pipeline
+ *    with today's generator, compiles what the cache lacks on all cores, writes the cache, makes each
+ *    pipeline once (the driver keeps it) and puts them in the made-ahead list under their new names.
+ *  - in the game the list waits: a listed pipeline whose programs are known (stored, found in memory as
+ *    the game loads them, or just used by a draw) is translated and compiled by threads of its own, only
+ *    while the game's own compile pool has nothing to do, and then as many as the CPU has free (at most
+ *    half of it) while the backlog is long; its first draw finds the shaders ready.
+ *  - a list that ships with the port (shaders\known_d3d12.lst: keys only, no program bytes) adds what
+ *    other players' games drew; its pipelines are made the moment their programs are seen here.
+ * Settings: a record says which of the settings-made parts its text depends on (Shadows; the render
+ * scale and upscaler, for programs reading WPOS or depth textures read by texel; motion vectors, for
+ * depth-writing single-target draws; the upscaler's one-tap resolve; and, for its pipeline only, the scale
+ * of a polygon-offset slope) and what those settings were (one byte a kind, from the setting values
+ * themselves, not from what a frame happened to have on). Its texts are used when their kinds' settings
+ * are today's, its pipeline when the pipeline's are too; a record with none is used with any settings.
+ * Exactness: a prepared shader is used only when a draw's own translation is its text exactly (same
+ * length and two independent 64-bit hashes; the pack compares the whole source), so a stale record can
+ * waste work but never draw a wrong shader.
+ * LD_PREP=0: none of it. LD_PREP_BUILD=0: notes and store only, nothing built in the game.
+ * LD_PREP_CHECK=1: every new pipeline's two texts are made again from its record and compared with the
+ * draw's (the first 16 of a session always are); [shader-prep] lines say how many matched.
+ * LD_PREP_SCAN=0: no memory scan (it runs while listed programs are not yet known). LD_PREP_THREADS=<n>:
+ * at most n threads for the game's own making ahead.
+ */
+
+#define LD_PREP_MAGIC    0x31504B53u   /* "SKP1": a pipeline's keys */
+#define LD_PREP_VERSION  2u            /* 1: 496 bytes, a per-frame settings word (read, converted) */
+#define LD_PREP_V1_SIZE  496u
+#define LD_PROG_MAGIC    0x31475250u   /* "PRG1": a program in the store */
+#define LD_PREP_DIR      "scratch\\shader_keys"
+#define LD_PREP_SHIPPED  "shaders\\known_d3d12.lst"
+#define LD_PREP_MAX_PROG (64u * 1024u)
+
+enum {
+    LD_PREP_F_MASKED = 1u, LD_PREP_F_PACKED = 2u, LD_PREP_F_MV = 4u, LD_PREP_F_UPRES = 8u,
+    LD_PREP_F_WPOS_GRID = 16u, LD_PREP_F_WPOS_RS = 32u, LD_PREP_F_BRANCH = 64u,
+    /* the settings kinds the record's text depends on; cfg holds a byte for each (0 = any) */
+    LD_PREP_D_SHADOW = 0x100u, LD_PREP_D_SCALE = 0x200u, LD_PREP_D_MV = 0x400u, LD_PREP_D_UPRES = 0x800u,
+    /* ... and its pipeline only (not its text): a polygon-offset slope, times the pass's scale */
+    LD_PREP_D_SCALE_PSO = 0x1000u
+};
+
+/* One pipeline, by its programs: everything get_pso's translation and the pipeline description took.
+ * Keys only: the programs themselves are in the player's own store. */
+typedef struct {
+    u32 magic, version, size, flags;
+    u64 vp_key, fp_key;                 /* ld_prep_vp_key / rsx_fp_structural_hash (inline constants left out) */
+    u32 vp_instrs, vp_start, fp_size, fp_ctrl;
+    u32 cube_mask, vol_mask, vtex_mask, shadow_mask;
+    u32 expand_units, srgb_output, branch_bits, unnorm_mask;
+    u32 wpos_x, wpos_y, n_consts;
+    u32 cfg;                            /* a byte a settings kind (shadow, scale, mv, upres), 0 = any */
+    u32 layout_mask, layout_count;
+    u32 fp_head, vp_head;               /* a 32-bit hash of each program's first 16 bytes as guest memory holds
+                                         * them, for finding a listed program in memory (the scan) */
+    u8  gamma[16], expand[16], attrs[16];
+    rsx_fp_shadow_desc shadow[16];
+    u16 unnorm_dim[16][3];
+    render_state_t rs;                  /* as built: motion-vector / one-tap-resolve bits included */
+    char title[12];                     /* the release it was drawn on: disc id ... */
+    u32 eboot_size;                     /* ... and the size of the game's EBOOT (one per version) */
+    u64 check;                          /* fnv1a of everything before it */
+} ld_prep_rec;
+typedef char ld_prep_rec_size_is_512[sizeof(ld_prep_rec) == 512u ? 1 : -1];
+
+typedef struct ld_prep_prog {
+    struct ld_prep_prog* next_file;     /* the writer's list */
+    struct ld_prep_prog* next_walk;     /* the walker's list */
+    u64 key;
+    u32 stage, size;                    /* 'V' (transform program words as the decompiler reads them) or 'P' (guest bytes) */
+    u32 origin;                         /* 0 met by a draw, 1 found in memory, 2 read from programs.bin */
+    u8 bytes[];
+} ld_prep_prog;
+
+static int ld_prep_on(void)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("LD_PREP"); on = !(e && atoi(e) == 0); }
+    return on;
+}
+static int ld_prep_build_on(void)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("LD_PREP_BUILD"); on = !(e && atoi(e) == 0); }
+    return on;
+}
+static u64 ld_prep_vp_key(const u8* vp, u32 bytes)
+{
+    static const u32 tag = 0x314B5056u;   /* "VPK1" */
+    return fnv1a(vp, bytes, fnv1a(&tag, sizeof tag, 1469598103934665603ull));
+}
+/* A program's first 16 bytes as guest memory holds them, hashed (part of the list format: keep it). The
+ * transform program is kept as the decompiler reads it, host-order words; memory has them big-endian. */
+static u32 ld_prep_head(const u8* p)
+{
+    u64 a, b;
+    memcpy(&a, p, 8); memcpy(&b, p + 8, 8);
+    u64 h = (a * 0x9E3779B97F4A7C15ull) ^ ((b + 0x632BE59BD9B4E019ull) * 0xC2B2AE3D27D4EB4Full);
+    h ^= h >> 29;
+    return (u32)(h ^ (h >> 32));
+}
+static u32 ld_prep_vp_head(const u8* host_words)
+{
+    u8 b[16];
+    for (u32 k = 0; k < 4; k++) {
+        u32 w; memcpy(&w, host_words + 4u * k, 4);
+        w = _byteswap_ulong(w);
+        memcpy(b + 4u * k, &w, 4);
+    }
+    return ld_prep_head(b);
+}
+static u64 ld_prep_rec_id(const ld_prep_rec* r)
+{
+    const u64 h = fnv1a(r, (u32)offsetof(ld_prep_rec, check), 1469598103934665603ull);
+    return h ? h : 1u;
+}
+static void ld_prep_rec_seal(ld_prep_rec* r)
+{
+    r->check = fnv1a(r, (u32)offsetof(ld_prep_rec, check), 1469598103934665603ull);
+}
+static int ld_prep_rec_valid(const ld_prep_rec* r)
+{
+    return r->magic == LD_PREP_MAGIC && r->version == LD_PREP_VERSION && r->size == (u32)sizeof *r &&
+           r->check == fnv1a(r, (u32)offsetof(ld_prep_rec, check), 1469598103934665603ull) &&
+           r->vp_instrs && r->vp_instrs <= RSX_DSP_VP_INSTR && r->fp_size && r->fp_size <= LD_PREP_MAX_PROG &&
+           r->layout_count <= RSX_DSP_NUM_VERTEX_ATTR;
+}
+/* A version-1 record (round 1's test lists): the same fields up to the render state; its settings word
+ * was what a frame had on, not settings, so it becomes "any settings", with no release. */
+static int ld_prep_rec_from_v1(ld_prep_rec* r, const u8* p)
+{
+    u32 m, v, size; u64 check;
+    memcpy(&m, p, 4); memcpy(&v, p + 4, 4); memcpy(&size, p + 8, 4); memcpy(&check, p + 488, 8);
+    if (m != LD_PREP_MAGIC || v != 1u || size != LD_PREP_V1_SIZE) return 0;
+    if (check != fnv1a(p, 488u, 1469598103934665603ull)) return 0;
+    memset(r, 0, sizeof *r);
+    memcpy(r, p, 488u);                   /* every field up to and with the render state */
+    r->version = LD_PREP_VERSION; r->size = (u32)sizeof *r;
+    r->flags &= 0xFFu; r->cfg = 0;
+    ld_prep_rec_seal(r);
+    return ld_prep_rec_valid(r);
+}
+
+/* ---- settings ---------------------------------------------------------------------------------------- *
+ * One byte a kind, from the setting values (the registry in the game; in --prepare-shaders the values
+ * play.bat and settings.bat give, ld_prep_apply_bat). 1 + Shadows level; the others 1 + a hash of the
+ * values of the keys that decide that kind. The keys are the ones rsx_live_draw.c reads for the render
+ * scale (LD_RES_*, the upscaler's mode and scale, the TV mode, Shadows for the scaled shadow passes),
+ * motion vectors (LD_MV, the upscaler, frame generation) and the one-tap resolve (LD_UP_*, the upscaler). */
+static u8 ld_prep_cfg_hash(const char* const* keys, u32 extra)
+{
+    u64 h = fnv1a(&extra, sizeof extra, 1469598103934665603ull);
+    char v[96];
+    for (; *keys; keys++) {
+        gt5_setting_str(*keys, v, sizeof v);
+        h = fnv1a(*keys, (u32)strlen(*keys), h);
+        h = fnv1a("=", 1, h);
+        h = fnv1a(v, (u32)strlen(v), h);
+        h = fnv1a(";", 1, h);
+    }
+    return (u8)(1u + (u32)(h % 255u));
+}
+static u32 ld_prep_cfg_compute(void)
+{
+    static const char* const scale_keys[] = { "LD_RES_SCALE", "LD_RES_TARGET", "LD_RES_AA", "LD_RES_MIN", "LD_RES_ONLY",
+        "LD_RES_SKIP", "LD_RES_SCENE", "LD_RES_DEPTH_RULE", "LD_RES_OUT", "LD_AA", "LD_DLSS_SCALE", "PS3_VIDEO_MODE", NULL };
+    static const char* const mv_keys[] = { "LD_MV", "LD_AA", "LD_FRAMEGEN", "LD_FG_METHOD", NULL };
+    static const char* const up_keys[] = { "LD_AA", "LD_UP_RESOLVE", "LD_UP_OUT", "LD_DLSS_SCALE", "PS3_VIDEO_MODE", NULL };
+    const u32 level = (u32)ld_sm_level_read();
+    const u32 sh = 1u + level;
+    return sh | ((u32)ld_prep_cfg_hash(scale_keys, level) << 8) | ((u32)ld_prep_cfg_hash(mv_keys, 0) << 16) |
+           ((u32)ld_prep_cfg_hash(up_keys, 0) << 24);
+}
+/* The settings now, recomputed only when the registry changes (any thread). */
+static SRWLOCK s_cfg_lock = SRWLOCK_INIT;
+static u32 ld_prep_cfg_now(void)
+{
+    static u32 cfg; static unsigned gen = ~0u;
+    AcquireSRWLockExclusive(&s_cfg_lock);
+    if (gen != gt5_settings_gen()) { gen = gt5_settings_gen(); cfg = ld_prep_cfg_compute(); }
+    const u32 c = cfg;
+    ReleaseSRWLockExclusive(&s_cfg_lock);
+    return c;
+}
+/* Its texts usable now: every kind they depend on was made under today's settings (or the record is
+ * from before kinds were kept). */
+static int ld_prep_usable(const ld_prep_rec* r, u32 cur)
+{
+    for (u32 k = 0; k < 4; k++) {
+        if (!(r->flags & ((u32)LD_PREP_D_SHADOW << k))) continue;
+        const u32 a = (r->cfg >> (8u * k)) & 0xFFu, b = (cur >> (8u * k)) & 0xFFu;
+        if (a && a != b) return 0;
+    }
+    return 1;
+}
+/* ... and its pipeline too (the slope's scale is the render-scale kind's byte). */
+static int ld_prep_usable_pso(const ld_prep_rec* r, u32 cur)
+{
+    if (!ld_prep_usable(r, cur)) return 0;
+    if (!(r->flags & LD_PREP_D_SCALE_PSO)) return 1;
+    const u32 a = (r->cfg >> 8) & 0xFFu, b = (cur >> 8) & 0xFFu;
+    return !a || a == b;
+}
+/* Debug switches that edit get_pso's text after the translation: no notes and no checks with them. */
+static int ld_prep_debug_edits(void)
+{
+    static int d = -1;
+    if (d < 0) d = getenv("LD_SHADER_TINT") || getenv("LD_PS_STAGES") || getenv("LD_PS_ZERO") ||
+                   getenv("LD_FORCE_GREEN") || getenv("LD_FORCE_COL0") || getenv("RSX_FP_CTRL_AUTO");
+    return d;
+}
+
+/* get_pso's translation, from a record: the same calls with the same inputs, in the same order. Any
+ * thread: the vertex decompiler keeps its branch state and work buffers per thread (rsx_vp_decompiler.c),
+ * the fragment decompiler and the text edits keep none that shape the text. 1 when both made. */
+static int ld_prep_translate(const ld_prep_rec* r, const u8* vp, const u8* fp,
+                             char* vs, u32 vs_cap, char* ps, u32 ps_cap)
+{
+    rsx_vp_set_branch_base(r->vp_start);
+    rsx_vp_set_branch_bits((r->flags & LD_PREP_F_BRANCH) ? r->branch_bits : 0u);
+    const int vi = (r->flags & LD_PREP_F_MASKED)
+        ? rsx_vp_decompile_compact_ex(vp, r->vp_instrs * 16u, r->vtex_mask, r->layout_mask, vs, vs_cap)
+        : rsx_vp_decompile_ex(vp, r->vp_instrs * 16u, r->vtex_mask, vs, vs_cap);
+    if (vi <= 0) return 0;
+    u32 n_consts = 0;
+    int fi = rsx_fp_decompile_buffered_shadow_color_expand_vol_ex(
+        fp, r->fp_size, r->fp_ctrl, r->cube_mask, r->vol_mask,
+        r->shadow_mask ? r->shadow : NULL, r->gamma, r->expand_units ? r->expand : NULL,
+        ps, ps_cap, &n_consts);
+    if (fi > 0 && n_consts != r->n_consts) fi = -1;
+    if (fi > 0 && (r->flags & LD_PREP_F_WPOS_RS)) {
+        if (ld_rs_apply_wpos(ps, ps_cap, r->wpos_x, r->wpos_y) < 0) fi = -1;
+    } else if (fi > 0 && (r->flags & LD_PREP_F_WPOS_GRID) &&
+               rsx_fp_apply_wpos_grid(ps, ps_cap, r->wpos_x, r->wpos_y) < 0)
+        fi = -1;
+    if (fi > 0 && r->srgb_output && rsx_fp_apply_srgb_output(ps, ps_cap) < 0) fi = -1;
+    if (fi > 0 && r->rs.alpha_test_enable &&
+        rsx_fp_apply_alpha_test_buffered(ps, ps_cap, r->rs.alpha_func) < 0)
+        fi = -1;
+    if (fi > 0) {
+        u32 dim[16][3];
+        for (u32 u = 0; u < 16; u++)
+            for (u32 k = 0; k < 3; k++) dim[u][k] = r->unnorm_dim[u][k];
+        if (rsx_fp_apply_unnorm_scale(ps, ps_cap, r->unnorm_mask, (const u32 (*)[3])dim, r->cube_mask, r->vol_mask) < 0)
+            fi = -1;
+    }
+    if (fi <= 0) return 0;
+    if ((r->flags & LD_PREP_F_MV) && !ld_mv_apply_shaders(vs, vs_cap, ps, ps_cap)) return 0;
+    if ((r->flags & LD_PREP_F_UPRES) && !ld_up_apply_resolve(ps, ps_cap)) return 0;
+    return 1;
+}
+
+/* ---- the files ------------------------------------------------------------------------------------ */
+static char s_prep_dir[MAX_PATH];
+static int ld_prep_dir(void)
+{
+    if (s_prep_dir[0]) return 1;
+    const char* o = getenv("LD_PREP_DIR");
+    if (o && o[0]) snprintf(s_prep_dir, sizeof s_prep_dir, "%s", o);
+    else { CreateDirectoryA("scratch", NULL); snprintf(s_prep_dir, sizeof s_prep_dir, "%s", LD_PREP_DIR); }
+    if (!CreateDirectoryA(s_prep_dir, NULL) && GetLastError() != ERROR_ALREADY_EXISTS) { s_prep_dir[0] = 0; return 0; }
+    return 1;
+}
+static u8* ld_prep_read_file(const char* path, size_t* n)
+{
+    *n = 0;
+    FILE* f = fopen(path, "rb");
+    if (!f) return NULL;
+    u8* d = NULL;
+    if (_fseeki64(f, 0, SEEK_END) == 0) {
+        const long long len = _ftelli64(f);
+        if (len > 0 && len < (1ll << 31) && _fseeki64(f, 0, SEEK_SET) == 0) {
+            d = (u8*)malloc((size_t)len);
+            if (d && fread(d, 1, (size_t)len, f) == (size_t)len) *n = (size_t)len;
+            else { free(d); d = NULL; }
+        }
+    }
+    fclose(f);
+    return d;
+}
+static u64 ld_prep_ft(const FILETIME* t) { return ((u64)t->dwHighDateTime << 32) | t->dwLowDateTime; }
+
+/* Programs: the table every part looks them up in (filled by whoever loads; after s_prep_ready only the
+ * walker writes it, and only a slot's program pointer, never a new slot), with each one's records. */
+typedef struct { u64 key; u32 stage; u32 head; ld_prep_prog* volatile prog; } ld_prep_pslot;
+typedef struct { u32 rec, next; } ld_prep_link;
+static ld_prep_pslot* s_pt;
+static u32 s_pt_mask;
+static ld_prep_link* s_links;
+static u32 s_links_n;
+static ld_prep_pslot* ld_prep_slot(u64 key, u32 stage, int add)
+{
+    if (!s_pt) return NULL;
+    const u64 k = key ^ ((u64)stage << 56);
+    u32 i = (u32)(k ^ (k >> 31)) & s_pt_mask;
+    for (u32 probes = 0; probes <= s_pt_mask; probes++, i = (i + 1u) & s_pt_mask) {
+        ld_prep_pslot* s = &s_pt[i];
+        if (s->stage == stage && s->key == key) return s;
+        if (!s->stage) {
+            if (!add) return NULL;
+            s->key = key; s->stage = stage; s->head = 0; s->prog = NULL;
+            return s;
+        }
+    }
+    return NULL;
+}
+static int ld_prog_ok(const u8* p, size_t avail, ld_prep_prog** out)
+{
+    *out = NULL;
+    if (avail < 24) return 0;
+    u32 m, stage, size, check; u64 key;
+    memcpy(&m, p, 4); memcpy(&stage, p + 4, 4); memcpy(&key, p + 8, 8); memcpy(&size, p + 16, 4); memcpy(&check, p + 20, 4);
+    if (m != LD_PROG_MAGIC || (stage != 'V' && stage != 'P') || !size || size > LD_PREP_MAX_PROG || (size_t)size + 24 > avail)
+        return 0;
+    if ((u32)fnv1a(p + 24, size, 1469598103934665603ull) != check) return -1;   /* damaged: skip it */
+    ld_prep_prog* g2 = (ld_prep_prog*)malloc(sizeof *g2 + size);
+    if (!g2) return -1;
+    memset(g2, 0, sizeof *g2);
+    g2->key = key; g2->stage = stage; g2->size = size; g2->origin = 2;
+    memcpy(g2->bytes, p + 24, size);
+    *out = g2;
+    return 1;
+}
+static void ld_prog_write(FILE* f, const ld_prep_prog* g2)
+{
+    const u32 m = LD_PROG_MAGIC, check = (u32)fnv1a(g2->bytes, g2->size, 1469598103934665603ull);
+    fwrite(&m, 4, 1, f); fwrite(&g2->stage, 4, 1, f); fwrite(&g2->key, 8, 1, f);
+    fwrite(&g2->size, 4, 1, f); fwrite(&check, 4, 1, f); fwrite(g2->bytes, 1, g2->size, f);
+}
+
+/* The records both parts read: the PC's own (newest first) and then the shipped list, without repeats.
+ * Version-1 records (496 bytes) are converted; a file is one or the other, told by its first record. */
+typedef struct { ld_prep_rec* r; u32 n, own, shipped, damaged, v1; } ld_prep_list;
+static void ld_prep_add_list(ld_prep_list* L, const u8* d, size_t n, u64* seen, u32 seen_mask, int newest_first, u32* added)
+{
+    *added = 0;
+    u32 v = 0, rs = 0;
+    if (n >= 12) { memcpy(&v, d + 4, 4); memcpy(&rs, d + 8, 4); }
+    const size_t rec_size = (v == 1u && rs == LD_PREP_V1_SIZE) ? LD_PREP_V1_SIZE : sizeof(ld_prep_rec);
+    const size_t cnt = n / rec_size;
+    for (size_t j = 0; j < cnt; j++) {
+        const size_t k = newest_first ? cnt - 1 - j : j;
+        ld_prep_rec r;
+        if (rec_size == LD_PREP_V1_SIZE) {
+            if (!ld_prep_rec_from_v1(&r, d + k * rec_size)) { L->damaged++; continue; }
+            L->v1++;
+        } else {
+            memcpy(&r, d + k * rec_size, sizeof r);
+            if (!ld_prep_rec_valid(&r)) { L->damaged++; continue; }
+        }
+        const u64 id = ld_prep_rec_id(&r);
+        u32 i = (u32)(id ^ (id >> 29)) & seen_mask;
+        int dup = 0;
+        while (seen[i]) { if (seen[i] == id) { dup = 1; break; } i = (i + 1u) & seen_mask; }
+        if (dup) continue;
+        seen[i] = id;
+        L->r[L->n++] = r;
+        (*added)++;
+    }
+}
+static int ld_prep_load_lists(ld_prep_list* L)
+{
+    memset(L, 0, sizeof *L);
+    char path[MAX_PATH];
+    size_t n_own = 0, n_ship = 0;
+    snprintf(path, sizeof path, "%s\\shader_keys.lst", s_prep_dir);
+    u8* own = ld_prep_read_file(path, &n_own);
+    const char* sp = getenv("LD_PREP_SHIPPED");
+    u8* ship = ld_prep_read_file(sp && sp[0] ? sp : LD_PREP_SHIPPED, &n_ship);
+    const size_t total = n_own / LD_PREP_V1_SIZE + n_ship / LD_PREP_V1_SIZE + 1u;
+    u32 mask = 1023u;
+    while (mask < 2u * total + 1024u) mask = mask * 2u + 1u;
+    u64* seen = (u64*)calloc((size_t)mask + 1u, sizeof *seen);
+    L->r = (ld_prep_rec*)malloc(total * sizeof *L->r);
+    if (!seen || !L->r) { free(seen); free(L->r); L->r = NULL; free(own); free(ship); return 0; }
+    if (own) ld_prep_add_list(L, own, n_own, seen, mask, 1, &L->own);
+    if (ship) ld_prep_add_list(L, ship, n_ship, seen, mask, 0, &L->shipped);
+    free(seen); free(own); free(ship);
+    return 1;
+}
+static int ld_prep_load_programs(u32* n_out)
+{
+    *n_out = 0;
+    char path[MAX_PATH];
+    snprintf(path, sizeof path, "%s\\programs.bin", s_prep_dir);
+    size_t n = 0;
+    u8* d = ld_prep_read_file(path, &n);
+    size_t off = 0;
+    while (d && off + 24 <= n) {
+        ld_prep_prog* g2 = NULL;
+        const int ok = ld_prog_ok(d + off, n - off, &g2);
+        if (ok == 0) break;                          /* a torn tail */
+        u32 size; memcpy(&size, d + off + 16, 4);
+        off += 24u + size;
+        if (!g2) continue;
+        ld_prep_pslot* s = ld_prep_slot(g2->key, g2->stage, 1);
+        if (s && !s->prog) { s->prog = g2; (*n_out)++; }
+        else free(g2);
+    }
+    free(d);
+    return 1;
+}
+/* How many programs the store may hold, from its size (a program is at least 24 + 16 bytes; most are
+ * 0.5-8 KB, so this errs high): the table is sized for them and the records' programs together. */
+static u32 ld_prep_prog_hint(void)
+{
+    char p[MAX_PATH];
+    WIN32_FILE_ATTRIBUTE_DATA a;
+    snprintf(p, sizeof p, "%s\\programs.bin", s_prep_dir);
+    u32 hint = 8192u;
+    if (GetFileAttributesExA(p, GetFileExInfoStandard, &a) && !a.nFileSizeHigh && a.nFileSizeLow / 256u > hint)
+        hint = a.nFileSizeLow / 256u;
+    return hint < (1u << 22) ? hint : (1u << 22);
+}
+static int ld_prep_table_make(u32 n_recs, u32 n_prog_hint)
+{
+    u32 sz = 4096u;
+    while (sz < 2u * (2u * n_recs + n_prog_hint) + 4096u) sz <<= 1;
+    s_pt = (ld_prep_pslot*)calloc(sz, sizeof *s_pt);
+    s_links = (ld_prep_link*)malloc(((size_t)2u * n_recs + 1u) * sizeof *s_links);
+    if (!s_pt || !s_links) { free(s_pt); free(s_links); s_pt = NULL; s_links = NULL; return 0; }
+    s_pt_mask = sz - 1u;
+    s_links_n = 1;   /* 0 = end of a chain */
+    return 1;
+}
+static void ld_prep_link_rec(u32 rec, u64 key, u32 stage)
+{
+    ld_prep_pslot* s = ld_prep_slot(key, stage, 1);
+    if (!s) return;
+    s_links[s_links_n].rec = rec; s_links[s_links_n].next = s->head;
+    s->head = s_links_n++;
+}
+static int ld_prep_rec_ready(u32 i, const ld_prep_rec* recs, ld_prep_prog** vp, ld_prep_prog** fp)
+{
+    const ld_prep_rec* r = &recs[i];
+    const ld_prep_pslot* v = ld_prep_slot(r->vp_key, 'V', 0);
+    const ld_prep_pslot* f = ld_prep_slot(r->fp_key, 'P', 0);
+    ld_prep_prog* a = v ? v->prog : NULL;
+    ld_prep_prog* b = f ? f->prog : NULL;
+    if (!a || !b || a->size != r->vp_instrs * 16u || b->size != r->fp_size) return 0;
+    if (vp) *vp = a;
+    if (fp) *fp = b;
+    return 1;
+}
+
+/* The release this game is (records carry it; the tools sort lists by it; the game uses any release's). */
+extern const char* cellGame_get_title_id(void);
+extern uint8_t* vm_base;
+static void ld_prep_release(char title[12], u32* eboot_size)
+{
+    static char t[12]; static u32 sz; static int done;
+    if (!done) {
+        done = 1;
+        const char* id = cellGame_get_title_id();
+        snprintf(t, sizeof t, "%s", id ? id : "");
+        WIN32_FILE_ATTRIBUTE_DATA a;
+        if (GetFileAttributesExA("input\\EBOOT.elf", GetFileExInfoStandard, &a)) sz = a.nFileSizeLow;
+    }
+    memcpy(title, t, 12);
+    *eboot_size = sz;
+}
+
+/* ---- in the game ----------------------------------------------------------------------------------- */
+static volatile LONG s_prep_ready;
+static ld_prep_list s_pl;
+static u8* s_rec_state;              /* 0 waiting for a program, 1 queued, 2 done or skipped (walker) */
+static SRWLOCK s_prep_lock = SRWLOCK_INIT;
+static ld_prep_prog* s_new_file;     /* programs first used or found this session, for programs.bin */
+static ld_prep_prog* s_new_walk;     /* ... and for the walker's table */
+static ld_prep_rec* s_rec_pend; static u32 s_rec_pend_n, s_rec_pend_cap;
+static u64* s_noted; static u32 s_noted_n;               /* walker: record ids noted this session */
+static u64* s_seen_prog; static u32 s_seen_prog_n;       /* walker: program keys handled this session */
+#define LD_PREP_SEEN 65536u
+static struct {
+    volatile LONG64 noted, programs, built, built_fail, used, translate_fail, other_settings, check_same, check_diff,
+                    known, full, work_qpc, translated;
+    u32 n_prog_file;
+} s_pst;
+
+static int ld_prep_set_add(u64** set, u32* n, u64 key)
+{
+    if (!*set) *set = (u64*)calloc(LD_PREP_SEEN, sizeof **set);
+    if (!*set || *n >= LD_PREP_SEEN / 2u) return 0;
+    if (!key) key = 1u;
+    u32 i = (u32)(key ^ (key >> 31)) & (LD_PREP_SEEN - 1u);
+    while ((*set)[i]) { if ((*set)[i] == key) return 0; i = (i + 1u) & (LD_PREP_SEEN - 1u); }
+    (*set)[i] = key; (*n)++;
+    return 1;
+}
+
+/* Shaders made ahead and not yet asked for (walker): by length and two hashes of the text. */
+typedef struct { u64 key, h2; u32 stage, len; u8* blob; u32 blob_len; u32 used; } ld_prep_built;
+#define LD_PREP_BUILT 16384u
+#define LD_PREP_BUILT_MAX 8192u              /* about 50 MB of compiled shaders at most */
+static ld_prep_built* s_built; static u32 s_built_n;
+
+static u64 ld_prep_h2(const char* src, u32 len) { return ld_fast_hash(src, len, 0x50524550ull); }
+static ld_prep_built* ld_prep_built_slot(u32 stage, u64 hash, u32 len, int add)
+{
+    if (!s_built) {
+        if (!add) return NULL;
+        s_built = (ld_prep_built*)calloc(LD_PREP_BUILT, sizeof *s_built);
+        if (!s_built) return NULL;
+    }
+    const u64 key = shader_mem_key(stage, hash, len);
+    u32 i = (u32)(key ^ (key >> 29)) & (LD_PREP_BUILT - 1u);
+    while (s_built[i].key) {
+        if (s_built[i].key == key && s_built[i].stage == stage && s_built[i].len == len) return &s_built[i];
+        i = (i + 1u) & (LD_PREP_BUILT - 1u);
+    }
+    if (!add || s_built_n >= LD_PREP_BUILT_MAX) return NULL;
+    s_built[i].key = key; s_built[i].stage = stage; s_built[i].len = len;
+    s_built_n++;
+    return &s_built[i];
+}
+
+/* shader_disk_cache_load_raw, for a shader not in the pack: one made ahead with exactly this text.
+ * The walker's alone (it is the only caller of the cache loads). A copy, as ld_blob_private does. */
+static ID3DBlob* ld_prep_lookup(u32 stage, const char* source, u32 length, u64 hash)
+{
+    if (!s_built_n) return NULL;
+    ld_prep_built* b = ld_prep_built_slot(stage, hash, length, 0);
+    if (!b || !b->blob || b->h2 != ld_prep_h2(source, length)) return NULL;
+    ID3DBlob* out = NULL;
+    if (FAILED(D3DCreateBlob(b->blob_len, &out)) || !out) return NULL;
+    memcpy(out->lpVtbl->GetBufferPointer(out), b->blob, b->blob_len);
+    if (!b->used) { b->used = 1; InterlockedIncrement64(&s_pst.used); }
+    return out;
+}
+
+/* ---- the game's own making ahead: a queue of records and threads that translate and compile ---------- *
+ * A worker takes a record whose programs are known, translates it (any thread may: see ld_prep_translate),
+ * compiles the texts the pack doesn't hold and nobody else took, saves them as the game's compiles are
+ * saved, and leaves the bytes for the walker (ld_prep_tick), which hands them to the first draw that asks.
+ * "Needed now" always beats "maybe later":
+ *  - the gate (ld_prep_gate_main): while the game's compile pool has work queued or running, or the
+ *    made-ahead list's threads are still making pipelines, the gate is shut; workers finish the shader in
+ *    hand and take nothing new, the memory scan waits; the gate opens 100 ms after the pool went idle.
+ *    Polled every 5 ms from the pool's own state, not from priorities or frame times.
+ *  - no second copy where it is free: a text a worker is compiling is in the in-flight table; a pool thread
+ *    given the same text by a draw takes the worker's result only if it is out already, else compiles the text
+ *    itself ([stall], 19 Nov: no pool thread waits for a worker); a text a draw's pipeline has (noted in
+ *    ld_prep_note before its compile starts) is never taken by a worker.
+ *  - workers: none without a backlog, 1-2 with a short one, with a long one the processors the game leaves
+ *    free, never more than half the logical processors nor (logical - pool threads running - 2)
+ *    (ld_prep_control, every 250 ms). Below normal priority. */
+typedef struct { u32 rec; ld_prep_prog* vp; ld_prep_prog* fp; } ld_prep_item;
+typedef struct ld_prep_done { struct ld_prep_done* next; u32 stage, len; u64 hash, h2; u8* blob; u32 blob_len; } ld_prep_done;
+static ld_prep_item* s_qhi; static u32 s_qhi_r, s_qhi_w;   /* a program was just used or found: first */
+static ld_prep_item* s_qn;  static u32 s_qn_r, s_qn_w;     /* known at start, in list order */
+static volatile LONG* s_rec_taken;                         /* a worker took the record (a record may be queued twice) */
+static SRWLOCK s_q_lock = SRWLOCK_INIT;
+static CONDITION_VARIABLE s_q_wake = CONDITION_VARIABLE_INIT;
+static volatile LONG s_active, s_busy;
+static HANDLE s_wth[64]; static u32 s_wth_n;
+static ld_prep_done* s_done;                                /* under s_q_lock */
+static u64* s_sent; static u32 s_sent_n;                    /* texts a worker took or a draw has, under s_q_lock */
+static volatile LONG s_cfg_cur;                              /* the settings now, for the workers */
+
+/* The gate. */
+static volatile LONG s_gate_open = 1;
+static volatile LONG64 s_gate_closed_at, s_paused_qpc;      /* when it shut; time shut, summed */
+static volatile LONG64 s_adopted, s_adopt_wait_qpc;          /* pool compiles served by a worker's result */
+static int ld_prep_game_busy(void)
+{
+    if (s_cpool_head || s_cpool_hi_head) return 1;                 /* queued (a racy look is enough) */
+    if (InterlockedCompareExchange(&s_cp_running, 0, 0) > 0) return 1;   /* running, or waiting for a shader */
+    if (InterlockedCompareExchange(&s_ahead_ready, 0, 0) && InterlockedCompareExchange(&s_ahead_next, 0, 0) < (LONG)s_ahead_n)
+        return 1;                                                  /* the made-ahead list's pipelines */
+    return 0;
+}
+static DWORD WINAPI ld_prep_gate_main(LPVOID unused)
+{
+    (void)unused;
+    SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_ABOVE_NORMAL);   /* it must see the pool promptly */
+    LARGE_INTEGER fq; QueryPerformanceFrequency(&fq);
+    const LONGLONG idle_needed = fq.QuadPart / 10;                         /* 100 ms */
+    LONGLONG last_busy = 0;
+    for (;;) {
+        Sleep(5);
+        LARGE_INTEGER q; QueryPerformanceCounter(&q);
+        if (ld_prep_game_busy()) {
+            last_busy = q.QuadPart;
+            if (s_gate_open) {
+                s_gate_closed_at = q.QuadPart;
+                InterlockedExchange(&s_gate_open, 0);
+            }
+        } else if (!s_gate_open && q.QuadPart - last_busy >= idle_needed) {
+            InterlockedAdd64(&s_paused_qpc, q.QuadPart - s_gate_closed_at);
+            AcquireSRWLockExclusive(&s_q_lock);
+            InterlockedExchange(&s_gate_open, 1);
+            ReleaseSRWLockExclusive(&s_q_lock);
+            WakeAllConditionVariable(&s_q_wake);
+        }
+    }
+}
+/* Time the gate was shut, summed, the current stretch included (for the 5 s line). */
+static LONG64 ld_prep_paused_total(void)
+{
+    LONG64 t = s_paused_qpc;
+    if (!s_gate_open) { LARGE_INTEGER q; QueryPerformanceCounter(&q); t += q.QuadPart - s_gate_closed_at; }
+    return t;
+}
+
+/* The in-flight table: texts a worker is compiling right now, and their results for any pool thread
+ * waiting for them. Under s_q_lock; a slot is free again when its result is out and nobody waits. */
+typedef struct { u64 key, h2; u8* blob; u32 blob_len; LONG used, done, waiters; } ld_prep_fl;
+#define LD_PREP_FL 128
+static ld_prep_fl s_fl[LD_PREP_FL];
+static volatile LONG s_fl_used;
+static CONDITION_VARIABLE s_fl_cv = CONDITION_VARIABLE_INIT;
+static int ld_prep_fl_take(u64 key, u64 h2)               /* s_q_lock held; -1 = no room (compiled anyway) */
+{
+    for (int i = 0; i < (int)LD_PREP_FL; i++)
+        if (!s_fl[i].used) {
+            memset(&s_fl[i], 0, sizeof s_fl[i]);
+            s_fl[i].used = 1; s_fl[i].key = key; s_fl[i].h2 = h2;
+            InterlockedIncrement(&s_fl_used);
+            return i;
+        }
+    return -1;
+}
+static void ld_prep_fl_put(int i, const u8* blob, u32 blob_len)   /* s_q_lock held */
+{
+    if (i < 0) return;
+    ld_prep_fl* f = &s_fl[i];
+    f->done = 1;
+    if (f->waiters && blob && (f->blob = (u8*)malloc(blob_len)) != NULL) { memcpy(f->blob, blob, blob_len); f->blob_len = blob_len; }
+    if (!f->waiters) { f->used = 0; InterlockedDecrement(&s_fl_used); }
+}
+/* ld_cpool_compile, on a pool thread: a draw's shader a worker has compiled and not handed over yet: the result
+ * as a blob of this thread's own. 0: compile it as usual, also while the worker is still compiling it ([stall]:
+ * a pool thread never sleeps on a worker). */
+static int ld_prep_adopt(const ld_shader_job* j, ID3DBlob** out)
+{
+    *out = NULL;
+    if (!InterlockedCompareExchange(&s_fl_used, 0, 0) || !j->source) return 0;
+    const u64 key = shader_mem_key(j->stage, j->hash, j->length);
+    const u64 h2 = ld_prep_h2(j->source, j->length);
+    LARGE_INTEGER c0, c1; QueryPerformanceCounter(&c0);
+    u8* bytes = NULL; u32 n = 0;
+    int found = 0;
+    AcquireSRWLockExclusive(&s_q_lock);
+    for (int i = 0; i < (int)LD_PREP_FL; i++) {
+        ld_prep_fl* f = &s_fl[i];
+        if (!f->used || f->key != key || f->h2 != h2) continue;
+        /* [stall] Never wait here for a worker: a pool thread compiles the text itself unless the worker's result is
+         * already out (a second compile of one shader costs less than any wait on a thread the gate can park). */
+        if (!f->done) break;
+        found = 1;
+        f->waiters++;
+        if (f->blob && (bytes = (u8*)malloc(f->blob_len)) != NULL) { memcpy(bytes, f->blob, f->blob_len); n = f->blob_len; }
+        if (--f->waiters == 0) { free(f->blob); f->blob = NULL; f->used = 0; InterlockedDecrement(&s_fl_used); }
+        break;
+    }
+    ReleaseSRWLockExclusive(&s_q_lock);
+    if (!found || !bytes) { free(bytes); return 0; }   /* not in flight, or the worker's compile failed */
+    ID3DBlob* b = NULL;
+    if (SUCCEEDED(D3DCreateBlob(n, &b)) && b) memcpy(b->lpVtbl->GetBufferPointer(b), bytes, n);
+    free(bytes);
+    if (!b) return 0;
+    QueryPerformanceCounter(&c1);
+    InterlockedIncrement64(&s_adopted);
+    InterlockedAdd64(&s_adopt_wait_qpc, c1.QuadPart - c0.QuadPart);
+    *out = b;
+    return 1;
+}
+/* A text a draw's pipeline has: no worker takes it (ld_prep_note, before the draw's compile starts). */
+static void ld_prep_sent_mark(u32 stage, const char* src)
+{
+    const u32 len = (u32)strlen(src);
+    const u64 qk = shader_mem_key(stage, fnv1a(src, len, 1469598103934665603ull), len);
+    AcquireSRWLockExclusive(&s_q_lock);
+    ld_prep_set_add(&s_sent, &s_sent_n, qk);
+    ReleaseSRWLockExclusive(&s_q_lock);
+}
+
+static u32 ld_prep_backlog(void)
+{
+    return (s_qhi_w - s_qhi_r) + (s_qn_w - s_qn_r) + (u32)s_busy;
+}
+static DWORD WINAPI ld_prep_worker(LPVOID arg)
+{
+    const LONG me = (LONG)(intptr_t)arg;
+    SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_BELOW_NORMAL);
+    { HRESULT (WINAPI *sd)(HANDLE, PCWSTR) = (HRESULT (WINAPI*)(HANDLE, PCWSTR))
+          (void*)GetProcAddress(GetModuleHandleA("kernel32.dll"), "SetThreadDescription");
+      if (sd) sd(GetCurrentThread(), L"rsx shader prepare"); }
+    char* vs = (char*)malloc(256u * 1024u);
+    char* ps = (char*)malloc(256u * 1024u);
+    if (!vs || !ps) return 0;
+    for (;;) {
+        ld_prep_item it;
+        AcquireSRWLockExclusive(&s_q_lock);
+        for (;;) {
+            const int work = me < s_active && (s_qhi_r < s_qhi_w || s_qn_r < s_qn_w);
+            if (work && s_gate_open && !ld_prep_game_busy()) break;
+            /* Woken by a push, a change of s_active or the gate opening; only with work and the gate still open
+             * over a busy pool (the gate's 5 ms poll not round yet) is it looked at again in 10 ms. */
+            SleepConditionVariableSRW(&s_q_wake, &s_q_lock, work && s_gate_open ? 10u : INFINITE, 0);
+        }
+        it = s_qhi_r < s_qhi_w ? s_qhi[s_qhi_r++] : s_qn[s_qn_r++];
+        InterlockedIncrement(&s_busy);
+        ReleaseSRWLockExclusive(&s_q_lock);
+        LARGE_INTEGER c0, c1; QueryPerformanceCounter(&c0);
+        const ld_prep_rec* r = &s_pl.r[it.rec];
+        if (InterlockedExchange(&s_rec_taken[it.rec], 1)) { InterlockedDecrement(&s_busy); continue; }   /* queued twice */
+        if (!ld_prep_usable(r, (u32)s_cfg_cur)) InterlockedIncrement64(&s_pst.other_settings);
+        else if (!ld_prep_translate(r, it.vp->bytes, it.fp->bytes, vs, 256u * 1024u, ps, 256u * 1024u))
+            InterlockedIncrement64(&s_pst.translate_fail);
+        else {
+            InterlockedIncrement64(&s_pst.translated);
+            for (int k = 0; k < 2; k++) {
+                const char* src = k ? ps : vs;
+                const u32 stage = k ? 'P' : 'V';
+                const u32 len = (u32)strlen(src);
+                const u64 h = fnv1a(src, len, 1469598103934665603ull);
+                const u64 qk = shader_mem_key(stage, h, len);
+                const u64 h2 = ld_prep_h2(src, len);
+                /* In the pack with this exact text: nothing to do (the table is read-only once ready). */
+                const shader_mem_entry* e = InterlockedCompareExchange(&s_shader_mem_ready, 0, 0) ? shader_mem_get(qk) : NULL;
+                if (e && e->size >= sizeof(shader_disk_cache_header) + len &&
+                    memcmp(e->data + sizeof(shader_disk_cache_header), src, len) == 0) continue;
+                /* The game's work first: wait for the gate between shaders too. Then take the text (unless a
+                 * draw has it or another worker took it) into the in-flight table, and from here on wait for
+                 * nothing until its result is out. */
+                AcquireSRWLockExclusive(&s_q_lock);
+                while (!s_gate_open || ld_prep_game_busy())
+                    SleepConditionVariableSRW(&s_q_wake, &s_q_lock, s_gate_open ? 10u : INFINITE, 0);
+                const int mine = ld_prep_set_add(&s_sent, &s_sent_n, qk);
+                const int fl = mine ? ld_prep_fl_take(qk, h2) : -1;
+                ReleaseSRWLockExclusive(&s_q_lock);
+                if (!mine) continue;
+                ID3DBlob* blob = NULL; ID3DBlob* err = NULL;
+                const HRESULT hr = D3DCompile(src, len, k ? "xps" : "xvs", NULL, NULL, "main", k ? "ps_5_0" : "vs_5_0",
+                                              0, 0, &blob, &err);
+                ld_prep_done* d = NULL;
+                if (SUCCEEDED(hr) && blob) {
+                    const SIZE_T bl = blob->lpVtbl->GetBufferSize(blob);
+                    d = (ld_prep_done*)calloc(1, sizeof *d);
+                    if (d && bl && (d->blob = (u8*)malloc(bl)) != NULL) {
+                        memcpy(d->blob, blob->lpVtbl->GetBufferPointer(blob), bl);
+                        d->blob_len = (u32)bl; d->stage = stage; d->len = len; d->hash = h; d->h2 = h2;
+                    } else { free(d); d = NULL; }
+                    shader_disk_cache_store(stage, src, len, h, blob);   /* as the game's own compiles */
+                    blob->lpVtbl->Release(blob);
+                } else InterlockedIncrement64(&s_pst.built_fail);
+                if (err) err->lpVtbl->Release(err);
+                AcquireSRWLockExclusive(&s_q_lock);
+                ld_prep_fl_put(fl, d ? d->blob : NULL, d ? d->blob_len : 0u);
+                if (d) { d->next = s_done; s_done = d; }
+                ReleaseSRWLockExclusive(&s_q_lock);
+                WakeAllConditionVariable(&s_fl_cv);
+            }
+        }
+        QueryPerformanceCounter(&c1);
+        InterlockedAdd64(&s_pst.work_qpc, c1.QuadPart - c0.QuadPart);
+        InterlockedDecrement(&s_busy);
+    }
+}
+static void ld_prep_set_active(LONG n)
+{
+    if (n > (LONG)s_wth_n) {   /* threads are made the first time they are wanted, and stay */
+        const u32 want = (u32)n < 64u ? (u32)n : 64u;
+        while (s_wth_n < want) {
+            HANDLE t = CreateThread(NULL, 1u << 20, ld_prep_worker, (LPVOID)(intptr_t)s_wth_n, 0, NULL);
+            if (!t) break;
+            s_wth[s_wth_n++] = t;
+        }
+        if (n > (LONG)s_wth_n) n = (LONG)s_wth_n;
+    }
+    AcquireSRWLockExclusive(&s_q_lock);
+    s_active = n;
+    ReleaseSRWLockExclusive(&s_q_lock);
+    WakeAllConditionVariable(&s_q_wake);
+}
+static void ld_prep_push(const ld_prep_item* it, int hi)
+{
+    AcquireSRWLockExclusive(&s_q_lock);
+    if (hi) s_qhi[s_qhi_w++] = *it; else s_qn[s_qn_w++] = *it;
+    ReleaseSRWLockExclusive(&s_q_lock);
+    WakeAllConditionVariable(&s_q_wake);
+}
+
+static void ld_prep_first_diff(const char* what, const char* a, const char* b)
+{
+    size_t i = 0;
+    while (a[i] && a[i] == b[i]) i++;
+    const size_t from = i > 40 ? i - 40 : 0;
+    fprintf(stderr, "[shader-prep] check: the %s differs at byte %zu: draw \"%.80s\" record \"%.80s\"\n",
+            what, i, a + from, b + from);
+}
+
+/* get_pso, a new pipeline with both texts made: note it (once a session) and its programs (once ever).
+ * vs/ps are the texts build_pso is about to get. */
+static void ld_prep_note(u32 vp_start, const u8* vp_uc, u32 vp_instrs, const u8* fp_uc, u32 fp_size, u32 fp_ctrl,
+    u32 cube_mask, u32 vol_mask, u32 vtex_mask, u32 shadow_mask, const rsx_fp_shadow_desc* shadow,
+    const u8* gamma, u32 expand_units, const u8* expand, u32 srgb_output, int wpos_scaled, int wpos_rs,
+    const u32 wpos_grid[2], int branch_used, u32 branch_bits, u32 unnorm_mask, const u32 unnorm_dim[][3],
+    u32 n_consts, int mv_built, const render_state_t* rs, const rsx_vertex_layout_plan* masked_layout,
+    int packed_payload, const char* vs, const char* ps)
+{
+    if (!ld_prep_on()) return;
+    /* This draw's texts are compiled by the game now (or found ready): no worker takes them later. */
+    if (InterlockedCompareExchange(&s_prep_ready, 0, 0)) { ld_prep_sent_mark('V', vs); ld_prep_sent_mark('P', ps); }
+    if (ld_prep_debug_edits() || !ld_fp_constants_buffered()) return;
+    if (!vp_uc || !fp_uc || !vp_instrs || !fp_size || fp_size > LD_PREP_MAX_PROG || fp_size < 16u) return;
+    if (unnorm_mask)
+        for (u32 u = 0; u < 16; u++)
+            for (u32 k = 0; k < 3; k++) if (unnorm_dim[u][k] > 0xFFFFu) return;
+    const u64 vp_key = ld_prep_vp_key(vp_uc, vp_instrs * 16u);
+    const u64 fp_key = rsx_fp_structural_hash(fp_uc, fp_size, 1469598103934665603ull);
+    if (!fp_key) return;
+    ld_prep_rec r;
+    memset(&r, 0, sizeof r);
+    r.magic = LD_PREP_MAGIC; r.version = LD_PREP_VERSION; r.size = (u32)sizeof r;
+    r.vp_key = vp_key; r.fp_key = fp_key;
+    r.vp_instrs = vp_instrs; r.vp_start = vp_start; r.fp_size = fp_size; r.fp_ctrl = fp_ctrl;
+    r.cube_mask = cube_mask; r.vol_mask = vol_mask; r.vtex_mask = vtex_mask; r.shadow_mask = shadow_mask;
+    if (shadow_mask) memcpy(r.shadow, shadow, sizeof r.shadow);
+    memcpy(r.gamma, gamma, 16);
+    r.expand_units = expand_units;
+    if (expand_units) memcpy(r.expand, expand, 16);
+    r.srgb_output = srgb_output;
+    if (wpos_rs) { r.flags |= LD_PREP_F_WPOS_RS; r.wpos_x = wpos_grid[0]; r.wpos_y = wpos_grid[1]; }
+    else if (wpos_scaled) { r.flags |= LD_PREP_F_WPOS_GRID; r.wpos_x = wpos_grid[0]; r.wpos_y = wpos_grid[1]; }
+    if (branch_used) { r.flags |= LD_PREP_F_BRANCH; r.branch_bits = branch_bits; }
+    r.unnorm_mask = unnorm_mask;
+    if (unnorm_mask)
+        for (u32 u = 0; u < 16; u++)
+            for (u32 k = 0; k < 3; k++) r.unnorm_dim[u][k] = (u16)unnorm_dim[u][k];
+    r.n_consts = n_consts;
+    if (mv_built) r.flags |= LD_PREP_F_MV;
+    r.rs = *rs;
+    if (rs->rt_count & LD_RT_UPRES) r.flags |= LD_PREP_F_UPRES;
+    if (masked_layout) {
+        r.flags |= LD_PREP_F_MASKED;
+        if (packed_payload) r.flags |= LD_PREP_F_PACKED;
+        r.layout_mask = masked_layout->mask;
+        r.layout_count = masked_layout->count < RSX_DSP_NUM_VERTEX_ATTR ? masked_layout->count : RSX_DSP_NUM_VERTEX_ATTR;
+        memcpy(r.attrs, masked_layout->attrs, r.layout_count);
+    }
+    /* What of its text the settings make (see the top). */
+    const u32 targets = rs->rt_count & 0xFFu;
+    if (shadow_mask) r.flags |= LD_PREP_D_SHADOW;
+    if (strstr(ps, "_rsx_wpos(input.position)")) r.flags |= LD_PREP_D_SCALE;   /* grid line or scale line */
+    for (u32 u = 0; u < 16 && unnorm_mask; u++) {
+        /* a depth texture read by texel takes its zeta snapshot's host size (get_pso): scale-made */
+        if (!(unnorm_mask & (1u << u))) continue;
+        rsx_dsp_texture tx;
+        rsx_dsp_get_texture(&g.rsx, u, &tx);
+        const u32 f = tx.format & TEX_FMT_BASE_MASK & ~(u32)TEX_FMT_UNNORM;
+        if (f == TEX_FMT_DEPTH24_D8 || f == TEX_FMT_DEPTH16) { r.flags |= LD_PREP_D_SCALE; break; }
+    }
+    if (rs->slope_bias) r.flags |= LD_PREP_D_SCALE_PSO;
+    if (mv_built || (rs->depth_test && rs->depth_write && targets == 1u)) r.flags |= LD_PREP_D_MV;
+    if (rs->rt_count & LD_RT_UPRES) r.flags |= LD_PREP_D_UPRES;
+    else if (!rs->depth_test && !rs->blend_enable && targets == 1u) {
+        /* the scene's copy into the display buffer would get the one-tap edit with the upscaler on */
+        static char scratch[256 * 1024];
+        const size_t n = strlen(ps);
+        if (n + 64u < sizeof scratch) {
+            memcpy(scratch, ps, n + 1u);
+            if (ld_up_apply_resolve(scratch, sizeof scratch)) r.flags |= LD_PREP_D_UPRES;
+        }
+    }
+    r.cfg = ld_prep_cfg_now();
+    r.fp_head = ld_prep_head(fp_uc); r.vp_head = ld_prep_vp_head(vp_uc);
+    ld_prep_release(r.title, &r.eboot_size);
+    ld_prep_rec_seal(&r);
+    /* The check: the record must give back exactly the texts the draw made. */
+    static int check_all = -1;
+    if (check_all < 0) { const char* e = getenv("LD_PREP_CHECK"); check_all = e && atoi(e) != 0; }
+    if (check_all || s_pst.check_same + s_pst.check_diff < 16) {
+        static char cvs[256 * 1024], cps[256 * 1024];
+        const int ok = ld_prep_translate(&r, vp_uc, fp_uc, cvs, sizeof cvs, cps, sizeof cps);
+        const int same = ok && strcmp(cvs, vs) == 0 && strcmp(cps, ps) == 0;
+        if (same) s_pst.check_same++;
+        else {
+            s_pst.check_diff++;
+            if (s_pst.check_diff <= 4) {
+                if (!ok) fprintf(stderr, "[shader-prep] check: the record did not translate (flags 0x%X)\n", r.flags);
+                else if (strcmp(cvs, vs) != 0) ld_prep_first_diff("vertex shader", vs, cvs);
+                else ld_prep_first_diff("pixel shader", ps, cps);
+            }
+            return;   /* a record that doesn't give the draw's text back is not kept */
+        }
+    }
+    const u64 id = ld_prep_rec_id(&r);
+    if (ld_prep_set_add(&s_noted, &s_noted_n, id)) {
+        AcquireSRWLockExclusive(&s_prep_lock);
+        if (s_rec_pend_n == s_rec_pend_cap) {
+            const u32 nc = s_rec_pend_cap ? s_rec_pend_cap * 2u : 256u;
+            ld_prep_rec* p = (ld_prep_rec*)realloc(s_rec_pend, (size_t)nc * sizeof *p);
+            if (p) { s_rec_pend = p; s_rec_pend_cap = nc; }
+        }
+        if (s_rec_pend_n < s_rec_pend_cap) s_rec_pend[s_rec_pend_n++] = r;
+        ReleaseSRWLockExclusive(&s_prep_lock);
+        InterlockedIncrement64(&s_pst.noted);
+    }
+    /* The programs, the first time this session: to the store, and to the walker's table, where they
+     * free the listed pipelines that waited for them. */
+    for (int k = 0; k < 2; k++) {
+        const u32 stage = k ? 'P' : 'V';
+        const u64 key = k ? fp_key : vp_key;
+        if (!ld_prep_set_add(&s_seen_prog, &s_seen_prog_n, key ^ ((u64)stage << 56))) continue;
+        { static u32 said;   /* the first ones, against the scan's lines: was it in memory before this draw? */
+          const ld_prep_pslot* s = InterlockedCompareExchange(&s_prep_ready, 0, 0) ? ld_prep_slot(key, stage, 0) : NULL;
+          if (k && said < 24 && vm_base && fp_uc >= vm_base && fp_uc < vm_base + 0x100000000ull) {
+              said++;
+              fprintf(stderr, "[shader-prep] t=%.1f s: first draw of fragment program %016llX, fetched at guest 0x%08X; %s\n",
+                      ld_uptime_s(), (unsigned long long)key, (unsigned)(fp_uc - vm_base),
+                      !s ? "in no list" : s->prog ? (s->prog->origin == 1 ? "found in memory before" : "stored") :
+                      "listed, not found before");
+          } }
+        const u32 size = k ? fp_size : vp_instrs * 16u;
+        ld_prep_prog* g2 = (ld_prep_prog*)malloc(sizeof *g2 + size);
+        if (!g2) continue;
+        memset(g2, 0, sizeof *g2);
+        g2->key = key; g2->stage = stage; g2->size = size;
+        memcpy(g2->bytes, k ? fp_uc : vp_uc, size);
+        AcquireSRWLockExclusive(&s_prep_lock);
+        g2->next_file = s_new_file; s_new_file = g2;
+        g2->next_walk = s_new_walk; s_new_walk = g2;
+        ReleaseSRWLockExclusive(&s_prep_lock);
+    }
+}
+
+/* The walker, at every present: the shaders the workers finished into the table draws look in, the
+ * programs met this session into the program table (their waiting records to the front of the queue),
+ * and the frame's time for ld_prep_control. No translation or compile here. */
+static volatile LONG64 s_tick_n, s_tick_gap_sum, s_tick_gap_max;
+static void ld_prep_tick(void)
+{
+    if (!ld_prep_on() || !InterlockedCompareExchange(&s_prep_ready, 0, 0)) return;
+    { static LONGLONG last;
+      LARGE_INTEGER q; QueryPerformanceCounter(&q);
+      if (last) {
+          const LONG64 gap = q.QuadPart - last;
+          InterlockedAdd64(&s_tick_gap_sum, gap);
+          if (gap > s_tick_gap_max) s_tick_gap_max = gap;
+          InterlockedIncrement64(&s_tick_n);
+      }
+      last = q.QuadPart; }
+    ld_prep_done* d;
+    AcquireSRWLockExclusive(&s_q_lock);
+    d = s_done; s_done = NULL;
+    ReleaseSRWLockExclusive(&s_q_lock);
+    while (d) {
+        ld_prep_done* next = d->next;
+        ld_prep_built* b = ld_prep_built_slot(d->stage, d->hash, d->len, 1);
+        if (b && !b->blob) {
+            b->blob = d->blob; b->blob_len = d->blob_len; b->h2 = d->h2; d->blob = NULL;
+            InterlockedIncrement64(&s_pst.built);
+        } else if (!b) InterlockedIncrement64(&s_pst.full);
+        free(d->blob); free(d);
+        d = next;
+    }
+    ld_prep_prog* nw;
+    AcquireSRWLockExclusive(&s_prep_lock);
+    nw = s_new_walk; s_new_walk = NULL;
+    ReleaseSRWLockExclusive(&s_prep_lock);
+    for (; nw; nw = nw->next_walk) {
+        ld_prep_pslot* s = ld_prep_slot(nw->key, nw->stage, 0);
+        if (!s) continue;                          /* in no list: nothing waits for it */
+        if (s->prog && nw->origin != 0) continue;  /* found in memory, already known */
+        if (!s->prog) s->prog = nw;
+        /* Its records to the front of the queue: those that waited for it, and, when a draw has just used
+         * it, those already queued behind others (each record goes to the front once; a worker takes a
+         * record once, s_rec_taken). States: 0 waiting, 1 queued, 3 queued at the front, 2 skipped. */
+        for (u32 l = s->head; l; l = s_links[l].next) {
+            const u32 i = s_links[l].rec;
+            ld_prep_item it;
+            if (s_rec_state[i] == 0) {
+                if (!ld_prep_rec_ready(i, s_pl.r, &it.vp, &it.fp)) continue;
+            } else if (s_rec_state[i] == 1 && nw->origin == 0 && !s_rec_taken[i]) {
+                if (!ld_prep_rec_ready(i, s_pl.r, &it.vp, &it.fp)) continue;
+            } else continue;
+            s_rec_state[i] = 3;
+            it.rec = i;
+            if (ld_prep_build_on()) ld_prep_push(&it, 1);
+        }
+    }
+}
+
+/* ---- the memory scan --------------------------------------------------------------------------------- *
+ * While listed programs are not known yet (LD_PREP_SCAN=0: never): find them in guest memory as the game
+ * loads them (a track's or car's during its loading screen), not at their first draw. A pass hashes each
+ * 64 KB of committed guest memory, skips the pieces that are as they were, and at every 16 bytes of the
+ * rest compares a hash of the 16 bytes with the first-16-byte hashes of the listed programs not known yet
+ * (a bitmap first); a candidate is checked by the program's own key over its listed length. A pass runs
+ * when the game has read a lot from disc (4 MB since the last pass) and its reading paused for 0.5 s or
+ * 2 s went by, or once a minute after any reading; its cost is held to 1 s of one thread in any 5 s.
+ * A program found goes to the walker's table as one the game used (and to the store). One found that a
+ * draw had already met counts as "after its first draw". The thread ends once every listed program is
+ * known. "[shader-prep] scan" lines every 5 s with a pass. */
+typedef struct { u32 head, stage, size, pad; u64 key; } ld_scan_ent;
+static ld_scan_ent* s_se; static u32 s_se_n;
+static u8* s_bloom;                     /* 1 << 20 bits by head */
+static volatile LONG64 s_scan_found, s_scan_late, s_scan_bytes, s_scan_sweeps, s_scan_found_v;
+static HANDLE s_scan_th;
+static int ld_scan_cmp(const void* a, const void* b)
+{
+    const ld_scan_ent* x = (const ld_scan_ent*)a;
+    const ld_scan_ent* y = (const ld_scan_ent*)b;
+    if (x->head != y->head) return x->head < y->head ? -1 : 1;
+    if (x->stage != y->stage) return x->stage < y->stage ? -1 : 1;
+    if (x->key != y->key) return x->key < y->key ? -1 : 1;
+    return 0;
+}
+static int ld_prep_scan_on(void)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("LD_PREP_SCAN"); on = !(e && atoi(e) == 0); }
+    return on;
+}
+/* The listed programs without bytes (the loader's, before ready). */
+static void ld_scan_index(void)
+{
+    s_se = (ld_scan_ent*)malloc(((size_t)2u * s_pl.n + 1u) * sizeof *s_se);
+    s_bloom = (u8*)calloc(1u << 17, 1);
+    if (!s_se || !s_bloom) { s_se_n = 0; return; }
+    for (u32 i = 0; i < s_pl.n; i++) {
+        const ld_prep_rec* r = &s_pl.r[i];
+        if (!r->fp_head && !r->vp_head) continue;
+        for (int k = 0; k < 2; k++) {
+            const u32 stage = k ? 'P' : 'V';
+            const ld_prep_pslot* s = ld_prep_slot(k ? r->fp_key : r->vp_key, stage, 0);
+            if (!s || s->prog) continue;   /* its bytes are known already */
+            ld_scan_ent* e = &s_se[s_se_n++];
+            e->head = k ? r->fp_head : r->vp_head; e->stage = stage; e->key = k ? r->fp_key : r->vp_key;
+            e->size = k ? r->fp_size : r->vp_instrs * 16u; e->pad = 0;
+            s_bloom[(e->head & 0xFFFFFu) >> 3] |= (u8)(1u << (e->head & 7u));
+        }
+    }
+    qsort(s_se, s_se_n, sizeof *s_se, ld_scan_cmp);
+    u32 w = 0;   /* one entry per program (records share them) */
+    for (u32 i = 0; i < s_se_n; i++)
+        if (!w || ld_scan_cmp(&s_se[w - 1u], &s_se[i]) != 0 || s_se[w - 1u].size != s_se[i].size) s_se[w++] = s_se[i];
+    s_se_n = w;
+}
+static void ld_scan_found(const ld_scan_ent* e, const u8* p)
+{
+    /* Already met by a draw (or stored): the scan came too late for it. */
+    const ld_prep_pslot* s = ld_prep_slot(e->key, e->stage, 0);
+    const int late = s && s->prog;
+    { static volatile LONG said;   /* where programs are found, the first ones ("loaded, or only drawn?") */
+      if (InterlockedIncrement(&said) <= 24)
+          fprintf(stderr, "[shader-prep] scan t=%.1f s: %s program %016llX (%u bytes) at guest 0x%08X%s\n", ld_uptime_s(),
+                  e->stage == 'V' ? "vertex" : "fragment", (unsigned long long)e->key, e->size, (unsigned)(p - vm_base),
+                  late ? ", after its first draw" : ""); }
+    if (late) { InterlockedIncrement64(&s_scan_late); return; }
+    ld_prep_prog* g2 = (ld_prep_prog*)malloc(sizeof *g2 + e->size);
+    if (!g2) return;
+    memset(g2, 0, sizeof *g2);
+    g2->key = e->key; g2->stage = e->stage; g2->size = e->size; g2->origin = 1;
+    if (e->stage == 'P') memcpy(g2->bytes, p, e->size);
+    else for (u32 k = 0; k + 4u <= e->size; k += 4u) {
+        u32 w; memcpy(&w, p + k, 4); w = _byteswap_ulong(w); memcpy(g2->bytes + k, &w, 4);
+    }
+    AcquireSRWLockExclusive(&s_prep_lock);
+    g2->next_file = s_new_file; s_new_file = g2;
+    g2->next_walk = s_new_walk; s_new_walk = g2;
+    ReleaseSRWLockExclusive(&s_prep_lock);
+    InterlockedIncrement64(&s_scan_found);
+    if (e->stage == 'V') InterlockedIncrement64(&s_scan_found_v);
+}
+/* One piece of guest memory, [p, p + n), with `room` readable bytes from p. */
+static void ld_scan_piece(const u8* p, size_t n, size_t room, u64** got, u32* got_n)
+{
+    static u8 vbuf[RSX_DSP_VP_INSTR * 16];
+    for (size_t o = 0; o + 16u <= n; o += 16u) {
+        const u32 h = ld_prep_head(p + o);
+        if (!(s_bloom[(h & 0xFFFFFu) >> 3] & (1u << (h & 7u)))) continue;
+        size_t lo = 0, hi = s_se_n;
+        while (lo < hi) { const size_t mid = (lo + hi) / 2u; if (s_se[mid].head < h) lo = mid + 1u; else hi = mid; }
+        for (size_t k = lo; k < s_se_n && s_se[k].head == h; k++) {
+            const ld_scan_ent* e = &s_se[k];
+            if (e->size > room - o) continue;
+            u64 key;
+            if (e->stage == 'P') key = rsx_fp_structural_hash(p + o, e->size, 1469598103934665603ull);
+            else {
+                if (e->size > sizeof vbuf) continue;
+                for (u32 b = 0; b + 4u <= e->size; b += 4u) {
+                    u32 w; memcpy(&w, p + o + b, 4); w = _byteswap_ulong(w); memcpy(vbuf + b, &w, 4);
+                }
+                key = ld_prep_vp_key(vbuf, e->size);
+            }
+            if (key != e->key) continue;
+            if (!ld_prep_set_add(got, got_n, key ^ ((u64)e->stage << 56))) continue;
+            ld_scan_found(e, p + o);
+        }
+    }
+}
+/* A range of guest memory searched now, on the caller's thread: a file the game's own reader has just loaded
+ * (GT5\src\gt5_volprobe.cpp). The same test as the scan (bitmap of first-16-byte hashes, then the program's
+ * own key over its listed length); a program found goes to the store and the walker the same way. Counts:
+ * found = listed programs not known before (stored now), known = listed programs already known (stored,
+ * drawn or found earlier), vertex = how many of the found were vertex programs. Returns 0 (and nothing is
+ * searched) while the lists are not read, or when nothing is looked for. Also used once at start for the
+ * executable's own image (its built-in shader containers), see ld_prep_main. */
+static SRWLOCK s_scan_ext_lock = SRWLOCK_INIT;
+static u64* s_scan_ext_got; static u32 s_scan_ext_got_n;
+int rsx_shader_prep_scan_guest(uint32_t ea, uint32_t n, uint32_t* found, uint32_t* known, uint32_t* vertex)
+{
+    *found = *known = *vertex = 0;
+    if (!InterlockedCompareExchange(&s_prep_ready, 0, 0) || !s_se_n || !s_bloom || !vm_base || n < 16u) return 0;
+    if ((u64)ea + n > 0x100000000ull) n = (uint32_t)(0x100000000ull - ea);
+    u8* vbuf = (u8*)malloc(RSX_DSP_VP_INSTR * 16);
+    if (!vbuf) return 0;
+    const u8* p = vm_base + ea;
+    AcquireSRWLockExclusive(&s_scan_ext_lock);
+    __try {
+        for (u32 o = 0; o + 16u <= n; o += 16u) {
+            const u32 h = ld_prep_head(p + o);
+            if (!(s_bloom[(h & 0xFFFFFu) >> 3] & (1u << (h & 7u)))) continue;
+            size_t lo = 0, hi = s_se_n;
+            while (lo < hi) { const size_t mid = (lo + hi) / 2u; if (s_se[mid].head < h) lo = mid + 1u; else hi = mid; }
+            for (size_t k = lo; k < s_se_n && s_se[k].head == h; k++) {
+                const ld_scan_ent* e = &s_se[k];
+                if (e->size > n - o) continue;
+                u64 key;
+                if (e->stage == 'P') key = rsx_fp_structural_hash(p + o, e->size, 1469598103934665603ull);
+                else {
+                    if (e->size > RSX_DSP_VP_INSTR * 16) continue;
+                    for (u32 b = 0; b + 4u <= e->size; b += 4u) {
+                        u32 w; memcpy(&w, p + o + b, 4); w = _byteswap_ulong(w); memcpy(vbuf + b, &w, 4);
+                    }
+                    key = ld_prep_vp_key(vbuf, e->size);
+                }
+                if (key != e->key) continue;
+                /* known: present here, but stored, drawn or found before (also by an earlier range) */
+                const int fresh = ld_prep_set_add(&s_scan_ext_got, &s_scan_ext_got_n, key ^ ((u64)e->stage << 56));
+                const ld_prep_pslot* s = ld_prep_slot(e->key, e->stage, 0);
+                if (!fresh || (s && s->prog)) { (*known)++; continue; }
+                ld_scan_found(e, p + o);
+                (*found)++;
+                if (e->stage == 'V') (*vertex)++;
+            }
+        }
+    } __except (EXCEPTION_EXECUTE_HANDLER) {
+        fprintf(stderr, "[shader-prep] scan of guest 0x%08X (%u bytes) stopped: not readable\n", ea, n);
+    }
+    ReleaseSRWLockExclusive(&s_scan_ext_lock);
+    free(vbuf);
+    return 1;
+}
+/* How many listed programs the scan looks for (0 until the lists are read). */
+uint32_t rsx_shader_prep_scan_listed(void)
+{
+    return InterlockedCompareExchange(&s_prep_ready, 0, 0) ? s_se_n : 0u;
+}
+/* For the volume reader (GT5\src\gt5_volread.cpp): how many listed programs are not known yet (no bytes:
+ * not stored, drawn or found), a hash of the shipped list's program keys (*list_hash: the reader's done-list
+ * belongs to one shipped list; the PC's own records come first in s_pl and are left out, they grow as it
+ * plays), and the folder the lists live in (*dir, or NULL). 0 until the lists are read. */
+uint32_t rsx_shader_prep_scan_unknown(uint64_t* list_hash, const char** dir)
+{
+    if (list_hash) *list_hash = 0;
+    if (dir) *dir = NULL;
+    if (!InterlockedCompareExchange(&s_prep_ready, 0, 0) || !s_se_n) return 0;
+    u32 unknown = 0;
+    u64 h = 1469598103934665603ull;
+    for (u32 i = s_pl.own; i < s_pl.n; i++) h = (h ^ s_pl.r[i].vp_key ^ (s_pl.r[i].fp_key << 1)) * 1099511628211ull;
+    for (u32 i = 0; i < s_se_n; i++) {
+        const ld_prep_pslot* s = ld_prep_slot(s_se[i].key, s_se[i].stage, 0);
+        if (!(s && s->prog)) unknown++;
+    }
+    if (list_hash) *list_hash = h;
+    if (dir && s_prep_dir[0]) *dir = s_prep_dir;
+    return unknown;
+}
+
+/* One pass; returns the bytes hashed and searched. */
+static void ld_scan_pass(u64* chunk_h, u64** got, u32* got_n, u64* read_out, u64* searched_out)
+{
+    u64 read = 0, scanned = 0;
+    for (u8* a = vm_base; a < vm_base + 0x100000000ull;) {
+        MEMORY_BASIC_INFORMATION mi;
+        if (!VirtualQuery(a, &mi, sizeof mi)) break;
+        u8* end = (u8*)mi.BaseAddress + mi.RegionSize;
+        if (end > vm_base + 0x100000000ull) end = vm_base + 0x100000000ull;
+        const int readable = mi.State == MEM_COMMIT && !(mi.Protect & (PAGE_GUARD | PAGE_NOACCESS)) &&
+                             (mi.Protect & (PAGE_READONLY | PAGE_READWRITE | PAGE_WRITECOPY | PAGE_EXECUTE_READ |
+                                            PAGE_EXECUTE_READWRITE));
+        if (readable) {
+            for (u8* c = (u8*)((uintptr_t)a & ~(uintptr_t)0xFFFF); c < end; c += 0x10000) {
+                u8* lo = c < a ? a : c;
+                u8* hi = c + 0x10000 < end ? c + 0x10000 : end;
+                const u32 idx = (u32)((u64)(c - vm_base) >> 16);
+                while (!s_gate_open) Sleep(10);   /* the game's own compiles first */
+                __try {
+                    const u64 h = ld_fast_hash(lo, (u32)(hi - lo), 0x5343414Eull);
+                    read += (u64)(hi - lo);
+                    if (h != chunk_h[idx]) {
+                        chunk_h[idx] = h;
+                        ld_scan_piece(lo, (size_t)(hi - lo), (size_t)(end - lo), got, got_n);
+                        scanned += (u64)(hi - lo);
+                    }
+                } __except (EXCEPTION_EXECUTE_HANDLER) {
+                    chunk_h[idx] = 0;   /* gone under us: look again next time */
+                }
+            }
+        }
+        a = end;
+    }
+    *read_out = read; *searched_out = scanned;
+}
+static double ld_uptime_s(void);
+static DWORD WINAPI ld_prep_scan_main(LPVOID unused)
+{
+    (void)unused;
+    SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_IDLE);
+    u64* chunk_h = (u64*)calloc(1u << 16, sizeof *chunk_h);   /* per 64 KB of the 4 GB guest space */
+    u64* got = NULL; u32 got_n = 0;
+    if (!chunk_h || !s_se_n || !vm_base) return 0;
+    fprintf(stderr, "[shader-prep] scan: looking for %u listed programs in guest memory as the game loads\n", s_se_n);
+    LARGE_INTEGER fq; QueryPerformanceFrequency(&fq);
+    ULONGLONG io_last = 0, acc = 0, acc_since = 0, quiet_since = 0, last_pass = 0, win_start = GetTickCount64();
+    double win_cost = 0.0, win_hashed = 0.0, win_searched = 0.0;
+    u32 win_passes = 0; LONG64 win_found0 = 0, win_late0 = 0;
+    int first = 1;
+    for (;;) {
+        Sleep(250);
+        const ULONGLONG now = GetTickCount64();
+        IO_COUNTERS io;
+        if (GetProcessIoCounters(GetCurrentProcess(), &io)) {
+            const ULONGLONG rd = io.ReadTransferCount;
+            if (io_last && rd > io_last) {
+                if (!acc) acc_since = now;
+                acc += rd - io_last;
+                quiet_since = now;
+            }
+            io_last = rd;
+        }
+        const int loaded = acc >= (4u << 20) && (now - quiet_since >= 500u || now - acc_since >= 2000u);
+        const int stale = acc && now - last_pass >= 60000u;
+        if ((first || loaded || stale) && win_cost < 1.0 && s_gate_open) {
+            first = 0;
+            LARGE_INTEGER t0, t1; QueryPerformanceCounter(&t0);
+            u64 rb = 0, sb = 0;
+            ld_scan_pass(chunk_h, &got, &got_n, &rb, &sb);
+            QueryPerformanceCounter(&t1);
+            const double sec = (double)(t1.QuadPart - t0.QuadPart) / (double)fq.QuadPart;
+            win_cost += sec; win_hashed += (double)rb; win_searched += (double)sb; win_passes++;
+            s_scan_sweeps++; s_scan_bytes += (LONG64)sb;
+            acc = 0; last_pass = now;
+        }
+        if (now - win_start >= 5000u) {
+            if (win_passes) {
+                /* known now: listed programs found or met by a draw (a racy look at pointers that never go) */
+                u32 known = 0;
+                for (u32 i = 0; i < s_se_n; i++) {
+                    const ld_prep_pslot* s = ld_prep_slot(s_se[i].key, s_se[i].stage, 0);
+                    if (s && s->prog) known++;
+                }
+                fprintf(stderr, "[shader-prep] scan t=%.0f s: %u passes, %.0f MB hashed, %.0f MB searched, %.2f s; "
+                        "found %lld before their first draw (%lld so far, %lld of them vertex programs), %lld after; "
+                        "%u of %u listed programs known\n",
+                        ld_uptime_s(), win_passes, win_hashed / 1048576.0, win_searched / 1048576.0, win_cost,
+                        (long long)(s_scan_found - win_found0), (long long)s_scan_found, (long long)s_scan_found_v,
+                        (long long)(s_scan_late - win_late0), known, s_se_n);
+                if (known >= s_se_n) {
+                    fprintf(stderr, "[shader-prep] scan: every listed program is known; the scan stops\n");
+                    free(chunk_h);
+                    return 0;
+                }
+            }
+            win_start = now; win_cost = win_hashed = win_searched = 0.0; win_passes = 0;
+            win_found0 = s_scan_found; win_late0 = s_scan_late;
+        }
+    }
+}
+
+/* ---- the thread: loads, appends what the session noted, and sets how many workers may work ---------- */
+static void ld_prep_flush(void)
+{
+    ld_prep_rec* recs; u32 n; ld_prep_prog* progs;
+    AcquireSRWLockExclusive(&s_prep_lock);
+    recs = s_rec_pend; n = s_rec_pend_n; s_rec_pend = NULL; s_rec_pend_n = s_rec_pend_cap = 0;
+    progs = s_new_file; s_new_file = NULL;
+    ReleaseSRWLockExclusive(&s_prep_lock);
+    char path[MAX_PATH];
+    if (n) {
+        snprintf(path, sizeof path, "%s\\shader_keys.lst", s_prep_dir);
+        FILE* f = fopen(path, "ab");
+        if (f) { fwrite(recs, sizeof *recs, n, f); fclose(f); }
+    }
+    free(recs);
+    if (progs) {
+        snprintf(path, sizeof path, "%s\\programs.bin", s_prep_dir);
+        FILE* f = fopen(path, "ab");
+        static u64* written; static u32 written_n;
+        for (ld_prep_prog* g2 = progs; g2; g2 = g2->next_file) {
+            /* Once in the file: not one it had at start (the table's copy came from it), not twice this
+             * session (a program found in memory and then met by a draw comes twice). */
+            const ld_prep_pslot* s = InterlockedCompareExchange(&s_prep_ready, 0, 0) ? ld_prep_slot(g2->key, g2->stage, 0) : NULL;
+            if (s && s->prog && s->prog->origin == 2) continue;
+            if (!ld_prep_set_add(&written, &written_n, g2->key ^ ((u64)g2->stage << 56)) && written_n < LD_PREP_SEEN / 2u) continue;
+            if (f) { ld_prog_write(f, g2); InterlockedIncrement64(&s_pst.programs); }
+        }
+        if (f) fclose(f);
+    }
+}
+/* A list of version-1 records (round 1's builds) is written again as version 2, oldest first, so the
+ * session's notes can be appended to it (the loader's thread, once, before anything is appended). */
+static void ld_prep_rewrite_v1(void)
+{
+    char path[MAX_PATH], tmp[MAX_PATH];
+    snprintf(path, sizeof path, "%s\\shader_keys.lst", s_prep_dir);
+    FILE* f = fopen(path, "rb");
+    u32 hd[3] = {0, 0, 0};
+    if (!f) return;
+    const size_t got = fread(hd, 4, 3, f);
+    fclose(f);
+    if (got != 3 || hd[1] != 1u || hd[2] != LD_PREP_V1_SIZE) return;
+    snprintf(tmp, sizeof tmp, "%s.tmp.%lu", path, (unsigned long)GetCurrentProcessId());
+    FILE* o = fopen(tmp, "wb");
+    int ok = o != NULL;
+    for (u32 k = s_pl.own; ok && k-- > 0;) ok = fwrite(&s_pl.r[k], sizeof s_pl.r[k], 1, o) == 1;
+    if (o) ok = (fclose(o) == 0) && ok;
+    if (ok) ok = MoveFileExA(tmp, path, MOVEFILE_REPLACE_EXISTING) != 0;
+    if (!ok) {   /* set aside rather than appended to: one file, one record size */
+        char old[MAX_PATH];
+        DeleteFileA(tmp);
+        snprintf(old, sizeof old, "%s.v1", path);
+        MoveFileExA(path, old, MOVEFILE_REPLACE_EXISTING);
+    }
+}
+/* At most half the logical processors (LD_PREP_THREADS lowers it), whatever the idle tests say. */
+static int ld_prep_threads_max(void)
+{
+    SYSTEM_INFO si; GetSystemInfo(&si);
+    int n = (int)si.dwNumberOfProcessors / 2;
+    { const char* e = getenv("LD_PREP_THREADS"); if (e && atoi(e) > 0 && atoi(e) < n) n = atoi(e); }
+    if (n < 1) n = 1;
+    if (n > 64) n = 64;
+    return n;
+}
+static u64 ld_prep_thread_cpu(HANDLE t)
+{
+    FILETIME c, x, k, u;
+    return t && GetThreadTimes(t, &c, &x, &k, &u) ? ld_prep_ft(&k) + ld_prep_ft(&u) : 0;
+}
+/* Every 250 ms: how many workers may work (see ld_prep_worker's block), and a line every 5 s. */
+static void ld_prep_control(void)
+{
+    static u64 p_proc, p_prep; static ULONGLONG p_wall, line_t;
+    static double base_ms;
+    static LONG64 p_built, p_used, p_work, p_paused, p_adopted;
+    const ULONGLONG now = GetTickCount64();
+    s_cfg_cur = (LONG)ld_prep_cfg_now();   /* the settings the workers check records against */
+    FILETIME c, x, k, u;
+    const u64 proc = GetProcessTimes(GetCurrentProcess(), &c, &x, &k, &u) ? ld_prep_ft(&k) + ld_prep_ft(&u) : 0;
+    u64 prep = ld_prep_thread_cpu(s_scan_th);
+    for (u32 i = 0; i < s_wth_n; i++) prep += ld_prep_thread_cpu(s_wth[i]);
+    const double wall = p_wall ? (double)(now - p_wall) / 1000.0 : 0.0;
+    const double game = wall > 0.05 && proc >= p_proc && prep >= p_prep
+                      ? ((double)(proc - p_proc) - (double)(prep - p_prep)) / 1e7 / wall : 0.0;
+    p_proc = proc; p_prep = prep; p_wall = now;
+    const LONG64 ticks = InterlockedExchange64(&s_tick_n, 0);
+    const LONG64 gaps = InterlockedExchange64(&s_tick_gap_sum, 0);
+    InterlockedExchange64(&s_tick_gap_max, 0);
+    LARGE_INTEGER fq; QueryPerformanceFrequency(&fq);
+    const double frame_ms = ticks ? 1000.0 * (double)gaps / (double)ticks / (double)fq.QuadPart : 0.0;
+    SYSTEM_INFO si; GetSystemInfo(&si);
+    const int n_cpu = (int)si.dwNumberOfProcessors, tmax = ld_prep_threads_max();
+    const u32 backlog = ld_prep_backlog();
+    const LONG cur = s_active;
+    /* the usual frame time: measured while at most two workers run */
+    if (ticks >= 3 && cur <= 2) base_ms = base_ms > 0.0 ? 0.75 * base_ms + 0.25 * frame_ms : frame_ms;
+    const int suffering = ticks >= 3 && base_ms > 0.0 && frame_ms > 17.0 && frame_ms > 1.2 * base_ms;
+    LONG want;
+    if (!backlog || !ld_prep_build_on()) want = 0;
+    else if (backlog < 32u) want = backlog < 8u ? 1 : 2;
+    else {
+        int free_cpu = (int)((double)n_cpu - game - 1.0);
+        if (free_cpu < 2) free_cpu = 2;
+        want = free_cpu < tmax ? free_cpu : tmax;
+        if (suffering && cur > 2) want = cur / 2 > 2 ? cur / 2 : 2;
+        else if (want > cur) { const LONG step = cur < 2 ? 2 : cur; if (want > cur + step) want = cur + step; }
+    }
+    /* Room for the pool even when the gate is wrong: never more than logical - pool threads running - 2. */
+    { const LONG room = (LONG)n_cpu - InterlockedCompareExchange(&s_cp_running, 0, 0) - 2;
+      if (want > room) want = room > 0 ? room : 0; }
+    if (want != cur) ld_prep_set_active(want);
+    if (now - line_t >= 5000u) {
+        line_t = now;
+        const LONG64 built = s_pst.built, used = s_pst.used, work = s_pst.work_qpc;
+        const LONG64 paused = ld_prep_paused_total(), adopted = s_adopted;
+        if (backlog || built != p_built || used != p_used || adopted != p_adopted)
+            fprintf(stderr, "[shader-prep] t=%.0f s: backlog %u pipelines; workers %ld of %d (game %.1f of %d processors busy, "
+                    "frames %.1f ms, usual %.1f ms%s); paused %.0f ms for the game's own compiles; made %lld shaders (+%lld), "
+                    "%lld used by draws (+%lld); %lld of the game's compiles served by one in flight (+%lld); %.1f s of work\n",
+                    ld_uptime_s(), backlog, (long)s_active, tmax, game, n_cpu, frame_ms, base_ms,
+                    suffering ? ", slower" : "", 1000.0 * (double)(paused - p_paused) / (double)fq.QuadPart,
+                    (long long)built, (long long)(built - p_built), (long long)used, (long long)(used - p_used),
+                    (long long)adopted, (long long)(adopted - p_adopted), (double)(work - p_work) / (double)fq.QuadPart);
+        p_built = built; p_used = used; p_work = work; p_paused = paused; p_adopted = adopted;
+    }
+}
+static void ld_prep_stamp(char* out, size_t cap, u32 cfg);
+static void ld_prep_check_stamp(void)
+{
+    /* Prepared for another build, settings or driver than this run's: the next start prepares again. */
+    char path[MAX_PATH], line[1024] = "", now[1024];
+    snprintf(path, sizeof path, "%s\\prepared.txt", g_ld_shader_disk_dir);
+    FILE* f = fopen(path, "r");
+    if (!f) return;
+    if (!fgets(line, sizeof line, f)) line[0] = 0;
+    fclose(f);
+    ld_prep_stamp(now, sizeof now, ld_prep_cfg_now());
+    if (strcmp(line, now) != 0) {
+        DeleteFileA(path);
+        fprintf(stderr, "[shader-prep] the shaders were prepared for another build, settings or graphics driver: "
+                "the next start from the launcher prepares them again\n");
+    }
+}
+static DWORD WINAPI ld_prep_main(LPVOID unused)
+{
+    (void)unused;
+    SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_BELOW_NORMAL);
+    LARGE_INTEGER fq, t0, t1;
+    QueryPerformanceFrequency(&fq); QueryPerformanceCounter(&t0);
+    u32 n_prog = 0;
+    if (ld_prep_load_lists(&s_pl) && ld_prep_table_make(s_pl.n, ld_prep_prog_hint())) {
+        ld_prep_load_programs(&n_prog);
+        s_rec_state = (u8*)calloc(s_pl.n ? s_pl.n : 1u, 1);
+        s_qn = (ld_prep_item*)malloc((s_pl.n ? s_pl.n : 1u) * sizeof *s_qn);
+        s_qhi = (ld_prep_item*)malloc((s_pl.n ? s_pl.n : 1u) * sizeof *s_qhi);
+        s_rec_taken = (volatile LONG*)calloc(s_pl.n ? s_pl.n : 1u, sizeof *s_rec_taken);
+        if (s_rec_state && s_qn && s_qhi && s_rec_taken) {
+            for (u32 i = 0; i < s_pl.n; i++) {
+                ld_prep_link_rec(i, s_pl.r[i].vp_key, 'V');
+                ld_prep_link_rec(i, s_pl.r[i].fp_key, 'P');
+            }
+            const u32 cfg = ld_prep_cfg_now();
+            u32 other = 0;
+            for (u32 i = 0; i < s_pl.n; i++) {
+                ld_prep_item it;
+                if (!ld_prep_usable(&s_pl.r[i], cfg)) { s_rec_state[i] = 2; other++; continue; }
+                if (!ld_prep_rec_ready(i, s_pl.r, &it.vp, &it.fp)) continue;
+                s_rec_state[i] = 1; it.rec = i;
+                if (ld_prep_build_on()) s_qn[s_qn_w++] = it;
+            }
+            s_pst.known = s_pl.n; s_pst.other_settings = other;
+            s_cfg_cur = (LONG)cfg;
+            if (s_pl.v1) ld_prep_rewrite_v1();
+            s_pst.n_prog_file = n_prog;
+            if (ld_prep_scan_on()) ld_scan_index();
+            QueryPerformanceCounter(&t1);
+            fprintf(stderr, "[shader-prep] lists: %u pipelines (%u noted on this PC, %u shipped, %u damaged, %u of an older "
+                    "version), %u programs stored; %u can be made now, %u made under other settings, %u wait for their "
+                    "programs (%.0f ms to read)\n",
+                    s_pl.n, s_pl.own, s_pl.shipped, s_pl.damaged, s_pl.v1, n_prog, s_qn_w, other,
+                    s_pl.n - s_qn_w - other, 1000.0 * (double)(t1.QuadPart - t0.QuadPart) / (double)fq.QuadPart);
+            InterlockedExchange(&s_prep_ready, 1);
+            /* The executable's own programs (GT5 keeps 8 shader containers in its data segment): searched now,
+             * as soon as the lists are read, so they go to build-ahead before the first menu; they need no file
+             * read. The memory scan's first pass would find them too, a few seconds later. */
+            if (ld_prep_scan_on() && s_se_n) {
+                LARGE_INTEGER e0, e1; QueryPerformanceCounter(&e0);
+                uint32_t f = 0, k = 0, v = 0;
+                /* the committed, readable stretches of the image's 32 MB (as the scan pass tells them) */
+                u8* run_lo = NULL;
+                for (u8* a = vm_base + 0x00010000u; a <= vm_base + 0x02000000u;) {
+                    MEMORY_BASIC_INFORMATION mi;
+                    int ok = 0;
+                    u8* end = vm_base + 0x02000000u;
+                    if (a < vm_base + 0x02000000u && VirtualQuery(a, &mi, sizeof mi)) {
+                        end = (u8*)mi.BaseAddress + mi.RegionSize;
+                        if (end > vm_base + 0x02000000u) end = vm_base + 0x02000000u;
+                        ok = mi.State == MEM_COMMIT && !(mi.Protect & (PAGE_GUARD | PAGE_NOACCESS)) &&
+                             (mi.Protect & (PAGE_READONLY | PAGE_READWRITE | PAGE_WRITECOPY | PAGE_EXECUTE_READ |
+                                            PAGE_EXECUTE_READWRITE));
+                    }
+                    if (ok && !run_lo) run_lo = a;
+                    if (!ok && run_lo) {
+                        uint32_t f1 = 0, k1 = 0, v1 = 0;
+                        rsx_shader_prep_scan_guest((uint32_t)(run_lo - vm_base), (uint32_t)(a - run_lo), &f1, &k1, &v1);
+                        f += f1; k += k1; v += v1;
+                        run_lo = NULL;
+                    }
+                    if (a >= vm_base + 0x02000000u) break;
+                    a = end;
+                }
+                QueryPerformanceCounter(&e1);
+                fprintf(stderr, "[shader-prep] the executable's own programs: %u listed ones found (%u vertex), %u known "
+                        "already (%.0f ms)\n", f, v, k, 1000.0 * (double)(e1.QuadPart - e0.QuadPart) / (double)fq.QuadPart);
+            }
+            { HANDLE gt = CreateThread(NULL, 64u << 10, ld_prep_gate_main, NULL, 0, NULL);   /* the game first */
+              if (gt) CloseHandle(gt); }
+            if (ld_prep_scan_on() && s_se_n)
+                s_scan_th = CreateThread(NULL, 1u << 20, ld_prep_scan_main, NULL, 0, NULL);
+        }
+    }
+    if (!InterlockedCompareExchange(&s_prep_ready, 0, 0))
+        fprintf(stderr, "[shader-prep] the lists could not be read: nothing is made ahead this session\n");
+    ld_prep_check_stamp();
+    LONG64 last_sum = -1; int ticks = 0, quiet = 0;
+    for (;;) {
+        Sleep(250);
+        if (InterlockedCompareExchange(&s_prep_ready, 0, 0)) ld_prep_control();
+        if (++ticks % 4) continue;
+        ld_prep_flush();
+        const LONG64 sum = s_pst.noted + s_pst.built + s_pst.used + s_pst.check_diff + s_pst.translate_fail + s_scan_found;
+        if (quiet < 30) quiet++;
+        if (sum != last_sum && quiet >= 30) {
+            quiet = 0; last_sum = sum;
+            fprintf(stderr, "[shader-prep] this session: %lld pipelines noted, %lld programs stored; made ahead %lld shaders "
+                    "(%lld used by draws so far, %lld failed, %lld records for other settings, %lld did not translate, %lld past the cap); "
+                    "programs found in memory %lld (and %lld after their first draw); text check %lld of %lld the same\n",
+                    (long long)s_pst.noted, (long long)s_pst.programs, (long long)s_pst.built, (long long)s_pst.used,
+                    (long long)s_pst.built_fail, (long long)s_pst.other_settings, (long long)s_pst.translate_fail,
+                    (long long)s_pst.full, (long long)s_scan_found, (long long)s_scan_late, (long long)s_pst.check_same,
+                    (long long)(s_pst.check_same + s_pst.check_diff));
+        }
+    }
+}
+static void ld_prep_start(void)
+{
+    static int started;
+    if (started || !ld_prep_on() || !ld_prep_dir()) return;
+    started = 1;
+    HANDLE t = CreateThread(NULL, 1u << 20, ld_prep_main, NULL, 0, NULL);
+    if (t) CloseHandle(t);
+}
+
+/* ---- gt5.exe --prepare-shaders ---------------------------------------------------------------------- *
+ * Run by the installer, the update and the launcher, in the GT5 folder, before the game starts:
+ *  1. every listed pipeline whose programs this PC has, and whose settings kinds are the ones play.bat
+ *     and settings.bat give now, is translated with today's generator;
+ *  2. the shaders the cache lacks are compiled on every logical processor (below normal priority) and
+ *     written as the game writes them, then the pack is rewritten with them;
+ *  3. every one of those pipelines is made once on the GPU the game uses and let go, so the driver keeps
+ *     it in its own disk cache for gt5.exe: measured here (RTX 4070 Ti SUPER, GT5's own 8,523 pipelines,
+ *     tools\psobench), a pipeline the driver has never seen takes 21 ms to make, one it has 0.47 ms;
+ *  4. the pipelines go into the made-ahead list under their new names, so the game makes them at its start.
+ * Progress: "GT5_SHADERS done total" lines on stdout (shaders and pipelines together) and
+ * <cache>\prepare_progress.txt. Safe to stop at any point: each shader is its own file the moment it is
+ * compiled, and the next run (or the game) carries on. When nothing changed since the last full run (the
+ * same gt5.exe, settings, shipped list and graphics driver; the stamp <cache>\prepared.txt, which clearing
+ * the cache removes) it ends at once. The stamp's second line is what the launcher compares before it
+ * starts this at all (gt5.exe, settings.bat, the shipped list: sizes and times). --force: run anyway;
+ * --threads=N: N threads. */
+typedef struct { u32 stage, len; u64 hash; char* src; u8* blob; u32 blob_len; } ld_prep_job;
+static ld_prep_job* s_pj; static volatile LONG s_pj_next, s_pj_done, s_pj_fail; static LONG s_pj_n;
+static char s_pj_cache[MAX_PATH];
+
+/* What the cache holds, by shader_mem_key: a pack entry (header, text, blob), a job of this run, or a
+ * file beside the pack (read when a pipeline needs it). */
+typedef struct { u64 key, hash; u32 stage, len; const u8* entry; s32 job; u32 used; } ld_prep_have;
+#define LD_PREP_HAVE_SLOTS (1u << 20)
+static ld_prep_have* s_have; static u32 s_have_n;
+static ld_prep_have* ld_prep_have_slot(u32 stage, u64 hash, u32 len, int add)
+{
+    const u64 key = shader_mem_key(stage, hash, len);
+    u32 i = (u32)(key ^ (key >> 29)) & (LD_PREP_HAVE_SLOTS - 1u);
+    while (s_have[i].used) {
+        if (s_have[i].key == key && s_have[i].stage == stage && s_have[i].hash == hash && s_have[i].len == len) return &s_have[i];
+        i = (i + 1u) & (LD_PREP_HAVE_SLOTS - 1u);
+    }
+    if (!add || s_have_n >= LD_PREP_HAVE_SLOTS / 2u) return NULL;
+    s_have[i].used = 1; s_have[i].key = key; s_have[i].hash = hash; s_have[i].stage = stage; s_have[i].len = len;
+    s_have[i].entry = NULL; s_have[i].job = -1;
+    s_have_n++;
+    return &s_have[i];
+}
+/* A compiled shader as a blob of the calling thread's own (d3dcompiler's reference counts are not
+ * thread-safe), from wherever the cache has it. */
+static ID3DBlob* ld_prep_blob(u32 stage, u64 hash, u32 len)
+{
+    const ld_prep_have* h = ld_prep_have_slot(stage, hash, len, 0);
+    if (!h) return NULL;
+    const u8* bytes = NULL; u32 n = 0; u8* file = NULL;
+    if (h->job >= 0) { bytes = s_pj[h->job].blob; n = s_pj[h->job].blob_len; }
+    else {
+        const u8* e = h->entry;
+        size_t fn = 0;
+        if (!e) {
+            char path[MAX_PATH];
+            snprintf(path, sizeof path, "%s\\%c_%016llX_%08X.bin", s_pj_cache, (char)stage, (unsigned long long)hash, len);
+            e = file = ld_prep_read_file(path, &fn);
+        }
+        shader_disk_cache_header hd;
+        if (e) {
+            memcpy(&hd, e, sizeof hd);
+            if (hd.magic == SHADER_DISK_CACHE_MAGIC && hd.stage == stage && hd.source_length == len &&
+                hd.blob_length && hd.blob_length <= SHADER_DISK_CACHE_MAX_BLOB &&
+                (!file || (u64)sizeof hd + hd.source_length + hd.blob_length == fn)) {
+                bytes = e + sizeof hd + hd.source_length; n = hd.blob_length;
+            }
+        }
+    }
+    ID3DBlob* b = NULL;
+    if (bytes && n && SUCCEEDED(D3DCreateBlob(n, &b)) && b) memcpy(b->lpVtbl->GetBufferPointer(b), bytes, n);
+    free(file);
+    return b;
+}
+
+static DWORD WINAPI ld_prep_compile_worker(LPVOID unused)
+{
+    (void)unused;
+    SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_BELOW_NORMAL);
+    for (;;) {
+        const LONG i = InterlockedIncrement(&s_pj_next) - 1;
+        if (i >= s_pj_n) return 0;
+        ld_prep_job* j = &s_pj[i];
+        ID3DBlob* blob = NULL; ID3DBlob* err = NULL;
+        /* exactly as ld_cpool_compile */
+        const HRESULT hr = D3DCompile(j->src, j->len, j->stage == 'V' ? "xvs" : "xps", NULL, NULL, "main",
+                                      j->stage == 'V' ? "vs_5_0" : "ps_5_0", 0, 0, &blob, &err);
+        int ok = 0;
+        if (SUCCEEDED(hr) && blob) {
+            const SIZE_T bl = blob->lpVtbl->GetBufferSize(blob);
+            char path[MAX_PATH], tmp[MAX_PATH];
+            snprintf(path, sizeof path, "%s\\%c_%016llX_%08X.bin", s_pj_cache, (char)j->stage,
+                     (unsigned long long)j->hash, j->len);
+            snprintf(tmp, sizeof tmp, "%s.tmp.%lu", path, (unsigned long)GetCurrentThreadId());
+            shader_disk_cache_header h;
+            memset(&h, 0, sizeof h);
+            h.magic = SHADER_DISK_CACHE_MAGIC; h.version = SHADER_DISK_CACHE_VERSION; h.stage = j->stage;
+            h.source_length = j->len; h.blob_length = (u32)bl; h.source_hash = j->hash;
+            FILE* f = bl && bl <= SHADER_DISK_CACHE_MAX_BLOB ? fopen(tmp, "wb") : NULL;
+            if (f) {
+                ok = fwrite(&h, sizeof h, 1, f) == 1 && fwrite(j->src, 1, j->len, f) == j->len &&
+                     fwrite(blob->lpVtbl->GetBufferPointer(blob), 1, bl, f) == bl;
+                ok = (fclose(f) == 0) && ok;
+                if (ok) ok = MoveFileExA(tmp, path, MOVEFILE_REPLACE_EXISTING) != 0;
+                if (!ok) DeleteFileA(tmp);
+            }
+            if (ok && (j->blob = (u8*)malloc(bl)) != NULL) {   /* for the pipelines below */
+                memcpy(j->blob, blob->lpVtbl->GetBufferPointer(blob), bl);
+                j->blob_len = (u32)bl;
+            }
+        }
+        if (!ok) InterlockedIncrement(&s_pj_fail);
+        if (blob) blob->lpVtbl->Release(blob);
+        if (err) err->lpVtbl->Release(err);
+        InterlockedIncrement(&s_pj_done);
+    }
+}
+
+/* The pipelines, made once each and let go (a made pipeline holds about 140 KB of the process's memory). */
+static ld_ahead_rec* s_pp; static LONG s_pp_n; static volatile LONG s_pp_next, s_pp_done, s_pp_fail;
+static volatile LONG64 s_pp_qpc;
+static DWORD WINAPI ld_prep_pso_worker(LPVOID unused)
+{
+    (void)unused;
+    SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_BELOW_NORMAL);
+    for (;;) {
+        const LONG i = InterlockedIncrement(&s_pp_next) - 1;
+        if (i >= s_pp_n) return 0;
+        const ld_ahead_rec* r = &s_pp[i];
+        ID3DBlob* vs = ld_prep_blob('V', r->vs_hash, r->vs_len);
+        ID3DBlob* ps = vs ? ld_prep_blob('P', r->ps_hash, r->ps_len) : NULL;
+        int ok = 0;
+        if (vs && ps) {
+            D3D12_INPUT_ELEMENT_DESC il[16];
+            D3D12_GRAPHICS_PIPELINE_STATE_DESC pd;
+            /* the game's own description of it (ld_fill_pipeline_desc, apply_render_state) */
+            ld_fill_pipeline_desc(&pd, il, vs, ps, &r->rs, (int)r->masked, r->count, r->attrs, (int)r->packed);
+            ID3D12PipelineState* pso = NULL;
+            LARGE_INTEGER c0, c1; QueryPerformanceCounter(&c0);
+            const HRESULT hr = g.dev->lpVtbl->CreateGraphicsPipelineState(g.dev, &pd, &IID_ID3D12PipelineState, (void**)&pso);
+            QueryPerformanceCounter(&c1);
+            InterlockedAdd64(&s_pp_qpc, c1.QuadPart - c0.QuadPart);
+            if (SUCCEEDED(hr) && pso) { ok = 1; pso->lpVtbl->Release(pso); }
+        }
+        if (vs) vs->lpVtbl->Release(vs);
+        if (ps) ps->lpVtbl->Release(ps);
+        if (!ok) InterlockedIncrement(&s_pp_fail);
+        InterlockedIncrement(&s_pp_done);
+    }
+}
+/* The device the game would use (its own choice, ld_create_device), its root signature, and a depth
+ * buffer to stand for the game's (apply_render_state only asks whether there is one). */
+static int ld_create_device(IDXGIFactory4* factory);
+static int make_root_signature(void);
+static int ld_prep_device(void)
+{
+    IDXGIFactory4* f = NULL;
+    if (FAILED(CreateDXGIFactory1(&IID_IDXGIFactory4, (void**)&f)) || !f) return 0;
+    const int ok = ld_create_device(f) == 0 && g.dev;
+    f->lpVtbl->Release(f);
+    if (!ok || make_root_signature() != 0 || !g.rootsig_x) return 0;
+    D3D12_HEAP_PROPERTIES hp; memset(&hp, 0, sizeof hp); hp.Type = D3D12_HEAP_TYPE_DEFAULT;
+    D3D12_RESOURCE_DESC rd; memset(&rd, 0, sizeof rd);
+    rd.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D; rd.Width = 1; rd.Height = 1; rd.DepthOrArraySize = 1;
+    rd.MipLevels = 1; rd.Format = DXGI_FORMAT_D32_FLOAT_S8X24_UINT; rd.SampleDesc.Count = 1;
+    rd.Flags = D3D12_RESOURCE_FLAG_ALLOW_DEPTH_STENCIL;
+    return SUCCEEDED(g.dev->lpVtbl->CreateCommittedResource(g.dev, &hp, D3D12_HEAP_FLAG_NONE, &rd,
+               D3D12_RESOURCE_STATE_DEPTH_WRITE, NULL, &IID_ID3D12Resource, (void**)&g.depth)) && g.depth;
+}
+
+static void ld_prep_progress(const char* path, LONG done, LONG total, int force)
+{
+    static ULONGLONG last;
+    const ULONGLONG now = GetTickCount64();
+    if (!force && now - last < 250u) return;
+    last = now;
+    printf("GT5_SHADERS %ld %ld\n", (long)done, (long)total);
+    fflush(stdout);
+    FILE* f = fopen(path, "w");
+    if (f) { fprintf(f, "%ld %ld\n", (long)done, (long)total); fclose(f); }
+}
+/* The settings play.bat would start the game with: its own `set "NAME=value"` lines, then settings.bat's
+ * (the launcher's), into this process's environment, which ld_prep_cfg_now reads. Lines with a %...% in
+ * their value are left out (none of the keys the settings kinds use has one). */
+static void ld_prep_apply_bat(const char* path)
+{
+    FILE* f = fopen(path, "r");
+    if (!f) return;
+    char line[1024];
+    while (fgets(line, sizeof line, f)) {
+        char* p = line;
+        while (*p == ' ' || *p == '\t') p++;
+        if (_strnicmp(p, "set \"", 5) != 0) continue;
+        p += 5;
+        char* eq = strchr(p, '=');
+        char* end = eq ? strchr(eq, '"') : NULL;
+        if (!eq || !end || eq == p) continue;
+        *eq = 0; *end = 0;
+        if (strchr(eq + 1, '%')) continue;
+        _putenv_s(p, eq + 1);
+    }
+    fclose(f);
+}
+/* What a full run was made for: gt5.exe, the shipped list, the settings kinds and the graphics drivers
+ * (a new driver starts its cache empty). */
+static void ld_prep_stamp(char* out, size_t cap, u32 cfg)
+{
+    char exe[MAX_PATH]; WIN32_FILE_ATTRIBUTE_DATA a, s;
+    memset(&a, 0, sizeof a); memset(&s, 0, sizeof s);
+    if (GetModuleFileNameA(NULL, exe, sizeof exe)) GetFileAttributesExA(exe, GetFileExInfoStandard, &a);
+    const char* sp = getenv("LD_PREP_SHIPPED");
+    GetFileAttributesExA(sp && sp[0] ? sp : LD_PREP_SHIPPED, GetFileExInfoStandard, &s);
+    int n = snprintf(out, cap, "exe %lu-%llu shipped %lu-%llu settings %08X version %u gpu",
+                     (unsigned long)a.nFileSizeLow, (unsigned long long)ld_prep_ft(&a.ftLastWriteTime),
+                     (unsigned long)s.nFileSizeLow, (unsigned long long)ld_prep_ft(&s.ftLastWriteTime), cfg, LD_PREP_VERSION);
+    IDXGIFactory1* f = NULL;
+    if (n > 0 && SUCCEEDED(CreateDXGIFactory1(&IID_IDXGIFactory1, (void**)&f)) && f) {
+        IDXGIAdapter1* ad = NULL;
+        for (UINT i = 0; f->lpVtbl->EnumAdapters1(f, i, &ad) != DXGI_ERROR_NOT_FOUND && n > 0 && (size_t)n < cap; i++) {
+            DXGI_ADAPTER_DESC1 d; LARGE_INTEGER umd; umd.QuadPart = 0;
+            if (SUCCEEDED(ad->lpVtbl->GetDesc1(ad, &d)) && !(d.Flags & DXGI_ADAPTER_FLAG_SOFTWARE)) {
+                ad->lpVtbl->CheckInterfaceSupport(ad, &IID_IDXGIDevice, &umd);
+                n += snprintf(out + n, cap - (size_t)n, " %04X:%04X:%llX", d.VendorId, d.DeviceId,
+                              (unsigned long long)umd.QuadPart);
+            }
+            ad->lpVtbl->Release(ad);
+        }
+        f->lpVtbl->Release(f);
+    }
+    if (n > 0 && (size_t)n + 2 < cap) { out[n] = '\n'; out[n + 1] = 0; }
+}
+/* The launcher's line: what it can look at without starting anything (GT5Launcher.cs, PrepareWanted). */
+static void ld_prep_launcher_line(char* out, size_t cap)
+{
+    char exe[MAX_PATH]; WIN32_FILE_ATTRIBUTE_DATA a, b, s;
+    memset(&a, 0, sizeof a); memset(&b, 0, sizeof b); memset(&s, 0, sizeof s);
+    if (GetModuleFileNameA(NULL, exe, sizeof exe)) GetFileAttributesExA(exe, GetFileExInfoStandard, &a);
+    GetFileAttributesExA("settings.bat", GetFileExInfoStandard, &b);
+    GetFileAttributesExA(LD_PREP_SHIPPED, GetFileExInfoStandard, &s);
+    snprintf(out, cap, "launcher %lu %llu %llu %lu %llu\n",
+             (unsigned long)a.nFileSizeLow, (unsigned long long)ld_prep_ft(&a.ftLastWriteTime),
+             (unsigned long long)ld_prep_ft(&b.ftLastWriteTime), (unsigned long)s.nFileSizeLow,
+             (unsigned long long)ld_prep_ft(&s.ftLastWriteTime));
+}
+static void ld_prep_write_stamp(const char* path, const char* full, const char* launcher)
+{
+    FILE* f = fopen(path, "w");
+    if (f) { fputs(full, f); fputs(launcher, f); fclose(f); }
+}
+
+/* [standin2] The walker, at a frame's end once the stand-in's shaders are asked for (ld_si_frame): the general
+ * stand-in pipeline of every render state and vertex layout this PC's records name, made ahead by the stand-in's own
+ * [standin3] thread, at below-normal priority and only while the game's compile pool is idle (about 1 ms each once
+ * the driver knows the two shaders), so that a new pipeline of a known state finds its stand-in made before its
+ * first frame. Once, when the records are read; only with the variants the cache has. */
+static void ld_si_prebuild(void)
+{
+    static int done;
+    if (done || !InterlockedCompareExchange(&s_prep_ready, 0, 0)) return;
+    done = 1;
+    const u32 cfg = ld_prep_cfg_now();
+    const u32 before = s_sip_n;
+    for (u32 i = 0; i < s_pl.n && s_sip_n * 2u < LD_SIP_SLOTS; i++) {
+        const ld_prep_rec* r = &s_pl.r[i];
+        if (!ld_prep_usable_pso(r, cfg)) continue;
+        if (r->rs.depth_test && r->rs.depth_func == 0x0202u) continue;   /* equal-depth passes use their own form */
+        if ((r->rs.rt_count & 0xFFu) > 1u || (r->rs.rt_count & LD_RT_UPRES)) continue;
+        const int masked = (r->flags & LD_PREP_F_MASKED) != 0;
+        if (masked && !r->layout_count) continue;
+        rsx_si_desc d; memset(&d, 0, sizeof d);
+        d.cube_mask = r->cube_mask; d.vol_mask = r->vol_mask; d.shadow = r->shadow_mask ? r->shadow : NULL;
+        d.mv = (r->flags & LD_PREP_F_MV) != 0;
+        /* [standin3] only with variants the cache has (none is compiled for the records alone) */
+        const int ps = ld_si_var_slot('P', rsx_si_variant_of(&d), 0), vs = ld_si_var_slot('V', d.mv ? 1u : 0u, 0);
+        if (ps < 0 || vs < 0 || !ld_si_var_blob((u32)ps) || !ld_si_var_blob((u32)vs)) continue;
+        rsx_vertex_layout_plan lp; memset(&lp, 0, sizeof lp);
+        if (masked) {
+            lp.mask = r->layout_mask; lp.count = (u8)(r->layout_count < 16u ? r->layout_count : 16u);
+            memcpy(lp.attrs, r->attrs, sizeof lp.attrs);
+        }
+        ld_sip_get(&r->rs, masked ? &lp : NULL, (r->flags & LD_PREP_F_PACKED) != 0, (u32)ps, (u32)vs, 1);
+    }
+    fprintf(stderr, "[shaders] stand-in pipelines made ahead: %u render states and layouts of this PC's records\n",
+            s_sip_n - before);
+}
+
+int rsx_live_draw_prepare_shaders(int argc, char** argv)
+{
+    int force = 0, nt = 0;
+    for (int i = 1; i < argc; i++) {
+        if (!strcmp(argv[i], "--force")) force = 1;
+        else if (!strncmp(argv[i], "--threads=", 10)) nt = atoi(argv[i] + 10);
+    }
+    LARGE_INTEGER fq, t0, t1, t2, t3;
+    QueryPerformanceFrequency(&fq); QueryPerformanceCounter(&t0);
+    /* The settings the next start will have (play.bat's defaults, then the launcher's settings.bat). */
+    ld_prep_apply_bat("play.bat");
+    ld_prep_apply_bat("settings.bat");
+    /* The cache folder, as shader_disk_cache_prepare names it (without starting the game's loaders). */
+    const char* od = getenv("RSX_SHADER_CACHE_DIR");
+    if (od && od[0]) snprintf(s_pj_cache, sizeof s_pj_cache, "%s", od);
+    else { CreateDirectoryA("scratch", NULL);
+           snprintf(s_pj_cache, sizeof s_pj_cache, "scratch\\rsx_shader_cache_v%u", SHADER_DISK_CACHE_VERSION); }
+    CreateDirectoryA(s_pj_cache, NULL);
+    char progress[MAX_PATH], stamp_path[MAX_PATH], stamp[1024], launcher[256], old[1024] = "";
+    snprintf(progress, sizeof progress, "%s\\prepare_progress.txt", s_pj_cache);
+    snprintf(stamp_path, sizeof stamp_path, "%s\\prepared.txt", s_pj_cache);
+    if (!ld_prep_on()) { ld_prep_progress(progress, 0, 0, 1); return 0; }
+    if (!ld_prep_dir()) { fprintf(stderr, "[shader-prep] no folder for the lists\n"); ld_prep_progress(progress, 0, 0, 1); return 1; }
+    const u32 cfg = ld_prep_cfg_compute();
+    ld_prep_stamp(stamp, sizeof stamp, cfg);
+    ld_prep_launcher_line(launcher, sizeof launcher);
+    { FILE* f = fopen(stamp_path, "r"); if (f) { if (!fgets(old, sizeof old, f)) old[0] = 0; fclose(f); } }
+    if (!force && !strcmp(old, stamp)) {
+        ld_prep_write_stamp(stamp_path, stamp, launcher);   /* the launcher's line may be newer (settings.bat saved) */
+        fprintf(stderr, "[shader-prep] prepared already for this build, these settings and this driver\n");
+        ld_prep_progress(progress, 0, 0, 1);
+        return 0;
+    }
+    /* What the cache has: the pack's entries and the files beside it. */
+    s_have = (ld_prep_have*)calloc(LD_PREP_HAVE_SLOTS, sizeof *s_have);
+    if (!s_have) { fprintf(stderr, "[shader-prep] out of memory\n"); return 1; }
+    size_t pack_n = 0;
+    char pack_path[MAX_PATH];
+    snprintf(pack_path, sizeof pack_path, "%s\\pack.bin", s_pj_cache);
+    u8* pack = ld_prep_read_file(pack_path, &pack_n);
+    u32 pack_count = 0;
+    if (pack && pack_n >= 8) {
+        u32 m; memcpy(&m, pack, 4); memcpy(&pack_count, pack + 4, 4);
+        if (m != SHADER_PACK_MAGIC) pack_count = 0;
+    }
+    { size_t off = 8;
+      for (u32 i = 0; i < pack_count && off + 4 <= pack_n; i++) {
+          u32 size; memcpy(&size, pack + off, 4); off += 4;
+          if (size > pack_n - off) break;
+          u64 key; shader_disk_cache_header hd;
+          if (shader_mem_entry_key(pack + off, size, &key)) {
+              memcpy(&hd, pack + off, sizeof hd);
+              ld_prep_have* h = ld_prep_have_slot(hd.stage, hd.source_hash, hd.source_length, 1);
+              if (h && !h->entry) h->entry = pack + off;
+          }
+          off += size;
+      } }
+    { char pat[MAX_PATH]; WIN32_FIND_DATAA fd;
+      snprintf(pat, sizeof pat, "%s\\*_*.bin", s_pj_cache);
+      HANDLE fh = FindFirstFileA(pat, &fd);
+      if (fh != INVALID_HANDLE_VALUE) {
+          do {
+              char st = 0; unsigned long long h = 0; unsigned len = 0;
+              if (sscanf(fd.cFileName, "%c_%16llX_%8X.bin", &st, &h, &len) == 3 && (st == 'V' || st == 'P'))
+                  ld_prep_have_slot((u32)(u8)st, (u64)h, len, 1);
+          } while (FindNextFileA(fh, &fd));
+          FindClose(fh);
+      } }
+    const u32 n_cached = s_have_n;
+    /* The lists and the programs. */
+    if (!ld_prep_load_lists(&s_pl) || !ld_prep_table_make(s_pl.n, ld_prep_prog_hint())) {
+        fprintf(stderr, "[shader-prep] the lists could not be read\n");
+        ld_prep_progress(progress, 0, 0, 1);
+        return 1;
+    }
+    u32 n_prog = 0;
+    ld_prep_load_programs(&n_prog);
+    /* 1. Translate, collect the missing texts and the made-ahead records. */
+    static char vs[256 * 1024], ps[256 * 1024];
+    u32 cap_jobs = 4096u, n_ahead = 0, n_ready = 0, n_other = 0, n_fail = 0, n_wait = 0;
+    s_pj = (ld_prep_job*)calloc(cap_jobs, sizeof *s_pj);
+    s_pp = (ld_ahead_rec*)malloc(((size_t)s_pl.n + 1u) * sizeof *s_pp);
+    if (!s_pj || !s_pp) { fprintf(stderr, "[shader-prep] out of memory\n"); return 1; }
+    /* Oldest first, so the PC's newest pipelines end up last in the made-ahead list (the ones it keeps):
+     * the shipped records (s_pl.r[own..n), in file order), then the PC's own (s_pl.r[0..own) is newest
+     * first, so from own - 1 down to 0). */
+    for (u32 step = 0; step < s_pl.n; step++) {
+        const u32 i = step < s_pl.n - s_pl.own ? s_pl.own + step : s_pl.n - 1u - step;
+        const ld_prep_rec* r = &s_pl.r[i];
+        ld_prep_prog* vp = NULL; ld_prep_prog* fp = NULL;
+        if (!ld_prep_usable(r, cfg)) { n_other++; continue; }
+        if (!ld_prep_rec_ready(i, s_pl.r, &vp, &fp)) { n_wait++; continue; }
+        if (!ld_prep_translate(r, vp->bytes, fp->bytes, vs, sizeof vs, ps, sizeof ps)) { n_fail++; continue; }
+        n_ready++;
+        u64 hv = 0, hp = 0; u32 lv = 0, lp = 0;
+        int ok = 1;
+        for (int k = 0; k < 2 && ok; k++) {
+            const char* src = k ? ps : vs;
+            const u32 stage = k ? 'P' : 'V';
+            const u32 len = (u32)strlen(src);
+            const u64 h = fnv1a(src, len, 1469598103934665603ull);
+            if (k) { hp = h; lp = len; } else { hv = h; lv = len; }
+            if (ld_prep_have_slot(stage, h, len, 0)) continue;   /* cached (or already a job of this run) */
+            if ((u32)s_pj_n == cap_jobs) {
+                ld_prep_job* p = (ld_prep_job*)realloc(s_pj, (size_t)cap_jobs * 2u * sizeof *s_pj);
+                if (!p) { ok = 0; break; }
+                memset(p + cap_jobs, 0, (size_t)cap_jobs * sizeof *p);
+                s_pj = p; cap_jobs *= 2u;
+            }
+            char* copy = (char*)malloc(len + 1u);
+            ld_prep_have* hs = copy ? ld_prep_have_slot(stage, h, len, 1) : NULL;
+            if (!hs) { free(copy); ok = 0; break; }
+            memcpy(copy, src, len + 1u);
+            hs->job = (s32)s_pj_n;
+            s_pj[s_pj_n].stage = stage; s_pj[s_pj_n].len = len; s_pj[s_pj_n].hash = h; s_pj[s_pj_n].src = copy;
+            s_pj_n++;
+        }
+        if (ok && ld_prep_usable_pso(r, cfg))
+            ld_ahead_rec_fill(&s_pp[n_ahead++], hv, lv, hp, lp, &r->rs, (r->flags & LD_PREP_F_MASKED) ? 1u : 0u,
+                              r->layout_count, r->attrs, (r->flags & LD_PREP_F_PACKED) ? 1u : 0u);
+    }
+    /* [standin2] The stand-in's own shaders (rsx_standin_d3d12.inc): the built-in list of pixel variants, every other
+     * one these records need, and both vertex ones, so that the game reads them from the cache at its first frame
+     * instead of compiling them (counted in GT5_SHADERS done / total like every shader of this step). */
+    { u64 vars[160]; u32 nv = 0, added = 0;
+      { const u64* bl; const u32 bn = rsx_si_builtin_variants(&bl);   /* [standin4] the built-in list first: also */
+        for (u32 k = 0; k < bn && nv < 128u; k++) vars[nv++] = bl[k]; }   /* on a PC with no records */
+      for (u32 i = 0; i < s_pl.n && nv < 158u; i++) {
+          const ld_prep_rec* r = &s_pl.r[i];
+          if (!ld_prep_usable(r, cfg)) continue;
+          rsx_si_desc d; memset(&d, 0, sizeof d);
+          d.cube_mask = r->cube_mask; d.vol_mask = r->vol_mask; d.shadow = r->shadow_mask ? r->shadow : NULL;
+          d.mv = (r->flags & LD_PREP_F_MV) != 0;
+          const u64 v = rsx_si_variant_of(&d);
+          u32 k = 0; while (k < nv && vars[k] != v) k++;
+          if (k == nv) vars[nv++] = v;
+      }
+      static char sisrc[96 * 1024];
+      for (u32 k = 0; k < nv + 2u; k++) {
+          const u32 stage = k < nv ? 'P' : 'V';
+          const u32 len = k < nv ? rsx_si_variant_source(vars[k], sisrc, sizeof sisrc)
+                                 : rsx_si_vp_source((int)(k - nv), sisrc, sizeof sisrc);
+          if (!len) continue;
+          const u64 h = fnv1a(sisrc, len, 1469598103934665603ull);
+          if (ld_prep_have_slot(stage, h, len, 0)) continue;   /* cached already */
+          if ((u32)s_pj_n == cap_jobs) {
+              ld_prep_job* q = (ld_prep_job*)realloc(s_pj, (size_t)cap_jobs * 2u * sizeof *s_pj);
+              if (!q) break;
+              memset(q + cap_jobs, 0, (size_t)cap_jobs * sizeof *q);
+              s_pj = q; cap_jobs *= 2u;
+          }
+          char* copy = (char*)malloc(len + 1u);
+          ld_prep_have* hs = copy ? ld_prep_have_slot(stage, h, len, 1) : NULL;
+          if (!hs) { free(copy); break; }
+          memcpy(copy, sisrc, len + 1u);
+          hs->job = (s32)s_pj_n;
+          s_pj[s_pj_n].stage = stage; s_pj[s_pj_n].len = len; s_pj[s_pj_n].hash = h; s_pj[s_pj_n].src = copy;
+          s_pj_n++; added++;
+      }
+      fprintf(stderr, "[shader-prep] the stand-in's shaders: %u variants, %u to compile\n", nv + 2u, added); }
+    s_pp_n = (LONG)n_ahead;
+    QueryPerformanceCounter(&t1);
+    fprintf(stderr, "[shader-prep] %u pipelines listed (%u noted on this PC, %u shipped, %u of an older version), %u programs "
+            "stored: %u translated (%u did not), %u wait for programs, %u were made under other settings; %ld shaders to "
+            "compile (%u in the cache), %.1f s\n",
+            s_pl.n, s_pl.own, s_pl.shipped, s_pl.v1, n_prog, n_ready, n_fail, n_wait, n_other, (long)s_pj_n, n_cached,
+            (double)(t1.QuadPart - t0.QuadPart) / (double)fq.QuadPart);
+    /* 2. Compile on every logical processor (the PC stays usable: below normal priority). */
+    if (nt <= 0) { SYSTEM_INFO si; GetSystemInfo(&si); nt = (int)si.dwNumberOfProcessors; }
+    if (nt > 64) nt = 64;
+    if (nt < 1) nt = 1;
+    const LONG total = s_pj_n + s_pp_n;
+    ld_prep_progress(progress, 0, total, 1);
+    HANDLE th[64]; int started = 0;
+    for (int k = 0; k < nt && k < s_pj_n; k++) {
+        th[started] = CreateThread(NULL, 1u << 20, ld_prep_compile_worker, NULL, 0, NULL);
+        if (th[started]) started++;
+    }
+    if (!started && s_pj_n) ld_prep_compile_worker(NULL);
+    while (started && WaitForMultipleObjects((DWORD)started, th, TRUE, 250) == WAIT_TIMEOUT)
+        ld_prep_progress(progress, s_pj_done, total, 0);
+    for (int k = 0; k < started; k++) CloseHandle(th[k]);
+    const int compile_threads = started ? started : 1;
+    QueryPerformanceCounter(&t2);
+    /* The pack again: the old one's entries and this run's shaders (the next start reads it whole). */
+    int pack_ok = 1;
+    if (s_pj_n > s_pj_fail) {
+        char tmp[MAX_PATH];
+        snprintf(tmp, sizeof tmp, "%s.tmp.%lu", pack_path, (unsigned long)GetCurrentProcessId());
+        FILE* o = fopen(tmp, "wb");
+        pack_ok = o != NULL;
+        u32 count = 0;
+        if (o) {
+            const u32 m = SHADER_PACK_MAGIC;
+            pack_ok = fwrite(&m, 4, 1, o) == 1 && fwrite(&count, 4, 1, o) == 1;
+            size_t off = 8;
+            for (u32 i = 0; pack_ok && i < pack_count && off + 4 <= pack_n; i++) {
+                u32 size; memcpy(&size, pack + off, 4);
+                if (size > pack_n - off - 4) break;
+                pack_ok = fwrite(pack + off, 1, 4u + size, o) == 4u + size;
+                off += 4u + size; count++;
+            }
+            for (LONG i = 0; pack_ok && i < s_pj_n; i++) {
+                const ld_prep_job* j = &s_pj[i];
+                if (!j->blob) continue;
+                shader_disk_cache_header h;
+                memset(&h, 0, sizeof h);
+                h.magic = SHADER_DISK_CACHE_MAGIC; h.version = SHADER_DISK_CACHE_VERSION; h.stage = j->stage;
+                h.source_length = j->len; h.blob_length = j->blob_len; h.source_hash = j->hash;
+                const u32 size = (u32)sizeof h + j->len + j->blob_len;
+                pack_ok = fwrite(&size, 4, 1, o) == 1 && fwrite(&h, sizeof h, 1, o) == 1 &&
+                          fwrite(j->src, 1, j->len, o) == j->len && fwrite(j->blob, 1, j->blob_len, o) == j->blob_len;
+                count++;
+            }
+            if (pack_ok) pack_ok = _fseeki64(o, 4, SEEK_SET) == 0 && fwrite(&count, 4, 1, o) == 1;
+            pack_ok = (fclose(o) == 0) && pack_ok;
+            if (pack_ok) pack_ok = MoveFileExA(tmp, pack_path, MOVEFILE_REPLACE_EXISTING) != 0;
+            if (!pack_ok) DeleteFileA(tmp);
+        }
+    }
+    /* 3. The pipelines, once each, on the GPU the game uses. */
+    int pso_threads = 0, have_dev = 0;
+    if (s_pp_n && (have_dev = ld_prep_device()) != 0) {
+        for (int k = 0; k < nt && k < s_pp_n; k++) {
+            th[pso_threads] = CreateThread(NULL, 1u << 20, ld_prep_pso_worker, NULL, 0, NULL);
+            if (th[pso_threads]) pso_threads++;
+        }
+        if (!pso_threads) ld_prep_pso_worker(NULL);
+        while (pso_threads && WaitForMultipleObjects((DWORD)pso_threads, th, TRUE, 250) == WAIT_TIMEOUT)
+            ld_prep_progress(progress, s_pj_done + s_pp_done, total, 0);
+        for (int k = 0; k < pso_threads; k++) CloseHandle(th[k]);
+    } else if (s_pp_n) fprintf(stderr, "[shader-prep] no graphics device: the pipelines are left to the game\n");
+    ld_prep_progress(progress, total, total, 1);
+    QueryPerformanceCounter(&t3);
+    free(pack);   /* the pipelines read their shaders from it */
+    /* 4. The made-ahead list: its records, then these (the newest are the ones the game keeps and makes). */
+    { char lst[MAX_PATH], tmp[MAX_PATH]; size_t n = 0;
+      snprintf(lst, sizeof lst, "%s\\pipelines_d3d12.lst", s_pj_cache);
+      snprintf(tmp, sizeof tmp, "%s.tmp.%lu", lst, (unsigned long)GetCurrentProcessId());
+      u8* old_l = ld_prep_read_file(lst, &n);
+      FILE* o = n_ahead ? fopen(tmp, "wb") : NULL;
+      int ok = o != NULL;
+      if (o) {
+          const size_t whole = n - n % sizeof(ld_ahead_rec);
+          if (old_l && whole) ok = fwrite(old_l, 1, whole, o) == whole;
+          if (ok) ok = fwrite(s_pp, sizeof *s_pp, n_ahead, o) == n_ahead;
+          ok = (fclose(o) == 0) && ok;
+          if (ok) ok = MoveFileExA(tmp, lst, MOVEFILE_REPLACE_EXISTING) != 0;
+          if (!ok) DeleteFileA(tmp);
+      }
+      free(old_l); }
+    const int complete = s_pj_fail == 0 && pack_ok;
+    if (complete) ld_prep_write_stamp(stamp_path, stamp, launcher);
+    fprintf(stderr, "[shader-prep] compiled %ld of %ld shaders on %d threads in %.1f s (%ld failed); "
+            "%ld of %ld pipelines made on %d threads in %.1f s (%.1f s in the driver, %ld failed)%s; "
+            "%u pipelines into the made-ahead list%s\n",
+            (long)s_pj_done - (long)s_pj_fail, (long)s_pj_n, compile_threads,
+            (double)(t2.QuadPart - t1.QuadPart) / (double)fq.QuadPart, (long)s_pj_fail,
+            (long)s_pp_done - (long)s_pp_fail, (long)s_pp_n, pso_threads ? pso_threads : (have_dev ? 1 : 0),
+            (double)(t3.QuadPart - t2.QuadPart) / (double)fq.QuadPart, (double)s_pp_qpc / (double)fq.QuadPart,
+            (long)s_pp_fail, have_dev ? "" : " (no device)", n_ahead,
+            complete ? "" : "; not all done: the next run carries on");
+    return complete ? 0 : 1;
+}
diff --git a/libs/video/rsx_standin_d3d12.inc b/libs/video/rsx_standin_d3d12.inc
new file mode 100644
--- /dev/null
+++ b/libs/video/rsx_standin_d3d12.inc
@@ -0,0 +1,686 @@
+/*
+ * [standin] DirectX 12 side of the stand-in (rsx_standin.c, rsx_standin_fp.hlsl, rsx_standin_vp.hlsl). #included by
+ * rsx_live_draw.c after the compile pool's code (.inc: every .c in libs/video is built on its own).
+ *
+ * With "Asynchronous shader loading" on, a draw whose pipeline is still being made was left out (or, for draws
+ * other draws read, waited for). Now such a draw is drawn by a stand-in: one general vertex shader that runs the
+ * RSX vertex program from its words and one general pixel shader that runs the fragment program from its words,
+ * both as rsx_vp/fp_decompiler.c translate them, with the draw's own render state and vertex layout.
+ * [standin2] Since both shaders are general, the stand-in pipeline depends only on the render state, the vertex
+ * layout and the shaders' variants (texture unit kinds, motion vectors, depth comparison), not on the programs: one
+ * pipeline serves every new pipeline of that state, made once (about 1 ms of the driver, on the pool's fast queue)
+ * and kept; a new pipeline needs NO compile at all to have its stand-in. Round 1 used the draw's own vertex shader,
+ * which needed the vertex shader compiled first and a pipeline of its own for every new pipeline (36 ms each in the
+ * driver with a vertex shader new to it, on the same pool threads as the real compiles: more left out, for longer).
+ * A depth-EQUAL pass keeps that per-pipeline form when its own vertex shader is compiled (positions then bit for bit
+ * the real ones; the general one matches them bit for bit in 92 % of the recorded programs and within one ulp in
+ * the rest, which is fine everywhere but against an equal-depth test), and is left out otherwise.
+ * The walker writes, for each draw, the programs and their translation inputs after the draw's own pixel constants
+ * (256-aligned, same ring allocation); the recording thread points b1 (visible to both stages) at that block for the
+ * one draw it draws with the stand-in. Draws that wait keep waiting (LD_STANDIN_PRODUCERS=1: the stand-in takes
+ * those too). What the stand-in cannot do exactly is refused, counted by reason, and left to the old rule.
+ * Switches: LD_STANDIN=0 off (as before); LD_STANDIN_ALL=1 every draw the stand-in accepts is drawn with it, ready
+ * or not (picture check); LD_STANDIN_PRODUCERS=1 also the draws that wait; LD_STANDIN_MAX_OPS=<n> no stand-in for
+ * fragment programs longer than n (its pixel cost: about 0.06 ms per instruction per 1080p screen it covers).
+ */
+#include "rsx_standin.h"
+
+enum { LD_CT_SI = 3, LD_CT_SIP = 4 };
+/* Pipeline-level refusals beyond rsx_standin.h's (RSX_SI_R_*), and the draw-level one. */
+enum { LD_SIR_VSNEW = RSX_SI_R_N, LD_SIR_VARIANT, LD_SIR_DEBUG, LD_SIR_MEMORY, LD_SIR_FAILED, LD_SIR_NOTREADY, LD_SIR_LONG,
+       LD_SIR_EQUAL, LD_SIR_NOATTR, LD_SIR_N };
+static const char* ld_si_reason(u32 r)
+{
+    switch (r) {
+    case LD_SIR_VSNEW:    return "vertex shader not compiled";
+    case LD_SIR_VARIANT:  return "its shader not ready yet";
+    case LD_SIR_DEBUG:    return "debug edits";
+    case LD_SIR_MEMORY:   return "out of memory";
+    case LD_SIR_FAILED:   return "pipeline failed";
+    case LD_SIR_NOTREADY: return "stand-in not ready yet";
+    case LD_SIR_LONG:     return "program longer than LD_STANDIN_MAX_OPS";
+    case LD_SIR_EQUAL:    return "depth-equal pass, vertex shader new";
+    case LD_SIR_NOATTR:   return "no vertex attributes";
+    default:              return rsx_si_reason_name(r);
+    }
+}
+
+/* [standin2] A general stand-in pipeline: both shaders general, one per (render state, layout, variants). */
+typedef struct ld_sip {
+    ld_ctask task;                      /* LD_CT_SIP on the pool's fast queue */
+    volatile LONG done;                 /* made (pso set) or failed (pso NULL) */
+    ID3D12PipelineState* pso;
+    struct ld_sip* next_bg;             /* [standin3] in the stand-in thread's list (s_sibg_lock's) */
+    int ahead;                          /* made ahead from the records only: when the game's pool is idle */
+    u64 key;
+    u32 ps_var, vs_var;                 /* slots in s_si_var */
+    render_state_t rs;
+    u32 masked, count, packed;
+    u8 attrs[RSX_DSP_NUM_VERTEX_ATTR];
+} ld_sip;
+/* One new pipeline's stand-in: its programs as micro-ops, and which pipeline draws it. */
+typedef struct ld_si {
+    ld_ctask task;                      /* LD_CT_SI: only for the own-vertex-shader form (depth-EQUAL passes) */
+    volatile LONG done;
+    ID3D12PipelineState* pso;           /* the own-vertex-shader form's pipeline */
+    ID3DBlob* vs;                       /* its own copy of the vertex shader, released once built */
+    ld_sip* gen;                        /* the general form's shared pipeline, or NULL */
+    u32 var;                            /* the pixel variant's slot */
+    render_state_t rs;
+    u32 masked, count, packed;
+    u8 attrs[RSX_DSP_NUM_VERTEX_ATTR];
+    rsx_si_state st;
+    u32 n_ops, n_slots, n_regs, rows;   /* rows: the whole block (pixel part, then the vertex part) */
+    u32 vn_ops, vpresent, vtex, vat;    /* the vertex part: micro-ops, inputs read, vertex textures, its first row */
+    rsx_si_op* vops;                    /* vn_ops, after ops[] */
+    rsx_si_op ops[];                    /* n_ops, then the vertex micro-ops */
+} ld_si;
+
+static struct {
+    int on, all, producers, said;
+    u32 max_ops;
+    int started;
+    LONGLONG t0;                        /* when the base variants were asked for */
+    int ready_said;
+} s_si = { -1, 0, 0, 0, 0, 0, 0, 0 };
+/* Shader variants (stage 'P': unit kinds, motion vectors, depth comparison; 'V': motion vectors): the walker's
+ * table. Each is an ordinary shader to the pool and the shader cache (0.7-2 s of fxc once a PC, then read; the
+ * prepare step makes the ones this PC's records need before the game starts). */
+#define LD_SI_MAX_VAR 128u                     /* [standin4] the built-in list (44) and what records or draws add */
+/* [standin3] state: 0 not in the cache and no draw needs it yet, 1 to compile (a draw needs it), 2 ready, 3 failed,
+ * 4 being compiled, 5 [standin4] to compile ahead (the built-in list, the cache lacks it; below-normal priority).
+ * The walker makes a slot (looked up in the cache's memory only once its loader is done, so the shaders a former
+ * session compiled are found: round 2 asked while the folder's own files were still being listed and compiled them
+ * again at every start); the stand-in thread compiles, one at a time, never on the game's compile pool. */
+static struct { u64 v; u32 stage; volatile LONG state; ID3DBlob* volatile blob; char* src; u32 len; u64 hash; } s_si_var[LD_SI_MAX_VAR];
+static volatile LONG s_si_nvar;
+static volatile LONG s_si_warm[LD_SI_MAX_VAR][LD_SI_MAX_VAR];   /* the driver has made a pipeline of this pair */
+static SRWLOCK s_sibg_lock = SRWLOCK_INIT;
+static ld_sip* s_sibg_head;                                       /* pipelines for the stand-in thread */
+static HANDLE s_sibg_wake;
+static volatile LONG64 s_si_var_read, s_si_var_compiled, s_si_var_qpc, s_si_bg_made, s_si_bg_qpc, s_si_wait_qpc;
+static volatile LONG64 s_si_wait_real, s_si_wait_kept;   /* [standin5] must-wait draws left to the real pipeline */
+/* General pipelines by key (the walker's table; the objects live as long as the process). */
+#define LD_SIP_SLOTS 4096u
+static ld_sip* s_sip[LD_SIP_SLOTS];
+static u32 s_sip_n;
+/* What get_pso hands to the next ld_async_build (the walker's alone). */
+static struct {
+    int valid;
+    const u8* fp; u32 fp_size;
+    rsx_si_desc d;
+    const u8* vp; u32 vp_bytes, vp_start, vp_bits, vtex, compact, layout_mask;
+} s_si_in;
+/* The draw being recorded: its stand-in and where its block went in the pixel constants (0: none). */
+static ld_si* s_si_draw;
+static u32 s_si_draw_off;
+/* Counters for the [stutter] line. */
+static volatile LONG64 s_si_drawn, s_si_drawn_wait, s_si_refused[LD_SIR_N], s_si_made, s_si_made_qpc, s_si_psos, s_si_got;
+static volatile LONG64 s_si_bytes;
+
+static int ld_si_on(void)
+{
+    if (s_si.on < 0) {
+        const char* e = getenv("LD_STANDIN");
+        s_si.on = !(e && atoi(e) == 0);
+        e = getenv("LD_STANDIN_ALL");
+        s_si.all = s_si.on && e && atoi(e) != 0;
+        e = getenv("LD_STANDIN_PRODUCERS");
+        s_si.producers = s_si.on && !(e && *e && atoi(e) == 0);   /* [standin5] on by default; 0 = as before */
+        /* The stand-in costs about 0.06 ms per instruction of the program per 1080p screen it covers (this PC's
+         * RTX 4070 Ti SUPER; 300-instruction car materials 18-43 ms a full screen): a limit for slow GPUs / 4K. */
+        e = getenv("LD_STANDIN_MAX_OPS");
+        s_si.max_ops = e && atoi(e) > 0 ? (u32)atoi(e) : 0u;
+    }
+    return s_si.on;
+}
+
+/* The walker: a variant's slot, or -1. need: a draw's stand-in uses it (compiled if the cache lacks it); 0: only
+ * looked up (the records' made-ahead pipelines use only what the cache has). */
+static int ld_si_var_slot(u32 stage, u64 v, int need)
+{
+    const u32 nv = (u32)s_si_nvar;
+    for (u32 i = 0; i < nv; i++)
+        if (s_si_var[i].v == v && s_si_var[i].stage == stage) {
+            if (need && (InterlockedCompareExchange(&s_si_var[i].state, 1, 0) == 0 ||
+                         InterlockedCompareExchange(&s_si_var[i].state, 1, 5) == 5) && s_sibg_wake)
+                SetEvent(s_sibg_wake);           /* needed now: ahead of the built-in list's */
+            return (int)i;
+        }
+    if (nv >= LD_SI_MAX_VAR) return -1;
+    static char src[96 * 1024];
+    const u32 n = stage == 'V' ? rsx_si_vp_source((int)(v & 1u), src, sizeof src) : rsx_si_variant_source(v, src, sizeof src);
+    if (!n) return -1;
+    const u64 h = fnv1a(src, n, 1469598103934665603ull);
+    s_si_var[nv].v = v; s_si_var[nv].stage = stage; s_si_var[nv].len = n; s_si_var[nv].hash = h;
+    ID3DBlob* blob = shader_disk_cache_load(stage, src, n, h);   /* memory only: the loader is done */
+    if (blob) {
+        s_si_var[nv].blob = blob;                 /* the walker's reference, kept for the run */
+        s_si_var[nv].state = 2;
+        InterlockedIncrement64(&s_si_var_read);
+    } else {
+        s_si_var[nv].src = (char*)malloc(n + 1u);
+        if (!s_si_var[nv].src) return -1;
+        memcpy(s_si_var[nv].src, src, n + 1u);
+        s_si_var[nv].state = need ? 1 : 0;
+    }
+    InterlockedExchange(&s_si_nvar, (LONG)nv + 1);   /* published: the stand-in thread may look at it now */
+    if (s_si_var[nv].state == 1 && s_sibg_wake) SetEvent(s_sibg_wake);
+    return (int)nv;
+}
+/* Any thread: the variant's compiled shader, or NULL. */
+static ID3DBlob* ld_si_var_blob(u32 slot)
+{
+    if (slot >= LD_SI_MAX_VAR || InterlockedCompareExchange(&s_si_var[slot].state, 0, 0) != 2) return NULL;
+    return s_si_var[slot].blob;
+}
+static int ld_si_var_failed(u32 slot)
+{
+    return slot >= LD_SI_MAX_VAR || InterlockedCompareExchange(&s_si_var[slot].state, 0, 0) == 3;
+}
+
+static void ld_si_prebuild(void);              /* rsx_shader_prep.inc */
+static ld_sip* ld_sip_get(const render_state_t* rs, const rsx_vertex_layout_plan* masked_layout, int packed_offsets,
+                          u32 ps_var, u32 vs_var, int ahead);
+static void ld_si_build(struct ld_si* any);
+/* [standin3] The stand-in's threads: two, never the game's compile pool. In this order: a variant a draw's
+ * stand-in needs (normal priority: a screen's few variants are the cheapest way to have everything on it), a
+ * draw's pipeline whose variant pair the driver has not made yet (its first one costs the driver 0.2-0.45 s: not
+ * on the game's pool); then, at below-normal priority and only while the game's pool has nothing queued or
+ * running, the records' made-ahead pipelines. A stand-in whose pipeline is not made yet is simply not ready (its
+ * draws are left out as without it): nothing waits for one. */
+static int ld_si_pool_idle(void)
+{
+    return !s_cpool_head && !s_cpool_hi_head && InterlockedCompareExchange(&s_cp_running, 0, 0) == 0;
+}
+/* One variant from state `from` (1 needed, 5 ahead): claimed, compiled, stored in the cache, published. */
+static int ld_si_bg_compile(LONG from, int priority)
+{
+    const u32 nv = (u32)InterlockedCompareExchange(&s_si_nvar, 0, 0);
+    for (u32 i = 0; i < nv; i++) {
+        if (InterlockedCompareExchange(&s_si_var[i].state, 4, from) != from) continue;   /* claimed: 4 = compiling */
+        SetThreadPriority(GetCurrentThread(), priority);
+        LARGE_INTEGER c0, c1; QueryPerformanceCounter(&c0);
+        ID3DBlob* blob = NULL; ID3DBlob* err = NULL;
+        const HRESULT hr = D3DCompile(s_si_var[i].src, s_si_var[i].len, s_si_var[i].stage == 'V' ? "xvs" : "xps", NULL,
+                                      NULL, "main", s_si_var[i].stage == 'V' ? "vs_5_0" : "ps_5_0", 0, 0, &blob, &err);
+        if (err) err->lpVtbl->Release(err);
+        if (SUCCEEDED(hr) && blob) {
+            shader_disk_cache_store(s_si_var[i].stage, s_si_var[i].src, s_si_var[i].len, s_si_var[i].hash, blob);
+            s_si_var[i].blob = blob;              /* this thread's reference, kept for the run */
+            InterlockedExchange(&s_si_var[i].state, 2);
+            InterlockedIncrement64(&s_si_var_compiled);
+        } else {
+            if (blob) blob->lpVtbl->Release(blob);
+            InterlockedExchange(&s_si_var[i].state, 3);
+        }
+        QueryPerformanceCounter(&c1);
+        InterlockedAdd64(&s_si_var_qpc, c1.QuadPart - c0.QuadPart);
+        InterlockedAdd64(&s_si_bg_qpc, c1.QuadPart - c0.QuadPart);
+        return 1;
+    }
+    return 0;
+}
+/* One pipeline of the list whose variants are there (or failed): ahead 0 = a draw's, 1 = made ahead. */
+static int ld_si_bg_pipeline(int ahead)
+{
+    ld_sip* take = NULL;
+    AcquireSRWLockExclusive(&s_sibg_lock);
+    for (ld_sip** pp = &s_sibg_head; *pp; pp = &(*pp)->next_bg) {
+        ld_sip* q = *pp;
+        if ((q->ahead != 0) != (ahead != 0)) continue;
+        const int failed = ld_si_var_failed(q->ps_var) || ld_si_var_failed(q->vs_var);
+        if (!failed && !(ld_si_var_blob(q->ps_var) && ld_si_var_blob(q->vs_var))) continue;
+        *pp = q->next_bg; q->next_bg = NULL; take = q;
+        break;
+    }
+    ReleaseSRWLockExclusive(&s_sibg_lock);
+    if (!take) return 0;
+    SetThreadPriority(GetCurrentThread(), ahead ? THREAD_PRIORITY_BELOW_NORMAL : THREAD_PRIORITY_NORMAL);
+    LARGE_INTEGER c0, c1; QueryPerformanceCounter(&c0);
+    ld_si_build((struct ld_si*)take);            /* fails cleanly (NULL pipeline) when a variant failed */
+    QueryPerformanceCounter(&c1);
+    InterlockedAdd64(&s_si_bg_qpc, c1.QuadPart - c0.QuadPart);
+    InterlockedIncrement64(&s_si_bg_made);
+    return 1;
+}
+static DWORD WINAPI ld_si_bg_main(LPVOID unused)
+{
+    (void)unused;
+    { HRESULT (WINAPI *sd)(HANDLE, PCWSTR) = (HRESULT (WINAPI*)(HANDLE, PCWSTR))
+          (void*)GetProcAddress(GetModuleHandleA("kernel32.dll"), "SetThreadDescription");
+      if (sd) sd(GetCurrentThread(), L"rsx stand-in"); }
+    for (;;) {
+        WaitForSingleObject(s_sibg_wake, 50);
+        /* One item at a time, each time the most urgent: a variant a draw needs, a draw's pipeline whose pair the
+         * driver has not made yet, [standin4] a variant of the built-in list the cache lacks (below normal), the
+         * made-ahead pipelines (below normal, only while the game's compile pool is idle). */
+        while (ld_si_bg_compile(1, THREAD_PRIORITY_NORMAL) || ld_si_bg_pipeline(0) ||
+               ld_si_bg_compile(5, THREAD_PRIORITY_BELOW_NORMAL) || (ld_si_pool_idle() && ld_si_bg_pipeline(1))) {}
+    }
+}
+/* The walker, at every frame's end (ld_nw_frame). [standin2] The base variants are asked for only once pack.bin is
+ * in memory: asked for earlier (round 1: at the first frame) the cache answered "not cached" while its loader
+ * still read the pack, so they were compiled again at every start. */
+static void ld_si_frame(void)
+{
+    if (!ld_si_on() || s_cpool_state != 1) return;
+    if (!s_si.started) {
+        /* [standin3] only once the cache's loader is done (pack.bin and the folder's own files in memory): the
+         * shaders a former session compiled are loose files until then, and a lookup before it misses them */
+        if (InterlockedCompareExchange(&s_shader_mem_loading, 0, 0)) return;
+        if (!s_sibg_wake) {
+            s_sibg_wake = CreateEventA(NULL, FALSE, FALSE, NULL);
+            /* two threads: a screen's few new variants and pairs side by side (each a second or less, once a PC) */
+            int started = 0;
+            for (int k2 = 0; k2 < 2 && s_sibg_wake; k2++) {
+                HANDLE th = CreateThread(NULL, 1u << 20, ld_si_bg_main, NULL, 0, NULL);
+                if (th) { CloseHandle(th); started++; }
+            }
+            if (!started) { s_si.on = 0; return; }   /* no thread: no stand-in, as before */
+        }
+        s_si.started = 1;
+        LARGE_INTEGER t; QueryPerformanceCounter(&t); s_si.t0 = t.QuadPart;
+        const int p = ld_si_var_slot('P', 0, 1), v = ld_si_var_slot('V', 0, 1);
+        const int vm = ld_si_var_slot('V', 1, 0);  /* the motion-vector vertex variant */
+        /* [standin4] The built-in list (rsx_si_builtin_variants: every variant met on the records of the PC it was
+         * made on, commonest first): read from the cache (the prepare step makes them, also with no records), else
+         * compiled ahead by the stand-in's threads at below-normal priority, after anything a draw needs. And for
+         * each, one pipeline of a plain state, made ahead (below normal, while the game's pool is idle), so that the
+         * driver's one-time cost of the pair (0.2-0.45 s cold) is paid at start, not at the pair's first need. */
+        { const u64* bl; const u32 bn = rsx_si_builtin_variants(&bl);
+          if (vm >= 0) InterlockedCompareExchange(&s_si_var[vm].state, 5, 0);
+          for (u32 k2 = 0; k2 < bn; k2++) {
+              const int sl = ld_si_var_slot('P', bl[k2], 0);
+              if (sl < 0) continue;
+              InterlockedCompareExchange(&s_si_var[sl].state, 5, 0);
+              const int mvv = (bl[k2] >> 32) & 1u;
+              const int vsl = mvv ? vm : v;
+              if (vsl < 0) continue;
+              render_state_t rs0; memset(&rs0, 0, sizeof rs0);
+              rs0.color_mask = 0x01010101u;
+              if (mvv) { rs0.rt_count = LD_RT_MV; rs0.depth_write = 1u; }   /* the variant writes the vectors' target */
+              ld_sip_get(&rs0, NULL, 0, (u32)sl, (u32)vsl, 1);
+          }
+          SetEvent(s_sibg_wake); }
+        fprintf(stderr, "[shaders] stand-in for draws whose pipeline is being made: on (LD_STANDIN=0 off)%s%s; its shaders %s\n",
+                s_si.all ? ", every draw it can take (LD_STANDIN_ALL)" : "",
+                s_si.producers ? ", also draws that wait (LD_STANDIN_PRODUCERS)" : "",
+                p < 0 || v < 0 ? "could not be made" : s_si_var[p].blob && s_si_var[v].blob ? "read from the shader cache"
+                                                                                       : "being compiled");
+    }
+    ld_si_prebuild();                             /* once, when this PC's records are read (rsx_shader_prep.inc) */
+    if (!s_si.ready_said && s_si_nvar >= 2 && ld_si_var_blob(0) && ld_si_var_blob(1)) {
+        s_si.ready_said = 1;
+        LARGE_INTEGER t, f; QueryPerformanceCounter(&t); QueryPerformanceFrequency(&f);
+        fprintf(stderr, "[shaders] stand-in ready %.0f ms after it was asked for (frame %u)\n",
+                (double)(t.QuadPart - s_si.t0) * 1000.0 / (double)f.QuadPart, g_ld_frames);
+    }
+}
+
+/* get_pso, just before build_pso: both programs and every input of their translation. */
+static void ld_si_note(const u8* fp, u32 fp_size, u32 fp_ctrl, u32 cube_mask, u32 vol_mask, const rsx_fp_shadow_desc* shadow,
+                       const u8* gamma, const u8* expand, u32 unnorm_mask, const u32 dim[16][3], u32 srgb, u32 alpha_test,
+                       u32 alpha_func, int wpos_scaled, int wpos_rs, const u32 wpos_grid[2], int mv, u32 rt_count,
+                       const u8* vp, u32 vp_instrs, u32 vp_start, u32 vp_bits, u32 vtex_mask,
+                       const rsx_vertex_layout_plan* masked_layout)
+{
+    s_si_in.valid = 0;
+    if (!ld_si_on() || !s_nw.mode) return;
+    rsx_si_desc* d = &s_si_in.d;
+    memset(d, 0, sizeof *d);
+    s_si_in.fp = fp; s_si_in.fp_size = fp_size;
+    d->fp_ctrl = fp_ctrl; d->cube_mask = cube_mask; d->vol_mask = vol_mask;
+    d->shadow = shadow; d->gamma = gamma; d->expand = expand;
+    d->unnorm_mask = unnorm_mask;
+    memcpy(d->unnorm_dim, dim, sizeof d->unnorm_dim);
+    d->srgb_output = srgb; d->alpha_test = alpha_test; d->alpha_func = alpha_func;
+    d->wpos_mode = wpos_rs ? 2u : wpos_scaled ? 1u : 0u;
+    d->wpos_x = wpos_grid[0]; d->wpos_y = wpos_grid[1];
+    d->mv = mv != 0; d->upres = (rt_count & LD_RT_UPRES) != 0; d->rt_count = rt_count;
+    s_si_in.vp = vp; s_si_in.vp_bytes = vp_instrs * 16u; s_si_in.vp_start = vp_start; s_si_in.vp_bits = vp_bits;
+    s_si_in.vtex = vtex_mask;
+    s_si_in.compact = masked_layout != NULL;
+    s_si_in.layout_mask = masked_layout ? (u32)masked_layout->mask : 0xFFFFu;
+    s_si_in.valid = 1;
+}
+
+/* [standin2] The general pipeline for a (state, layout, variants), made on the fast queue the first time. */
+static ld_sip* ld_sip_get(const render_state_t* rs, const rsx_vertex_layout_plan* masked_layout, int packed_offsets,
+                          u32 ps_var, u32 vs_var, int ahead)
+{
+    struct { render_state_t rs; u32 masked, count, packed, ps_var, vs_var; u8 attrs[RSX_DSP_NUM_VERTEX_ATTR]; } k;
+    memset(&k, 0, sizeof k);
+    k.rs = *rs;
+    k.rs.alpha_test_enable = k.rs.alpha_func = k.rs.alpha_ref_raw = k.rs.alpha_ref_format = 0;   /* in the block */
+    if (masked_layout) {
+        k.masked = 1u; k.count = masked_layout->count < RSX_DSP_NUM_VERTEX_ATTR ? masked_layout->count : RSX_DSP_NUM_VERTEX_ATTR;
+        k.packed = packed_offsets ? 1u : 0u;
+        memcpy(k.attrs, masked_layout->attrs, k.count);
+    }
+    k.ps_var = ps_var; k.vs_var = vs_var;
+    const u64 key = fnv1a(&k, sizeof k, 1469598103934665603ull) | 1u;
+    u32 h = (u32)(key ^ (key >> 32)) & (LD_SIP_SLOTS - 1u);
+    for (; s_sip[h]; h = (h + 1u) & (LD_SIP_SLOTS - 1u)) {
+        ld_sip* p = s_sip[h];
+        if (p->key == key && p->ps_var == ps_var && p->vs_var == vs_var && p->masked == k.masked && p->count == k.count &&
+            p->packed == k.packed && !memcmp(p->attrs, k.attrs, sizeof k.attrs) && ld_rs_desc_same(&p->rs, rs)) {
+            if (!ahead && p->ahead) {             /* a draw needs a made-ahead one now: ahead of the others */
+                AcquireSRWLockExclusive(&s_sibg_lock);
+                p->ahead = 0;
+                ReleaseSRWLockExclusive(&s_sibg_lock);
+                SetEvent(s_sibg_wake);
+            }
+            return p;
+        }
+    }
+    if (s_sip_n * 4u >= LD_SIP_SLOTS * 3u) return NULL;
+    ld_sip* p = (ld_sip*)calloc(1, sizeof *p);
+    if (!p) return NULL;
+    p->task.kind = LD_CT_SIP;
+    p->key = key; p->ps_var = ps_var; p->vs_var = vs_var;
+    p->rs = *rs; p->masked = k.masked; p->count = k.count; p->packed = k.packed;
+    memcpy(p->attrs, k.attrs, sizeof p->attrs);
+    s_sip[h] = p; s_sip_n++;
+    p->ahead = ahead;
+    /* [standin3] On the game's fast queue only when it costs the driver about 1 ms: both variants there and a pipeline
+     * of the pair made before. Else (and every made-ahead one) the stand-in thread's. */
+    if (!ahead && ld_si_var_blob(ps_var) && ld_si_var_blob(vs_var) && InterlockedCompareExchange(&s_si_warm[ps_var][vs_var], 0, 0))
+        ld_cpool_push_hi(&p->task);
+    else {
+        AcquireSRWLockExclusive(&s_sibg_lock);
+        p->next_bg = s_sibg_head; s_sibg_head = p;
+        ReleaseSRWLockExclusive(&s_sibg_lock);
+        SetEvent(s_sibg_wake);
+    }
+    return p;
+}
+
+/* ld_async_build, on the walker, for a pipeline handed to the pool: its stand-in, or NULL (refused, counted).
+ * vsb: the job's own copy of its vertex shader when that is compiled (the depth-EQUAL form uses it). */
+static ld_si* ld_si_attach(ID3DBlob* vsb, const render_state_t* rs, const rsx_vertex_layout_plan* masked_layout,
+                           int packed_offsets)
+{
+    if (!s_si_in.valid || !ld_si_on()) return NULL;
+    s_si_in.valid = 0;
+    InterlockedIncrement64(&s_si_psos);
+    u32 why = 0;
+    static rsx_si_prog prog;                     /* the walker's alone */
+    static rsx_si_vprog vprog;
+    const int equal = rs->depth_test && rs->depth_func == 0x0202u;   /* an equal-depth pass: its own vertex shader */
+    if (!s_si.started) why = LD_SIR_VARIANT;      /* the cache is not read yet: nothing is asked for before that */
+    else if (ld_prep_debug_edits() || getenv("RSX_FP_DEBUG")) why = LD_SIR_DEBUG;
+    else if (!ld_fp_constants_buffered()) why = RSX_SI_R_UNBUFFERED;
+    else if (equal && !vsb) why = LD_SIR_EQUAL;
+    else if (!equal && masked_layout && masked_layout->count == 0) why = LD_SIR_NOATTR;
+    rsx_si_state st; memset(&st, 0, sizeof st);
+    if (!why && rsx_si_encode(s_si_in.fp, s_si_in.fp_size, &prog) < 0) why = prog.refused ? prog.refused : RSX_SI_R_PROGRAM;
+    if (!why) why = rsx_si_desc_check(&prog, &s_si_in.d, &st);
+    if (!why && s_si.max_ops && prog.n_ops > s_si.max_ops) why = LD_SIR_LONG;
+    if (!why && !equal)
+        why = rsx_si_vp_encode(s_si_in.vp, s_si_in.vp_bytes, s_si_in.vp_start, s_si_in.vp_bits, s_si_in.vtex,
+                               s_si_in.compact, s_si_in.layout_mask, &vprog);
+    const u32 vn = equal ? 0u : vprog.n_ops;
+    const u32 rows = rsx_si_block_rows(prog.n_slots, prog.n_ops) + (vn ? rsx_si_vp_block_rows(vn) : 0u);
+    if (!why && rows > RSX_SI_BLOCK_ROWS) why = RSX_SI_R_PROGRAM;
+    int slot = -1, vslot = -1;
+    if (!why && (slot = ld_si_var_slot('P', rsx_si_variant_of(&s_si_in.d), 1)) < 0) why = LD_SIR_MEMORY;
+    if (!why && ld_si_var_failed((u32)slot)) why = LD_SIR_VARIANT;   /* it could not be compiled */
+    if (!why && !equal && (vslot = ld_si_var_slot('V', s_si_in.d.mv ? 1u : 0u, 1)) < 0) why = LD_SIR_MEMORY;
+    ld_si* s = NULL;
+    if (!why) {
+        s = (ld_si*)calloc(1, sizeof *s + ((size_t)prog.n_ops + vn) * sizeof(rsx_si_op));
+        if (!s) why = LD_SIR_MEMORY;
+        else if (equal) {
+            const SIZE_T n = vsb->lpVtbl->GetBufferSize(vsb);
+            if (FAILED(D3DCreateBlob(n, &s->vs)) || !s->vs) { free(s); s = NULL; why = LD_SIR_MEMORY; }
+            else memcpy(s->vs->lpVtbl->GetBufferPointer(s->vs), vsb->lpVtbl->GetBufferPointer(vsb), n);
+        } else if (!(s->gen = ld_sip_get(rs, masked_layout, packed_offsets, (u32)slot, (u32)vslot, 0))) {
+            free(s); s = NULL; why = LD_SIR_MEMORY;
+        }
+    }
+    if (why) {
+        InterlockedIncrement64(&s_si_refused[why < LD_SIR_N ? why : 0]);
+        return NULL;
+    }
+    InterlockedIncrement64(&s_si_got);
+    s->task.kind = LD_CT_SI;
+    s->var = (u32)slot;
+    s->rs = *rs;
+    if (masked_layout) {
+        s->masked = 1u; s->count = masked_layout->count; s->packed = packed_offsets ? 1u : 0u;
+        memcpy(s->attrs, masked_layout->attrs, sizeof s->attrs);
+    }
+    s->st = st;
+    s->n_ops = prog.n_ops; s->n_slots = prog.n_slots; s->n_regs = prog.n_regs;
+    memcpy(s->ops, prog.ops, (size_t)prog.n_ops * sizeof(rsx_si_op));
+    s->vops = s->ops + prog.n_ops;
+    if (vn) {
+        s->vn_ops = vn; s->vpresent = vprog.present; s->vtex = vprog.vtex;
+        s->vat = rsx_si_block_rows(prog.n_slots, prog.n_ops);
+        memcpy(s->vops, vprog.ops, (size_t)vn * sizeof(rsx_si_op));
+    }
+    s->rows = rows;
+    if (equal) {                                  /* the own-vertex-shader form: a pipeline of its own */
+        if (ld_si_var_blob((u32)slot)) ld_cpool_push_hi(&s->task);
+        else {                                    /* its variant is not compiled yet: none for this pipeline */
+            if (s->vs) { s->vs->lpVtbl->Release(s->vs); s->vs = NULL; }
+            InterlockedIncrement64(&s_si_refused[LD_SIR_VARIANT]);
+            ld_cpool_finish(&s->done);
+        }
+    } else ld_cpool_finish(&s->done);             /* the general form: its pipeline is the shared one */
+    return s;
+}
+
+/* The general pipeline's input layout: all sixteen attributes, from where the draw's layout has them (an
+ * attribute it does not have reads the first element; the shader reads it only if the program does, as 0,0,0,1). */
+static void ld_sip_layout(const ld_sip* p, D3D12_INPUT_ELEMENT_DESC il[16])
+{
+    for (u32 a = 0; a < 16u; a++) {
+        u32 offset = a * 16u;
+        if (p->masked) {
+            offset = 0;
+            for (u32 s = 0; s < p->count; s++)
+                if (p->attrs[s] == a) { offset = p->packed ? s * 16u : a * 16u; break; }
+        }
+        D3D12_INPUT_ELEMENT_DESC e = { "ATTR", a, DXGI_FORMAT_R32G32B32A32_FLOAT, 0, offset,
+                                       D3D12_INPUT_CLASSIFICATION_PER_VERTEX_DATA, 0 };
+        il[a] = e;
+    }
+}
+/* A compile thread: a stand-in pipeline (general: kind LD_CT_SIP; own vertex shader: LD_CT_SI). Its shaders still
+ * compiling (the first session on a PC, before the prepare step ran): none, counted. */
+static void ld_si_build(struct ld_si* any)
+{
+    LARGE_INTEGER c0, c1;
+    ID3D12PipelineState* pso = NULL;
+    if (any->task.kind == LD_CT_SIP) {
+        ld_sip* p = (ld_sip*)any;
+        ID3DBlob* ps = ld_si_var_blob(p->ps_var);
+        ID3DBlob* vs = ld_si_var_blob(p->vs_var);
+        if (ps && vs) {
+            D3D12_INPUT_ELEMENT_DESC il[16], gil[16];
+            D3D12_GRAPHICS_PIPELINE_STATE_DESC pd;
+            ld_fill_pipeline_desc(&pd, il, vs, ps, &p->rs, (int)p->masked, p->count, p->attrs, (int)p->packed);
+            ld_sip_layout(p, gil);
+            pd.InputLayout.pInputElementDescs = gil; pd.InputLayout.NumElements = 16;
+            QueryPerformanceCounter(&c0);
+            if (FAILED(g.dev->lpVtbl->CreateGraphicsPipelineState(g.dev, &pd, &IID_ID3D12PipelineState, (void**)&pso)))
+                pso = NULL;
+            QueryPerformanceCounter(&c1);
+            InterlockedAdd64(&s_si_made_qpc, c1.QuadPart - c0.QuadPart);
+            if (pso) InterlockedIncrement64(&s_si_made);
+            else InterlockedIncrement64(&s_si_refused[LD_SIR_FAILED]);
+        } else InterlockedIncrement64(&s_si_refused[LD_SIR_VARIANT]);
+        if (pso) InterlockedExchange(&s_si_warm[p->ps_var][p->vs_var], 1);
+        p->pso = pso;
+        ld_cpool_finish(&p->done);
+        return;
+    }
+    ld_si* s = any;
+    ID3DBlob* ps = ld_si_var_blob(s->var);
+    if (ps && s->vs) {
+        D3D12_INPUT_ELEMENT_DESC il[16];
+        D3D12_GRAPHICS_PIPELINE_STATE_DESC pd;
+        ld_fill_pipeline_desc(&pd, il, s->vs, ps, &s->rs, (int)s->masked, s->count, s->attrs, (int)s->packed);
+        QueryPerformanceCounter(&c0);
+        if (FAILED(g.dev->lpVtbl->CreateGraphicsPipelineState(g.dev, &pd, &IID_ID3D12PipelineState, (void**)&pso)))
+            pso = NULL;
+        QueryPerformanceCounter(&c1);
+        InterlockedAdd64(&s_si_made_qpc, c1.QuadPart - c0.QuadPart);
+        if (pso) InterlockedIncrement64(&s_si_made);
+        else InterlockedIncrement64(&s_si_refused[LD_SIR_FAILED]);
+    } else InterlockedIncrement64(&s_si_refused[LD_SIR_VARIANT]);
+    if (s->vs) { s->vs->lpVtbl->Release(s->vs); s->vs = NULL; }   /* its own copy: no other thread has it */
+    s->pso = pso;
+    ld_cpool_finish(&s->done);
+}
+/* Its pipeline when it is made (any thread), NULL while it is being made or when it failed. */
+static ID3D12PipelineState* ld_si_pso(const ld_si* s)
+{
+    if (s->gen) return InterlockedCompareExchange(&s->gen->done, 0, 0) ? s->gen->pso : NULL;
+    return InterlockedCompareExchange(&((ld_si*)s)->done, 0, 0) ? s->pso : NULL;
+}
+static int ld_si_failed(const ld_si* s)
+{
+    if (s->gen) return InterlockedCompareExchange(&s->gen->done, 0, 0) && !s->gen->pso;
+    return InterlockedCompareExchange(&((ld_si*)s)->done, 0, 0) && !s->pso;
+}
+static volatile LONG* ld_si_done_flag(ld_si* s) { return s->gen ? &s->gen->done : &s->done; }
+
+/* The walker, after get_pso: the draw's stand-in when it may be drawn with it (its pipeline still being made, or
+ * LD_STANDIN_ALL), else NULL. ld_upload_pixel_constants then writes its block. */
+static void ld_si_for_draw(ID3D12PipelineState* pso)
+{
+    s_si_draw = NULL; s_si_draw_off = 0;
+    if (!s_nw.mode || !ld_pso_is_job(pso)) return;
+    ld_pso_job* const j = ld_pso_job_of(pso);
+    ld_si* const s = j->si;
+    if (!s) return;
+    if (ld_si_failed(s)) return;
+    if (!s_si.all && InterlockedCompareExchange(&j->done, 0, 0)) return;           /* the real one is ready */
+    s_si_draw = s;
+}
+/* ld_upload_pixel_constants: bytes the draw's allocation needs beyond its own constants (base = their size). */
+static u32 ld_si_extra_bytes(u32 base)
+{
+    if (!s_si_draw) return 0;
+    return ((base + 255u) & ~255u) - base + s_si_draw->rows * 16u;
+}
+/* ... and the block, written after them (dst = the allocation, base = their size, alpha = the fp_alpha row). */
+static void ld_si_write_block(u8* dst, u32 base, const u8* alpha)
+{
+    if (!s_si_draw) return;
+    const u32 off = (base + 255u) & ~255u;
+    float a[4]; memcpy(a, alpha, 16);
+    rsx_si_block_write(dst + off, s_si_draw->n_slots, s_si_draw->n_regs, s_si_draw->n_ops, s_si_draw->ops, &s_si_draw->st,
+                       (const u32 (*)[4])g.fp_constants.values, g.fp_constants.count, a);
+    if (s_si_draw->vn_ops)
+        rsx_si_vp_block_write(dst + off, s_si_draw->vat, s_si_draw->vn_ops, s_si_draw->vpresent, s_si_draw->vtex, s_si_draw->vops);
+    s_si_draw_off = off;
+    InterlockedAdd64(&s_si_bytes, (LONG64)s_si_draw->rows * 16);
+}
+
+/* ---- the recording thread ---- */
+/* s_rec_b1 (b1 as the walker last set it) and s_rec_cur_pso (the pipeline set for its calls): beside ro_draw */
+/* Set the stand-in for one draw: 1 when set (b1 pointed at its block; ld_si_rec_end puts things back). */
+static int ld_si_rec_set(ld_si* s, u32 off)
+{
+    ID3D12PipelineState* p = s && off ? ld_si_pso(s) : NULL;
+    if (!p) return 0;
+    s_rec_real->lpVtbl->SetPipelineState(s_rec_real, p);
+    s_rec_real->lpVtbl->SetGraphicsRootConstantBufferView(s_rec_real, 4, s_rec_b1 + off);
+    return 1;
+}
+static void ld_si_rec_end(int restore_pso)
+{
+    s_rec_real->lpVtbl->SetGraphicsRootConstantBufferView(s_rec_real, 4, s_rec_b1);
+    if (restore_pso && s_rec_cur_pso) s_rec_real->lpVtbl->SetPipelineState(s_rec_real, s_rec_cur_pso);
+}
+/* A draw that would be left out: the stand-in instead, if it is ready. [standin3] Never waited for (round 2 waited
+ * up to 2 ms a draw): a stand-in may not make a frame longer than without it. */
+static int ld_si_rec_leave(ld_si* s, u32 off)
+{
+    if (!s || !off) return 0;
+    if (ld_si_rec_set(s, off)) { InterlockedIncrement64(&s_si_drawn); return 1; }
+    InterlockedIncrement64(&s_si_refused[LD_SIR_NOTREADY]);
+    return 0;
+}
+/* A draw that would wait for its pipeline (LD_STANDIN_PRODUCERS, or LD_STANDIN_ALL): wait for the stand-in
+ * instead (about a millisecond, or nothing once its state's pipeline is made). */
+static int ld_si_rec_wait(ld_si* s, u32 off, u32 why)
+{
+    if (!s || !off || !(s_si.producers || s_si.all)) return 0;
+    volatile LONG* d = ld_si_done_flag(s);
+    if (s_si.all) {                               /* the picture test: the stand-in for every draw it takes */
+        if (!InterlockedCompareExchange(d, 0, 0)) {
+            LARGE_INTEGER a, b; QueryPerformanceCounter(&a);
+            ld_cpool_wait(d);
+            QueryPerformanceCounter(&b);
+            InterlockedAdd64(&g_st.rec_wait_qpc, b.QuadPart - a.QuadPart);
+            InterlockedAdd64(&s_si_wait_qpc, b.QuadPart - a.QuadPart);
+            InterlockedIncrement64(&g_st.rec_wait_n);
+        }
+        if (!ld_si_rec_set(s, off)) return 0;
+        InterlockedIncrement64(&s_si_drawn_wait);
+        return 1;
+    }
+    /* [standin5] A draw that must wait (its picture is read by other draws): the stand-in only when it can be had
+     * now or within about a millisecond, and never into a target that may be drawn once and kept ("a target new
+     * this frame", "its target is read by later draws" = not redrawn every frame): a one-ulp difference there could
+     * stay for the session. Everything else waits for the real pipeline exactly as without the stand-in. */
+    if (why == NWR_NEWTARGET || why == NWR_PRODUCER) { InterlockedIncrement64(&s_si_wait_kept); return 0; }
+    if (!InterlockedCompareExchange(d, 0, 0)) {
+        /* instantly there: its two shaders in memory and its pair's first (cold) pipeline made, so at most its
+         * state's ~1 ms pipeline is missing; that is waited for, 3 ms at most */
+        const ld_sip* p = s->gen;
+        const int instant = p && ld_si_var_blob(p->ps_var) && ld_si_var_blob(p->vs_var) &&
+                            InterlockedCompareExchange(&s_si_warm[p->ps_var][p->vs_var], 0, 0);
+        if (!instant) { InterlockedIncrement64(&s_si_wait_real); return 0; }
+        LARGE_INTEGER a, b; QueryPerformanceCounter(&a);
+        ld_cpool_wait_ms(d, 3);
+        QueryPerformanceCounter(&b);
+        InterlockedAdd64(&g_st.rec_wait_qpc, b.QuadPart - a.QuadPart);
+        InterlockedAdd64(&s_si_wait_qpc, b.QuadPart - a.QuadPart);
+        if (!InterlockedCompareExchange(d, 0, 0)) { InterlockedIncrement64(&s_si_wait_real); return 0; }
+    }
+    if (!ld_si_rec_set(s, off)) { InterlockedIncrement64(&s_si_wait_real); return 0; }
+    InterlockedIncrement64(&s_si_drawn_wait);
+    return 1;
+}
+
+/* The [stutter] line's tail (appended when the mode is on or anything happened since the last line). */
+static void ld_si_stutter(char* out, size_t cap, double k)
+{
+    static LONG64 p_drawn, p_wait, p_made, p_made_qpc, p_psos, p_got, p_ref[LD_SIR_N], p_vr, p_vc, p_vq, p_bm, p_bq, p_wq, p_wr, p_wk;
+    const LONG64 wr = s_si_wait_real, wk = s_si_wait_kept;
+    const LONG64 vr = s_si_var_read, vc = s_si_var_compiled, vq = s_si_var_qpc, bm = s_si_bg_made, bq = s_si_bg_qpc, wq = s_si_wait_qpc;
+    const LONG64 dr = s_si_drawn, dw = s_si_drawn_wait, mk = s_si_made, mq = s_si_made_qpc, ps = s_si_psos, gt = s_si_got;
+    LONG64 ref[LD_SIR_N]; int any_ref = 0;
+    for (int r = 0; r < LD_SIR_N; r++) { ref[r] = s_si_refused[r]; any_ref |= ref[r] != p_ref[r]; }
+    if (ld_si_on() && (s_nw.mode || dr != p_drawn || any_ref)) {
+        size_t used = strlen(out);
+        snprintf(out + used, cap - used, " | stand-in: %lld draws drawn by it (%lld that would have waited; %lld that had to wait waited for"
+                 " their own pipeline as the stand-in was not instantly there, %lld into a target maybe kept), %lld of %lld new pipelines"
+                 " got one, %lld stand-in pipelines made (%.1f ms each in the driver), %u kept",
+                 (long long)(dr - p_drawn), (long long)(dw - p_wait), (long long)(wr - p_wr), (long long)(wk - p_wk),
+                 (long long)(gt - p_got), (long long)(ps - p_psos),
+                 (long long)(mk - p_made), mk != p_made ? (double)(mq - p_made_qpc) * k / (double)(mk - p_made) : 0.0, s_sip_n);
+        used = strlen(out);
+        snprintf(out + used, cap - used, "; its shaders: %lld read from the cache, %lld compiled (%.0f ms); its own thread made %lld"
+                 " pipelines, busy %.0f ms; the recording thread waited %.0f ms for it",
+                 (long long)(vr - p_vr), (long long)(vc - p_vc), (double)(vq - p_vq) * k, (long long)(bm - p_bm),
+                 (double)(bq - p_bq) * k, (double)(wq - p_wq) * k);
+        int first = 1;
+        for (int r = 1; r < LD_SIR_N; r++) {
+            if (ref[r] == p_ref[r]) continue;
+            used = strlen(out);
+            snprintf(out + used, cap - used, "%s%s %lld", first ? "; refused: " : ", ", ld_si_reason((u32)r),
+                     (long long)(ref[r] - p_ref[r]));
+            first = 0;
+        }
+    }
+    p_drawn = dr; p_wait = dw; p_made = mk; p_made_qpc = mq; p_psos = ps; p_got = gt;
+    p_vr = vr; p_vc = vc; p_vq = vq; p_bm = bm; p_bq = bq; p_wq = wq; p_wr = wr; p_wk = wk;
+    for (int r = 0; r < LD_SIR_N; r++) p_ref[r] = ref[r];
+}
