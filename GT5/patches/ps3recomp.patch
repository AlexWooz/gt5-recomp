+"    float fb = saturate((float(q) / 2000.0 - 0.035) / 0.035);\n"
+"    return float4(lerp(o3, c0, fb), 1.0);\n"
+"}\n"
+"#elif PASS == 10\n"
+"/* [fg1] The scene's vectors and depth brought to the frame's pixels: xy = where this pixel's surface\n"
+" * was in the frame before, relative, in frame pixels; z = its depth (0 near); w = 1 inside the 3D\n"
+" * picture. Of the scene texels under a frame pixel the nearest one speaks (a thin thing in front\n"
+" * keeps its own vector). Chain: the vectors of the frame before are added, taken where this one\n"
+" * points (two frames back, for the test that withholds the middle frame). */\n"
+"cbuffer K : register(b0) { float4 Rect; float2 Scene; float Chain; float K7; };\n"
+"Texture2D<float4> Mv : register(t0);\n"
+"Texture2D<float4> Dp : register(t1);\n"
+"Texture2D<float4> MvB : register(t2);\n"
+"float4 vs(uint id : SV_VertexID) : SV_Position {\n"
+"    float2 uv = float2((id << 1) & 2, id & 2);\n"
+"    return float4(uv * float2(2, -2) + float2(-1, 1), 0, 1);\n"
+"}\n"
+"float4 ps(float4 pos : SV_Position) : SV_Target {\n"
+"    float2 p = pos.xy;\n"
+"    if (p.x < Rect.x || p.y < Rect.y || p.x >= Rect.z || p.y >= Rect.w) return float4(0, 0, 1, 0);\n"
+"    float2 k = Scene / (Rect.zw - Rect.xy);\n"
+"    float2 s = (p - Rect.xy) * k;\n"
+"    int2 i0 = int2(floor(s - 0.5));\n"
+"    float best = 2.0;\n"
+"    float2 v = float2(0, 0);\n"
+"    [unroll] for (int j = 0; j < 2; j++) [unroll] for (int i = 0; i < 2; i++) {\n"
+"        int2 q = clamp(i0 + int2(i, j), int2(0, 0), int2(Scene) - 1);\n"
+"        float d = Dp.Load(int3(q, 0)).x;\n"
+"        if (d < best) { best = d; v = Mv.Load(int3(q, 0)).xy; }\n"
+"    }\n"
+"    v /= k;\n"
+"    if (Chain > 0.5) {\n"
+"        float4 b = MvB.Load(int3(clamp(int2(p + v), int2(0, 0), int2(W - 1, H - 1)), 0));\n"
+"        if (b.w < 0.5) return float4(0, 0, best, 0);\n"
+"        v += b.xy;\n"
+"    }\n"
+"    return float4(v, best, 1);\n"
+"}\n"
+"#elif PASS == 11\n"
+"/* [fg1] A made frame from the two frames' pictures without HUD, the real vectors and the depth.\n"
+" *   - outside the 3D picture, and where the newest finished frame differs from its picture without\n"
