+static int kb_vk(const char* s)
+{
+    if (s[0] && !s[1]) {
+        const char c = (char)toupper((unsigned char)s[0]);
+        if ((c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9')) return c;
+    }
+    if ((s[0] == 'F' || s[0] == 'f') && isdigit((unsigned char)s[1])) {
+        char* end; const long n = strtol(s + 1, &end, 10);
+        if (!*end && n >= 1 && n <= 24) return VK_F1 + (int)n - 1;
+    }
+    if (!_strnicmp(s, "Num", 3) && isdigit((unsigned char)s[3]) && !s[4]) return VK_NUMPAD0 + (s[3] - '0');
+    for (size_t i = 0; i < sizeof kb_names / sizeof kb_names[0]; i++)
+        if (!_stricmp(s, kb_names[i].name)) return kb_names[i].vk;
+    return 0;
+}
+
+static const char* kb_vk_name(int vk, char buf[8])
+{
+    if ((vk >= 'A' && vk <= 'Z') || (vk >= '0' && vk <= '9')) { buf[0] = (char)vk; buf[1] = 0; return buf; }
+    if (vk >= VK_F1 && vk <= VK_F24) { snprintf(buf, 8, "F%d", vk - VK_F1 + 1); return buf; }
+    if (vk >= VK_NUMPAD0 && vk <= VK_NUMPAD9) { snprintf(buf, 8, "Num%d", vk - VK_NUMPAD0); return buf; }
+    for (size_t i = 0; i < sizeof kb_names / sizeof kb_names[0]; i++)
+        if (kb_names[i].vk == vk) return kb_names[i].name;
+    snprintf(buf, 8, "0x%02X", (unsigned)vk);
+    return buf;
+}
