+/* VK_SHADER_BOOST, on the walker at a scene draw whose pipeline is still queued: 1 when the walker
+ * has claimed it to build it now, because it is VK_SHADER_ASSIST_MS (1500) since its first skipped
+ * draw. One a frame, and never one a worker has started (that would be a wait). */
+static u64 s_assist_ticks;     /* the walker's time on them (from the decision to the built variant) */
+static int vk_shader_assist(vk_eng_pipe* P)
+{
+    static int ms = -1;
+    static u32 last = ~0u;
+    static u64 win_t0, win_ticks0;
+    if (ms < 0) { const char* e = getenv("VK_SHADER_ASSIST_MS"); ms = (e && *e) ? atoi(e) : 1500; }
+    if (!vk_shader_boost() || ms <= 0) return 0;
+    const u64 now = SDL_GetPerformanceCounter(), hz = SDL_GetPerformanceFrequency();
+    if (!P->first_skip) { P->first_skip = now; return 0; }
+    if (last == s_vk_present_no || (now - P->first_skip) * 1000u < (u64)ms * hz) return 0;
+    /* At most a quarter of the walker's time, a second at a time: the game's clock counts frames. */
+    if (now - win_t0 >= hz) { win_t0 = now; win_ticks0 = s_assist_ticks; }
+    if ((s_assist_ticks - win_ticks0) * 4u >= hz) return 0;
+    if (__atomic_exchange_n(&P->claimed, 1, __ATOMIC_ACQ_REL)) return 0;
+    last = s_vk_present_no;
+    return 1;
+}
