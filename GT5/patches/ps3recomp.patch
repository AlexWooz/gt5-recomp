+ * SPU_NO_IMG_RESTORE_INLINE opts a file out. */
+#ifndef SPU_NO_IMG_RESTORE_INLINE
+SPU_CH_INL void spu_img_restore_inl(spu_context* ctx, int32_t saved_img)
+{
+    ctx->image_id = ctx->module_img_a00 ? ctx->module_img_a00 : saved_img;
+}
