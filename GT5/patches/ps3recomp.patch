+"RWTexture2D<uint> MvS : register(u2);\n"
+"RWTexture2D<uint> MvQ : register(u3);\n"
+"float P(int2 p) { return Prev[uint2(clamp(p, int2(0, 0), int2(QW - 1, QH - 1)))]; }\n"
+"[numthreads(8, 8, 1)] void main(uint3 id : SV_DispatchThreadID) {\n"
