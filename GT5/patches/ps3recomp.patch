+            for (u32 i = (pick + 1u) % VK_ENG_MAX_PIPE; i != s_async_sh.tail; i = (i + 1u) % VK_ENG_MAX_PIPE) {
+                const u32 s = __atomic_load_n(&s_epipe[s_async_sh.queue[i]].last_skip, __ATOMIC_RELAXED);
