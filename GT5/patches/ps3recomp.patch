+    int on;                       /* -1 undecided, 0 off, 1 on */
+    int repeat;                   /* VK_FRAMEGEN_REPEAT: the drawn frame again, nothing made */
+    int ready, failed, layouts;
+    u32 W, H, QW, QH, SW, SH, GSW, GSH, GQW, GQH;
+    vk_image frame[VFG_SLOTS], mid;
+    vk_buffer lq[VFG_SLOTS], ls[VFG_SLOTS], mvs, mvq, mvf[2], out;
+    VkSampler samp;
+    VkDescriptorSetLayout dsl;
+    VkPipelineLayout layout;
+    VkPipeline pipe[VFG_PASSES];
+    VkDescriptorPool dpool;
+    VkDescriptorSet set[VFG_COMBOS][VFG_PASSES];
+    /* walker */
+    u64 seq;                      /* the last drawn frame taken */
+    int have;                     /* that frame is in its slot: the next one can be made against it */
+    int pending;                  /* cur recorded, handed over once its command buffer is submitted */
+    vfg_item cur;
+    unsigned long long last_game;
+    u64 last_t, waited, rep_at;
+    u64 drawn, rep_drawn, rep_made, rep_shown, rep_dropped;
+    /* presenter */
+    SDL_Thread* th;
+    SDL_mutex* mu;
+    SDL_cond* cv;                 /* a frame in the mailbox, or done_seq moved */
+    vfg_item mb;
+    int mb_full, quit;
+    u64 done_seq;
+    VkCommandPool cpool;
+    VkCommandBuffer cb[3];
+    VkFence fence[3];
+    VkSemaphore acq[3];
+    int busy[3];
+    u32 ring;
+    double refresh_ms;            /* > 0: a screen faster than 75 Hz, presents spaced by time */
+    u64 made, shown, dropped;     /* presenter counts (dropped: the walker) */
+    /* VK_FRAMEGEN_DUMP=<dir> (tests; VK_FRAMEGEN_DUMP_EVERY=n, default 120): before / made / after as .ppm */
+    const char* dump_dir;
+    u32 dump_every, dump_n, dump_files;
+    vk_buffer dump_buf;
+} s_fg = { .on = -1 };
+
+/* On as the DirectX 12 renderer has it (rsx_framegen.c, rsx_fg_enabled): LD_FRAMEGEN set to anything but 0,
+ * or a multiplier (LD_FRAMEGEN_MULT) of 2 or more. Read through the settings registry and followed while the
+ * game runs, so the in-game menu's Frame generation row switches it. Vulkan has the one generator, whatever
+ * LD_FRAMEGEN or LD_FG_METHOD name (their rows are hidden here: vk_menu_start). */
+static int vfg_enabled(void)
+{
+    static unsigned gen = ~0u;
+    if (s_fg.on < 0 || gen != gt5_settings_gen()) {
+        gen = gt5_settings_gen();
+        const int was = s_fg.on;
+        const int want = gt5_setting_bool("LD_FRAMEGEN", 0) || gt5_setting_int("LD_FRAMEGEN_MULT", 1) >= 2;
+        if (was < 0) s_fg.repeat = vk_env_on("VK_FRAMEGEN_REPEAT");
+        s_fg.on = want && s_vk.windowed && rsx_hlsl_to_spirv_available();
+        if (s_fg.on && was <= 0)
+            VK_LOG("[framegen] on: frames that watch mode or 30 fps leave undrawn are %s, and a thread of"
+                   " its own presents (LD_FRAMEGEN%s)\n", s_fg.repeat ? "shown again at an even pace" :
+                   "made from the drawn ones", s_fg.repeat ? ", VK_FRAMEGEN_REPEAT" : "");
+        else if (!s_fg.on && was > 0)
+            VK_LOG("[framegen] off: the walker presents its own frames again\n");
+    }
+    return s_fg.on && !s_fg.failed;
+}
+
+/* Frame generation was switched off while the game runs: the presenter shows what it was given first,
+ * so no older frame follows the walker's own present; and nothing of before is used when it comes back. */
+static int vfg_wait_done(u64 target);
+static void vfg_quiet(void)
+{
+    if (!s_fg.ready || !s_fg.have) return;
+    if (s_fg.th && !s_fg.failed) vfg_wait_done(s_fg.seq);
+    s_fg.have = 0;
+    s_fg.last_game = 0;
+}
+
+static void vfg_barrier(VkCommandBuffer cb)
+{
+    VkMemoryBarrier mb = { .sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER,
+                           .srcAccessMask = VK_ACCESS_MEMORY_WRITE_BIT,
+                           .dstAccessMask = VK_ACCESS_MEMORY_READ_BIT | VK_ACCESS_MEMORY_WRITE_BIT };
+    pvkCmdPipelineBarrier(cb, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT,
+                          0, 1, &mb, 0, NULL, 0, NULL);
+}
+
+static int vfg_fail(const char* what)
+{
+    VK_LOG("[framegen] off: %s failed\n", what);
+    s_fg.failed = 1;
+    return -1;
+}
+
+static void vfg_write_set(VkDescriptorSet set, VkImageView a, VkImageView b, const VkBuffer u[4])
+{
+    VkDescriptorImageInfo ia = { VK_NULL_HANDLE, a, VK_IMAGE_LAYOUT_GENERAL };
+    VkDescriptorImageInfo ib = { VK_NULL_HANDLE, b, VK_IMAGE_LAYOUT_GENERAL };
+    VkDescriptorImageInfo is = { s_fg.samp, VK_NULL_HANDLE, VK_IMAGE_LAYOUT_UNDEFINED };
+    VkDescriptorBufferInfo io = { s_fg.out.buf, 0, VK_WHOLE_SIZE };
+    VkDescriptorBufferInfo bi[4];
+    VkWriteDescriptorSet w[8];
+    for (int i = 0; i < 4; i++) bi[i] = (VkDescriptorBufferInfo){ u[i], 0, VK_WHOLE_SIZE };
+    for (int i = 0; i < 8; i++)
+        w[i] = (VkWriteDescriptorSet){ .sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET, .dstSet = set,
+                                       .dstBinding = k_vfg_binding[i], .descriptorCount = 1 };
+    w[0].descriptorType = VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE; w[0].pImageInfo = &ia;
+    w[1].descriptorType = VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE; w[1].pImageInfo = &ib;
+    w[2].descriptorType = VK_DESCRIPTOR_TYPE_SAMPLER;       w[2].pImageInfo = &is;
+    for (int i = 0; i < 4; i++) { w[3 + i].descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER; w[3 + i].pBufferInfo = &bi[i]; }
+    w[7].descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER; w[7].pBufferInfo = &io;
+    pvkUpdateDescriptorSets(s_vk.device, 8, w, 0, NULL);
+}
+
+static int SDLCALL vfg_presenter(void* arg);
+
+/* Walker thread, at the first frame: images, buffers, the six pipelines, their sets, the presenter. */
+static int vfg_setup(void)
+{
+    const u32 w = s_vk.fw, h = s_vk.fh;   /* [res] the frame at its size (vfg_teardown when it changes) */
+    s_fg.W = w; s_fg.H = h;
+    s_fg.QW = w / 4u; s_fg.QH = h / 4u; s_fg.SW = s_fg.QW / 4u; s_fg.SH = s_fg.QH / 4u;
+    s_fg.GSW = (s_fg.SW + 3u) / 4u; s_fg.GSH = (s_fg.SH + 3u) / 4u;
+    s_fg.GQW = (s_fg.QW + 3u) / 4u; s_fg.GQH = (s_fg.QH + 3u) / 4u;
+    if (s_fg.SW < 8u || s_fg.SH < 8u) return vfg_fail("a frame this small");
+    const VkImageUsageFlags fu = VK_IMAGE_USAGE_TRANSFER_DST_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT |
+                                 VK_IMAGE_USAGE_SAMPLED_BIT;
+    for (int i = 0; i < VFG_SLOTS; i++)
+        if (vk_create_image(&s_fg.frame[i], VK_FORMAT_R8G8B8A8_UNORM, w, h, fu, VK_IMAGE_ASPECT_COLOR_BIT) ||
+            vk_create_device_buffer(&s_fg.lq[i], (VkDeviceSize)s_fg.QW * s_fg.QH * 4u, VK_BUFFER_USAGE_STORAGE_BUFFER_BIT) ||
+            vk_create_device_buffer(&s_fg.ls[i], (VkDeviceSize)s_fg.SW * s_fg.SH * 4u, VK_BUFFER_USAGE_STORAGE_BUFFER_BIT))
+            return vfg_fail("history slots");
+    if (vk_create_image(&s_fg.mid, VK_FORMAT_R8G8B8A8_UNORM, w, h,
+                        VK_IMAGE_USAGE_TRANSFER_DST_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT | VK_IMAGE_USAGE_SAMPLED_BIT,
+                        VK_IMAGE_ASPECT_COLOR_BIT) ||
+        vk_create_device_buffer(&s_fg.out, (VkDeviceSize)w * h * 4u,
+                                VK_BUFFER_USAGE_STORAGE_BUFFER_BIT | VK_BUFFER_USAGE_TRANSFER_SRC_BIT) ||
+        vk_create_device_buffer(&s_fg.mvs, (VkDeviceSize)s_fg.GSW * s_fg.GSH * 4u, VK_BUFFER_USAGE_STORAGE_BUFFER_BIT) ||
+        vk_create_device_buffer(&s_fg.mvq, (VkDeviceSize)s_fg.GQW * s_fg.GQH * 4u, VK_BUFFER_USAGE_STORAGE_BUFFER_BIT) ||
+        vk_create_device_buffer(&s_fg.mvf[0], (VkDeviceSize)s_fg.GQW * s_fg.GQH * 4u, VK_BUFFER_USAGE_STORAGE_BUFFER_BIT) ||
+        vk_create_device_buffer(&s_fg.mvf[1], (VkDeviceSize)s_fg.GQW * s_fg.GQH * 4u, VK_BUFFER_USAGE_STORAGE_BUFFER_BIT))
+        return vfg_fail("motion buffers");
+    VkSamplerCreateInfo sci = { .sType = VK_STRUCTURE_TYPE_SAMPLER_CREATE_INFO,
+                                .magFilter = VK_FILTER_LINEAR, .minFilter = VK_FILTER_LINEAR,
+                                .mipmapMode = VK_SAMPLER_MIPMAP_MODE_NEAREST,
+                                .addressModeU = VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE,
+                                .addressModeV = VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE,
+                                .addressModeW = VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE, .maxLod = 0.0f };
+    if (pvkCreateSampler(s_vk.device, &sci, NULL, &s_fg.samp) != VK_SUCCESS) return vfg_fail("sampler");
+    VkDescriptorSetLayoutBinding lb[8];
+    static const VkDescriptorType types[8] = {
+        VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE, VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE, VK_DESCRIPTOR_TYPE_SAMPLER,
+        VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, VK_DESCRIPTOR_TYPE_STORAGE_BUFFER,
+        VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, VK_DESCRIPTOR_TYPE_STORAGE_BUFFER };
+    for (u32 i = 0; i < 8; i++)
+        lb[i] = (VkDescriptorSetLayoutBinding){ .binding = k_vfg_binding[i], .descriptorType = types[i],
+                                                .descriptorCount = 1, .stageFlags = VK_SHADER_STAGE_COMPUTE_BIT };
+    VkDescriptorSetLayoutCreateInfo dli = { .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO,
+                                            .bindingCount = 8, .pBindings = lb };
+    VkPushConstantRange pr = { VK_SHADER_STAGE_COMPUTE_BIT, 0, 4 * sizeof(float) };
+    if (pvkCreateDescriptorSetLayout(s_vk.device, &dli, NULL, &s_fg.dsl) != VK_SUCCESS) return vfg_fail("set layout");
+    VkPipelineLayoutCreateInfo pli = { .sType = VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO,
+                                       .setLayoutCount = 1, .pSetLayouts = &s_fg.dsl,
+                                       .pushConstantRangeCount = 1, .pPushConstantRanges = &pr };
+    if (pvkCreatePipelineLayout(s_vk.device, &pli, NULL, &s_fg.layout) != VK_SUCCESS) return vfg_fail("pipeline layout");
+    static char src[sizeof k_vfg_src + 512];
+    static u32 spv[16384];
+    for (int p = 0; p < VFG_PASSES; p++) {
+        snprintf(src, sizeof src, "#define PASS %d\n#define W %u\n#define H %u\n#define QW %u\n#define QH %u\n"
+                 "#define SW %u\n#define SH %u\n#define GSW %u\n#define GSH %u\n#define GQW %u\n#define GQH %u\n"
+                 "#define RS %d\n#define RQ %d\n%s", p, w, h, s_fg.QW, s_fg.QH, s_fg.SW, s_fg.SH, s_fg.GSW, s_fg.GSH,
+                 s_fg.GQW, s_fg.GQH, VFG_RS, VFG_RQ, k_vfg_src);
+        u32 n = 0;
+        char log[1024] = "";
+        if (rsx_hlsl_to_spirv(src, RSX_SHADER_STAGE_COMPUTE, spv, (u32)(sizeof spv / sizeof spv[0]), &n, log, sizeof log) || !n) {
+            VK_LOG("[framegen] pass %d: %s\n", p, log);
+            return vfg_fail("shader translation");
+        }
+        VkShaderModuleCreateInfo smi = { .sType = VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO,
+                                         .codeSize = (size_t)n * 4u, .pCode = spv };
+        VkShaderModule sm = VK_NULL_HANDLE;
+        if (pvkCreateShaderModule(s_vk.device, &smi, NULL, &sm) != VK_SUCCESS) return vfg_fail("shader module");
+        VkComputePipelineCreateInfo ci = {
+            .sType = VK_STRUCTURE_TYPE_COMPUTE_PIPELINE_CREATE_INFO,
+            .stage = { .sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO,
+                       .stage = VK_SHADER_STAGE_COMPUTE_BIT, .module = sm, .pName = "main" },
+            .layout = s_fg.layout };
+        const VkResult r = pvkCreateComputePipelines(s_vk.device, VK_NULL_HANDLE, 1, &ci, NULL, &s_fg.pipe[p]);
+        pvkDestroyShaderModule(s_vk.device, sm, NULL);
+        if (r != VK_SUCCESS) return vfg_fail("compute pipeline");
+    }
+    VkDescriptorPoolSize ps[3] = {
+        { VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE, 2 * VFG_COMBOS * VFG_PASSES },
+        { VK_DESCRIPTOR_TYPE_SAMPLER, VFG_COMBOS * VFG_PASSES },
+        { VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, 5 * VFG_COMBOS * VFG_PASSES } };
+    VkDescriptorPoolCreateInfo dpi = { .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO,
+                                       .maxSets = VFG_COMBOS * VFG_PASSES, .poolSizeCount = 3, .pPoolSizes = ps };
+    if (pvkCreateDescriptorPool(s_vk.device, &dpi, NULL, &s_fg.dpool) != VK_SUCCESS) return vfg_fail("descriptor pool");
+    for (int c = 0; c < VFG_COMBOS; c++) {
+        const int n = c % VFG_SLOTS, p = (c + VFG_SLOTS - 1) % VFG_SLOTS, m = c % 2;
+        const VkBuffer x = s_fg.mvs.buf;   /* a filler for the buffers a pass leaves alone */
+        const VkBuffer u[VFG_PASSES][4] = {
+            { s_fg.lq[n].buf, x, x, x },
+            { s_fg.lq[n].buf, s_fg.ls[n].buf, x, x },
+            { s_fg.ls[n].buf, s_fg.ls[p].buf, s_fg.mvs.buf, x },
+            { s_fg.lq[n].buf, s_fg.lq[p].buf, s_fg.mvs.buf, s_fg.mvq.buf },
+            { s_fg.mvq.buf, s_fg.mvf[m].buf, x, x },
+            { s_fg.mvf[m].buf, x, x, x } };
+        for (int q = 0; q < VFG_PASSES; q++) {
+            VkDescriptorSetAllocateInfo ai = { .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO,
+                                               .descriptorPool = s_fg.dpool, .descriptorSetCount = 1,
+                                               .pSetLayouts = &s_fg.dsl };
+            if (pvkAllocateDescriptorSets(s_vk.device, &ai, &s_fg.set[c][q]) != VK_SUCCESS) return vfg_fail("descriptor set");
+            vfg_write_set(s_fg.set[c][q], q == 5 ? s_fg.frame[p].view : s_fg.frame[n].view,
+                          s_fg.frame[n].view, u[q]);
+        }
+    }
+    /* The presenter's own command pool (a pool is one thread's), buffers, fences and semaphores. */
+    VkCommandPoolCreateInfo cpi = { .sType = VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO,
+                                    .flags = VK_COMMAND_POOL_CREATE_RESET_COMMAND_BUFFER_BIT,
+                                    .queueFamilyIndex = s_vk.queue_family };
+    if (pvkCreateCommandPool(s_vk.device, &cpi, NULL, &s_fg.cpool) != VK_SUCCESS) return vfg_fail("command pool");
+    VkCommandBufferAllocateInfo cai = { .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO,
+                                        .commandPool = s_fg.cpool, .level = VK_COMMAND_BUFFER_LEVEL_PRIMARY,
+                                        .commandBufferCount = 3 };
+    if (pvkAllocateCommandBuffers(s_vk.device, &cai, s_fg.cb) != VK_SUCCESS) return vfg_fail("command buffers");
+    VkFenceCreateInfo fci = { .sType = VK_STRUCTURE_TYPE_FENCE_CREATE_INFO };
+    VkSemaphoreCreateInfo semi = { .sType = VK_STRUCTURE_TYPE_SEMAPHORE_CREATE_INFO };
+    for (int i = 0; i < 3; i++)
+        if (pvkCreateFence(s_vk.device, &fci, NULL, &s_fg.fence[i]) != VK_SUCCESS ||
+            pvkCreateSemaphore(s_vk.device, &semi, NULL, &s_fg.acq[i]) != VK_SUCCESS)
+            return vfg_fail("fences");
+    {   /* A screen faster than 75 Hz: FIFO alone would show a made frame for one short refresh. */
+        SDL_DisplayMode dm;
+        const int di = s_vk.window ? SDL_GetWindowDisplayIndex(s_vk.window) : -1;
+        if (di >= 0 && SDL_GetCurrentDisplayMode(di, &dm) == 0 && dm.refresh_rate > 75)
+            s_fg.refresh_ms = 1000.0 / (double)dm.refresh_rate;
+    }
+    s_fg.dump_dir = getenv("VK_FRAMEGEN_DUMP");
+    if (s_fg.dump_dir && s_fg.dump_dir[0]) {
+        const char* e = getenv("VK_FRAMEGEN_DUMP_EVERY");
+        s_fg.dump_every = e && atoi(e) > 0 ? (u32)atoi(e) : 120u;
+        if (vk_create_host_buffer(&s_fg.dump_buf, (VkDeviceSize)w * h * 4u * 3u, VK_BUFFER_USAGE_TRANSFER_DST_BIT))
+            s_fg.dump_dir = NULL;
+    } else {
+        s_fg.dump_dir = NULL;
+    }
+    if (!s_fg.mu) s_fg.mu = SDL_CreateMutex();   /* [res] kept across vfg_teardown */
+    if (!s_fg.cv) s_fg.cv = SDL_CreateCond();
+    if (!s_fg.mu || !s_fg.cv) return vfg_fail("presenter lock");
+    s_fg.th = SDL_CreateThread(vfg_presenter, "vk-present", NULL);
+    if (!s_fg.th) return vfg_fail("presenter thread");
+    s_fg.ready = 1;
+    VK_LOG("[framegen] ready for %ux%u: motion at %ux%u and %ux%u, vectors %ux%u; presenter thread started%s\n",
+           w, h, s_fg.SW, s_fg.SH, s_fg.QW, s_fg.QH, s_fg.GQW, s_fg.GQH,
+           s_fg.refresh_ms > 0 ? ", presents spaced by time (a fast screen)" : "");
+    return 0;
+}
+
+/* Walker: until the presenter has taken frame `target` (shown or dropped). 0 if it stays stuck. */
+static int vfg_wait_done(u64 target)
+{
+    SDL_LockMutex(s_fg.mu);
+    if (s_fg.done_seq >= target) { SDL_UnlockMutex(s_fg.mu); return 1; }
+    const u64 t0 = SDL_GetPerformanceCounter(), hz = SDL_GetPerformanceFrequency();
+    int ok = 1;
+    while (s_fg.done_seq < target) {
+        SDL_CondWaitTimeout(s_fg.cv, s_fg.mu, 5);
+        if (SDL_GetPerformanceCounter() - t0 > hz) {
+            VK_LOG("[framegen] off: the presenter stopped taking frames\n");
+            s_fg.failed = 1; ok = 0;
+            break;
+        }
+    }
+    SDL_UnlockMutex(s_fg.mu);
+    s_fg.waited += SDL_GetPerformanceCounter() - t0;
+    return ok;
+}
+
+/* Walker, in the present's command buffer once the frame is in s_vk.color: keep it, and when game
+ * frames went undrawn since the drawn frame before, find the motion. Sets s_vk.fg_this when the
+ * presenter will show this frame (vfg_hand_off after the submit); else the walker presents it. */
+static void vfg_record(VkCommandBuffer cb)
+{
+    s_vk.fg_this = 0;
+    if (!vfg_enabled() || !s_vk.eng_active || !cb) { vfg_quiet(); return; }
+    {   extern int ps3_ab_on(const char* what);
+        if (ps3_ab_on("vkfg") == 0) { s_fg.have = 0; s_fg.last_game = 0; return; } }
+    if (!s_fg.ready && vfg_setup()) return;
+    unsigned long long game = 0, drawn = 0;
+    rsx_draw_engine_frame_counts(&game, &drawn);
+    const u64 now = SDL_GetPerformanceCounter(), hz = SDL_GetPerformanceFrequency();
+    const unsigned long long undrawn = s_fg.last_game && game > s_fg.last_game ? game - s_fg.last_game - 1u : 0u;
+    const int gen = undrawn >= 1u && undrawn <= 3u && s_fg.last_t && (now - s_fg.last_t) * 1000u < 150u * hz
+                    ? (int)undrawn : 0;
+    s_fg.last_game = game; s_fg.last_t = now;
+
+    const u64 d = s_fg.seq + 1u;
+    if (d > 2u && !vfg_wait_done(d - 2u)) return;   /* slot d % 3, vectors d % 2: last read for d - 2 */
+    const int n = (int)(d % VFG_SLOTS), p = (int)((d + VFG_SLOTS - 1u) % VFG_SLOTS), m = (int)(d % 2u);
+    const int c = (int)(d % VFG_COMBOS);
+    if (!s_fg.layouts) {
+        for (int i = 0; i < VFG_SLOTS; i++)
+            vk_barrier_image_on(cb, s_fg.frame[i].img, VK_IMAGE_ASPECT_COLOR_BIT, VK_IMAGE_LAYOUT_UNDEFINED);
+        vk_barrier_image_on(cb, s_fg.mid.img, VK_IMAGE_ASPECT_COLOR_BIT, VK_IMAGE_LAYOUT_UNDEFINED);
+        s_fg.layouts = 1;
+    }
+    vfg_barrier(cb);
+    VkImageCopy ic = { .srcSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 },
+                       .dstSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 },
+                       .extent = { s_fg.W, s_fg.H, 1 } };
+    pvkCmdCopyImage(cb, s_vk.color.img, VK_IMAGE_LAYOUT_GENERAL, s_fg.frame[n].img, VK_IMAGE_LAYOUT_GENERAL, 1, &ic);
+    vfg_barrier(cb);
+    static const int pass_dims[5] = { 0, 1, 2, 3, 3 };
+    const u32 dims[4][2] = { { s_fg.QW, s_fg.QH }, { s_fg.SW, s_fg.SH }, { s_fg.GSW, s_fg.GSH }, { s_fg.GQW, s_fg.GQH } };
+    const int made_ok = gen > 0 && s_fg.have && !s_fg.repeat;
+    const int passes = made_ok ? 5 : 2;
+    for (int q = 0; q < passes; q++) {
+        pvkCmdBindPipeline(cb, VK_PIPELINE_BIND_POINT_COMPUTE, s_fg.pipe[q]);
+        pvkCmdBindDescriptorSets(cb, VK_PIPELINE_BIND_POINT_COMPUTE, s_fg.layout, 0, 1, &s_fg.set[c][q], 0, NULL);
+        const u32* dm = dims[pass_dims[q]];
+        pvkCmdDispatch(cb, (dm[0] + 7u) / 8u, (dm[1] + 7u) / 8u, 1);
+        vfg_barrier(cb);
+    }
+    s_fg.cur = (vfg_item){ .seq = d, .t = now, .n = n, .p = p, .m = m,
+                           .made = made_ok ? (gen > 3 ? 3 : gen) : 0, .again = s_fg.repeat ? gen : 0 };
+    s_fg.seq = d;
+    s_fg.have = 1;
+    s_fg.drawn++;
+    s_fg.pending = 1;
+    s_vk.fg_this = 1;
+
