+/* =========================================================================
+ * Taskset2 and Task2
+ *
+ * GT5 converts every movie picture from YUV with four Task2s per frame and joins
+ * them; unregistered, the calls "succeeded" without running anything and the
+ * pictures stayed black.
+ *
+ * CellSpursTasksetAttribute2 (128 bytes): +0x00 revision, +0x04 name, +0x08 u64 args,
+ * +0x10 priority[8], +0x18 maxContention, +0x1C enable_clear_ls, +0x20 task_name_buffer.
+ * CellSpursTaskAttribute2 (256 bytes): +0x00 revision, +0x04 sizeContext, +0x08 u64 eaContext,
+ * +0x10 lsPattern[16], +0x20 name. From RPCS3's cellSpurs.h.
+ * =====================================================================*/
+#define CELL_SPURS_TASKSET2_SIZE 0x2900u
+#define TASK2_EXIT_ENTRY(ts, id) ((ts) + 0x1980u + 16u * (id))   /* see spu_taskset2_set_exit */
+#define TASK2_STATE_EXITED 2u
+#define TASK2_STATE_JOINED 4u
+
+s32 _cellSpursTasksetAttribute2Initialize(u32 attr, u32 revision)
+{
+    if (!attr) return CELL_SPURS_TASK_ERROR_NULL_POINTER;
+    if (attr & 7u) return (s32)0x80410910u;
+    memset(vm_base + attr, 0, 0x80);
+    vm_write32(attr + 0x00, revision);
+    for (u32 i = 0; i < 8; i++) vm_write8(attr + 0x10 + i, 1);
+    vm_write32(attr + 0x18, 8);
+    return CELL_OK;
+}
+
+s32 _cellSpursTaskAttribute2Initialize(u32 attr, u32 revision)
+{
+    if (!attr) return CELL_SPURS_TASK_ERROR_NULL_POINTER;
+    if (attr & 7u) return (s32)0x80410910u;
+    memset(vm_base + attr, 0, 0x28);
+    vm_write32(attr + 0x00, revision);
+    return CELL_OK;
+}
+
+s32 cellSpursCreateTaskset2(CellSpurs* spurs, CellSpursTaskset* taskset, u32 attr)
+{
+    extern void spu_taskset2_register(uint32_t);
+    const u64 args = attr ? vm_read64(attr + 0x08) : 0;
+    const s32 rc = spurs_create_taskset(spurs, taskset, args, NULL, 0, CELL_SPURS_TASKSET2_SIZE);
+    if (rc == CELL_OK) spu_taskset2_register((u32)(uintptr_t)taskset);
+    return rc;
+}
+
+s32 cellSpursDestroyTaskset2(CellSpursTaskset* taskset)
+{
+    return cellSpursDestroyTaskset(taskset);
