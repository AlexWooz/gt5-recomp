+/* Presenter: one picture into the window -- made frame k of it->made (k > 0) or the drawn frame. */
+static void vfg_present_one(const vfg_item* it, int k)
+{
+    SDL_LockMutex(s_swap_mu);
+    if (s_win_wait) {   /* minimised (vk_present_window has the same test) */
+        if (!s_vk.windowed || !vk_window_has_area()) { SDL_UnlockMutex(s_swap_mu); return; }
+        vk_swapchain_lost();
+    }
+    if (!s_win_wait && s_vk.windowed && vk_sync_stale()) vk_swapchain_lost();   /* [vsync] as vk_present_window_now */
+    if (s_win_wait || !s_vk.windowed || !s_vk.swapchain) { SDL_UnlockMutex(s_swap_mu); return; }
+    const u32 slot = s_fg.ring++ % 3u;
+    if (s_fg.busy[slot]) {
+        pvkWaitForFences(s_vk.device, 1, &s_fg.fence[slot], VK_TRUE, UINT64_MAX);
+        s_fg.busy[slot] = 0;
+    }
+    u32 idx = 0;
+    VkResult r = pvkAcquireNextImageKHR(s_vk.device, s_vk.swapchain, UINT64_MAX, s_fg.acq[slot], VK_NULL_HANDLE, &idx);
+    if (r == VK_ERROR_OUT_OF_DATE_KHR || r == VK_ERROR_SURFACE_LOST_KHR) {
+        vk_swapchain_lost(); SDL_UnlockMutex(s_swap_mu); return;
+    }
+    if (r != VK_SUCCESS && r != VK_SUBOPTIMAL_KHR) {
+        VK_LOG("[framegen] vkAcquireNextImageKHR failed (VkResult %d)\n", (int)r);
+        SDL_UnlockMutex(s_swap_mu); return;
+    }
+    VkCommandBuffer cb = s_fg.cb[slot];
+    VkCommandBufferBeginInfo bi = { .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO,
+                                    .flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT };
+    if (pvkResetCommandBuffer(cb, 0) != VK_SUCCESS || pvkBeginCommandBuffer(cb, &bi) != VK_SUCCESS) {
+        SDL_UnlockMutex(s_swap_mu); return;
+    }
+    vfg_barrier(cb);                    /* after the walker's frame and motion, and the last made frame's blit */
+    VkImage src = s_fg.frame[it->n].img;
+    VkImageView src_view = s_fg.frame[it->n].view;   /* [winf] */
+    if (k > 0) {
+        const float pc[4] = { (float)k / (float)(it->made + 1), 0.0f, 0.0f, 0.0f };
+        pvkCmdBindPipeline(cb, VK_PIPELINE_BIND_POINT_COMPUTE, s_fg.pipe[5]);
+        pvkCmdBindDescriptorSets(cb, VK_PIPELINE_BIND_POINT_COMPUTE, s_fg.layout, 0, 1,
+                                 &s_fg.set[it->seq % VFG_COMBOS][5], 0, NULL);
+        pvkCmdPushConstants(cb, s_fg.layout, VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof pc, pc);
+        pvkCmdDispatch(cb, (s_fg.W + 7u) / 8u, (s_fg.H + 7u) / 8u, 1);
+        vfg_barrier(cb);
+        VkBufferImageCopy bc = { .imageSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 },
+                                 .imageExtent = { s_fg.W, s_fg.H, 1 } };
+        pvkCmdCopyBufferToImage(cb, s_fg.out.buf, s_fg.mid.img, VK_IMAGE_LAYOUT_GENERAL, 1, &bc);
+        vfg_barrier(cb);
+        src = s_fg.mid.img;
+        src_view = s_fg.mid.view;
+    }
+    VkImageMemoryBarrier b = {
+        .sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER,
+        .srcAccessMask = 0, .dstAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT,
+        .oldLayout = VK_IMAGE_LAYOUT_UNDEFINED, .newLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+        .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED, .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+        .image = s_vk.sc_images[idx], .subresourceRange = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1 },
+    };
+    pvkCmdPipelineBarrier(cb, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, NULL, 0, NULL, 1, &b);
+    vk_window_blit(cb, src, src_view, s_fg.W, s_fg.H, idx, 1, slot);   /* [win] [fill] [winf] */
+    if (!(s_vk.menu && gt5_menu_vk_composite(cb, idx))) {   /* the in-game menu over made frames too */
+        b.srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT; b.dstAccessMask = 0;
+        b.oldLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL; b.newLayout = VK_IMAGE_LAYOUT_PRESENT_SRC_KHR;
+        pvkCmdPipelineBarrier(cb, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, 0, 0, NULL, 0, NULL, 1, &b);
+    }
+    const int dump = s_fg.dump_dir && k == 1 && s_fg.dump_files < 12u && (s_fg.dump_n++ % s_fg.dump_every) == 0u;
+    if (dump) {   /* VK_FRAMEGEN_DUMP: the frame before, the made one and the drawn one */
+        const VkImage im3[3] = { s_fg.frame[it->p].img, s_fg.mid.img, s_fg.frame[it->n].img };
+        for (int i = 0; i < 3; i++) {
+            VkBufferImageCopy rc = { .bufferOffset = (VkDeviceSize)s_fg.W * s_fg.H * 4u * (u32)i,
+                                     .imageSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 },
+                                     .imageExtent = { s_fg.W, s_fg.H, 1 } };
+            pvkCmdCopyImageToBuffer(cb, im3[i], VK_IMAGE_LAYOUT_GENERAL, s_fg.dump_buf.buf, 1, &rc);
+        }
+        VkMemoryBarrier hb = { .sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER,
+                               .srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT, .dstAccessMask = VK_ACCESS_HOST_READ_BIT };
+        pvkCmdPipelineBarrier(cb, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_HOST_BIT, 0, 1, &hb, 0, NULL, 0, NULL);
+    }
+    if (pvkEndCommandBuffer(cb) != VK_SUCCESS) { SDL_UnlockMutex(s_swap_mu); return; }
+    VkPipelineStageFlags wait_stage = VK_PIPELINE_STAGE_TRANSFER_BIT;
+    VkSubmitInfo si = { .sType = VK_STRUCTURE_TYPE_SUBMIT_INFO,
+                        .waitSemaphoreCount = 1, .pWaitSemaphores = &s_fg.acq[slot], .pWaitDstStageMask = &wait_stage,
+                        .commandBufferCount = 1, .pCommandBuffers = &cb,
+                        .signalSemaphoreCount = 1, .pSignalSemaphores = &s_vk.sc_done[idx] };
+    pvkResetFences(s_vk.device, 1, &s_fg.fence[slot]);
+    if (vk_queue_submit(&si, s_fg.fence[slot]) != VK_SUCCESS) {
+        VK_LOG("[framegen] vkQueueSubmit failed\n"); SDL_UnlockMutex(s_swap_mu); return;
+    }
+    s_fg.busy[slot] = 1;
+    VkPresentInfoKHR pi = { .sType = VK_STRUCTURE_TYPE_PRESENT_INFO_KHR,
+                            .waitSemaphoreCount = 1, .pWaitSemaphores = &s_vk.sc_done[idx],
+                            .swapchainCount = 1, .pSwapchains = &s_vk.swapchain, .pImageIndices = &idx };
+    r = vk_queue_present(&pi);
+    if (r == VK_SUCCESS || r == VK_SUBOPTIMAL_KHR) {
+        SDL_LockMutex(s_fg.mu);
+        if (k > 0) s_fg.made++; else s_fg.shown++;
+        SDL_UnlockMutex(s_fg.mu);
+    }
+    if (r == VK_ERROR_OUT_OF_DATE_KHR || r == VK_SUBOPTIMAL_KHR) vk_swapchain_lost();
+    else if (r != VK_SUCCESS) VK_LOG("[framegen] vkQueuePresentKHR failed (VkResult %d)\n", (int)r);
+    SDL_UnlockMutex(s_swap_mu);
+    if (dump) {
+        pvkWaitForFences(s_vk.device, 1, &s_fg.fence[slot], VK_TRUE, UINT64_MAX);
+        vk_invalidate(&s_fg.dump_buf);
+        static const char* tag[3] = { "a_before", "b_made", "c_after" };
+        for (int i = 0; i < 3; i++) {
+            char path[1024];
+            snprintf(path, sizeof path, "%s/vfg_%03u_%s.ppm", s_fg.dump_dir, s_fg.dump_files, tag[i]);
+            FILE* f = fopen(path, "wb");
+            if (!f) continue;
+            fprintf(f, "P6\n%u %u\n255\n", s_fg.W, s_fg.H);
+            const unsigned char* px = (const unsigned char*)s_fg.dump_buf.ptr + (size_t)s_fg.W * s_fg.H * 4u * (u32)i;
+            for (size_t j = 0; j < (size_t)s_fg.W * s_fg.H; j++) fwrite(px + j * 4u, 1, 3, f);
+            fclose(f);
+        }
+        VK_LOG("[framegen] dump %u written to %s\n", s_fg.dump_files, s_fg.dump_dir);
+        s_fg.dump_files++;
+    }
+}
