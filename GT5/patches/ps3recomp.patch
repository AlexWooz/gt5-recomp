+static int SDLCALL vfg_presenter(void* arg)
+{
+    (void)arg;
+    SDL_SetThreadPriority(SDL_THREAD_PRIORITY_HIGH);
+    const u64 hz = SDL_GetPerformanceFrequency();
+    for (;;) {
+        SDL_LockMutex(s_fg.mu);
+        while (!s_fg.mb_full && !s_fg.quit) SDL_CondWait(s_fg.cv, s_fg.mu);
+        if (s_fg.quit) { SDL_UnlockMutex(s_fg.mu); break; }
+        const vfg_item it = s_fg.mb;
+        s_fg.mb_full = 0;
+        SDL_UnlockMutex(s_fg.mu);
+        /* The made frames first, then the drawn one, then any repeats of it (VK_FRAMEGEN_REPEAT). */
+        const int total = it.made + 1 + it.again;
+        for (int i = 0; i < total; i++) {
+            /* A fast screen, or presents that don't wait for the refresh ([vsync] off): one game frame (59.94 Hz) apart. */
+            if (i > 0 && (s_fg.refresh_ms > 0 || vk_sync_free())) {
+                const double due_ms = i * 16.683;
+                for (;;) {
+                    const double at = (double)(SDL_GetPerformanceCounter() - it.t) * 1000.0 / (double)hz;
+                    if (at >= due_ms) break;
+                    SDL_Delay(due_ms - at > 2.0 ? 1u : 0u);
+                }
+            }
+            vfg_present_one(&it, i < it.made ? i + 1 : 0);
+            if (i < it.made || i == it.made) {
+                SDL_LockMutex(s_swap_mu);
+                vk_pace_note(1);
+                SDL_UnlockMutex(s_swap_mu);
+            }
+        }
+        SDL_LockMutex(s_fg.mu);
+        s_fg.done_seq = it.seq;
+        SDL_CondBroadcast(s_fg.cv);
+        SDL_UnlockMutex(s_fg.mu);
+    }
+    return 0;
+}
+
+/* Shutdown: the presenter stops; its objects go with the device (the process is ending). */
+static void vfg_stop(void)
+{
+    if (!s_fg.th) return;
+    SDL_LockMutex(s_fg.mu);
+    s_fg.quit = 1;
+    SDL_CondBroadcast(s_fg.cv);
+    SDL_UnlockMutex(s_fg.mu);
+    SDL_WaitThread(s_fg.th, NULL);
+    s_fg.th = NULL;
+    s_fg.failed = 1;
+}
+
+/* [res] The frame changed size (the Resolution setting): frame generation's images, buffers and the sizes compiled
+ * into its passes are the old frame's, so they go, its presenter thread with them, and are made again at the next
+ * frame it takes (vfg_setup, at the new size). Walker, present_mu held, the previous present complete; nothing it
+ * had given the presenter is shown any more (the frame before a change of size is not one to make frames from). */
+static void vfg_teardown(void)
+{
+    if (!s_fg.ready && !s_fg.th) return;
+    if (s_fg.th) {
+        SDL_LockMutex(s_fg.mu);
+        s_fg.quit = 1;
+        SDL_CondBroadcast(s_fg.cv);
+        SDL_UnlockMutex(s_fg.mu);
+        SDL_WaitThread(s_fg.th, NULL);
+        s_fg.th = NULL;
+    }
+    vk_device_idle();
+    for (int i = 0; i < VFG_SLOTS; i++) {
+        vk_image_free(&s_fg.frame[i]);
+        vk_destroy_buffer(&s_fg.lq[i]);
+        vk_destroy_buffer(&s_fg.ls[i]);
+    }
+    vk_image_free(&s_fg.mid);
+    vk_destroy_buffer(&s_fg.mvs); vk_destroy_buffer(&s_fg.mvq);
+    vk_destroy_buffer(&s_fg.mvf[0]); vk_destroy_buffer(&s_fg.mvf[1]);
+    vk_destroy_buffer(&s_fg.out); vk_destroy_buffer(&s_fg.dump_buf);
+    for (int p = 0; p < VFG_PASSES; p++) if (s_fg.pipe[p]) pvkDestroyPipeline(s_vk.device, s_fg.pipe[p], NULL);
+    if (s_fg.layout) pvkDestroyPipelineLayout(s_vk.device, s_fg.layout, NULL);
+    if (s_fg.dsl) pvkDestroyDescriptorSetLayout(s_vk.device, s_fg.dsl, NULL);
+    if (s_fg.dpool) pvkDestroyDescriptorPool(s_vk.device, s_fg.dpool, NULL);   /* its sets with it */
+    if (s_fg.samp) pvkDestroySampler(s_vk.device, s_fg.samp, NULL);
+    for (int i = 0; i < 3; i++) {
+        if (s_fg.fence[i]) pvkDestroyFence(s_vk.device, s_fg.fence[i], NULL);
+        if (s_fg.acq[i]) pvkDestroySemaphore(s_vk.device, s_fg.acq[i], NULL);
+    }
+    if (s_fg.cpool) pvkDestroyCommandPool(s_vk.device, s_fg.cpool, NULL);      /* its command buffers with it */
+    /* The lock and its condition stay (vfg_setup takes them again): the menu's readout locks it from the window's
+     * thread (vk_menu_stats), so the counters are cleared under it. */
+    SDL_mutex* const mu = s_fg.mu;
+    SDL_cond* const cv = s_fg.cv;
+    const int on = s_fg.on, repeat = s_fg.repeat, failed = s_fg.failed;
+    if (mu) SDL_LockMutex(mu);
+    memset(&s_fg, 0, sizeof s_fg);
+    s_fg.mu = mu; s_fg.cv = cv;
+    s_fg.on = on; s_fg.repeat = repeat; s_fg.failed = failed;
+    if (mu) SDL_UnlockMutex(mu);
+    s_vk.fg_this = 0;
+    VK_LOG("[framegen] the frame's size changed: made again at its next frame\n");
+}
