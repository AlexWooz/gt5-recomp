+        s_async_sh.queue[pick] = s_async_sh.queue[s_async_sh.head];
+        s_async_sh.head = (s_async_sh.head + 1u) % VK_ENG_MAX_PIPE;
+        /* Shutting down: the rest of the queue is dropped, not built (it ends
+         * as a failed build would), so quitting after a scene change does not
+         * wait for hundreds of shaders. */
+        const int quitting = s_async_sh.quit;
+        s_async_sh.busy++;
+        SDL_UnlockMutex(s_async_sh.mu);
+
+        vk_eng_pipe* P = &s_epipe[slot];
+        /* The walker took it first (a draw that couldn't wait in line): it clears pending. */
+        if (__atomic_exchange_n(&P->claimed, 1, __ATOMIC_ACQ_REL)) {
+            SDL_LockMutex(s_async_sh.mu); s_async_sh.busy--; SDL_UnlockMutex(s_async_sh.mu);
+            continue;
+        }
