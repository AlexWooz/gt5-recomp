+ * hardware that clock never stops while cellAudio runs, so a title's timeout there means its sound is
+ * gone (GT5 then drops its tick queue for good); here a host stall of a second fired it. NULL = none. */
+int (*g_sys_event_timeout_veto)(uint64_t key) = 0;
 
