+/* ---------------------------------------------------------------- the hash */
+
+/* Four lanes of 8 bytes, multiply and fold, then a final mix. Never change it: texture packs are
+ * named by it, so a change would orphan every pack made before. */
+static u64 tp_hash_run(const u8* p, u32 n, u64 seed)
+{
+    u64 a = seed ^ 0x9E3779B97F4A7C15ull, b = seed + 0xC2B2AE3D27D4EB4Full,
+        c = seed ^ 0x165667B19E3779F9ull, d = seed - 0x27D4EB2F165667C5ull;
+    u32 i = 0;
+    for (; i + 32 <= n; i += 32) {
+        u64 w0, w1, w2, w3;
+        memcpy(&w0, p + i, 8); memcpy(&w1, p + i + 8, 8); memcpy(&w2, p + i + 16, 8); memcpy(&w3, p + i + 24, 8);
+        a = (a ^ w0) * 0x9E3779B97F4A7C15ull; a ^= a >> 29;
+        b = (b ^ w1) * 0xC2B2AE3D27D4EB4Full; b ^= b >> 29;
+        c = (c ^ w2) * 0x165667B19E3779F9ull; c ^= c >> 29;
+        d = (d ^ w3) * 0xD6E8FEB86659FD93ull; d ^= d >> 29;
+    }
+    for (; i + 8 <= n; i += 8) { u64 w; memcpy(&w, p + i, 8); a = (a ^ w) * 0x9E3779B97F4A7C15ull; a ^= a >> 29; }
+    for (; i < n; i++) { b = (b ^ p[i]) * 0xC2B2AE3D27D4EB4Full; b ^= b >> 29; }
+    u64 h = a ^ (b * 31u) ^ (c * 961u) ^ (d * 29791u) ^ (u64)n;
+    h ^= h >> 33; h *= 0xff51afd7ed558ccdull; h ^= h >> 33; h *= 0xc4ceb9fe1a85ec53ull; h ^= h >> 33;
+    return h;
+}
+
+u64 rsx_texpack_hash(const u8* data, u32 row_bytes, u32 rows, u32 pitch, u32 tag, u32 w, u32 h, u32 remap)
+{
+    u64 x = 0x5450585445583130ull ^ ((u64)(tag & 0xFF) << 56) ^ ((u64)w << 36) ^ ((u64)h << 16) ^ (u64)(remap & 0xFFFF);
+    if (rows <= 1 || pitch == row_bytes)
+        x = tp_hash_run(data, row_bytes * (rows ? rows : 1), x);
+    else
+        for (u32 y = 0; y < rows; y++)
+            x = tp_hash_run(data + (size_t)y * pitch, row_bytes, x);
+    return x ? x : 1;
+}
+
+/* ---------------------------------------------------------------- stats */
