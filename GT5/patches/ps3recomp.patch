+    const u32 snap = z ? eng_zdepth_snapshot(zi, s_scn.b_sig.cw, s_scn.b_sig.ch) : 0;
+    if (!z || !snap || z->rs != sc->rs) { eng_up_miss(1, "no depth copy of the scene's size"); return; }
