+    *full_waits = g_ld_full_waits;
+    *wait_us = g_ld_fence_wait_us;
+}
+
+/* Has anything been drawn since the last time this said yes? GT5 reached a present twice per frame,
+ * the second with no draws at all: half of the presents in a race, each costing 13 ms and a full
+ * wait for the GPU, and each counted as a frame. LD_SKIP_EMPTY_PRESENT=0 presents them anyway. */
+int rsx_live_draw_present_needed(void)
+{
+    static int on = -1;
+    static unsigned long long last_groups, last_clears;
+    if (on < 0) { const char* e = getenv("LD_SKIP_EMPTY_PRESENT"); on = !e || atoi(e) != 0; }
+    if (!on || g_ld_movie_mode) return 1;
+    const unsigned long long groups = g_ld_stats.groups_seen, clears = g_ld_stats.clears;
+    /* A frame watch mode left out is never shown, even when a pass of it into a target only it
+     * updates (a name label, a cube face) was drawn: its display buffer was not drawn, and showing
+     * it would flash an old frame. */
+    if (g_ld_skip_frame) { last_groups = groups; last_clears = clears; return 0; }
+    if (groups == last_groups && clears == last_clears) return 0;
+    last_groups = groups;
+    last_clears = clears;
+    return 1;
+}
+#endif /* _WIN32 */
