+/* ---- VK_IMAGE_POOL: released images stand in for the next ones made the same (on by default on
+ * Windows and Linux; VK_IMAGE_POOL=0 turns it off, =1 turns it on elsewhere) ------------------------
+ * Steam Deck (radv), GT5 US 2.17, PGO build, alternated every 10 s: car select 16.9 vs 16.0 fps,
+ * a race paused on the grid 14.4 vs 12.1 (+19%), with ~800 images made and freed a second.
+ * Every image had memory of its own (vkAllocateMemory), and Windows makes and frees each allocation
+ * in the kernel: a GT5 race made and freed hundreds a second (textures the game rewrites, feedback
+ * copies, depth read as colour), and those calls were the walker's largest cost after the FIFO
+ * itself. A released image -- once the GPU is done with it: it leaves through the graves -- is kept
+ * here, and one made with the same format, size, levels, usage and view takes it instead of a new
+ * one. VK_IMAGE_POOL_MB caps what is kept (default 256); the oldest goes first. GCM_DRAIN_STAT=1
+ * prints a [vkalloc] line every 5 s. PS3_AB_WHAT=vkpool alternates it (tests). */
+#define VK_IPOOL_MAX 512
+static struct { vk_image im; u64 seq; } s_ipool[VK_IPOOL_MAX];
+static u32 s_ipool_n;
+static VkDeviceSize s_ipool_bytes, s_ipool_cap;
+static u64 s_ipool_seq;
+static unsigned long long s_ia_made, s_ia_taken, s_ia_freed, s_ia_kept;   /* [vkalloc] counts */
+
+static int vk_ipool_on(void)
+{
+    static int on = -1;
+    if (on < 0) {
+        const char* e = getenv("VK_IMAGE_POOL");
+#if defined(_WIN32) || defined(__linux__)
+        on = !e || atoi(e) != 0;        /* on unless VK_IMAGE_POOL=0 (measured on Windows and the Deck) */
+#else
+        on = e && atoi(e) != 0;
+#endif
+        const char* m = getenv("VK_IMAGE_POOL_MB");
+        s_ipool_cap = (VkDeviceSize)(m && atoi(m) > 0 ? atoi(m) : 256) << 20;
+    }
+    if (!on) return 0;
+    extern int ps3_ab_on(const char* what);
+    return ps3_ab_on("vkpool") != 0;
+}
+
+static void vk_image_free(vk_image* im)
+{
+    if (im->view) pvkDestroyImageView(s_vk.device, im->view, NULL);
+    if (im->img)  pvkDestroyImage(s_vk.device, im->img, NULL);
+    if (im->mem)  { pvkFreeMemory(s_vk.device, im->mem, NULL); s_ia_freed++; }
+    memset(im, 0, sizeof *im);
+}
+
+/* GCM_DRAIN_STAT: the images taken from the pool most, by format, size and usage ([vkalloc] top). */
+static int s_ia_stat = -1;
+static struct { u32 k[4]; u32 n; } s_ia_top[16];
+static void vk_ia_count(const u32 key[12])
+{
+    if (s_ia_stat < 0) s_ia_stat = getenv("GCM_DRAIN_STAT") ? 1 : 0;
+    if (!s_ia_stat) return;
+    const u32 k[4] = { key[0], key[1], key[2], key[6] };
+    u32 low = 0;
+    for (u32 i = 0; i < 16; i++) {
+        if (memcmp(s_ia_top[i].k, k, sizeof k) == 0) { s_ia_top[i].n++; return; }
+        if (s_ia_top[i].n < s_ia_top[low].n) low = i;
+    }
+    memcpy(s_ia_top[low].k, k, sizeof k);
+    s_ia_top[low].n = 1;
+}
+
+/* A pooled image made as `key` into *im (1), or 0. */
+static int vk_ipool_take(vk_image* im, const u32 key[12])
+{
+    if (!s_ipool_n || !vk_ipool_on()) return 0;
+    for (u32 i = 0; i < s_ipool_n; i++)
+        if (memcmp(s_ipool[i].im.key, key, sizeof s_ipool[i].im.key) == 0) {
+            *im = s_ipool[i].im;
+            s_ipool_bytes -= im->bytes;
+            s_ipool[i] = s_ipool[--s_ipool_n];
+            s_ia_taken++;
+            vk_ia_count(key);
+            return 1;
+        }
+    return 0;
+}
+
+/* An image the GPU is done with: kept in the pool (1) or freed (0). */
+static int vk_ipool_put(vk_image* im)
+{
+    if (!im->img || !im->mem || !im->key[0] || !vk_ipool_on() || im->bytes > s_ipool_cap / 4u) return 0;
+    while (s_ipool_n && (s_ipool_n == VK_IPOOL_MAX || s_ipool_bytes + im->bytes > s_ipool_cap)) {
+        u32 old = 0;
+        for (u32 i = 1; i < s_ipool_n; i++) if (s_ipool[i].seq < s_ipool[old].seq) old = i;
+        s_ipool_bytes -= s_ipool[old].im.bytes;
+        vk_image_free(&s_ipool[old].im);
+        s_ipool[old] = s_ipool[--s_ipool_n];
+    }
+    s_ipool[s_ipool_n].im = *im;
+    s_ipool[s_ipool_n].seq = ++s_ipool_seq;
+    s_ipool_n++;
+    s_ipool_bytes += im->bytes;
+    s_ia_kept++;
+    memset(im, 0, sizeof *im);
+    return 1;
+}
+
+/* Released for good (the graves, an idle destroy): to the pool, or freed. */
+static void vk_image_release_now(vk_image* im)
+{
+    if (!vk_ipool_put(im)) vk_image_free(im);
