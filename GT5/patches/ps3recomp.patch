+static void vfg_record(VkCommandBuffer cb) { (void)cb; s_vk.fg_this = 0; }
+static void vfg_hand_off(int submitted) { (void)submitted; }
+static void vfg_stop(void) {}
+static void vfg_teardown(void) {}
+#endif
