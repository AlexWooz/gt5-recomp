+/* The logical CPUs this process may run on (its affinity on Windows). */
+static int vk_usable_cpus(void)
+{
+#ifdef _WIN32
+    unsigned long long pm = 0, sm = 0;
+    int n = 0;
+    if (GetProcessAffinityMask(GetCurrentProcess(), &pm, &sm))
+        for (; pm; pm &= pm - 1) n++;
+    if (n > 0) return n;
+#endif
+    return SDL_GetCPUCount();
+}
+static int vk_shader_threads_auto(void)
+{
+    int n = vk_shader_boost() ? vk_usable_cpus() / 2 : SDL_GetCPUCount() / 4;
+    return n < 2 ? 2 : n;
