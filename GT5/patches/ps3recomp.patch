+        fclose(f);
+    }
+    if (n) {   /* the header (Vulkan 1.0): its length, version 1, vendor id, device id, cache UUID */
+        VkPhysicalDeviceProperties p;
+        pvkGetPhysicalDeviceProperties(s_vk.phys, &p);
+        u32 h[4];
+        memcpy(h, data, sizeof h);
+        if (h[0] < 32u || h[1] != 1u || h[2] != p.vendorID || h[3] != p.deviceID ||
+            memcmp(data + 16, p.pipelineCacheUUID, VK_UUID_SIZE) != 0)
+            n = 0;
+    }
+    VkPipelineCacheCreateInfo ci = { .sType = VK_STRUCTURE_TYPE_PIPELINE_CACHE_CREATE_INFO,
+                                     .initialDataSize = n, .pInitialData = n ? data : NULL };
+    if (pvkCreatePipelineCache(s_vk.device, &ci, NULL, &s_pcd.pc) != VK_SUCCESS) s_pcd.pc = VK_NULL_HANDLE;
+    s_pcd.had_file = n != 0;
+    VK_LOG("engine: pipeline cache %s: %s, %zu bytes (VK_PIPELINE_DISK_CACHE)\n", s_pcd.path,
+           !s_pcd.pc ? "could not be made" : n ? "read" : found ? "not this GPU's or driver's, a new one" : "new", n);
+    free(data);
+}
+
+/* Any thread: written back with `least` or more pipelines made since it last was. One writer at a time. */
+static void vk_pcd_save(u32 least)
+{
+    if (!s_pcd.pc) return;
+    const u32 fresh = __atomic_load_n(&s_pcd.fresh, __ATOMIC_RELAXED);
+    if (fresh < least || __atomic_exchange_n(&s_pcd.saving, 1, __ATOMIC_ACQ_REL)) return;
+    __atomic_sub_fetch(&s_pcd.fresh, fresh, __ATOMIC_RELAXED);
+    size_t n = 0;
+    if (pvkGetPipelineCacheData(s_vk.device, s_pcd.pc, &n, NULL) == VK_SUCCESS && n) {
+        void* d = malloc(n);
+        if (d && pvkGetPipelineCacheData(s_vk.device, s_pcd.pc, &n, d) == VK_SUCCESS) {
+            char tmp[1120];
+            snprintf(tmp, sizeof tmp, "%s.tmp", s_pcd.path);
+            FILE* f = fopen(tmp, "wb");
+            int ok = f && fwrite(d, 1, n, f) == n;
+            if (f) ok = (fclose(f) == 0) && ok;
+#ifdef _WIN32
+            if (ok) remove(s_pcd.path);       /* rename does not replace on Windows */
+#endif
+            if (!ok || rename(tmp, s_pcd.path) != 0) remove(tmp);
+        }
+        free(d);
+    }
+    __atomic_store_n(&s_pcd.saving, 0, __ATOMIC_RELEASE);
+}
+
+static int SDLCALL vk_pb_thread(void* arg)
+{
+    (void)arg;
+    s_vk_in_worker = 1;
+    s_vk_in_prebuild = 1;
+    SDL_SetThreadPriority(SDL_THREAD_PRIORITY_LOW);
+    for (u32 i = 0; ; i++) {
+        SDL_LockMutex(s_pb.mu);
+        if (i >= s_pb.ntab) { SDL_UnlockMutex(s_pb.mu); break; }
+        vk_pb_ent* e = &s_pb.tab[i];
+        const int todo = e->state == 0;
+        vk_eng_pipe P = e->P;
+        const u32 topos = e->topos;
+        SDL_UnlockMutex(s_pb.mu);
+        if (!todo) continue;
+        P.vs = vk_pb_module(e->r.vs_h);
+        P.fs = P.vs ? vk_pb_module(e->r.ps_h) : VK_NULL_HANDLE;
+        int ok = P.vs && P.fs;
+        for (u32 t = 0; ok && t < VK_ENG_TOPOLOGIES; t++)
+            if (topos & (1u << t)) ok = vk_eng_variant(&P, t) != VK_NULL_HANDLE;
+        SDL_LockMutex(s_pb.mu);
+        if (ok && e->state == 0) { e->P = P; e->state = 1; s_pb.built++; P.vs = P.fs = VK_NULL_HANDLE; memset(P.variant, 0, sizeof P.variant); }
+        else if (!ok) { e->state = 2; s_pb.failed++; }
+        SDL_UnlockMutex(s_pb.mu);
+        for (u32 t = 0; t < VK_ENG_TOPOLOGIES; t++) if (P.variant[t]) pvkDestroyPipeline(s_vk.device, P.variant[t], NULL);
+        if (P.vs) pvkDestroyShaderModule(s_vk.device, P.vs, NULL);
+        if (P.fs) pvkDestroyShaderModule(s_vk.device, P.fs, NULL);
+    }
+    VK_LOG("engine: %u pipelines built ahead from an earlier session's list (%u could not be, %u were"
+           " asked for first and left to the workers)\n", s_pb.built, s_pb.failed, s_pb.left);
+    if (!s_pcd.had_file) { __atomic_add_fetch(&s_pcd.fresh, 1u, __ATOMIC_RELAXED); vk_pcd_save(1); }
+    return 0;
+}
+
+/* On the walker, at the first pipeline: read the list, make what the builds need that only the walker
+ * may make (render passes, the split layout), start the builder. */
+static int vk_pb_on(void)
+{
+    if (s_pb.decided) return s_pb.on;
+    s_pb.decided = 1;
+    const char* dir = getenv("PS3RECOMP_SPIRV_CACHE");
+    const char* pe = getenv("VK_PIPELINE_PREBUILD");
+#ifdef _WIN32
+    const int want = !pe || atoi(pe) != 0;   /* on unless VK_PIPELINE_PREBUILD=0 (measured on Windows) */
+#else
+    const int want = pe && atoi(pe) != 0;
+#endif
+    if (!want || !dir || !*dir || !vk_async_shaders()) return 0;
+    snprintf(s_pb.list, sizeof s_pb.list, "%s/vk_pipelines.lst", dir);
+    const char* me = getenv("VK_PB_MRU");
+    s_pb.mru = vk_shader_boost() && !(me && *me && atoi(me) == 0);
+    const u64 t0 = SDL_GetPerformanceCounter();
+    s_pb.mu = SDL_CreateMutex();
+    s_pb.seen = (vk_pb_slot*)calloc(VK_PB_SEEN, sizeof(vk_pb_slot));
+    s_pb.idx = (vk_pb_slot*)calloc(VK_PB_IDX, sizeof(vk_pb_slot));
+    s_pb.tab = (vk_pb_ent*)calloc(VK_PB_MAX, sizeof(vk_pb_ent));
+    if (!s_pb.mu || !s_pb.seen || !s_pb.idx || !s_pb.tab) return 0;
+    FILE* f = fopen(s_pb.list, "rb");
+    u32 read = 0, nrec = 0, kept = 0, from = 0;
+    vk_pb_rec* recs = NULL;
+    if (f && s_pb.mru && fseek(f, 0, SEEK_END) == 0) {
+        /* VK_PB_MRU: the whole file (written back at VK_PB_MAX records at most, so it holds that plus
+         * what one session added), or its newest 8 * VK_PB_MAX records */
+        const long sz = ftell(f);
+        const u32 total = sz > 0 ? (u32)((unsigned long)sz / sizeof(vk_pb_rec)) : 0u;
+        from = total > VK_PB_MAX * 8u ? total - VK_PB_MAX * 8u : 0u;
+        if (total && fseek(f, (long)(from * sizeof(vk_pb_rec)), SEEK_SET) == 0 &&
+            (recs = (vk_pb_rec*)malloc(sizeof(vk_pb_rec) * (total - from))) != NULL)
+            nrec = (u32)fread(recs, sizeof(vk_pb_rec), total - from, f);
+    }
+    u32* keep = s_pb.mru && nrec ? (u32*)malloc(sizeof(u32) * VK_PB_MAX) : NULL;
+    for (u32 i = 0; f; i++) {
+        vk_pb_rec r;
+        if (s_pb.mru) {   /* newest first */
+            if (!keep || i >= nrec || kept == VK_PB_MAX) break;
+            r = recs[nrec - 1u - i];
+        } else if (s_pb.nseen >= VK_PB_MAX || fread(&r, sizeof r, 1, f) != 1) break;
+        /* Written by this build's layout and render-state hash, or left out: a record from a
+         * build whose state struct or hash differs could otherwise build the wrong pipeline. */
+        if (r.magic != 0x31425056u || r.topo >= VK_ENG_TOPOLOGIES || r.pad != (u32)sizeof r ||
+            rsx_draw_engine_hash_render_state(&r.rs, 0xcbf29ce484222325ull) != r.rs_h)
+            continue;
+        vk_eng_pipe P; memset(&P, 0, sizeof P);
+        P.vs_h = r.vs_h; P.ps_h = r.ps_h; P.rs_h = r.rs_h; P.nslots = r.nslots; P.stride = r.stride;
+        P.rt_count = r.rt_count & 0xFFu; P.rt_fmt = (VkFormat)r.rt_fmt; P.cube_mask = r.cube_mask; P.rs = r.rs;
+        P.mv = (r.rt_count & RSX_BE_RT_MV) != 0;   /* [mv] carried in the record's rt_count */
+        P.nrs_h = vk_eng_vk_state_hash(&r.rs);
+        P.dkey = vk_eng_vk_key(&P);
+        const u64 key = vk_pb_reckey(&r, P.dkey);
+        vk_pb_slot* s = vk_pb_slot_at(s_pb.seen, VK_PB_SEEN, key);
+        if (s->used) continue;   /* an older copy of a record read already */
+        s->used = 1; s->key = key; s->val = !s_pb.mru; s_pb.nseen++;
+        read++;
+        if (keep) keep[kept++] = nrec - 1u - i;
+        u32 k = 0;
+        vk_pb_slot* x = NULL;
+        if (s_pb.mru) { x = vk_pb_slot_at(s_pb.idx, VK_PB_IDX, P.dkey); k = x->used ? x->val : s_pb.ntab; }
+        else while (k < s_pb.ntab && !vk_pb_same(&s_pb.tab[k].r, &P)) k++;
+        if (k == s_pb.ntab) {
+            if (s_pb.ntab == VK_PB_MAX || !vk_eng_pass_of(&P) ||
+                (P.cube_mask && !vk_eng_split_layout())) continue;
+            s_pb.tab[k].r = r; s_pb.tab[k].P = P; s_pb.ntab++;
+            if (x) { x->used = 1; x->key = P.dkey; x->val = k; }
+        }
+        s_pb.tab[k].topos |= 1u << r.topo;
+    }
+    if (f) fclose(f);
+    if (keep && (kept < nrec || from)) {   /* written back: the kept records, oldest first; then appended to */
+        char tmp[1120];
+        snprintf(tmp, sizeof tmp, "%s.tmp", s_pb.list);
+        FILE* o = fopen(tmp, "wb");
+        int ok = o != NULL;
+        for (u32 j = kept; ok && j-- > 0; ) ok = fwrite(&recs[keep[j]], sizeof(vk_pb_rec), 1, o) == 1;
+        if (o) ok = (fclose(o) == 0) && ok;
+#ifdef _WIN32
+        if (ok) remove(s_pb.list);       /* rename does not replace on Windows */
+#endif
+        if (!ok || rename(tmp, s_pb.list) != 0) remove(tmp);
+    }
+    free(keep);
+    free(recs);
+    s_pb.out = fopen(s_pb.list, "ab");
+    s_pb.on = 1;
+    VK_LOG("engine: pipeline list %s: %u entries (%u records), %u pipelines to build ahead, read in %.1f ms"
+           " (VK_PIPELINE_PREBUILD, %s)\n", s_pb.list, read, s_pb.mru ? nrec : read, s_pb.ntab,
+           (double)(SDL_GetPerformanceCounter() - t0) * 1000.0 / (double)SDL_GetPerformanceFrequency(),
+           s_pb.mru ? "most recently used first" : "VK_PB_MRU=0: in file order");
+    vk_pcd_open(dir);   /* VK_PIPELINE_DISK_CACHE, before anything builds */
+    if (s_pb.ntab) s_pb.th = SDL_CreateThread(vk_pb_thread, "vk-prebuild", NULL);
+    return 1;
+}
+
+/* On the walker: P (its names, state key and layout set) is built already: take its programs and
+ * variants. 1 when taken. One the builder hasn't reached yet is left to the shader workers
+ * (VK_SHADER_BOOST): the builder skips it instead of building it a second time, later, for nothing. */
+static int vk_pb_take(vk_eng_pipe* P)
+{
+    int got = 0;
+    const u64 t0 = SDL_GetPerformanceCounter();
+    SDL_LockMutex(s_pb.mu);
+    if (s_pb.mru) {   /* one entry per Vulkan pipeline, found by its key; taken = used: newest in the list */
+        const vk_pb_slot* x = vk_pb_slot_at(s_pb.idx, VK_PB_IDX, P->dkey);
+        vk_pb_ent* e = x->used ? &s_pb.tab[x->val] : NULL;
+        if (e && e->state == 0) { e->state = 2; s_pb.left++; }
+        else if (e && e->state == 1) {
+            P->vs = e->P.vs; P->fs = e->P.fs;
+            memcpy(P->variant, e->P.variant, sizeof P->variant);
+            e->state = 2;
+            s_pb.taken++;
+            got = 1;
+            for (u32 t = 0; t < VK_ENG_TOPOLOGIES; t++) {
+                if (!(e->topos & (1u << t))) continue;
+                vk_pb_rec r = e->r;
+                r.topo = t;
+                vk_pb_put(&r, vk_pb_reckey(&r, P->dkey), 0);   /* flushed with the next new one */
+            }
+        }
+        SDL_UnlockMutex(s_pb.mu);
+        s_pb.take_ticks += SDL_GetPerformanceCounter() - t0;
+        return got;
+    }
+    for (u32 k = 0; k < s_pb.ntab; k++) {
+        vk_pb_ent* e = &s_pb.tab[k];
+        if (e->state == 0 && vk_shader_boost() && vk_pb_same(&e->r, P)) { e->state = 2; s_pb.left++; break; }
+        if (e->state != 1 || !vk_pb_same(&e->r, P)) continue;
+        P->vs = e->P.vs; P->fs = e->P.fs;
+        memcpy(P->variant, e->P.variant, sizeof P->variant);
+        e->state = 2;
+        s_pb.taken++;
+        got = 1;
+        break;
+    }
+    SDL_UnlockMutex(s_pb.mu);
+    s_pb.take_ticks += SDL_GetPerformanceCounter() - t0;
+    return got;
+}
+
+/* VK_SHADER_LOG: a [vkpb] line when the list's counts moved. */
+static void vk_pb_log(void)
+{
+    static u32 last;
+    if (!s_pb.on) return;
+    const u32 n = s_pb.built + s_pb.taken + s_pb.left + s_pb.touched + s_pb.nseen;
+    if (n == last) return;
+    last = n;
+    VK_LOG("[vkpb] built ahead %u, taken %u, left to the workers %u, list records written again %u, keys %u,"
+           " walker %.2f ms finding them\n", s_pb.built, s_pb.taken, s_pb.left, s_pb.touched, s_pb.nseen,
+           (double)s_pb.take_ticks * 1000.0 / (double)SDL_GetPerformanceFrequency());
+}
