+/* ---- [fill] LD_FILL (default 1; 0 = as before): the picture fills the window ----------------------
+ * The DirectX 12 engine's (rsx_live_draw.c, [fill]), for the renderers on this engine (Vulkan).
+ * GT5 draws everything it shows inside a display margin (1728x972 at 96,54 of 1920x1080, the 90 % of its
+ * option display_margin_hd) and paints the rest black with one untextured strip over the whole frame:
+ * on a PC, a black border on all four sides. What the picture occupies is read from what lands in a
+ * display buffer every frame: the union of the colour draws' viewport-within-scissor and the guest's
+ * writes into one, leaving out draws that cover the whole frame without reading a texture (that strip,
+ * a full-frame fill or fade). That rect, widened to the frame's shape about its centre, is what the
+ * window shows (rsx_draw_engine_fill: the backend takes that part of the frame for its step into the
+ * window). It widens at once when a frame draws outside it (never a cropped frame), narrows only after
+ * LD_FILL_FRAMES (60) frames that drew something all stayed inside a smaller rect, and within half a
+ * percent of the frame it is the whole frame; it starts as the whole frame. Frames that draw nothing into
+ * a display buffer have no say. The frame itself (dumps, readback, frame generation's history) is the
+ * game's whole frame as before. A "[fill]" line says each change. */
+void cellVideoOut_scanout_size(u32* w, u32* h);   /* cellVideoOut.c */
+static struct {
+    int   mode;                 /* -1 not read yet, 0 off, 1 on */
+    u32   frames;
+    int   have;                 /* this frame put something into r */
+    float r[4];                 /* its union: x0, y0, x1, y1, guest pixels */
+    float cur[4];               /* the rect in force */
+    u32   fw, fh;               /* the frame cur belongs to */
+    int   win_have;
+    float win[4];
+    u32   win_n;
+    int   on;
+    u32   n_present;
+} s_fill = { .mode = -1 };
+static u64 s_fill_pub;          /* what the backend reads (any thread): 0 = the whole frame, else x0 y0 x1 y1
+                                   as 16-bit fractions of the frame, x0 in the low bits */
+
+static int eng_is_display(u32 slot)
+{
+    if (slot >= g.n_surfaces) return 0;
+    for (u32 b = 0; b < 8; b++)
+        if (g.display_buffers[b].valid && g.display_buffers[b].location == g.surfaces[slot].location &&
+            g.display_buffers[b].offset == g.surfaces[slot].offset)
+            return 1;
+    return 0;
+}
+
+static void eng_fill_note(float x0, float y0, float x1, float y1)
+{
+    const float W = (float)s_fill.fw, H = (float)s_fill.fh;
+    if (!s_fill.fw || !s_fill.fh) return;
+    if (x0 < 0.0f) x0 = 0.0f;
+    if (y0 < 0.0f) y0 = 0.0f;
+    if (x1 > W) x1 = W;
+    if (y1 > H) y1 = H;
+    if (!(x1 > x0) || !(y1 > y0)) return;
+    if (!s_fill.have) { s_fill.r[0] = x0; s_fill.r[1] = y0; s_fill.r[2] = x1; s_fill.r[3] = y1; s_fill.have = 1; return; }
+    if (x0 < s_fill.r[0]) s_fill.r[0] = x0;
+    if (y0 < s_fill.r[1]) s_fill.r[1] = y0;
+    if (x1 > s_fill.r[2]) s_fill.r[2] = x1;
+    if (y1 > s_fill.r[3]) s_fill.r[3] = y1;
+}
+
+/* A recorded draw: one that writes colour into a display buffer adds its viewport within its scissor,
+ * unless it covers the whole frame without reading a texture. */
+static void eng_fill_draw(u32 target, const rsx_dsp_viewport* vp, int writes_colour, u32 tex_mask)
+{
+    if (s_fill.mode <= 0 || !writes_colour || !eng_is_display(target)) return;
+    const float W = (float)s_fill.fw, H = (float)s_fill.fh;
+    float x0 = (float)vp->x, y0 = (float)vp->y, x1 = (float)vp->x + (float)vp->w, y1 = (float)vp->y + (float)vp->h;
+    if (!vp->w || !vp->h) { x0 = 0.0f; y0 = 0.0f; x1 = W; y1 = H; }
+    if (g.rsx.seen[M_SCISSOR_HORIZONTAL >> 2] || g.rsx.seen[M_SCISSOR_VERTICAL >> 2]) {
+        const u32 sh = rsx_dsp_reg(&g.rsx, M_SCISSOR_HORIZONTAL), sv = rsx_dsp_reg(&g.rsx, M_SCISSOR_VERTICAL);
+        const float sx0 = (float)(sh & 0xFFFFu), sy0 = (float)(sv & 0xFFFFu);
+        const float sx1 = sx0 + (float)(sh >> 16), sy1 = sy0 + (float)(sv >> 16);
+        if (sx0 > x0) x0 = sx0;
+        if (sy0 > y0) y0 = sy0;
+        if (sx1 < x1) x1 = sx1;
+        if (sy1 < y1) y1 = sy1;
+    }
+    if (!(x1 > x0) || !(y1 > y0)) return;
+    if (x0 <= 0.5f && y0 <= 0.5f && x1 >= W - 0.5f && y1 >= H - 0.5f && !tex_mask) return;   /* the border strip */
+    eng_fill_note(x0, y0, x1, y1);
+}
+
+static void eng_fill_guest_wrote(u32 slot, u32 x, u32 y, u32 rw, u32 rh)
+{
+    if (s_fill.mode > 0 && eng_is_display(slot)) eng_fill_note((float)x, (float)y, (float)(x + rw), (float)(y + rh));
+}
+
+/* b widened to the frame's shape about its centre, kept inside the frame. */
+static void eng_fill_fit(float* b)
+{
+    const float W = (float)s_fill.fw, H = (float)s_fill.fh, a = W / H;
+    float rw = b[2] - b[0], rh = b[3] - b[1];
+    if (rw < rh * a) rw = rh * a; else rh = rw / a;
+    if (rw > W) rw = W;
+    if (rh > H) rh = H;
+    float x0 = (b[0] + b[2]) * 0.5f - rw * 0.5f, y0 = (b[1] + b[3]) * 0.5f - rh * 0.5f;
+    if (x0 < 0.0f) x0 = 0.0f;
+    if (y0 < 0.0f) y0 = 0.0f;
+    if (x0 + rw > W) x0 = W - rw;
+    if (y0 + rh > H) y0 = H - rh;
+    b[0] = x0; b[1] = y0; b[2] = x0 + rw; b[3] = y0 + rh;
+}
