diff --git a/runtime/settings/gt5_settings.h b/runtime/settings/gt5_settings.h
new file mode 100644
--- /dev/null
+++ b/runtime/settings/gt5_settings.h
@@ -0,0 +1,193 @@
+/*
+ * gt5_settings - the settings registry of the GT5 PC port: the one place that says which settings
+ * exist, what they are called on screen, what values they take and whether a change counts at once.
+ *
+ * A setting's key is its environment-variable name (PS3_VIDEO_MODE, LD_WATCH, ...): the launcher
+ * writes them to GT5\settings.bat as `set "NAME=value"` lines, play.bat runs that file, and the game
+ * starts with them in its environment. The registry starts from that environment, the in-game menu
+ * changes values through it, and gt5_settings_save() writes them back to settings.bat in the
+ * launcher's own format (same header, same order, the player's own lines kept), so the launcher and
+ * the menu can both edit the same file.
+ *
+ * Values are text, exactly as in the file ("" = not set). Readers ask with a typed getter and the
+ * value they want for "not set":
+ *
+ *     static int v; static unsigned gen = ~0u;
+ *     if (gen != gt5_settings_gen()) { gen = gt5_settings_gen(); v = gt5_setting_int("LD_WATCH", 0); }
+ *
+ * gt5_settings_gen() is one load of a global, so the test is free on a hot path. Getters may be called
+ * from any thread; setters from any thread too (the menu's is the window thread).
+ *
+ * Plain C, no dependencies beyond the C library (and Win32 for the file). C++ can include it.
+ */
+#ifndef GT5_SETTINGS_H
+#define GT5_SETTINGS_H
+
+#include <stddef.h>
+
+/* LD_SHADERS (Display > New shaders) when the player has not chosen: 0 = wait for them, 1 = build them in the
+ * background (a 3D-scene draw whose pipeline is not ready is left out until it is: rsx_live_draw.c [nowait]).
+ * The menu's row (gt5_settings_table.h) and the renderer follow this; the launcher has the same constant
+ * (GT5Launcher.cs, ShadersBgDefault): flip both together. */
+#define GT5_SHADERS_BG_DEFAULT 1
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef enum {
+    GT5_SET_BOOL,     /* on_value / off_value                               */
+    GT5_SET_INT,      /* num_min..num_max in num_step; num_def saves as ""  */
+    GT5_SET_FLOAT,    /* the same, with decimals ("0.#", '.' always)        */
+    GT5_SET_CHOICE,   /* one of choices[]                                   */
+    GT5_SET_STRING    /* free text (key maps, device names)                 */
+} gt5_setting_type;
+
+typedef enum {
+    GT5_APPLY_LIVE,      /* counts at once (its reader follows gt5_settings_gen)  */
+    GT5_APPLY_RESTART    /* counts the next time the game starts                  */
+} gt5_setting_apply;
+
+typedef enum {
+    GT5_PAGE_DISPLAY, GT5_PAGE_PERFORMANCE, GT5_PAGE_CONTROLS, GT5_PAGE_GAME, GT5_PAGE_SOUND, GT5_PAGE_ABOUT,
+    GT5_PAGE_COUNT,
+    GT5_PAGE_NONE = -1   /* kept and saved, never shown (the launcher's own keys) */
+} gt5_setting_page;
+
+enum {
+    GT5_SF_LAUNCHER   = 1 << 0,  /* one of the launcher's keys: always written to settings.bat          */
+    GT5_SF_NO_ROW     = 1 << 1,  /* the menu draws no row of its own for it (part of another row)       */
+    GT5_SF_NEEDS_HOST = 1 << 2,  /* nothing reads it until the renderer says so: gt5_setting_enable()   */
+    GT5_SF_ENABLED    = 1 << 3,  /* ... and it has                                                      */
+    GT5_SF_SPEED_KEY  = 1 << 4,  /* one of the keys the launcher's Speed lines override (LD_WATCH...)   */
+    GT5_SF_NOT_ENV    = 1 << 5,  /* nothing in the game reads it from the environment (the launcher's own) */
+    GT5_SF_HIDDEN     = 1 << 6   /* the renderer in use does nothing with it: no row (gt5_setting_hide)    */
+};
+
+enum { GT5_CF_UNAVAILABLE = 1 << 0 };   /* a choice the menu shows greyed out (DLSS before it exists) */
+
+typedef struct gt5_choice {
+    const char* value;       /* what is stored */
+    const char* label_en;
+    const char* label_zh;    /* NULL = the English one */
+    unsigned    flags;       /* GT5_CF_* (the registry keeps a writable copy) */
+} gt5_choice;
+
+typedef struct gt5_setting_def {
+    const char*        key;
+    gt5_setting_type   type;
+    gt5_setting_apply  apply;
+    gt5_setting_page   page;
+    unsigned           flags;        /* GT5_SF_* */
+    const char*        def;          /* the launcher's default: what a fresh settings.bat gets ("" = not set) */
+    const char*        label_en;
+    const char*        label_zh;
+    const char*        help_en;      /* NULL = none */
+    const char*        help_zh;
+    /* GT5_SET_BOOL */
+    const char*        on_value;     /* "1" */
+    const char*        off_value;    /* "" */
+    /* GT5_SET_INT / GT5_SET_FLOAT */
+    double             num_min, num_max, num_step, num_def;
+    const char*        unit;         /* "%", NULL = none */
+    /* GT5_SET_CHOICE */
+    const gt5_choice*  choices;
+    int                n_choices;
+} gt5_setting_def;
+
+/* ---- start-up ------------------------------------------------------------------------------------ */
+
+/* Fills the registry from the process environment and from settings.bat (settings_path, or NULL to
+ * find it: $GT5_SETTINGS_FILE, else settings.bat one folder above the exe's, else in the working
+ * folder). The file matters for two things the environment can't say: the player's own value of a key
+ * the Speed lines override, and what to leave alone when saving. Safe to call again (it starts over).
+ * Getters called before it answer from the environment, so nothing depends on call order at start. */
+void gt5_settings_init(const char* settings_path);
+/* The file in use ("" before gt5_settings_init). */
+const char* gt5_settings_path(void);
+
+/* ---- reading ------------------------------------------------------------------------------------- */
+
+/* Counts every change. Readers keep the number they last saw (see the pattern above). */
+extern volatile unsigned g_gt5_settings_gen;
+#define gt5_settings_gen() (g_gt5_settings_gen)
+
+/* The value in force, into buf (always terminated); returns its length. "" = not set. In force means
+ * after the overrides the table lists (k_overrides; none now: the launcher's old Speed lines, with
+ * GT5_SPEED=30 LD_WATCH=2 and the like, are gone and a file that still has them is read without them).
+ * A key the registry doesn't list is answered from settings.bat's own line for it, else from the
+ * environment. */
+size_t gt5_setting_str(const char* key, char* buf, size_t cap);
+int    gt5_setting_int(const char* key, int if_unset);
+double gt5_setting_float(const char* key, double if_unset);
+/* 1 unless the value is "", "0", "off", "no" or "false". */
+int    gt5_setting_bool(const char* key, int if_unset);
+/* 1 when the value is exactly `value` (case ignored); "" matches "not set". */
+int    gt5_setting_is(const char* key, const char* value);
+
+/* The stored value: the player's own, without the Speed overrides. What the menu shows and edits. */
+size_t gt5_setting_stored(const char* key, char* buf, size_t cap);
+/* The value the game started with (in force then). A GT5_APPLY_RESTART setting whose stored value
+ * differs from it is waiting for a restart. */
+size_t gt5_setting_boot(const char* key, char* buf, size_t cap);
+int    gt5_setting_pending_restart(const char* key);
+
+/* ---- changing ------------------------------------------------------------------------------------ */
+
+/* Stores a value ("" or NULL = not set). Returns 1 when it changed: the generation moves on, the
+ * process environment follows (so code still on getenv sees it the next time it asks), change
+ * callbacks run on this thread, and the setting waits to be saved. */
+int gt5_setting_set(const char* key, const char* value);
+int gt5_setting_set_int(const char* key, int value);
+/* Numbers are stored the way the launcher writes them: the default as "", else "0.#" with a '.'. */
+int gt5_setting_set_number(const char* key, double value);
+/* Back to the launcher's default. */
+int gt5_setting_reset(const char* key);
+
+/* 1: a change is also put into the process environment (_putenv_s / setenv), for code still on
+ * getenv. Off by default: the C library's getenv isn't safe against a putenv on another thread. */
+void gt5_settings_mirror_env(int on);
+
+/* fn runs after key changed (key NULL: after any change), on the thread that made the change. */
+typedef void (*gt5_setting_changed_fn)(const char* key, const char* old_value, const char* new_value, void* user);
+void gt5_settings_on_change(const char* key, gt5_setting_changed_fn fn, void* user);
+
+/* ---- what the menu needs --------------------------------------------------------------------------- */
+
+int                    gt5_settings_count(void);
+const gt5_setting_def* gt5_settings_at(int index);
+const gt5_setting_def* gt5_settings_find(const char* key);
+/* The renderer (or whoever reads the setting) says what this build can do. */
+void gt5_setting_enable(const char* key, int enabled);                         /* GT5_SF_NEEDS_HOST settings  */
+void gt5_setting_choice_enable(const char* key, const char* value, int enabled); /* a greyed-out choice         */
+/* Why that choice is greyed out, for the player (at most ~110 characters; "" clears it). Any thread. */
+void gt5_setting_choice_note(const char* key, const char* value, const char* note);
+int  gt5_setting_choice_note_of(const char* key, int choice_index, char* out, unsigned cap); /* 1 = has one */
+void gt5_setting_set_apply(const char* key, gt5_setting_apply apply);          /* e.g. not converted yet      */
+/* The renderer in use does nothing with this setting: the menu shows no row for it (the value is kept and
+ * saved as it is). Call after gt5_settings_init (or the menu's start), which shows every row again. */
+void gt5_setting_hide(const char* key, int hidden);
+unsigned gt5_setting_flags(const char* key);                                   /* GT5_SF_*, live copy         */
+gt5_setting_apply gt5_setting_apply_of(const char* key);
+unsigned gt5_setting_choice_flags(const char* key, int choice_index);          /* GT5_CF_*, live copy         */
+
+/* ---- saving ---------------------------------------------------------------------------------------- */
+
+/* 1 when a change hasn't been written yet. */
+int gt5_settings_dirty(void);
+/* Writes settings.bat in the launcher's format. The file is read again first: a key changed here
+ * since the last load or save takes this value, every other key keeps the file's (so an edit made by
+ * hand or by the launcher meanwhile survives), and lines that aren't settings are kept as written.
+ * Written to a temporary file next to it and renamed over it, so a crash never leaves half a file.
+ * Returns 1 on success, 0 on failure (the reason goes to stderr); nothing to save counts as success. */
+int gt5_settings_save(void);
+
+/* ---- for tests ------------------------------------------------------------------------------------- */
+
+/* The text gt5_settings_save() would write, into a malloc'd string (free it). NULL on failure. */
+char* gt5_settings_render(void);
+
+#ifdef __cplusplus
+}
+#endif
+#endif /* GT5_SETTINGS_H */
