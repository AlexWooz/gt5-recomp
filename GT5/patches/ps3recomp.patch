+    "[[vk::binding(0, 0)]] RWStructuredBuffer<uint> buf;\n"
+    "[[vk::push_constant]] cbuffer PC { uint pc_count; uint pc_unorm24; uint pc_row; uint pc_sbase; };\n"
+    "uint round24(float d) {\n"
+    "    if (d >= 1.0) return 0xFFFFFFu;\n"
+    "    if (!(d > 0.0)) return 0u;\n"
+    "    uint b = asuint(d);\n"
+    "    uint e = (b >> 23) & 0xFFu;\n"
+    "    uint m = (b & 0x7FFFFFu) | (e != 0u ? 0x800000u : 0u);\n"
+    "    uint s = 150u - max(e, 1u);\n"
+    "    if (s >= 64u) return 0u;\n"
+    "    uint lo0 = (m & 0xFFu) << 24;\n"
+    "    uint hi = m >> 8;\n"
+    "    uint lo = lo0 - m;\n"
+    "    if (lo0 < m) hi -= 1u;\n"
+    "    uint r = s - 1u;\n"
+    "    if (r < 32u) { uint l2 = lo + (1u << r); if (l2 < lo) hi += 1u; lo = l2; }\n"
+    "    else hi += 1u << (r - 32u);\n"
+    "    return s < 32u ? ((lo >> s) | (hi << (32u - s))) : (hi >> (s - 32u));\n"
+    "}\n"
+    "uint round16(float d) {\n"
+    "    if (d >= 1.0) return 0xFFFFu;\n"
+    "    if (!(d > 0.0)) return 0u;\n"
+    "    uint b = asuint(d);\n"
+    "    uint e = (b >> 23) & 0xFFu;\n"
+    "    uint m = (b & 0x7FFFFFu) | (e != 0u ? 0x800000u : 0u);\n"
+    "    uint s = 150u - max(e, 1u);\n"
+    "    if (s >= 64u) return 0u;\n"
+    "    uint lo0 = (m & 0xFFFFu) << 16;\n"
+    "    uint hi = m >> 16;\n"
+    "    uint lo = lo0 - m;\n"
+    "    if (lo0 < m) hi -= 1u;\n"
+    "    uint r = s - 1u;\n"
+    "    if (r < 32u) { uint l2 = lo + (1u << r); if (l2 < lo) hi += 1u; lo = l2; }\n"
+    "    else hi += 1u << (r - 32u);\n"
+    "    return s < 32u ? ((lo >> s) | (hi << (32u - s))) : (hi >> (s - 32u));\n"
