+/* Walker, after the present's command buffer was submitted: the presenter takes the frame. */
+static void vfg_hand_off(int submitted)
+{
+    if (!s_fg.pending) return;
+    s_fg.pending = 0;
+    if (!submitted) { s_fg.have = 0; s_vk.fg_this = 0; return; }
+    SDL_LockMutex(s_fg.mu);
+    if (s_fg.mb_full) s_fg.dropped++;   /* the presenter never got to the one waiting */
+    s_fg.mb = s_fg.cur;
+    s_fg.mb_full = 1;
+    SDL_CondBroadcast(s_fg.cv);
+    SDL_UnlockMutex(s_fg.mu);
+}
