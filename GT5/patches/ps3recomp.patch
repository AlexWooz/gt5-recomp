+/* ---------------------------------------------------------------- replacement files */
+
+typedef struct {
+    u64 hash;
+    char* path;
+    volatile LONG state;   /* 0 idle, 1 loading, 2 ready, 3 on the GPU, -1 failed */
+    tp_image img;
+    u8* mem;
+    void* gpu;
+    u32 said;              /* rsx_texpack_once bits */
+    u32 uses;
+} tp_rec;
+
+static tp_rec* s_rec;
+static u32 s_n_rec, s_cap_rec;
+static int* s_map;         /* hash table: record index + 1 */
+static u32 s_map_mask;
+
+static int tp_hexval(char c)
+{
+    if (c >= '0' && c <= '9') return c - '0';
+    if (c >= 'a' && c <= 'f') return c - 'a' + 10;
+    if (c >= 'A' && c <= 'F') return c - 'A' + 10;
+    return -1;
+}
+
+/* The hash a file is named by (its first 16 characters), 0 if it has none. */
+static u64 tp_name_hash(const char* name)
+{
+    u64 h = 0;
+    for (int i = 0; i < 16; i++) {
+        const int v = tp_hexval(name[i]);
+        if (v < 0) return 0;
+        h = (h << 4) | (u64)v;
+    }
+    const char nx = name[16];
+    if (nx && nx != '_' && nx != '.' && nx != '-' && nx != ' ') return 0;
+    return h;
+}
+
+static int tp_ext(const char* name)   /* 1 .dds, 2 .png, 0 other */
+{
+    const char* dot = strrchr(name, '.');
+    if (!dot) return 0;
+    if (!_stricmp(dot, ".dds")) return 1;
+    if (!_stricmp(dot, ".png")) return 2;
+    return 0;
+}
+
+static void tp_index_dir(const char* dir, int depth)
+{
+    char pat[MAX_PATH * 2];
+    snprintf(pat, sizeof pat, "%s\\*", dir);
+    WIN32_FIND_DATAA fd;
+    HANDLE f = FindFirstFileA(pat, &fd);
+    if (f == INVALID_HANDLE_VALUE) return;
+    do {
+        if (fd.cFileName[0] == '.') continue;
+        char path[MAX_PATH * 2];
+        snprintf(path, sizeof path, "%s\\%s", dir, fd.cFileName);
+        if (fd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) {
+            if (depth < 8) tp_index_dir(path, depth + 1);
+            continue;
+        }
+        const int ext = tp_ext(fd.cFileName);
+        const u64 h = ext ? tp_name_hash(fd.cFileName) : 0;
+        if (!h) continue;
+        u32 k = 0;
+        for (; k < s_n_rec; k++) if (s_rec[k].hash == h) break;
+        if (k < s_n_rec) {
+            /* Two files for one texture: a DDS wins over a PNG, otherwise the first one found. */
+            const int had = tp_ext(s_rec[k].path);
+            fprintf(stderr, "[texpack] two files for %016llX: %s and %s, using the %s\n", (unsigned long long)h,
+                    s_rec[k].path, path, (ext == 1 && had != 1) ? "second" : "first");
+            if (ext == 1 && had != 1) { free(s_rec[k].path); s_rec[k].path = _strdup(path); }
+            continue;
+        }
+        if (s_n_rec == s_cap_rec) {
+            s_cap_rec = s_cap_rec ? s_cap_rec * 2 : 256;
+            s_rec = (tp_rec*)realloc(s_rec, sizeof(tp_rec) * s_cap_rec);
+        }
+        memset(&s_rec[s_n_rec], 0, sizeof(tp_rec));
+        s_rec[s_n_rec].hash = h;
+        s_rec[s_n_rec].path = _strdup(path);
+        s_n_rec++;
+    } while (FindNextFileA(f, &fd));
+    FindClose(f);
+}
+
+static void tp_build_map(void)
+{
+    u32 size = 64;
+    while (size < s_n_rec * 2u) size <<= 1;
+    s_map = (int*)calloc(size, sizeof(int));
+    s_map_mask = size - 1;
+    for (u32 k = 0; k < s_n_rec; k++) {
+        u32 j = (u32)(s_rec[k].hash ^ (s_rec[k].hash >> 32)) & s_map_mask;
+        while (s_map[j]) j = (j + 1) & s_map_mask;
+        s_map[j] = (int)k + 1;
+    }
+}
+
+int rsx_texpack_find(u64 hash)
+{
+    if (!s_map) return -1;
+    u32 j = (u32)(hash ^ (hash >> 32)) & s_map_mask;
+    while (s_map[j]) {
+        const int k = s_map[j] - 1;
+        if (s_rec[k].hash == hash) return k;
+        j = (j + 1) & s_map_mask;
+    }
+    return -1;
+}
+
+const char* rsx_texpack_name(int idx)
+{
+    const char* p = s_rec[idx].path;
+    const char* s = strrchr(p, '\\');
+    return s ? s + 1 : p;
+}
+
+int rsx_texpack_once(int idx, u32 reason)
+{
+    if (s_rec[idx].said & (1u << reason)) return 0;
+    s_rec[idx].said |= 1u << reason;
+    return 1;
+}
