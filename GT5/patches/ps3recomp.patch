+/* Does unit t read the remembered 3D scene the way the upscaler's output can stand in for? */
+static int eng_up_reads_scene(int si, u32 target, const rsx_dsp_texture* t)
+{
+    if (!s_scn.sig_valid || si < 0 || (u32)si == target || (u32)si >= g.n_surfaces || target >= g.n_surfaces) return 0;
+    const eng_surface* s = &g.surfaces[si];
+    if (!eng_scn_sig_is(&s_scn.sig, s) || eng_scn_sig_is(&s_scn.sig, &g.surfaces[target])) return 0;
