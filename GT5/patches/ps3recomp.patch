+static volatile LONG s_kb_menu_eaten;
+static LRESULT CALLBACK kb_menu_proc(HWND h, UINT m, WPARAM w, LPARAM l)
+{
+    if ((m == WM_SYSCOMMAND && (w & 0xFFF0) == SC_KEYMENU) || m == WM_SYSCHAR) {
+        const LONG n = InterlockedIncrement(&s_kb_menu_eaten);
+        if (n == 1 || n == 100 || n == 10000)
+            fprintf(stderr, "[keys] Alt or F10 is bound, so the window menu stays shut (%ld times)\n", (long)n);
