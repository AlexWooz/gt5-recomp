+    }
+    s_up.fails = s_up.waits = 0;
+    s_up.reason[0] = 0;
+    s_up.reset_next = 0;
+    s_up.last_ms = now ? now : 1u;
+    s_up.out_valid = 1;
+    s_up.evaluated = 1;
+    s_up.frame_ok = 1;
+    s_up.state = ENG_UP_S_RUNNING;
+    s_up.st_eval++;
+    s_up.st_reset += (u32)reset;
+    static u32 n_eval;                         /* every 300th evaluation (the counts since the line before) */
+    if (s_up.log && (n_eval++ % 300u) == 0u) {
+        fprintf(stderr, "[upscale] frame %u: %s %ux%u to %ux%u, model %d, jitter %.3f,%.3f handed over (phase %u of %u), reset=%d; "
+                        "since the last line: %u frames upscaled, %u of them without history, %u failed\n",
+                s_scn.present_no, eng_up_mode_name(s_up.made_mode), rw, rh, s_up.ow, s_up.oh, s_up.made_preset,
+                (double)fr.jitter_x, (double)fr.jitter_y, s_jit.phase, s_up.phases_now, reset,
