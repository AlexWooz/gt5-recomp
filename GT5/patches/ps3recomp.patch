diff --git a/libs/video/rsx_frame_rate.c b/libs/video/rsx_frame_rate.c
new file mode 100644
--- /dev/null
+++ b/libs/video/rsx_frame_rate.c
@@ -0,0 +1,30 @@
+/*
+ * rsx_frame_rate.c - the Frame rate setting: 60 or 30 (rsx_frame_rate.h). Sets the title's half-rate switch from
+ * GT5_SPEED, at the first vblank beat and whenever the setting changes (the in-game menu's row counts at once).
+ * Frame generation is its own setting and is not touched here: it doubles whatever the game runs (30 -> 60).
+ */
+#include <stdio.h>
+
+#include "gt5_settings.h"
+#include "rsx_frame_rate.h"
+
+static int* volatile s_switch;
+void rsx_frame_rate_set_switch(int* half_rate) { s_switch = half_rate; }
+int  rsx_frame_rate_has_switch(void) { return s_switch != NULL; }
+
+void rsx_frame_rate_apply(void)
+{
+    static unsigned gen;
+    static int applied = -1;   /* what the switch was set to here, -1 = nothing yet */
+    if (!s_switch || gen == gt5_settings_gen()) return;
+    gen = gt5_settings_gen();
+    /* "30"; an older menu's "30fg" is 30 too (gt5_settings.c rewrites it). Anything else is 60. */
+    const int half = gt5_setting_is("GT5_SPEED", "30") || gt5_setting_is("GT5_SPEED", "30fg");
+    if (half == applied) return;
+    const int first = applied < 0;
+    applied = half;
+    if (first && !half) return;   /* 60 at start: the switch stays as the mod set it (0, or GT5_MOD_HALF_RATE=1) */
+    __atomic_store_n(s_switch, half, __ATOMIC_RELAXED);
+    fprintf(stderr, "[frame-rate] %s\n", half ? "30 fps: the game waits two refreshes a frame (half rate)"
+                                            : "60 fps: the game's own pace");
+}
diff --git a/libs/video/rsx_frame_rate.h b/libs/video/rsx_frame_rate.h
new file mode 100644
--- /dev/null
+++ b/libs/video/rsx_frame_rate.h
@@ -0,0 +1,30 @@
+/*
+ * rsx_frame_rate - the Frame rate setting (GT5_SPEED in settings.bat; the in-game menu's Performance page and
+ * the launcher's Display page): "" = 60 (the game's own pace, the default), "30" = half rate (the game waits two
+ * refreshes a frame and steps its simulation twice: real speed at 30 frames a second, a third less CPU).
+ *
+ * Half rate is the title's own switch, a plain int its frame pacer reads at every frame (GT5: the half-rate mod's
+ * g_mod_half_rate, registered by GT5\src\gt5_framerate.cpp), so it changes while the game runs with no re-lift.
+ * Renderer-neutral: cellGcmSys.c calls rsx_frame_rate_apply at every vblank beat (the host loop's ticker).
+ * Frame generation is its own setting; it doubles whatever the game runs. Plain C, every platform.
+ */
+#ifndef RSX_FRAME_RATE_H
+#define RSX_FRAME_RATE_H
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* The title's half-rate switch. Without one there is no 30: the renderers hide the row in the menu. */
+void rsx_frame_rate_set_switch(int* half_rate);
+int  rsx_frame_rate_has_switch(void);
+
+/* At every vblank beat, from the ticker's thread: one load of the settings generation unless a setting changed;
+ * then the switch follows Frame rate, with one [frame-rate] line. At start a Frame rate of 60 leaves the switch as
+ * the mod set it (GT5_MOD_HALF_RATE, for tests); 30, and every change afterwards, set it. */
+void rsx_frame_rate_apply(void);
+
+#ifdef __cplusplus
+}
+#endif
+#endif /* RSX_FRAME_RATE_H */
diff --git a/runtime/settings/gt5_settings.c b/runtime/settings/gt5_settings.c
new file mode 100644
--- /dev/null
+++ b/runtime/settings/gt5_settings.c
@@ -0,0 +1,1002 @@
+/*
+ * gt5_settings.c - the settings registry (see gt5_settings.h).
+ *
+ * The file format and the merge at save time follow the launcher's Settings class
+ * (share_docs\launcher\GT5Launcher.cs: SetLine, Read, Merge, Save) line for line; a change there
+ * needs the same change here.
+ */
+#ifdef _WIN32
+#  ifndef WIN32_LEAN_AND_MEAN
+#    define WIN32_LEAN_AND_MEAN
+#  endif
+#  include <windows.h>
+#  include <io.h>
+#else
+#  include <unistd.h>
+#endif
+#include <ctype.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "gt5_settings.h"
+#include "gt5_settings_table.h"
+
+#define N_DEFS ((int)(sizeof k_defs / sizeof k_defs[0]))
+#define N_OVERRIDES ((int)(sizeof k_overrides / sizeof k_overrides[0]))
+#define MAX_CHOICES 32
+#define MAX_CALLBACKS 32
+
+volatile unsigned g_gt5_settings_gen = 1;
+
+/* One setting's state. Strings are malloc'd and never NULL once the registry is up.
+ *
+ * value is what this run goes by: the environment at start, then the menu's changes. base is the
+ * file's side: what settings.bat had for the key when it was last read or written (the launcher's
+ * default for one of its keys the file lacked), so at save time a key nobody changed here can be told
+ * from one somebody changed in the file meanwhile. The two differ when the game was started with a
+ * value the file doesn't hold (a test run with its own environment): that value stays in force and is
+ * never written unless it is changed in the menu. */
+typedef struct {
+    char* value;       /* stored: the player's own                                     */
+    char* sync;        /* value when the file was last read or written: differs = changed here */
+    char* base;        /* the file's value at that moment                              */
+    int   base_present;/* the file had the key (or it is one of the launcher's)        */
+    char* boot;        /* in force when the game started                               */
+    unsigned flags;    /* GT5_SF_*, live copy                                          */
+    gt5_setting_apply apply;
+    unsigned choice_flags[MAX_CHOICES];
+} slot_t;
+
+/* A key the table doesn't list: a line of the player's own (PS3_WHEEL_STEER), a mod's switch
+ * (GT5_MOD_...), a launcher key newer than this file. Kept and written back like the others. */
+typedef struct {
+    char* key;
+    slot_t s;
+} extra_t;
+
+static slot_t   s_slot[sizeof k_defs / sizeof k_defs[0]];
+static extra_t* s_extra;
+static int      s_n_extra, s_cap_extra;
+static int      s_inited;
+static char     s_path[1024];
+static struct { char key[64]; int any; gt5_setting_changed_fn fn; void* user; } s_cb[MAX_CALLBACKS];
+static int      s_n_cb;
+
+/* ---- a small lock ---------------------------------------------------------------------------------
+ * Changes are rare and readers come here only when the generation moved, so a spin lock is enough,
+ * and it builds the same on Windows, Linux and Android. */
+static volatile char s_lock;
+static void lock(void)
+{
+    while (__atomic_test_and_set(&s_lock, __ATOMIC_ACQUIRE)) {
+#ifdef _WIN32
+        SwitchToThread();
+#else
+        usleep(0);
+#endif
+    }
+}
+static void unlock(void) { __atomic_clear(&s_lock, __ATOMIC_RELEASE); }
+
+/* ---- small helpers ---------------------------------------------------------------------------------- */
+
+static char* dup_str(const char* s)
+{
+    const size_t n = s ? strlen(s) : 0;
+    char* d = (char*)malloc(n + 1);
+    if (!d) abort();
+    if (n) memcpy(d, s, n);
+    d[n] = 0;
+    return d;
+}
+static void set_str(char** dst, const char* s)
+{
+    char* d = dup_str(s);
+    free(*dst);
+    *dst = d;
+}
+static int ieq(const char* a, const char* b)
+{
+    for (; *a && *b; a++, b++)
+        if (toupper((unsigned char)*a) != toupper((unsigned char)*b)) return 0;
+    return *a == *b;
+}
+/* The launcher sorts with StringComparer.OrdinalIgnoreCase: by upper-cased code unit. */
+static int key_cmp(const char* a, const char* b)
+{
+    for (; *a && *b; a++, b++) {
+        const int ca = toupper((unsigned char)*a), cb = toupper((unsigned char)*b);
+        if (ca != cb) return ca - cb;
+    }
+    return (int)(unsigned char)*a - (int)(unsigned char)*b;
+}
+static size_t copy_out(const char* s, char* buf, size_t cap)
+{
+    const size_t n = s ? strlen(s) : 0;
+    if (buf && cap) {
+        const size_t m = n < cap - 1 ? n : cap - 1;
+        if (m) memcpy(buf, s, m);
+        buf[m] = 0;
+    }
+    return n;
+}
+static int def_index(const char* key)
+{
+    if (!key) return -1;
+    for (int i = 0; i < N_DEFS; i++) if (ieq(k_defs[i].key, key)) return i;
+    return -1;
+}
+static int extra_index(const char* key)
+{
+    for (int i = 0; i < s_n_extra; i++) if (ieq(s_extra[i].key, key)) return i;
+    return -1;
+}
+static slot_t* slot_of(const char* key)   /* under the lock */
+{
+    const int i = def_index(key);
+    if (i >= 0) return &s_slot[i];
+    const int e = extra_index(key);
+    return e >= 0 ? &s_extra[e].s : NULL;
+}
+static slot_t* extra_add(const char* key)   /* under the lock */
+{
+    if (s_n_extra == s_cap_extra) {
+        s_cap_extra = s_cap_extra ? s_cap_extra * 2 : 16;
+        s_extra = (extra_t*)realloc(s_extra, (size_t)s_cap_extra * sizeof *s_extra);
+        if (!s_extra) abort();
+    }
+    extra_t* x = &s_extra[s_n_extra++];
+    memset(x, 0, sizeof *x);
+    x->key = dup_str(key);
+    x->s.value = dup_str(""); x->s.sync = dup_str(""); x->s.base = dup_str(""); x->s.boot = dup_str("");
+    x->s.apply = GT5_APPLY_RESTART;
+    return &x->s;
+}
+static const char* env_or_empty(const char* key)
+{
+    const char* e = getenv(key);
+    return e ? e : "";
+}
+
+/* The value in force for key whose stored value is `stored`: an override wins while its condition
+ * holds. Under the lock. */
+static const char* in_force(const char* key, const char* stored)
+{
+    for (int o = 0; o < N_OVERRIDES && k_overrides[o].key; o++) {
+        if (!ieq(k_overrides[o].key, key)) continue;
+        const slot_t* w = slot_of(k_overrides[o].when);
+        if (w && ieq(w->value, k_overrides[o].is)) return k_overrides[o].value;
+    }
+    return stored;
+}
+
+/* ---- the file: the launcher's Read ------------------------------------------------------------------ */
+
+typedef struct { char* key; char* value; } kv_t;
+typedef struct {
+    kv_t*  kv;  int n_kv, cap_kv;
+    char** own; int n_own, cap_own;
+    int    had_speed;   /* the file has the Speed lines an older launcher wrote for 30 fps */
+} file_t;
+
+static void file_free(file_t* f)
+{
+    for (int i = 0; i < f->n_kv; i++) { free(f->kv[i].key); free(f->kv[i].value); }
+    for (int i = 0; i < f->n_own; i++) free(f->own[i]);
+    free(f->kv); free(f->own);
+    memset(f, 0, sizeof *f);
+}
+static int file_find(const file_t* f, const char* key)
+{
+    for (int i = 0; i < f->n_kv; i++) if (ieq(f->kv[i].key, key)) return i;
+    return -1;
+}
+static void file_put(file_t* f, const char* key, const char* value)
+{
+    const int i = file_find(f, key);
+    if (i >= 0) { set_str(&f->kv[i].value, value); return; }
+    if (f->n_kv == f->cap_kv) {
+        f->cap_kv = f->cap_kv ? f->cap_kv * 2 : 64;
+        f->kv = (kv_t*)realloc(f->kv, (size_t)f->cap_kv * sizeof *f->kv);
+        if (!f->kv) abort();
+    }
+    f->kv[f->n_kv].key = dup_str(key);
+    f->kv[f->n_kv].value = dup_str(value);
+    f->n_kv++;
+}
+static void file_own(file_t* f, const char* line)
+{
+    if (f->n_own == f->cap_own) {
+        f->cap_own = f->cap_own ? f->cap_own * 2 : 16;
+        f->own = (char**)realloc(f->own, (size_t)f->cap_own * sizeof *f->own);
+        if (!f->own) abort();
+    }
+    f->own[f->n_own++] = dup_str(line);
+}
+
+static int is_ws(char c) { return c == ' ' || c == '\t' || c == '\r' || c == '\n' || c == '\v' || c == '\f'; }
+static int is_key_char(char c)
+{
+    return (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '_';
+}
+static int starts_ci(const char* s, const char* prefix)
+{
+    for (; *prefix; s++, prefix++)
+        if (toupper((unsigned char)*s) != toupper((unsigned char)*prefix)) return 0;
+    return 1;
+}
+
+/* The launcher's SetLine:
+ *   ^\s*@?set\s+(?:"([A-Za-z0-9_]+)=(.*)"|([A-Za-z0-9_]+)=(.*))\s*$      (case ignored)
+ * 1 and key/value (malloc'd) when line is a set line. An unquoted value loses its trailing blanks. */
+static int parse_set_line(const char* line, char** key, char** value)
+{
+    const char* p = line;
+    while (is_ws(*p)) p++;
+    if (*p == '@') p++;
+    if (!starts_ci(p, "set") || !is_ws(p[3])) return 0;
+    p += 3;
+    while (is_ws(*p)) p++;
+    const char* end = p + strlen(p);
+    while (end > p && is_ws(end[-1])) end--;
+    const char* k;
+    const char* v_end = end;
+    if (*p == '"') {
+        if (end - p < 2 || end[-1] != '"') return 0;
+        k = p + 1;
+        v_end = end - 1;
+    } else {
+        k = p;
+    }
+    const char* q = k;
+    while (q < v_end && is_key_char(*q)) q++;
+    if (q == k || q >= v_end || *q != '=') return 0;
+    const size_t kn = (size_t)(q - k), vn = (size_t)(v_end - (q + 1));
+    *key = (char*)malloc(kn + 1); *value = (char*)malloc(vn + 1);
+    if (!*key || !*value) abort();
+    memcpy(*key, k, kn); (*key)[kn] = 0;
+    memcpy(*value, q + 1, vn); (*value)[vn] = 0;
+    return 1;
+}
+
+#define SPEED_MARK "REM Speed"
+#define OWN_MARK   "REM Your own lines"
+
+/* Lines the launcher writes itself (now or in earlier versions), so not the player's own. */
+static int launcher_line(const char* t)
+{
+    return !*t || ieq(t, "@echo off")
+        || starts_ci(t, "REM Written by the GT5 Launcher")
+        || starts_ci(t, "REM launcher, or edit them here")
+        || starts_ci(t, "REM Lines of your own")
+        || starts_ci(t, OWN_MARK)
+        || starts_ci(t, SPEED_MARK);
+}
+static int is_speed_key(const char* k)
+{
+    return ieq(k, "LD_WATCH") || ieq(k, "LD_WATCH_PRIORITY") || ieq(k, "LD_WATCH_DRAW");
+}
+
+#ifdef _WIN32
+static FILE* open_utf8(const char* path, const wchar_t* mode)
+{
+    wchar_t w[1024];
+    if (!MultiByteToWideChar(CP_UTF8, 0, path, -1, w, 1024)) return NULL;
+    return _wfopen(w, mode);
+}
+#else
+static FILE* open_utf8(const char* path, const char* mode) { return fopen(path, mode); }
+#endif
+
+/* The set lines of a settings.bat; any other line of the player's own goes to own as written (with
+ * its trailing blanks cut). A key set twice takes the later value, as cmd does. The Speed lines
+ * after the Speed mark are the launcher's, but reading goes on past them; for the Speed keys the
+ * first value outside that section counts, and an LD_WATCH_PRIORITY that came with a repeated
+ * LD_WATCH is dropped (what v0.1.20-v0.1.22 wrote without a mark). Returns 0 when there's no file. */
+static int file_read(const char* path, file_t* out)
+{
+    memset(out, 0, sizeof *out);
+#ifdef _WIN32
+    FILE* f = open_utf8(path, L"rb");
+#else
+    FILE* f = open_utf8(path, "rb");
+#endif
+    if (!f) return 0;
+    fseek(f, 0, SEEK_END);
+    long size = ftell(f);
+    fseek(f, 0, SEEK_SET);
+    if (size < 0 || size > (16 << 20)) { fclose(f); return 0; }
+    char* text = (char*)malloc((size_t)size + 1);
+    if (!text) abort();
+    const size_t got = fread(text, 1, (size_t)size, f);
+    fclose(f);
+    text[got] = 0;
+    char* p = text;
+    if (got >= 3 && (unsigned char)p[0] == 0xEF && (unsigned char)p[1] == 0xBB && (unsigned char)p[2] == 0xBF) p += 3;
+
+    int speed_section = 0, speed_lines = 0;
+    while (*p) {
+        /* one line: up to \r\n, \n or \r */
+        char* e = p;
+        while (*e && *e != '\r' && *e != '\n') e++;
+        char* next = e;
+        if (*next == '\r') { next++; if (*next == '\n') next++; }
+        else if (*next == '\n') next++;
+        const char saved = *e;
+        *e = 0;
+
+        const char* t = p;
+        while (is_ws(*t)) t++;
+        char trimmed[512];
+        { size_t n = strlen(t); while (n && is_ws(t[n - 1])) n--;
+          if (n >= sizeof trimmed) n = sizeof trimmed - 1;
+          memcpy(trimmed, t, n); trimmed[n] = 0; }
+
+        if (starts_ci(trimmed, SPEED_MARK)) {
+            speed_section = 1;
+            out->had_speed = 1;
+        } else {
+            char *k = NULL, *v = NULL;
+            if (!parse_set_line(p, &k, &v)) {
+                if (!launcher_line(trimmed)) {
+                    size_t n = strlen(p);
+                    while (n && is_ws(p[n - 1])) n--;
+                    const char c = p[n]; p[n] = 0;
+                    file_own(out, p);
+                    p[n] = c;
+                }
+            } else {
+                int keep = 1;
+                if (is_speed_key(k)) {
+                    if (speed_section) keep = 0;
+                    else if (file_find(out, k) >= 0) { if (ieq(k, "LD_WATCH")) speed_lines = 1; keep = 0; }
+                    else if (speed_lines && ieq(k, "LD_WATCH_PRIORITY")) keep = 0;
+                }
+                if (keep) file_put(out, k, v);
+                free(k); free(v);
+            }
+        }
+        *e = saved;
+        p = next;
+    }
+    free(text);
+    return 1;
+}
+
+/* ---- start-up --------------------------------------------------------------------------------------- */
+
+static int file_exists(const char* path)
+{
+#ifdef _WIN32
+    FILE* f = open_utf8(path, L"rb");
+#else
+    FILE* f = open_utf8(path, "rb");
+#endif
+    if (f) fclose(f);
+    return f != NULL;
+}
+
+static void find_path(const char* given)
+{
+    s_path[0] = 0;
+    if (given && *given) { snprintf(s_path, sizeof s_path, "%s", given); return; }
+    const char* e = getenv("GT5_SETTINGS_FILE");
+    if (e && *e) { snprintf(s_path, sizeof s_path, "%s", e); return; }
+    /* The launcher's Paths: GT5\settings.bat, with the exe in GT5\build. */
+    char exe[900] = "";
+#ifdef _WIN32
+    { wchar_t w[900];
+      const DWORD n = GetModuleFileNameW(NULL, w, 900);
+      if (n && n < 900) WideCharToMultiByte(CP_UTF8, 0, w, -1, exe, (int)sizeof exe, NULL, NULL); }
+    const char sep = '\\';
+#else
+    { const ssize_t n = readlink("/proc/self/exe", exe, sizeof exe - 1); exe[n > 0 ? n : 0] = 0; }
+    const char sep = '/';
+#endif
+    char* cut = strrchr(exe, sep);
+    if (cut) {
+        *cut = 0;                       /* ...\GT5\build */
+        cut = strrchr(exe, sep);
+        if (cut) {
+            *cut = 0;                   /* ...\GT5 */
+            snprintf(s_path, sizeof s_path, "%s%csettings.bat", exe, sep);
+            if (file_exists(s_path)) return;
+        }
+    }
+    /* play.bat starts the game in GT5 as well. Also where a first save goes when there's no file. */
+    if (!file_exists("settings.bat") && s_path[0]) return;
+    snprintf(s_path, sizeof s_path, "settings.bat");
+}
+
+static void slot_reset(slot_t* s)
+{
+    free(s->value); free(s->sync); free(s->base); free(s->boot);
+    memset(s, 0, sizeof *s);
+}
+
+void gt5_settings_init(const char* settings_path)
+{
+    lock();
+    for (int i = 0; i < N_DEFS; i++) slot_reset(&s_slot[i]);
+    for (int i = 0; i < s_n_extra; i++) { slot_reset(&s_extra[i].s); free(s_extra[i].key); }
+    s_n_extra = 0;
+
+    find_path(settings_path);
+    file_t disk;
+    const int have_file = file_read(s_path, &disk);
+
+    for (int i = 0; i < N_DEFS; i++) {
+        const gt5_setting_def* d = &k_defs[i];
+        slot_t* s = &s_slot[i];
+        const char* env = env_or_empty(d->key);
+        const int at = have_file ? file_find(&disk, d->key) : -1;
+        const int managed = (d->flags & GT5_SF_LAUNCHER) != 0;
+        s->boot = dup_str(env);
+        /* A key no reader in the game takes from the environment (the launcher's own): the file's
+         * value, else the launcher's default. Every other key: what this run started with. */
+        if (d->flags & GT5_SF_NOT_ENV) s->value = dup_str(at >= 0 ? disk.kv[at].value : *env ? env : d->def);
+        else                           s->value = dup_str(env);
+        s->base = dup_str(at >= 0 ? disk.kv[at].value : managed ? d->def : "");
+        s->base_present = at >= 0 || managed;
+        s->flags = d->flags;
+        s->apply = d->apply;
+        for (int c = 0; c < d->n_choices && c < MAX_CHOICES; c++) s->choice_flags[c] = d->choices[c].flags;
+    }
+    /* A key the Speed lines override: the environment holds the override, the player's own value is
+     * the file's (or nothing, when the environment's is just the override and there's no file). */
+    for (int o = 0; o < N_OVERRIDES && k_overrides[o].key; o++) {
+        const slot_t* w = slot_of(k_overrides[o].when);
+        slot_t* s = slot_of(k_overrides[o].key);
+        if (!w || !s || !ieq(w->value, k_overrides[o].is)) continue;
+        const int at = have_file ? file_find(&disk, k_overrides[o].key) : -1;
+        if (at >= 0) set_str(&s->value, disk.kv[at].value);
+        else if (have_file || ieq(s->value, k_overrides[o].value)) set_str(&s->value, "");
+    }
+    /* A file an older launcher wrote with 30 fps chosen ends in its Speed lines (LD_WATCH=2, LD_WATCH_PRIORITY=0,
+     * LD_WATCH_DRAW=2: drawing every other frame), and play.bat ran them, so they are in the environment. That 30
+     * fps is now the game's own half rate (GT5_SPEED=30, rsx_frame_rate.c): watch mode's keys go by the file's own
+     * lines, and the next save, here or in the launcher, leaves the Speed lines out. */
+    if (have_file && disk.had_speed)
+        for (int i = 0; i < N_DEFS; i++) {
+            if (!is_speed_key(k_defs[i].key)) continue;
+            const int at = file_find(&disk, k_defs[i].key);
+            set_str(&s_slot[i].value, at >= 0 ? disk.kv[at].value : "");
+        }
+    for (int i = 0; i < N_DEFS; i++) s_slot[i].sync = dup_str(s_slot[i].value);
+    /* A value an earlier test build wrote that reads as another now (k_renamed): taken as the new one, and as a
+     * change made here, so the next save writes it. */
+    for (int r = 0; k_renamed[r].key; r++) {
+        slot_t* s = slot_of(k_renamed[r].key);
+        if (s && ieq(s->value, k_renamed[r].old_value)) set_str(&s->value, k_renamed[r].value);
+    }
+    /* The file's other keys. */
+    for (int i = 0; have_file && i < disk.n_kv; i++) {
+        if (def_index(disk.kv[i].key) >= 0) continue;
+        slot_t* s = extra_add(disk.kv[i].key);
+        set_str(&s->value, disk.kv[i].value);
+        set_str(&s->sync, disk.kv[i].value);
+        set_str(&s->base, disk.kv[i].value);
+        set_str(&s->boot, env_or_empty(disk.kv[i].key));
+        s->base_present = 1;
+    }
+    if (have_file) file_free(&disk);
+    s_inited = 1;
+    g_gt5_settings_gen++;
+    unlock();
+}
+
+const char* gt5_settings_path(void) { return s_path; }
+
+/* ---- reading ---------------------------------------------------------------------------------------- */
+
+size_t gt5_setting_str(const char* key, char* buf, size_t cap)
+{
+    if (!s_inited) return copy_out(key ? getenv(key) : NULL, buf, cap);
+    lock();
+    const slot_t* s = slot_of(key);
+    size_t n;
+    if (s) n = copy_out(in_force(key, s->value), buf, cap);
+    else   n = copy_out(key ? getenv(key) : NULL, buf, cap);
+    unlock();
+    return n;
+}
+
+size_t gt5_setting_stored(const char* key, char* buf, size_t cap)
+{
+    if (!s_inited) return copy_out(key ? getenv(key) : NULL, buf, cap);
+    lock();
+    const slot_t* s = slot_of(key);
+    const size_t n = s ? copy_out(s->value, buf, cap) : copy_out(key ? getenv(key) : NULL, buf, cap);
+    unlock();
+    return n;
+}
+
+size_t gt5_setting_boot(const char* key, char* buf, size_t cap)
+{
+    if (!s_inited) return copy_out(key ? getenv(key) : NULL, buf, cap);
+    lock();
+    const slot_t* s = slot_of(key);
+    const size_t n = s ? copy_out(s->boot, buf, cap) : copy_out(key ? getenv(key) : NULL, buf, cap);
+    unlock();
+    return n;
+}
+
+int gt5_setting_pending_restart(const char* key)
+{
+    if (!s_inited) return 0;
+    lock();
+    const slot_t* s = slot_of(key);
+    const int r = s && s->apply == GT5_APPLY_RESTART && strcmp(in_force(key, s->value), s->boot) != 0;
+    unlock();
+    return r;
+}
+
+/* A number read by hand, so the C locale's decimal mark doesn't matter: "2.5" and "2,5" both. */
+static int parse_number(const char* s, double* out)
+{
+    while (is_ws(*s)) s++;
+    int neg = 0;
+    if (*s == '-') { neg = 1; s++; } else if (*s == '+') s++;
+    double v = 0, frac = 0;
+    int digits = 0;
+    for (; *s; s++) {
+        if (*s >= '0' && *s <= '9') {
+            if (frac > 0) { v += (*s - '0') * frac; frac /= 10; } else v = v * 10 + (*s - '0');
+            digits++;
+        } else if ((*s == '.' || *s == ',') && frac == 0) frac = 0.1;
+        else break;
+    }
+    if (!digits) return 0;
+    *out = neg ? -v : v;
+    return 1;
+}
+
+double gt5_setting_float(const char* key, double if_unset)
+{
+    char b[64];
+    gt5_setting_str(key, b, sizeof b);
+    double v;
+    return parse_number(b, &v) ? v : if_unset;
+}
+
+int gt5_setting_int(const char* key, int if_unset)
+{
+    char b[64];
+    gt5_setting_str(key, b, sizeof b);
+    double v;
+    if (!parse_number(b, &v)) return if_unset;
+    return (int)(v < 0 ? v - 0.5 : v + 0.5);
+}
+
+int gt5_setting_bool(const char* key, int if_unset)
+{
+    char b[16];
+    if (!gt5_setting_str(key, b, sizeof b)) return if_unset;
+    return !(ieq(b, "0") || ieq(b, "off") || ieq(b, "no") || ieq(b, "false"));
+}
+
+int gt5_setting_is(const char* key, const char* value)
+{
+    char b[256];
+    gt5_setting_str(key, b, sizeof b);
+    return ieq(b, value ? value : "");
+}
+
+/* ---- changing --------------------------------------------------------------------------------------- */
+
+static int s_mirror_env;
+/* Off by default: the C library's getenv isn't safe against a putenv on another thread, and the
+ * game's threads call getenv at odd moments. Tools and tests that are single-threaded may want it. */
+void gt5_settings_mirror_env(int on) { s_mirror_env = on; }
+
+static void fire(const char* key, const char* old_v, const char* new_v)
+{
+    for (int i = 0; i < s_n_cb; i++)
+        if (s_cb[i].fn && (s_cb[i].any || ieq(s_cb[i].key, key))) s_cb[i].fn(key, old_v, new_v, s_cb[i].user);
+}
+
+int gt5_setting_set(const char* key, const char* value)
+{
+    if (!key || !*key) return 0;
+    if (!value) value = "";
+    if (!s_inited) gt5_settings_init(NULL);
+    lock();
+    slot_t* s = slot_of(key);
+    if (!s) {
+        s = extra_add(key);
+        set_str(&s->boot, env_or_empty(key));
+        set_str(&s->value, s->boot);
+        set_str(&s->sync, s->boot);
+    }
+    if (!strcmp(s->value, value)) { unlock(); return 0; }
+    char* old = dup_str(s->value);
+    const int changed = 1;
+    set_str(&s->value, value);
+    g_gt5_settings_gen++;
+    unlock();
+    {
+        if (s_mirror_env) {
+#ifdef _WIN32
+            _putenv_s(key, value);
+#else
+            if (*value) setenv(key, value, 1); else unsetenv(key);
+#endif
+        }
+        fire(key, old, value);
+    }
+    free(old);
+    return changed;
+}
+
+int gt5_setting_set_int(const char* key, int value)
+{
+    char b[32];
+    snprintf(b, sizeof b, "%d", value);
+    return gt5_setting_set(key, b);
+}
+
+int gt5_setting_set_number(const char* key, double value)
+{
+    const int i = def_index(key);
+    char b[48];
+    if (i >= 0 && (k_defs[i].type == GT5_SET_INT || k_defs[i].type == GT5_SET_FLOAT)) {
+        const gt5_setting_def* d = &k_defs[i];
+        if (d->num_max > d->num_min) {
+            if (value < d->num_min) value = d->num_min;
+            if (value > d->num_max) value = d->num_max;
+        }
+        if (d->type == GT5_SET_INT) {
+            const int v = (int)(value < 0 ? value - 0.5 : value + 0.5);
+            if (v == (int)d->num_def) b[0] = 0; else snprintf(b, sizeof b, "%d", v);
+        } else {
+            /* the launcher's "0.#": one decimal at most, none when it's zero, '.' whatever the locale */
+            const long long t = (long long)(value * 10.0 + (value < 0 ? -0.5 : 0.5));
+            const long long d10 = (long long)(d->num_def * 10.0 + (d->num_def < 0 ? -0.5 : 0.5));
+            if (t == d10) b[0] = 0;
+            else if (t % 10 == 0) snprintf(b, sizeof b, "%lld", t / 10);
+            else snprintf(b, sizeof b, "%s%lld.%lld", t < 0 ? "-" : "", (t < 0 ? -t : t) / 10, (t < 0 ? -t : t) % 10);
+        }
+    } else {
+        const long long t = (long long)(value * 10.0 + (value < 0 ? -0.5 : 0.5));
+        if (t % 10 == 0) snprintf(b, sizeof b, "%lld", t / 10);
+        else snprintf(b, sizeof b, "%s%lld.%lld", t < 0 ? "-" : "", (t < 0 ? -t : t) / 10, (t < 0 ? -t : t) % 10);
+    }
+    return gt5_setting_set(key, b);
+}
+
+int gt5_setting_reset(const char* key)
+{
+    const int i = def_index(key);
+    return gt5_setting_set(key, i >= 0 ? k_defs[i].def : "");
+}
+
+void gt5_settings_on_change(const char* key, gt5_setting_changed_fn fn, void* user)
+{
+    lock();
+    if (s_n_cb < MAX_CALLBACKS && fn) {
+        s_cb[s_n_cb].any = !key || !*key;
+        snprintf(s_cb[s_n_cb].key, sizeof s_cb[s_n_cb].key, "%s", key ? key : "");
+        s_cb[s_n_cb].fn = fn;
+        s_cb[s_n_cb].user = user;
+        s_n_cb++;
+    }
+    unlock();
+}
+
+/* ---- what the menu needs ---------------------------------------------------------------------------- */
+
+int gt5_settings_count(void) { return N_DEFS; }
+const gt5_setting_def* gt5_settings_at(int index) { return index >= 0 && index < N_DEFS ? &k_defs[index] : NULL; }
+const gt5_setting_def* gt5_settings_find(const char* key) { return gt5_settings_at(def_index(key)); }
+
+static void ensure_init(void) { if (!s_inited) gt5_settings_init(NULL); }
+
+void gt5_setting_enable(const char* key, int enabled)
+{
+    ensure_init();
+    const int i = def_index(key);
+    if (i < 0) return;
+    lock();
+    if (enabled) s_slot[i].flags |= GT5_SF_ENABLED; else s_slot[i].flags &= ~(unsigned)GT5_SF_ENABLED;
+    unlock();
+}
+
+void gt5_setting_choice_enable(const char* key, const char* value, int enabled)
+{
+    ensure_init();
+    const int i = def_index(key);
+    if (i < 0) return;
+    lock();
+    for (int c = 0; c < k_defs[i].n_choices && c < MAX_CHOICES; c++)
+        if (ieq(k_defs[i].choices[c].value, value ? value : "")) {
+            if (enabled) s_slot[i].choice_flags[c] &= ~(unsigned)GT5_CF_UNAVAILABLE;
+            else         s_slot[i].choice_flags[c] |= GT5_CF_UNAVAILABLE;
+        }
+    unlock();
+}
+
+/* Why a choice is greyed out, in words for the player ("not added yet: launcher, Display"). A short
+ * list: only a handful of choices ever carry one. */
+static struct { int def, choice; char text[112]; } s_note[32];
+static int s_n_note;
+
+void gt5_setting_choice_note(const char* key, const char* value, const char* note)
+{
+    ensure_init();
+    const int i = def_index(key);
+    if (i < 0) return;
+    lock();
+    for (int c = 0; c < k_defs[i].n_choices && c < MAX_CHOICES; c++) {
+        if (!ieq(k_defs[i].choices[c].value, value ? value : "")) continue;
+        int n = 0;
+        while (n < s_n_note && !(s_note[n].def == i && s_note[n].choice == c)) n++;
+        if (n == s_n_note) {
+            if (s_n_note >= (int)(sizeof s_note / sizeof s_note[0])) break;
+            s_note[n].def = i; s_note[n].choice = c; s_n_note++;
+        }
+        snprintf(s_note[n].text, sizeof s_note[n].text, "%s", note ? note : "");
+    }
+    unlock();
+}
+
+int gt5_setting_choice_note_of(const char* key, int c, char* out, unsigned cap)
+{
+    if (out && cap) out[0] = 0;
+    const int i = def_index(key);
+    if (i < 0 || !s_inited || !out || !cap) return 0;
+    lock();
+    for (int n = 0; n < s_n_note; n++)
+        if (s_note[n].def == i && s_note[n].choice == c) { snprintf(out, cap, "%s", s_note[n].text); break; }
+    unlock();
+    return out[0] != 0;
+}
+
+void gt5_setting_set_apply(const char* key, gt5_setting_apply apply)
+{
+    ensure_init();
+    const int i = def_index(key);
+    if (i < 0) return;
+    lock();
+    s_slot[i].apply = apply;
+    unlock();
+}
+
+void gt5_setting_hide(const char* key, int hidden)
+{
+    ensure_init();
+    const int i = def_index(key);
+    if (i < 0) return;
+    lock();
+    if (hidden) s_slot[i].flags |= GT5_SF_HIDDEN; else s_slot[i].flags &= ~(unsigned)GT5_SF_HIDDEN;
+    unlock();
+}
+
+unsigned gt5_setting_flags(const char* key)
+{
+    const int i = def_index(key);
+    if (i < 0) return 0;
+    return s_inited ? s_slot[i].flags : k_defs[i].flags;
+}
+
+gt5_setting_apply gt5_setting_apply_of(const char* key)
+{
+    const int i = def_index(key);
+    if (i < 0) return GT5_APPLY_RESTART;
+    return s_inited ? s_slot[i].apply : k_defs[i].apply;
+}
+
+unsigned gt5_setting_choice_flags(const char* key, int c)
+{
+    const int i = def_index(key);
+    if (i < 0 || c < 0 || c >= k_defs[i].n_choices || c >= MAX_CHOICES) return 0;
+    return s_inited ? s_slot[i].choice_flags[c] : k_defs[i].choices[c].flags;
+}
+
+/* ---- saving: the launcher's Merge and Save ----------------------------------------------------------- */
+
+static int slot_dirty(const slot_t* s)
+{
+    return strcmp(s->value, s->sync) != 0;
+}
+
+int gt5_settings_dirty(void)
+{
+    if (!s_inited) return 0;
+    lock();
+    int d = 0;
+    for (int i = 0; i < N_DEFS && !d; i++) d = slot_dirty(&s_slot[i]);
+    for (int i = 0; i < s_n_extra && !d; i++) d = slot_dirty(&s_extra[i].s);
+    unlock();
+    return d;
+}
+
+typedef struct { char* p; size_t n, cap; } sb_t;
+static void sb_add(sb_t* b, const char* s)
+{
+    const size_t n = strlen(s);
+    if (b->n + n + 1 > b->cap) {
+        b->cap = (b->cap + n + 1) * 2;
+        b->p = (char*)realloc(b->p, b->cap);
+        if (!b->p) abort();
+    }
+    memcpy(b->p + b->n, s, n + 1);
+    b->n += n;
+}
+static void sb_line(sb_t* b, const char* s) { sb_add(b, s); sb_add(b, "\r\n"); }
+
+typedef struct { const char* key; slot_t* s; } ref_t;
+typedef struct { const char* key; const char* value; } line_t;
+static int line_cmp(const void* a, const void* b) { return key_cmp(((const line_t*)a)->key, ((const line_t*)b)->key); }
+
+typedef struct { char* key; char* old_v; char* new_v; } change_t;
+
+/* Takes in the file as it is now (Merge) and builds the text to write (Save). `adopt`: the values
+ * taken from the file become the registry's (a real save); 0 leaves the registry as it is (a
+ * preview). Changes made to stored values are appended to *changes for the callbacks. Under the lock. */
+static char* render_locked(int adopt, change_t** changes, int* n_changes)
+{
+    file_t disk;
+    const int have_file = file_read(s_path, &disk);
+
+    /* keys of the file the registry hasn't met: they join it, as the launcher's V takes them in */
+    for (int i = 0; have_file && i < disk.n_kv; i++) {
+        if (slot_of(disk.kv[i].key)) continue;
+        slot_t* s = extra_add(disk.kv[i].key);
+        set_str(&s->boot, env_or_empty(disk.kv[i].key));
+        /* neither in V nor in Base: not changed here, so the file's value is taken below */
+    }
+
+    const int total = N_DEFS + s_n_extra;
+    ref_t* refs = (ref_t*)malloc((size_t)(total ? total : 1) * sizeof *refs);
+    char** out_v = (char**)calloc((size_t)(total ? total : 1), sizeof *out_v);   /* merged value, NULL = not written */
+    if (!refs || !out_v) abort();
+    for (int i = 0; i < N_DEFS; i++) { refs[i].key = k_defs[i].key; refs[i].s = &s_slot[i]; }
+    for (int i = 0; i < s_n_extra; i++) { refs[N_DEFS + i].key = s_extra[i].key; refs[N_DEFS + i].s = &s_extra[i].s; }
+
+    /* The launcher's Merge: a key changed here keeps this value; any other takes the file's; one of
+     * the launcher's that the file lacks is written with what the file side last had (its default). */
+    for (int i = 0; i < total; i++) {
+        slot_t* s = refs[i].s;
+        const int managed = i < N_DEFS && (k_defs[i].flags & GT5_SF_LAUNCHER);
+        const int at = have_file ? file_find(&disk, refs[i].key) : -1;
+        if (slot_dirty(s)) out_v[i] = dup_str(s->value);
+        else if (at >= 0) out_v[i] = dup_str(disk.kv[at].value);
+        else if (managed) out_v[i] = dup_str(s->base);
+    }
+
+    if (adopt) {
+        for (int i = 0; i < total; i++) {
+            slot_t* s = refs[i].s;
+            const int managed = i < N_DEFS && (k_defs[i].flags & GT5_SF_LAUNCHER);
+            if (!slot_dirty(s)) {
+                /* Not changed here. Changed in the file since it was last read (by hand, by the
+                 * launcher)? Then that is the value from now on; a line taken out means "not set". */
+                const char* file_v = out_v[i] ? out_v[i] : "";
+                const int file_has = out_v[i] != NULL;
+                const int edited = file_has != s->base_present || strcmp(file_v, s->base) != 0;
+                if (edited && strcmp(s->value, file_v) != 0) {
+                    if (changes) {
+                        *changes = (change_t*)realloc(*changes, (size_t)(*n_changes + 1) * sizeof **changes);
+                        if (!*changes) abort();
+                        (*changes)[*n_changes].key = dup_str(refs[i].key);
+                        (*changes)[*n_changes].old_v = dup_str(s->value);
+                        (*changes)[*n_changes].new_v = dup_str(file_v);
+                        (*n_changes)++;
+                    }
+                    set_str(&s->value, file_v);
+                }
+            }
+            set_str(&s->base, out_v[i] ? out_v[i] : "");
+            s->base_present = out_v[i] != NULL || managed;
+            set_str(&s->sync, s->value);
+        }
+    }
+
+    /* the text */
+    sb_t b = { NULL, 0, 0 };
+    sb_line(&b, "@echo off");
+    sb_line(&b, "REM Written by the GT5 Launcher; play.bat runs it after its own defaults. Change these in the");
+    sb_line(&b, "REM launcher, or edit them here: one set \"NAME=value\" per line, an empty value means not set.");
+    sb_line(&b, "REM Lines of your own (like PS3_WHEEL_PEDALS) are kept, wherever you add them.");
+    line_t* order = (line_t*)malloc((size_t)(total ? total : 1) * sizeof *order);
+    if (!order) abort();
+    int n_order = 0;
+    for (int i = 0; i < total; i++)
+        if (out_v[i]) { order[n_order].key = refs[i].key; order[n_order].value = out_v[i]; n_order++; }
+    qsort(order, (size_t)n_order, sizeof *order, line_cmp);
+    for (int i = 0; i < n_order; i++) {
+        const char* v = order[i].value;
+        sb_add(&b, "set \""); sb_add(&b, order[i].key); sb_add(&b, "=");
+        for (const char* c = v; *c; c++) if (*c != '"') { const char one[2] = { *c, 0 }; sb_add(&b, one); }
+        sb_line(&b, "\"");
+    }
+    if (have_file && disk.n_own > 0) {
+        sb_line(&b, OWN_MARK ", as you wrote them:");
+        for (int i = 0; i < disk.n_own; i++) sb_line(&b, disk.own[i]);
