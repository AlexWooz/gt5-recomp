+/* The Frame generation row's state line: what is made and shown, or why not. Any thread. Returns 1
+ * while frames are being made. */
+int rsx_fg_state(char* text, size_t cap)
+{
+    if (!text || !cap) return 0;
+    text[0] = 0;
+    if (s_on <= 0) return 0;
+    if (fg.err) { snprintf(text, cap, "switched off: a Present failed (0x%08lX)", (unsigned long)fg.err); return 0; }
+    if (fg.failed) {
+        snprintf(text, cap, "%s", s_pp.stalled_at ? "paused: the presenter stopped taking frames; trying again"
+                                                  : "switched off: see the log ([framegen] off: ...)");
+        return 0;
+    }
+    if (!fg.pt_on) { snprintf(text, cap, "waiting for the first frame"); return 0; }
+    AcquireSRWLockShared(&s_pp.lock);
+    ReleaseSRWLockShared(&s_pp.lock);
+    /* For the menu's row: just which generator is working (the figures are in the log and on the
+     * Performance page). A vendor's that could not be used shows as the built-in one, which took over. */
+    const int vendor = s_vn.method == FG_M_FSR || s_vn.method == FG_M_DLSS;
+    const int took_over = vendor && s_vn.failed[s_vn.method == FG_M_DLSS];
+    const char* name = (!vendor || took_over) ? "Built-in" : s_vn.method == FG_M_DLSS ? "NVIDIA DLSS" : "AMD FSR 3";
+    /* [fga] with LD_FG_ALWAYS frames are made on every screen: no "starts in a race" (a benign race on
+     * s_fga.on: an int the RSX thread writes, -1 until it has read the setting) */
+    snprintf(text, cap, "%s%s", name, s_pp.l_made > 0 || s_fga.on != 0 ? "" : " (starts in a race)");
+    return s_pp.l_made > 0;
+}
