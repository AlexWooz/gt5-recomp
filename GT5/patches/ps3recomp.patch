+        int ok = spv != NULL && !quitting;
+        if (ok && vk_eng_translate_buf(P->src[0], RSX_SHADER_STAGE_VERTEX, &P->vs, spv, log, sizeof log)) ok = 0;
+        if (ok && vk_eng_translate_buf(P->src[1], RSX_SHADER_STAGE_FRAGMENT, &P->fs, spv, log, sizeof log)) ok = 0;
+        if (ok) {
+            /* The topologies draws have asked for so far; one asked for later is built by
