+static CRITICAL_SECTION s_lock;
+static CONDITION_VARIABLE s_wake;
+static int* s_loadq; static u32 s_loadq_n, s_loadq_cap;
+static tp_dump_job* s_dump_head; static tp_dump_job* s_dump_tail;
+static HANDLE s_thread;
+
+int rsx_texpack_poll(int idx)
+{
+    tp_rec* r = &s_rec[idx];
+    const LONG st = r->state;
+    if (st >= 2) return 1;
+    if (st < 0) return -1;
+    if (st == 0) {
+        r->state = 1;
+        EnterCriticalSection(&s_lock);
+        if (s_loadq_n == s_loadq_cap) {
+            s_loadq_cap = s_loadq_cap ? s_loadq_cap * 2 : 64;
+            s_loadq = (int*)realloc(s_loadq, sizeof(int) * s_loadq_cap);
+        }
+        s_loadq[s_loadq_n++] = idx;
+        LeaveCriticalSection(&s_lock);
+        WakeConditionVariable(&s_wake);
+    }
+    return 0;
+}
+
+static u8* tp_read_file(const char* path, u32* len)
+{
+    FILE* f = fopen(path, "rb");
+    if (!f) return NULL;
+    fseek(f, 0, SEEK_END);
+    const long n = ftell(f);
+    fseek(f, 0, SEEK_SET);
+    if (n <= 0 || n > (512l << 20)) { fclose(f); return NULL; }
+    u8* b = (u8*)malloc((size_t)n);
+    if (b && fread(b, 1, (size_t)n, f) != (size_t)n) { free(b); b = NULL; }
+    fclose(f);
+    *len = (u32)n;
+    return b;
+}
+
+static u32 tp_full_chain(u32 w, u32 h)
+{
+    u32 n = 1;
+    while (w > 1 || h > 1) { w = w > 1 ? w >> 1 : 1; h = h > 1 ? h >> 1 : 1; n++; }
+    return n;
+}
+
+/* A full chain of RGBA8 levels below the first, by 2x2 averages (the last row or column is reused
+ * for an odd size). Returns one block holding every level. */
+static u8* tp_rgba_mips(const u8* top, u32 w, u32 h, tp_image* im)
+{
+    const u32 n = tp_full_chain(w, h) > TP_MAX_LEVELS ? TP_MAX_LEVELS : tp_full_chain(w, h);
+    size_t total = 0;
+    { u32 mw = w, mh = h;
+      for (u32 m = 0; m < n; m++) { total += (size_t)mw * mh * 4; mw = mw > 1 ? mw >> 1 : 1; mh = mh > 1 ? mh >> 1 : 1; } }
+    u8* mem = (u8*)malloc(total);
+    if (!mem) return NULL;
+    memcpy(mem, top, (size_t)w * h * 4);
+    u8* prev = mem; u32 pw = w, ph = h;
+    size_t off = (size_t)w * h * 4;
+    im->fmt = TP_FMT_RGBA8; im->w = w; im->h = h; im->n_levels = n;
+    im->lv[0].w = w; im->lv[0].h = h; im->lv[0].row_bytes = w * 4; im->lv[0].rows = h; im->lv[0].data = mem;
+    for (u32 m = 1; m < n; m++) {
+        const u32 mw = pw > 1 ? pw >> 1 : 1, mh = ph > 1 ? ph >> 1 : 1;
+        u8* cur = mem + off;
+        for (u32 y = 0; y < mh; y++) {
+            const u32 y0 = (y * 2 < ph) ? y * 2 : ph - 1, y1 = (y * 2 + 1 < ph) ? y * 2 + 1 : ph - 1;
+            for (u32 x = 0; x < mw; x++) {
+                const u32 x0 = (x * 2 < pw) ? x * 2 : pw - 1, x1 = (x * 2 + 1 < pw) ? x * 2 + 1 : pw - 1;
+                const u8* a = prev + ((size_t)y0 * pw + x0) * 4; const u8* b = prev + ((size_t)y0 * pw + x1) * 4;
+                const u8* c = prev + ((size_t)y1 * pw + x0) * 4; const u8* d = prev + ((size_t)y1 * pw + x1) * 4;
+                u8* o = cur + ((size_t)y * mw + x) * 4;
+                for (int k = 0; k < 4; k++) o[k] = (u8)((a[k] + b[k] + c[k] + d[k] + 2) >> 2);
+            }
+        }
+        im->lv[m].w = mw; im->lv[m].h = mh; im->lv[m].row_bytes = mw * 4; im->lv[m].rows = mh; im->lv[m].data = cur;
+        off += (size_t)mw * mh * 4;
+        prev = cur; pw = mw; ph = mh;
+    }
+    return mem;
+}
+
+/* BC1/BC2/BC3 to RGBA8, for a DDS without mipmaps (the chain is then made from this). */
+static void tp_bc_colours(const u8* b, u8 col[4][4], int bc1)
+{
+    const u16 c0 = (u16)(b[0] | (b[1] << 8)), c1 = (u16)(b[2] | (b[3] << 8));
+    for (int i = 0; i < 2; i++) {
+        const u16 c = i ? c1 : c0;
+        col[i][0] = (u8)(((c >> 11) & 31) * 255 / 31);
+        col[i][1] = (u8)(((c >> 5) & 63) * 255 / 63);
+        col[i][2] = (u8)((c & 31) * 255 / 31);
+        col[i][3] = 255;
+    }
+    if (c0 > c1 || !bc1) {
+        for (int k = 0; k < 3; k++) {
+            col[2][k] = (u8)((2 * col[0][k] + col[1][k] + 1) / 3);
+            col[3][k] = (u8)((col[0][k] + 2 * col[1][k] + 1) / 3);
+        }
+        col[2][3] = col[3][3] = 255;
+    } else {
+        for (int k = 0; k < 3; k++) col[2][k] = (u8)((col[0][k] + col[1][k] + 1) / 2);
+        col[2][3] = 255;
+        col[3][0] = col[3][1] = col[3][2] = 0; col[3][3] = 0;
+    }
+}
+
+static u8* tp_bc_to_rgba(const u8* src, u32 fmt, u32 w, u32 h)
+{
+    u8* out = (u8*)malloc((size_t)w * h * 4);
+    if (!out) return NULL;
+    const u32 bw = (w + 3) / 4, bh = (h + 3) / 4, bs = fmt == TP_FMT_BC1 ? 8 : 16;
+    for (u32 by = 0; by < bh; by++)
+        for (u32 bx = 0; bx < bw; bx++) {
+            const u8* b = src + ((size_t)by * bw + bx) * bs;
+            const u8* cb = fmt == TP_FMT_BC1 ? b : b + 8;
+            u8 col[4][4];
+            tp_bc_colours(cb, col, fmt == TP_FMT_BC1);
+            const u32 idx = (u32)cb[4] | ((u32)cb[5] << 8) | ((u32)cb[6] << 16) | ((u32)cb[7] << 24);
+            u8 alpha[16];
+            if (fmt == TP_FMT_BC2) {
+                for (int i = 0; i < 16; i++) alpha[i] = (u8)(((b[i / 2] >> ((i & 1) * 4)) & 15) * 17);
+            } else if (fmt == TP_FMT_BC3) {
+                u8 a[8]; a[0] = b[0]; a[1] = b[1];
+                if (a[0] > a[1]) for (int i = 1; i < 7; i++) a[i + 1] = (u8)(((7 - i) * a[0] + i * a[1] + 3) / 7);
+                else { for (int i = 1; i < 5; i++) a[i + 1] = (u8)(((5 - i) * a[0] + i * a[1] + 2) / 5); a[6] = 0; a[7] = 255; }
+                u64 bits = 0;
+                for (int i = 0; i < 6; i++) bits |= (u64)b[2 + i] << (8 * i);
+                for (int i = 0; i < 16; i++) alpha[i] = a[(bits >> (3 * i)) & 7];
+            }
+            for (u32 py = 0; py < 4; py++)
+                for (u32 px = 0; px < 4; px++) {
+                    const u32 x = bx * 4 + px, y = by * 4 + py;
+                    if (x >= w || y >= h) continue;
+                    const u32 i = py * 4 + px;
+                    u8* o = out + ((size_t)y * w + x) * 4;
+                    const u8* c = col[(idx >> (2 * i)) & 3];
+                    o[0] = c[0]; o[1] = c[1]; o[2] = c[2];
+                    o[3] = fmt == TP_FMT_BC1 ? c[3] : alpha[i];
+                }
+        }
+    return out;
+}
+
+static const char* tp_load_png(tp_rec* r, const u8* buf, u32 len)
+{
+    int w = 0, h = 0, comp = 0;
+    u8* px = stbi_load_from_memory(buf, (int)len, &w, &h, &comp, 4);
+    if (!px) return "not a PNG this can read";
+    if (w < 1 || h < 1 || w > 8192 || h > 8192) { stbi_image_free(px); return "bigger than 8192"; }
+    r->mem = tp_rgba_mips(px, (u32)w, (u32)h, &r->img);
+    stbi_image_free(px);
+    return r->mem ? NULL : "out of memory";
+}
+
+static u32 rd32(const u8* p) { return (u32)p[0] | ((u32)p[1] << 8) | ((u32)p[2] << 16) | ((u32)p[3] << 24); }
+#define TP_FOURCC(a, b, c, d) ((u32)(a) | ((u32)(b) << 8) | ((u32)(c) << 16) | ((u32)(d) << 24))
+
+static const char* tp_load_dds(tp_rec* r, const u8* buf, u32 len)
+{
+    if (len < 128 || rd32(buf) != TP_FOURCC('D', 'D', 'S', ' ') || rd32(buf + 4) != 124) return "not a DDS file";
+    const u32 flags = rd32(buf + 8), h = rd32(buf + 12), w = rd32(buf + 16);
+    const u32 depth = rd32(buf + 24), mipc = rd32(buf + 28);
+    const u32 pf_flags = rd32(buf + 80), fourcc = rd32(buf + 84), bits = rd32(buf + 88);
+    const u32 rmask = rd32(buf + 92), gmask = rd32(buf + 96), bmask = rd32(buf + 100), amask = rd32(buf + 104);
+    const u32 caps2 = rd32(buf + 112);
+    if (caps2 & 0x200u) return "a cube map (not supported)";
+    if ((flags & 0x800000u) && depth > 1) return "a volume texture (not supported)";
+    if (w < 1 || h < 1 || w > 8192 || h > 8192) return "bigger than 8192";
+    u32 off = 128, fmt = TP_FMT_NONE, swap_rb = 0, bpp = 0, no_alpha = 0;
+    if ((pf_flags & 0x4u) && fourcc == TP_FOURCC('D', 'X', '1', '0')) {
+        if (len < 148) return "a cut-off DDS";
+        const u32 dxgi = rd32(buf + 128), dim = rd32(buf + 132), misc = rd32(buf + 136), arr = rd32(buf + 140);
+        off = 148;
+        if (dim != 3 || (misc & 0x4u) || arr > 1) return "not a single 2D texture";
+        switch (dxgi) {
+        case 71: case 72: fmt = TP_FMT_BC1; break;
+        case 74: case 75: fmt = TP_FMT_BC2; break;
+        case 77: case 78: fmt = TP_FMT_BC3; break;
+        case 98: case 99: fmt = TP_FMT_BC7; break;
+        case 28: case 29: fmt = TP_FMT_RGBA8; bpp = 4; break;
+        case 87: case 91: fmt = TP_FMT_RGBA8; bpp = 4; swap_rb = 1; break;
+        case 88: case 93: fmt = TP_FMT_RGBA8; bpp = 4; swap_rb = 1; no_alpha = 1; break;
+        default: return "a DXGI format this can't use (use BC1, BC3, BC7 or RGBA8)";
+        }
+    } else if (pf_flags & 0x4u) {
+        if (fourcc == TP_FOURCC('D', 'X', 'T', '1')) fmt = TP_FMT_BC1;
+        else if (fourcc == TP_FOURCC('D', 'X', 'T', '2') || fourcc == TP_FOURCC('D', 'X', 'T', '3')) fmt = TP_FMT_BC2;
+        else if (fourcc == TP_FOURCC('D', 'X', 'T', '4') || fourcc == TP_FOURCC('D', 'X', 'T', '5')) fmt = TP_FMT_BC3;
+        else return "a compression this can't use (use DXT1, DXT5 or BC7)";
+    } else if ((pf_flags & 0x40u) && (bits == 32 || bits == 24)) {
+        fmt = TP_FMT_RGBA8; bpp = bits / 8;
+        if (rmask == 0x00FF0000u && gmask == 0x0000FF00u && bmask == 0x000000FFu) swap_rb = 1;
+        else if (!(rmask == 0x000000FFu && gmask == 0x0000FF00u && bmask == 0x00FF0000u)) return "an RGB layout this can't use";
+        no_alpha = !(pf_flags & 0x1u) || !amask || bits == 24;
+    } else {
+        return "a pixel format this can't use (use DXT1, DXT5, BC7 or 32-bit RGBA)";
+    }
+    const int bc = fmt != TP_FMT_RGBA8;
+    if (bc && ((w & 3) || (h & 3))) return "compressed, but its size is not a multiple of 4";
+    const u32 full = tp_full_chain(w, h);
+    u32 n = ((flags & 0x20000u) && mipc > 1) ? mipc : 1;
+    if (n > full) n = full;
+    if (n > TP_MAX_LEVELS) n = TP_MAX_LEVELS;
+    const u32 bs = fmt == TP_FMT_BC1 ? 8 : 16;
+    /* Levels as stored; stop at the first one the file is too short for. */
+    size_t need[TP_MAX_LEVELS]; u32 have = 0; size_t total = 0;
+    { u32 mw = w, mh = h;
+      for (u32 m = 0; m < n; m++) {
+          need[m] = bc ? (size_t)((mw + 3) / 4) * ((mh + 3) / 4) * bs : (size_t)mw * mh * bpp;
+          if (off + total + need[m] > len) break;
+          total += need[m]; have++;
+          mw = mw > 1 ? mw >> 1 : 1; mh = mh > 1 ? mh >> 1 : 1;
+      } }
+    if (!have) return "a cut-off DDS";
+    const u8* src = buf + off;
+    if (!bc) {
+        /* To RGBA8, then either its own levels or a chain made from the first. */
+        u8* top = (u8*)malloc((size_t)w * h * 4);
+        if (!top) return "out of memory";
+        if (have == 1) {
+            for (size_t i = 0; i < (size_t)w * h; i++) {
+                const u8* s = src + i * bpp; u8* o = top + i * 4;
+                o[0] = swap_rb ? s[2] : s[0]; o[1] = s[1]; o[2] = swap_rb ? s[0] : s[2];
+                o[3] = no_alpha ? 255 : s[3];
+            }
+            r->mem = tp_rgba_mips(top, w, h, &r->img);
+            free(top);
+            return r->mem ? NULL : "out of memory";
+        }
+        free(top);
+        size_t out_total = 0;
+        { u32 mw = w, mh = h; for (u32 m = 0; m < have; m++) { out_total += (size_t)mw * mh * 4; mw = mw > 1 ? mw >> 1 : 1; mh = mh > 1 ? mh >> 1 : 1; } }
+        r->mem = (u8*)malloc(out_total);
+        if (!r->mem) return "out of memory";
+        size_t so = 0, oo = 0; u32 mw = w, mh = h;
+        for (u32 m = 0; m < have; m++) {
+            u8* o = r->mem + oo;
+            for (size_t i = 0; i < (size_t)mw * mh; i++) {
+                const u8* s = src + so + i * bpp; u8* d = o + i * 4;
+                d[0] = swap_rb ? s[2] : s[0]; d[1] = s[1]; d[2] = swap_rb ? s[0] : s[2];
+                d[3] = no_alpha ? 255 : s[3];
+            }
+            r->img.lv[m].w = mw; r->img.lv[m].h = mh; r->img.lv[m].row_bytes = mw * 4; r->img.lv[m].rows = mh;
+            r->img.lv[m].data = o;
+            so += need[m]; oo += (size_t)mw * mh * 4;
+            mw = mw > 1 ? mw >> 1 : 1; mh = mh > 1 ? mh >> 1 : 1;
+        }
+        r->img.fmt = TP_FMT_RGBA8; r->img.w = w; r->img.h = h; r->img.n_levels = have;
+        return NULL;
+    }
+    if (have == 1 && full > 1 && fmt != TP_FMT_BC7) {
+        /* No mipmaps in the file: unpack it and make them, so the texture doesn't shimmer far away. */
+        u8* top = tp_bc_to_rgba(src, fmt, w, h);
+        if (!top) return "out of memory";
+        r->mem = tp_rgba_mips(top, w, h, &r->img);
+        free(top);
+        return r->mem ? NULL : "out of memory";
+    }
+    r->mem = (u8*)malloc(total);
+    if (!r->mem) return "out of memory";
+    memcpy(r->mem, src, total);
+    size_t o = 0; u32 mw = w, mh = h;
+    for (u32 m = 0; m < have; m++) {
+        r->img.lv[m].w = (mw + 3) & ~3u; r->img.lv[m].h = (mh + 3) & ~3u;
+        r->img.lv[m].row_bytes = ((mw + 3) / 4) * bs; r->img.lv[m].rows = (mh + 3) / 4;
+        r->img.lv[m].data = r->mem + o;
+        o += need[m];
+        mw = mw > 1 ? mw >> 1 : 1; mh = mh > 1 ? mh >> 1 : 1;
+    }
+    r->img.fmt = fmt; r->img.w = w; r->img.h = h; r->img.n_levels = have;
+    if (have == 1 && full > 1)
+        fprintf(stderr, "[texpack] %s is BC7 without mipmaps: it will shimmer far away; save it with mipmaps\n", r->path);
+    return NULL;
+}
+
+static void tp_load(int idx)
+{
+    tp_rec* r = &s_rec[idx];
+    const ULONGLONG t0 = GetTickCount64();
+    u32 len = 0;
+    u8* buf = tp_read_file(r->path, &len);
+    const char* why = buf ? NULL : "can't be read";
+    if (buf) {
+        memset(&r->img, 0, sizeof r->img);
+        why = tp_ext(r->path) == 1 ? tp_load_dds(r, buf, len) : tp_load_png(r, buf, len);
+        free(buf);
+    }
+    InterlockedExchangeAdd(&s_load_ms, (LONG)(GetTickCount64() - t0));
+    if (why) {
+        fprintf(stderr, "[texpack] %s is not used: %s\n", r->path, why);
+        free(r->mem); r->mem = NULL;
+        InterlockedIncrement(&s_failed);
+        InterlockedExchange(&r->state, -1);
+        return;
+    }
+    InterlockedIncrement(&s_loaded);
+    MemoryBarrier();
+    InterlockedExchange(&r->state, 2);
+}
+
+/* ---------------------------------------------------------------- dumping */
+
+static u64* s_dumped; static u32 s_dumped_mask, s_dumped_n;   /* open addressing, 0 = empty */
+
+static void tp_dumped_add(u64 h)
+{
+    if (!s_dumped || (s_dumped_n + 1) * 2 > s_dumped_mask + 1) {
+        const u32 old_size = s_dumped ? s_dumped_mask + 1 : 0;
+        u64* old = s_dumped;
+        const u32 size = old_size ? old_size * 2 : 4096;
+        s_dumped = (u64*)calloc(size, sizeof(u64));
+        s_dumped_mask = size - 1; s_dumped_n = 0;
+        for (u32 i = 0; i < old_size; i++) if (old[i]) tp_dumped_add(old[i]);
+        free(old);
+    }
+    u32 j = (u32)(h ^ (h >> 32)) & s_dumped_mask;
+    while (s_dumped[j]) { if (s_dumped[j] == h) return; j = (j + 1) & s_dumped_mask; }
+    s_dumped[j] = h;
+    s_dumped_n++;
+}
+
+int rsx_texpack_dumped(u64 h)
+{
+    if (!s_dumped) return 0;
+    u32 j = (u32)(h ^ (h >> 32)) & s_dumped_mask;
+    while (s_dumped[j]) { if (s_dumped[j] == h) return 1; j = (j + 1) & s_dumped_mask; }
+    return 0;
+}
+
+static const char* tp_gcm_name(u32 f)
+{
+    switch (f & 0x9Fu) {
+    case 0x81: return "b8";
+    case 0x82: return "a1r5g5b5";
+    case 0x83: return "a4r4g4b4";
+    case 0x84: return "r5g6b5";
+    case 0x85: return "a8r8g8b8";
+    case 0x86: return "dxt1";
+    case 0x87: return "dxt3";
+    case 0x88: return "dxt5";
+    case 0x8B: return "g8b8";
+    default: return "other";
+    }
+}
+
+void rsx_texpack_dump(u64 hash, u32 fmt, u32 gcm_fmt, int rect, u32 w, u32 h, const u8* data, u32 bytes)
+{
+    if (rsx_texpack_dumped(hash)) return;
+    /* A long burst (a track load) is written as fast as the disk allows; past 256 MB waiting, the
+     * rest waits for its next decode. */
+    if (s_pending_bytes + bytes > (256ll << 20)) return;
+    tp_dump_job* j = (tp_dump_job*)malloc(sizeof *j);
+    u8* copy = (u8*)malloc(bytes);
+    if (!j || !copy) { free(j); free(copy); return; }
+    memcpy(copy, data, bytes);
+    j->next = NULL; j->hash = hash; j->fmt = fmt; j->gcm_fmt = gcm_fmt; j->w = w; j->h = h;
+    j->bytes = bytes; j->rect = rect; j->data = copy;
+    tp_dumped_add(hash);
+    InterlockedExchangeAdd64(&s_pending_bytes, bytes);
+    EnterCriticalSection(&s_lock);
+    if (s_dump_tail) s_dump_tail->next = j; else s_dump_head = j;
+    s_dump_tail = j;
+    LeaveCriticalSection(&s_lock);
+    WakeConditionVariable(&s_wake);
+}
+
+static void tp_png_out(void* ctx, void* data, int size) { fwrite(data, 1, (size_t)size, (FILE*)ctx); }
+
+static void tp_write(tp_dump_job* j)
+{
+    char name[96], path[MAX_PATH * 2], tmp[MAX_PATH * 2];
+    const int dds = j->fmt != TP_FMT_RGBA8;
+    snprintf(name, sizeof name, "%016llX_%ux%u_%s%s.%s", (unsigned long long)j->hash, j->w, j->h,
+             tp_gcm_name(j->gcm_fmt), j->rect ? "_rect" : "", dds ? "dds" : "png");
+    snprintf(path, sizeof path, "%s\\%s", s_dump_dir, name);
+    snprintf(tmp, sizeof tmp, "%s.tmp", path);
+    FILE* f = fopen(tmp, "wb");
+    if (!f) return;
+    int ok = 1;
+    if (dds) {
+        u32 hd[32];
+        memset(hd, 0, sizeof hd);
+        hd[0] = TP_FOURCC('D', 'D', 'S', ' ');
+        hd[1] = 124;
+        hd[2] = 0x1u | 0x2u | 0x4u | 0x1000u | 0x80000u;   /* caps, height, width, pixel format, linear size */
+        hd[3] = j->h; hd[4] = j->w; hd[5] = j->bytes;
+        hd[19] = 32; hd[20] = 0x4u;                        /* pixel format: fourCC */
+        hd[21] = j->fmt == TP_FMT_BC1 ? TP_FOURCC('D', 'X', 'T', '1')
+               : j->fmt == TP_FMT_BC2 ? TP_FOURCC('D', 'X', 'T', '3') : TP_FOURCC('D', 'X', 'T', '5');
+        hd[27] = 0x1000u;                                  /* DDSCAPS_TEXTURE */
+        ok = fwrite(hd, 1, 128, f) == 128 && fwrite(j->data, 1, j->bytes, f) == j->bytes;
+    } else {
+        ok = stbi_write_png_to_func(tp_png_out, f, (int)j->w, (int)j->h, 4, j->data, (int)(j->w * 4)) != 0;
+    }
+    ok = !ferror(f) && ok;
+    fclose(f);
+    if (ok && MoveFileExA(tmp, path, MOVEFILE_REPLACE_EXISTING)) InterlockedIncrement(&s_written);
+    else DeleteFileA(tmp);
+}
+
+static DWORD WINAPI tp_thread(LPVOID unused)
+{
+    (void)unused;
+    for (;;) {
+        int load = -1;
+        tp_dump_job* job = NULL;
+        EnterCriticalSection(&s_lock);
+        while (!s_loadq_n && !s_dump_head)
+            SleepConditionVariableCS(&s_wake, &s_lock, INFINITE);
+        if (s_loadq_n) {
+            load = s_loadq[0];
+            memmove(s_loadq, s_loadq + 1, sizeof(int) * --s_loadq_n);
+        } else {
+            job = s_dump_head;
+            s_dump_head = job->next;
+            if (!s_dump_head) s_dump_tail = NULL;
+        }
+        LeaveCriticalSection(&s_lock);
+        if (load >= 0) tp_load(load);
+        if (job) {
+            tp_write(job);
+            InterlockedExchangeAdd64(&s_pending_bytes, -(LONG64)job->bytes);
+            free(job->data);
+            free(job);
+        }
+    }
+}
+
+/* ---------------------------------------------------------------- start and report */
+
+static void tp_index_dumped(void)
+{
+    char pat[MAX_PATH * 2];
+    snprintf(pat, sizeof pat, "%s\\*", s_dump_dir);
+    WIN32_FIND_DATAA fd;
+    HANDLE f = FindFirstFileA(pat, &fd);
+    if (f == INVALID_HANDLE_VALUE) return;
+    do {
+        if (fd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) continue;
+        const u64 h = tp_ext(fd.cFileName) ? tp_name_hash(fd.cFileName) : 0;
+        if (h) tp_dumped_add(h);
+    } while (FindNextFileA(f, &fd));
+    FindClose(f);
+}
+
+void rsx_texpack_init(void)
+{
+    static int done;
+    if (done) return;
+    done = 1;
+    const char* base = getenv("PS3_TEX_DIR");
+    snprintf(s_dir, sizeof s_dir, "%s", base && base[0] ? base : "textures");
+    snprintf(s_dump_dir, sizeof s_dump_dir, "%s\\dump", s_dir);
+    snprintf(s_repl_dir, sizeof s_repl_dir, "%s\\replace", s_dir);
+    const char* d = getenv("PS3_TEX_DUMP");
+    const char* r = getenv("PS3_TEX_REPLACE");
+    const int want_dump = d && atoi(d) != 0;
+    const int want_repl = !(r && r[0] && atoi(r) == 0);
+    if (want_repl) {
+        const DWORD a = GetFileAttributesA(s_repl_dir);
+        if (a != INVALID_FILE_ATTRIBUTES && (a & FILE_ATTRIBUTE_DIRECTORY)) {
+            tp_index_dir(s_repl_dir, 0);
+            if (s_n_rec) tp_build_map();
+            fprintf(stderr, "[texpack] replace: %u texture file(s) in %s\n", s_n_rec, s_repl_dir);
+        }
+    } else {
+        fprintf(stderr, "[texpack] replace: off (PS3_TEX_REPLACE=0)\n");
+    }
+    if (want_dump) {
+        CreateDirectoryA(s_dir, NULL);
+        CreateDirectoryA(s_dump_dir, NULL);
+        const DWORD a = GetFileAttributesA(s_dump_dir);
+        if (a == INVALID_FILE_ATTRIBUTES || !(a & FILE_ATTRIBUTE_DIRECTORY)) {
+            fprintf(stderr, "[texpack] dump: can't make %s, dumping is off\n", s_dump_dir);
+        } else {
+            tp_index_dumped();
+            fprintf(stderr, "[texpack] dump: on, into %s (%u there already)\n", s_dump_dir, s_dumped_n);
+        }
+    }
+    const int dump_ok = want_dump && GetFileAttributesA(s_dump_dir) != INVALID_FILE_ATTRIBUTES;
+    if (!dump_ok && !s_n_rec) return;
+    InitializeCriticalSection(&s_lock);
+    InitializeConditionVariable(&s_wake);
+    s_thread = CreateThread(NULL, 0, tp_thread, NULL, 0, NULL);
+    if (!s_thread) { fprintf(stderr, "[texpack] no file thread, off\n"); return; }
+    SetThreadPriority(s_thread, THREAD_PRIORITY_BELOW_NORMAL);
+    /* Set last: the renderer only looks at these. */
+    g_texpack_dump = dump_ok;
+    g_texpack_replace = s_n_rec != 0;
+}
+
+void rsx_texpack_report(void)
+{
+    /* Every 10 s while files are used, loaded or written; once a minute when only hashing went on. */
+    static ULONGLONG next, last_print;
+    static u64 last_hashed, last_used, last_gpu, last_hash_qpc;
+    static LONG last_loaded, last_written, last_failed, last_load_ms;
+    const ULONGLONG now = GetTickCount64();
+    if (!next) { next = now + 10000; last_print = now; return; }
+    if (now < next) return;
+    next = now + 10000;
+    const u64 hashed = s_hashed - last_hashed, used = s_used - last_used, gpu = s_gpu_new - last_gpu;
+    const LONG loaded = s_loaded - last_loaded, written = s_written - last_written, failed = s_failed - last_failed;
+    const LONG load_ms = s_load_ms - last_load_ms;
+    if (!used && !loaded && !written && !failed && (!hashed || now - last_print < 59000)) return;
+    LARGE_INTEGER fq; QueryPerformanceFrequency(&fq);
+    const double hash_ms = (double)(s_hash_qpc - last_hash_qpc) * 1000.0 / (double)fq.QuadPart;
+    fprintf(stderr, "[texpack] last %llu s: %llu texture decodes hashed in %.2f ms; %llu replaced (%llu new on the GPU, "
+                    "%ld file(s) loaded in %ld ms, %ld failed); %ld dumped (%lld KB waiting)\n",
+            (unsigned long long)((now - last_print + 500) / 1000),
+            (unsigned long long)hashed, hash_ms, (unsigned long long)used, (unsigned long long)gpu,
+            (long)loaded, (long)load_ms, (long)failed, (long)written, (long long)(s_pending_bytes >> 10));
+    last_print = now;
+    last_hashed = s_hashed; last_used = s_used; last_gpu = s_gpu_new; last_hash_qpc = s_hash_qpc;
+    last_loaded = s_loaded; last_written = s_written; last_failed = s_failed; last_load_ms = s_load_ms;
+}
+
+#endif /* _WIN32 */
diff --git a/libs/video/rsx_texpack.h b/libs/video/rsx_texpack.h
new file mode 100644
--- /dev/null
+++ b/libs/video/rsx_texpack.h
@@ -0,0 +1,71 @@
+/*
+ * ps3recomp - texture packs: dumping the textures a game uploads and replacing them with files
+ * (HD texture packs), the renderer-independent half. The renderer (rsx_live_draw.c for DirectX 12)
+ * hashes a texture's top level when it decodes it, asks here for a replacement file by that hash,
+ * and hands over textures to dump.
+ *
+ *   PS3_TEX_DUMP=1      write each texture once, named by its hash, to <dir>\dump
+ *   PS3_TEX_REPLACE=0   ignore <dir>\replace (on by default when it holds files)
+ *   PS3_TEX_DIR=<dir>   the folder holding dump\ and replace\ (default: textures, beside play.bat)
+ *
+ * Files are named <16 hex digits of the hash>_<w>x<h>_<format>.dds|png; only the hash part is matched.
+ * Windows only for now (the Vulkan renderer does not call it yet); elsewhere it compiles to stubs.
+ */
+#ifndef PS3RECOMP_RSX_TEXPACK_H
+#define PS3RECOMP_RSX_TEXPACK_H
+
+#include "ps3emu/ps3types.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+enum { TP_FMT_NONE = 0, TP_FMT_RGBA8, TP_FMT_BC1, TP_FMT_BC2, TP_FMT_BC3, TP_FMT_BC7 };
+
+#define TP_MAX_LEVELS 15
+
+typedef struct { u32 w, h, row_bytes, rows; const u8* data; } tp_level;
+typedef struct { u32 fmt, w, h, n_levels; tp_level lv[TP_MAX_LEVELS]; } tp_image;
+
+extern int g_texpack_dump;      /* PS3_TEX_DUMP=1 */
+extern int g_texpack_replace;   /* replace\ holds files and PS3_TEX_REPLACE is not 0 */
+
+/* Once, from the renderer's init: reads the settings, indexes replace\, starts the file thread. */
+void rsx_texpack_init(void);
+/* Once a frame while either is on: a [texpack] line in play.err every 10 s while files are used,
+ * loaded or written, once a minute when only hashing went on. */
+void rsx_texpack_report(void);
+
+/* The name of a texture: its top level's bytes (rows of row_bytes, pitch apart), its format tag,
+ * size and channel remap. Never change it: texture packs are named by it. */
+u64 rsx_texpack_hash(const u8* data, u32 row_bytes, u32 rows, u32 pitch, u32 tag, u32 w, u32 h, u32 remap);
+/* Time the renderer spent hashing, for the report. */
+void rsx_texpack_note_hash(u64 qpc_ticks);
+
+/* Replacement for a hash: its index, or -1. */
+int rsx_texpack_find(u64 hash);
+/* 1 ready (image or GPU texture), 0 loading (the load starts on the first call), -1 failed. */
+int rsx_texpack_poll(int idx);
+/* The file's image (sizes stay valid after set_gpu; data is freed then). */
+const tp_image* rsx_texpack_image(int idx);
+void* rsx_texpack_gpu(int idx);
+/* The renderer's texture for it, kept here from now on; the file's data is freed. */
+void rsx_texpack_set_gpu(int idx, void* gpu);
+void rsx_texpack_fail(int idx);
+const char* rsx_texpack_name(int idx);
+/* Log once per file: returns 1 the first time for this index and reason. */
+int rsx_texpack_once(int idx, u32 reason);
+void rsx_texpack_note_use(int idx, int new_gpu);
+
+/* Dumping: has this hash been written (or queued, or found in dump\ at start)? */
+int rsx_texpack_dumped(u64 hash);
+/* Queue one texture's top level for writing: fmt TP_FMT_BC1/2/3 (written as DDS) or TP_FMT_RGBA8
+ * (written as PNG). gcm_fmt is the guest format byte (for the name), rect a texel-addressed one.
+ * The data is copied. */
+void rsx_texpack_dump(u64 hash, u32 fmt, u32 gcm_fmt, int rect, u32 w, u32 h, const u8* data, u32 bytes);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* PS3RECOMP_RSX_TEXPACK_H */
