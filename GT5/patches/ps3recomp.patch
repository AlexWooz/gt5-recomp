+static void vk_menu_test_tick(void)
+{
+    static int at = -1, step = -1;
+    static Uint32 t0;
+    if (at < 0) { const char* e = getenv("GT5_MENU_TEST"); at = e ? atoi(e) : 0; t0 = SDL_GetTicks(); }
+    if (at <= 0) return;
+    const int sec = (int)((SDL_GetTicks() - t0) / 1000u) - at;
+    const int want = sec < 0 ? -1 : sec / 4, pages = GT5_PAGE_COUNT, again = want - (pages + 2);
+    if (want < 0 || want == step) return;
+    step = want;
+    if (want < pages) {
+        gt5_menu_set_open(1);
+        gt5_menu_test_goto(want, 0);
+        fprintf(stderr, "[menu-test] page %d\n", want);
+    } else if (again >= 0 && again <= 2) {
+        gt5_menu_set_open(1);
+        gt5_menu_test_goto(again == 0 ? 0 : 2, again);
+        fprintf(stderr, "[menu-test] again: page %d, map %d\n", again == 0 ? 0 : 2, again);
+    } else if (again > 2) {
+        gt5_menu_set_open(0);
+        fprintf(stderr, "[menu-test] done\n");
+        at = 0;
+    } else if (want == pages) {
+        char kv[160];
+        const char* e = getenv("GT5_MENU_TEST_SET");
+        gt5_menu_set_open(0);
+        snprintf(kv, sizeof kv, "%s", e ? e : "");
+        char* eq = strchr(kv, '=');
+        if (eq) {
+            *eq = 0;
+            fprintf(stderr, "[menu-test] closed; %s=%s set: %d\n", kv, eq + 1, gt5_setting_set(kv, eq + 1));
