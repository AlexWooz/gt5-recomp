+static u64 s_hash_qpc, s_hashed;              /* renderer thread */
+static u64 s_used, s_gpu_new;                 /* renderer thread */
+static volatile LONG s_loaded, s_load_ms, s_failed, s_written;
+static volatile LONG64 s_pending_bytes;
